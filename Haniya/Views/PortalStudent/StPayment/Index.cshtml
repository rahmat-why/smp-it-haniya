@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Payments";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">My Payments</h2>
</div>

<div class="bg-white rounded-lg shadow">

    <!-- Toolbar -->
    <div class="px-4 pt-4">
        <div id="payment-toolbar"
             class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        </div>
    </div>

    <!-- Table -->
    <div class="px-4 pt-4">
        <div class="overflow-x-auto border border-gray-200 rounded-xl bg-white shadow-sm">
            <table id="payment-table"
                   class="w-full text-sm text-left text-gray-700 border-collapse">
                <thead class="bg-gray-50 text-gray-600 border-b border-gray-200">
                    <tr>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Date</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Class</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Type</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-right">Total</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-right">Paid</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-right">Remaining</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-center">Status</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Method</th>
                    </tr>
                </thead>

                <tbody class="bg-white"></tbody>
            </table>
        </div>
    </div>

    <!-- Footer -->
    <div class="px-4 pb-4 pt-3">
        <div id="payment-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info"></div>
            <div id="table-pagination"></div>
        </div>
    </div>

</div>

@section Scripts {

<script>
    $(document).ready(function () {
        initPaymentTable();
    });

    function initPaymentTable() {

        const table = $('#payment-table').DataTable({
            processing: true,
            serverSide: false,
            searching: true,
            lengthChange: true,
            dom: 'lftip',

            ajax: {
                url: '/StPayment/GetMyPayments',
                type: 'GET',
                dataSrc: function (res) {
                    if (!res.success) {
                        alert(res.message);
                        return [];
                    }
                    return res.data;
                }
            },

            columns: [
                {
                    data: 'payment_date',
                    className: 'px-5 py-3 font-medium text-gray-900 whitespace-nowrap',
                    render: d => d
                        ? new Date(d).toLocaleDateString('id-ID')
                        : '-'
                },
                { data: 'class_name', className: 'px-5 py-3 whitespace-nowrap' },
                { data: 'payment_type', className: 'px-5 py-3 whitespace-nowrap' },
                {
                    data: 'total_price',
                    className: 'px-5 py-3 text-right font-semibold text-gray-900 whitespace-nowrap',
                    render: d => d
                        ? 'Rp ' + Number(d).toLocaleString('id-ID')
                        : '-'
                },
                {
                    data: 'total_payment',
                    className: 'px-5 py-3 text-right font-semibold text-gray-900 whitespace-nowrap',
                    render: d => d
                        ? 'Rp ' + Number(d).toLocaleString('id-ID')
                        : '-'
                },
                {
                    data: 'remaining_payment',
                    className: 'px-5 py-3 text-right font-semibold text-blue-900 whitespace-nowrap',
                    render: d => d
                        ? 'Rp ' + Number(d).toLocaleString('id-ID')
                        : '-'
                },
                {
                    data: 'status',
                    className: 'px-5 py-3 text-center',
                    render: d => {
                        if (d === 'PAID')
                            return '<span class="px-2 py-1 text-xs rounded-md bg-green-50 text-green-700 border border-green-100 font-medium">PAID</span>';

                        if (d === 'PARTIAL')
                            return '<span class="px-2 py-1 text-xs rounded-md bg-yellow-50 text-yellow-700 border border-yellow-100 font-medium">PARTIAL</span>';

                        return '<span class="px-2 py-1 text-xs rounded-md bg-red-50 text-red-700 border border-red-100 font-medium">UNPAID</span>';
                    }
                },
                { data: 'payment_method', className: 'px-5 py-3 whitespace-nowrap' }
            ],

            initComplete: function () {
                styleStudentPaymentTable();
            },

            drawCallback: function () {
                styleStudentPaymentTable();
            }
        });
    }

    function styleStudentPaymentTable() {
        const wrapper = $('#payment-table_wrapper');
        const $length = wrapper.find('.dataTables_length, .dt-length');
        const $filter = wrapper.find('.dataTables_filter, .dt-search');

        $('#payment-toolbar').empty().append($length).append($filter);

        $length.addClass('flex items-center gap-2 text-sm text-gray-600');
        $length.find('label').addClass('flex items-center gap-2');
        $length.find('select').addClass(
            'border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 ' +
            'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
        );

        $filter.addClass('flex items-center gap-2 text-sm text-gray-600 w-full md:w-auto justify-end');
        $filter.find('label').addClass('flex items-center gap-2');
        $filter.find('input')
            .addClass(
                'border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white text-gray-700 ' +
                'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full md:w-72'
            )
            .attr('placeholder', 'Search payment...');

        let $info = wrapper.find('.dataTables_info').first();
        if ($info.length === 0) $info = wrapper.find('.dt-info').first();

        let $paginate = wrapper.find('.dataTables_paginate').first();
        if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

        if ($info.length > 0) {
            $('#table-info').empty().append($info);
            $info.removeClass().addClass('text-sm text-gray-600');
        }

        if ($paginate.length > 0) {
            $('#table-pagination').empty().append($paginate);
        }

        $('#table-pagination').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
        applyStudentPaginationStyle($('#table-pagination'));
    }

    function applyStudentPaginationStyle($scope) {
        const $root = $scope && $scope.length ? $scope : $(document);
        $root.find('.dataTables_paginate, .dt-paging').each(function () {
            const $paginate = $(this);
            $paginate.addClass('inline-flex items-center border border-gray-300 rounded-md overflow-hidden min-w-max');

            $paginate.find('a, span, button, .paginate_button, .dt-paging-button').each(function () {
                const $btn = $(this);
                const isCurrent = $btn.hasClass('current') || $btn.hasClass('active') || $btn.attr('aria-current') === 'page';
                const isDisabled = $btn.hasClass('disabled') || $btn.prop('disabled') || $btn.attr('aria-disabled') === 'true';
                const baseClasses = 'inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 last:border-r-0 min-w-[40px] transition-colors duration-150';

                $btn.addClass(baseClasses);
                $btn.removeClass('bg-blue-900 text-white cursor-default bg-gray-50 text-gray-400 cursor-not-allowed bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900 cursor-pointer');

                if (isCurrent) {
                    $btn.addClass('bg-blue-900 text-white cursor-default');
                } else if (isDisabled) {
                    $btn.addClass('bg-gray-50 text-gray-400 cursor-not-allowed');
                } else {
                    $btn.addClass('bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900 cursor-pointer');
                }
            });
        });
    }
</script>
}
