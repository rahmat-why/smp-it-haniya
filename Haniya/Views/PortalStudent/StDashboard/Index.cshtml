@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Dashboard";
}

<div class="max-w-7xl mx-auto space-y-10 py-8 px-4" id="student-dashboard">
    <div>
        <h1 class="text-3xl font-bold text-indigo-900">Student Dashboard</h1>
        <p class="text-gray-600 mt-2">Welcome back, @User.FindFirst("FullName")?.Value</p>
    </div>

    <div id="loading" class="text-center py-20">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-4 border-indigo-600"></div>
        <p class="mt-4 text-gray-600">Loading...</p>
    </div>

    <div id="content" class="hidden space-y-10">
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
            <div class="xl:col-span-7 bg-white rounded-2xl shadow-xl p-6 border border-gray-100 space-y-6">
                <div class="grid grid-cols-1 gap-6">
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                        <h4 class="text-lg font-bold text-indigo-900 mb-4">My Grade</h4>
                        <canvas id="studentGradesChart" height="140"></canvas>
                    </div>
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                        <h4 class="text-lg font-bold text-indigo-900 mb-4">My Attendance</h4>
                        <canvas id="studentAttendanceChart" height="140"></canvas>
                    </div>
                </div>
            </div>

            <div class="xl:col-span-5 space-y-4">
                <div class="bg-white rounded-2xl shadow-xl p-5 border border-gray-100">
                    <h3 class="text-lg font-bold text-indigo-900 mb-4">My Schedule</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 text-gray-700 uppercase text-xs">
                                <tr>
                                    <th class="px-6 py-4">Day</th>
                                    <th class="px-6 py-4">Time</th>
                                    <th class="px-6 py-4">Subject</th>
                                    <th class="px-6 py-4">Teacher</th>
                                </tr>
                            </thead>
                            <tbody id="weekly-schedule"></tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-xl p-5 border border-gray-100">
                    <h3 class="text-lg font-bold text-indigo-900 mb-4">My Payment</h3>
                    <div id="payment-bills" class="grid grid-cols-1 gap-3"></div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Articles (2/3) -->
            <div class="lg:col-span-2 bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-3xl font-bold text-indigo-900 mb-8">Latest Articles</h2>
                <div id="articles-list" class="space-y-6"></div>
                <div class="flex items-center justify-between mt-6">
                    <span id="articles-info" class="text-sm text-gray-600"></span>
                    <div id="articles-pagination" class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden"></div>
                </div>
            </div>
            <!-- Other card (1/3) -->
            <div class="lg:col-span-1 bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-3xl font-bold text-indigo-900 mb-8">Calendar Haniya</h2>
            </div>
        </div>
    </div>

</div>

<script>
    let studentGradesChart;
    let studentAttendanceChart;
    let dashboardData = null;

    function renderStudentGradesChart(data) {
        const ctx = document.getElementById('studentGradesChart').getContext('2d');
        if (studentGradesChart) studentGradesChart.destroy();

        const labels = (data || []).map(x => x.kelas || '-');
        const values = (data || []).map(x => Number(x.averageGrade || 0));

        studentGradesChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Average Grade',
                    data: values,
                    backgroundColor: '#6366f1',
                    borderRadius: 8,
                    barThickness: 28
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            stepSize: 20
                        }
                    }
                }
            }
        });
    }

    function renderStudentAttendanceChart(data) {
        const ctx = document.getElementById('studentAttendanceChart').getContext('2d');
        if (studentAttendanceChart) studentAttendanceChart.destroy();
        console.log(data);
        const classMap = {};
        (data || []).forEach(item => {
            const kelas = item.kelas || 'Unknown';
            const status = (item.status || '').toUpperCase().replace(/\s+/g, '').replace(/_/g, '');
            const count = Number(item.count || 0);

            if (!classMap[kelas]) {
                classMap[kelas] = {
                    PRESENT: 0,
                    SICK: 0,
                    EXCUSED: 0,
                    NOINFO: 0
                };
            }

            if (classMap[kelas][status] !== undefined) {
                classMap[kelas][status] = count;
            }
        });

        const kelasLabels = Object.keys(classMap);
        const presentData = kelasLabels.map(k => classMap[k].PRESENT);
        const sickData = kelasLabels.map(k => classMap[k].SICK);
        const excusedData = kelasLabels.map(k => classMap[k].EXCUSED);
        const noInfoData = kelasLabels.map(k => classMap[k].NOINFO);

        studentAttendanceChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: kelasLabels,
                datasets: [
                    {
                        label: 'Present',
                        data: presentData,
                        backgroundColor: '#10b981',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Sick',
                        data: sickData,
                        backgroundColor: '#facc15',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Excused',
                        data: excusedData,
                        backgroundColor: '#60a5fa',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'No Info',
                        data: noInfoData,
                        backgroundColor: '#9ca3af',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: true }
                },
                scales: {
                    x: {
                        stacked: true
                    },
                    y: {
                        beginAtZero: true,
                        stacked: true
                    }
                }
            }
        });
    }

    function formatRupiah(value) {
        return new Intl.NumberFormat('id-ID', {
            style: 'currency',
            currency: 'IDR',
            maximumFractionDigits: 0
        }).format(Number(value || 0));
    }

    function formatDateId(dateValue) {
        const d = new Date(dateValue);
        if (isNaN(d.getTime())) return '-';
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function getEndOfMonth(dateValue) {
        const d = new Date(dateValue);
        if (isNaN(d.getTime())) return null;
        return new Date(d.getFullYear(), d.getMonth() + 1, 0);
    }

    function renderPaymentBills(items) {
        const container = $('#payment-bills');
        container.empty();

        if (!items || items.length === 0) {
            container.html(`
                <div class="rounded-xl border border-gray-100 bg-gray-50 px-4 py-4 text-sm text-gray-500">
                    Tidak ada tagihan unpaid.
                </div>
            `);
            return;
        }

        items.forEach(item => {
            const sppDate = formatDateId(item.tanggalPembayaran);
            const deadline = getEndOfMonth(item.tanggalPembayaran);
            const deadlineText = deadline ? formatDateId(deadline) : '-';
            const nominal = formatRupiah(item.totalBelumLunas);

            container.append(`
                <div class="rounded-xl border border-rose-100 bg-rose-50/40 p-4">
                    <div class="text-xs font-semibold uppercase tracking-wide text-rose-700">SPP ${sppDate}</div>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-rose-100 text-rose-700 font-bold">!</span>
                        <div class="text-lg font-bold text-rose-800">${nominal}</div>
                    </div>
                    <div class="mt-2 text-xs text-gray-600">Payment Deadline: <span class="font-semibold text-gray-800">${deadlineText}</span></div>
                </div>
            `);
        });
    }

    function renderWeeklySchedule(schedule) {
        let html = '';

        if (!schedule || schedule.length === 0) {
            html = `
                <tr>
                    <td colspan="4" class="text-center py-8 text-gray-500">
                        Tidak ada jadwal untuk minggu ini
                    </td>
                </tr>`;
        } else {
            const today = new Date().toLocaleDateString('id-ID', { weekday: 'long' });
            const isWeekend = today === 'Sabtu' || today === 'Minggu';
            const targetDay = isWeekend ? 'Senin' : today;
            const dayItems = schedule.filter(x => x.day === targetDay);

            if (dayItems.length === 0) {
                html = `
                    <tr>
                        <td colspan="4" class="text-center py-8 text-gray-500">
                            Tidak ada jadwal untuk ${targetDay}
                        </td>
                    </tr>`;
            } else {
                dayItems.forEach((i, index) => {
                    html += `
                        <tr class="bg-amber-50 border-l-4 border-amber-400 ${index === 0 ? 'border-t-2 border-gray-200' : ''}">
                            ${index === 0 ? `
                                <td rowspan="${dayItems.length}" class="px-6 py-4 font-medium align-middle text-center text-amber-900">
                                    ${targetDay} ${isWeekend ? '(Upcoming)' : '(Today)'}
                                </td>
                            ` : ''}
                            <td class="px-6 py-4 text-indigo-900 font-medium">
                                ${i.startTime} - ${i.endTime}
                            </td>
                            <td class="px-6 py-4 font-semibold">
                                ${i.subject}
                            </td>
                            <td class="px-6 py-4 text-gray-600">
                                ${i.teacher}
                            </td>
                        </tr>`;
                });
            }
        }

        $('#weekly-schedule').html(html);
    }

    function loadStudentDashboard(){
        $.ajax({
            url: '/StDashboard/GetSummary',
            type: 'GET',
            success: function (res) {
                if (!res.success) {
                    Swal.fire('Error!', res.message || 'Gagal memuat data.', 'error');
                    return;
                }

                dashboardData = res.data || {};

                renderStudentGradesChart(dashboardData.gradesChart || []);
                renderStudentAttendanceChart(dashboardData.attendanceChart || []);
                renderWeeklySchedule(dashboardData.weeklySchedule || []);
                renderPaymentBills(dashboardData.unpaidPayments || []);

                allArticles = dashboardData.articles || [];
                renderArticles(1);

                $('#loading').addClass('hidden');
                $('#content').removeClass('hidden');
            },
            error: function () {
                Swal.fire('Error!', 'Gagal memuat data.', 'error');
            }
        });
    }

    function renderArticles(page) {
        const itemsPerPage = 6;
        const startIndex = (page - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const pageArticles = allArticles.slice(startIndex, endIndex);
        const totalPages = Math.ceil(allArticles.length / itemsPerPage);

        let articlesHtml = '<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">';
        pageArticles.forEach(a => {
            let tagHtml = '';
            (a.tags || []).forEach(tag => {
                tagHtml += `<span class="px-2 py-1 bg-rose-100 text-rose-800 rounded-full text-xs font-medium">${tag}</span>`;
            });
            articlesHtml += `
                    <div class="flex flex-col hover:bg-gray-50 p-4 rounded-2xl transition border border-gray-100">
                        <div class="w-full h-36 bg-gradient-to-br from-rose-200 to-pink-200 rounded-xl flex-shrink-0 bg-cover bg-center mb-3" style="background-image: url('${a.image || ''}')"></div>
                        <div class="flex-1 flex flex-col">
                            <p class="text-base font-semibold text-indigo-900 line-clamp-2">${a.title || ''}</p>
                            <p class="text-gray-500 text-xs mt-1">${a.date || ''}</p>
                            <p class="text-gray-600 text-sm mt-2 line-clamp-2">${a.content || ''}</p>
                            <div class="flex flex-wrap gap-1 mt-3">${tagHtml}</div>
                        </div>
                    </div>`;
        });
        articlesHtml += '</div>';

        $('#articles-list').html(articlesHtml);
        $('#articles-info').text(`Showing ${startIndex + 1} to ${Math.min(endIndex, allArticles.length)} of ${allArticles.length} articles`);

        let paginationHtml = '';
        for (let i = 1; i <= totalPages; i++) {
            paginationHtml += `
                    <button onclick="renderArticles(${i})"
                        class="px-3 py-2 text-sm font-medium border-r border-gray-300 last:border-r-0 min-w-[40px] transition-colors duration-150
                        ${i === page
                    ? 'bg-indigo-900 text-white cursor-default'
                    : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-indigo-900 cursor-pointer'}">
                        ${i}
                    </button>`;
        }
        $('#articles-pagination').html(paginationHtml);
    }

    $(document).ready(function() {
        loadStudentDashboard();
    });
</script>
