@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Schedule";
}

<!-- Header -->
<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold text-gray-900">
        My Class Schedule
    </h2>
</div>

<!-- Card -->
<div class="bg-white rounded-lg shadow">

    <!-- Table Wrapper -->
    <div class="overflow-x-auto px-4 pt-4">

        <table id="schedule-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">

            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">
                        Day
                    </th>

                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">
                        Time
                    </th>

                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">
                        Subject
                    </th>

                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">
                        Teacher
                    </th>

                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">
                        Class
                    </th>
                </tr>
            </thead>

            <tbody class="bg-white divide-y divide-gray-100"></tbody>

        </table>

    </div>

    <!-- Footer -->
    <div class="px-4 pb-4 pt-3 text-sm text-gray-600">
        <span id="schedule-info"></span>
    </div>

</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            $('#schedule-table').DataTable({
                ajax: {
                    url: '/StSchedule/GetMySchedule',
                    type: 'GET',
                    dataSrc: function (res) {
                        if (!res.success) {
                            alert(res.message);
                            return [];
                        }
                        return res.data;
                    }
                },

                paging: false,
                searching: false,
                info: false,
                ordering: true,

                columns: [
                    { data: 'day' },
                    {
                        data: null,
                        render: d => `${d.start_time} - ${d.end_time}`
                    },
                    { data: 'subject' },
                    { data: 'teacher' },
                    { data: 'class_name' }
                ],

                drawCallback: function (settings) {
                    let api = this.api();
                    let rows = api.rows({ page: 'current' }).nodes();

                    let lastDay = null;
                    let rowspan = 1;
                    let lastCell = null;

                    api.column(0, { page: 'current' }).data().each(function (day, i) {

                        let cell = $('td:eq(0)', rows[i]);

                        if (lastDay === day) {
                            cell.remove();
                            rowspan++;
                            lastCell.attr('rowspan', rowspan);

                        } else {
                            lastDay = day;
                            rowspan = 1;
                            lastCell = cell;
                        }
                    });
                }
            });
        });
    </script>
}
