@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Schedule";
}

<!-- Header -->
<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold text-gray-900">
        My Class Schedule
    </h2>
</div>

<!-- Card -->
<div class="bg-white rounded-lg shadow">

    <!-- Table Wrapper -->
    <div class="overflow-x-auto px-4 pt-4">
        <table id="schedule-table"
               class="min-w-full text-sm text-gray-700 border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr class="text-gray-600">
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">
                        Day
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">
                        Time
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">
                        Subject
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">
                        Teacher
                    </th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">
                        Class
                    </th>
                </tr>
            </thead>

            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="px-4 pb-4 pt-3 border-t border-gray-100 bg-white">
        <span id="schedule-info" class="text-sm text-gray-500"></span>
    </div>


</div>


@section Scripts {
    <script>
                $(document).ready(function () {
            $('#schedule-table').DataTable({
                ajax: {
                    url: '/StSchedule/GetMySchedule',
                    type: 'GET',
                    dataSrc: function (res) {
                        if (!res.success) {
                            alert(res.message);
                            return [];
                        }
                        return res.data;
                    }
                },

                paging: false,
                searching: false,
                info: false,
                ordering: true,

                columns: [
                    { data: 'day', className: 'py-3 font-medium text-gray-900 whitespace-nowrap' },
                    {
                        data: null,
                        className: 'py-3 text-gray-700 whitespace-nowrap',
                        render: d => `${d.start_time} - ${d.end_time}`
                    },
                    { data: 'subject', className: 'py-3 text-gray-700' },
                    { data: 'teacher', className: 'py-3 text-gray-700' },
                    { data: 'class_name', className: 'py-3 text-gray-700' }
                ],

                drawCallback: function () {
                    let api = this.api();
                    let rows = api.rows({ page: 'current' }).nodes();

                    let lastDay = null;
                    let rowspan = 1;
                    let lastCell = null;

                    api.column(0, { page: 'current' }).data().each(function (day, i) {
                        let cell = $('td:eq(0)', rows[i]);

                        if (lastDay === day) {
                            cell.remove();
                            rowspan++;
                            lastCell.attr('rowspan', rowspan);
                        } else {
                            lastDay = day;
                            rowspan = 1;
                            lastCell = cell;
                        }
                    });
                }
            });
        });

    </script>
}
