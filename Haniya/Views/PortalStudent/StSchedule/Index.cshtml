@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Schedule";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold text-gray-900">My Schedule List</h2>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4"><div id="schedule-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div></div>
    <div class="px-4 pt-4"><div class="relative overflow-x-auto border border-gray-200 rounded-xl bg-white shadow-sm"><div id="st-schedule-table-loading" class="hidden absolute inset-0 z-20 bg-white/80 backdrop-blur-[1px] flex items-center justify-center"><div class="flex flex-col items-center gap-3 text-gray-600"><div class="w-8 h-8 border-4 border-blue-200 border-t-blue-700 rounded-full animate-spin"></div><p class="text-sm font-medium">Loading schedule data...</p></div></div><table id="schedule-table" class="w-full text-sm text-left text-gray-700 border-collapse"><thead class="bg-gray-50 text-gray-600 border-b border-gray-200"><tr><th data-sort="day" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Day</th><th data-sort="time" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Time</th><th data-sort="subject" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Subject</th><th data-sort="teacher" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Teacher</th><th data-sort="class" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Class</th></tr></thead><tbody class="bg-white"></tbody></table></div></div>
    <div class="px-4 pb-4 pt-3"><div id="schedule-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"><div id="table-info"></div><div id="table-pagination"></div></div></div>
</div>

@section Scripts {
<script>
    const pageState = { page: 1, limit: 10, filters: { search: '' }, sort: { field: 'day', order: 'asc' }, hasNextPage: false, totalRows: 0 };
    let lastRequestKey = '';
    let searchDebounce = null;

    function getStateQuery() { return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`; }
    function syncStateToUrl() { history.replaceState({ ...pageState }, '', `?${getStateQuery()}`); }
    function hydrateStateFromUrl() { const q = new URLSearchParams(window.location.search); const page = Number(q.get('page') || 1); const limit = Number(q.get('limit') || 10); pageState.page = Number.isFinite(page) && page > 0 ? page : 1; pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10; pageState.filters.search = q.get('search') || ''; pageState.sort.field = q.get('sortField') || 'day'; pageState.sort.order = q.get('sortOrder') || 'asc'; }

    function dayLabel(day) {
        const dayMap = { DAY_MON: 'Senin', DAY_TUE: 'Selasa', DAY_WED: 'Rabu', DAY_THU: 'Kamis', DAY_FRI: 'Jumat', DAY_SAT: 'Sabtu', DAY_SUN: 'Minggu' };
        return dayMap[day] || day || '-';
    }

    function renderToolbar() {
        const searchVal = (pageState.filters.search || '').replace(/"/g, '&quot;');
        $('#schedule-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">Show <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select> rows</div>
            <div class="w-full md:w-80"><input id="schedule_search_filter" type="text" value="${searchVal}" class="w-full border border-gray-300 rounded-md p-2 text-sm" placeholder="Search schedule..." /></div>
        `);

        $('#list-limit').val(String(pageState.limit)).off('change').on('change', function () { const next = Number($(this).val() || 10); if (pageState.limit === next) return; pageState.limit = next; pageState.page = 1; lastRequestKey = ''; fetchSchedules(); });
    }

    function renderSortIndicators() {
        $('#schedule-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ↑' : ' ↓') : '';
            const base = $(this).text().replace(/ [↑↓]$/, '');
            $(this).text(base + icon);
        });
    }

    function renderRows(items) {
        const $tbody = $('#schedule-table tbody');
        if (!items || !items.length) { $tbody.html('<tr><td colspan="5" class="px-5 py-8 text-center text-gray-500">No data found.</td></tr>'); return; }

        let html = '';
        items.forEach(row => {
            html += `<tr class="border-b border-gray-100"><td class="px-5 py-3 whitespace-nowrap">${dayLabel(row.day)}</td><td class="px-5 py-3 whitespace-nowrap">${row.start_time || '-'} - ${row.end_time || '-'}</td><td class="px-5 py-3">${row.subject || '-'}</td><td class="px-5 py-3">${row.teacher || '-'}</td><td class="px-5 py-3 whitespace-nowrap">${row.class_name || '-'}</td></tr>`;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#table-info').html(`<span class="text-sm text-gray-600">Showing ${start} to ${end} of ${pageState.totalRows}</span>`);

        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        $('#table-pagination').html(`<div class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden min-w-max"><button id="page-prev" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${prevDisabled ? 'disabled' : ''}>Prev</button><span class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 bg-blue-900 text-white">${pageState.page}</span><button id="page-next" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${nextDisabled ? 'disabled' : ''}>Next</button></div>`);

        $('#page-prev').off('click').on('click', function () { if (pageState.page <= 1) return; pageState.page -= 1; lastRequestKey = ''; fetchSchedules(); });
        $('#page-next').off('click').on('click', function () { if (!pageState.hasNextPage) return; pageState.page += 1; lastRequestKey = ''; fetchSchedules(); });
    }

    function setStScheduleLoading(isLoading) {
        $('#st-schedule-table-loading').toggleClass('hidden', !isLoading);
    }

    async function fetchSchedules() {
        const payload = { page: pageState.page, limit: pageState.limit, filters: { ...pageState.filters }, sort: { ...pageState.sort } };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();
        setStScheduleLoading(true);

        try {
            const res = await $.ajax({ url: '/StSchedule/GetMySchedule', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload) });
            if (!res || !res.success) {
                lastRequestKey = '';
                await tailwindMessageModal('Failed', (res && res.message) ? res.message : 'Failed to load schedule.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.totalRows = Number(result.totalRows || 0);
            pageState.hasNextPage = !!result.hasNextPage;
            renderRows(items);
            renderPagination(items.length);
        } catch {
            lastRequestKey = '';
            await tailwindMessageModal('Error', 'An error occurred while loading schedule.');
        } finally {
            setStScheduleLoading(false);
        }
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();
        fetchSchedules();

        $('#schedule-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            else { pageState.sort.field = field; pageState.sort.order = 'asc'; }
            pageState.page = 1;
            lastRequestKey = '';
            fetchSchedules();
        });

        $(document).on('input', '#schedule_search_filter', function () {
            const val = ($(this).val() || '').trim();
            if ((pageState.filters.search || '') === val) return;
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                pageState.filters.search = val;
                pageState.page = 1;
                lastRequestKey = '';
                fetchSchedules();
            }, 300);
        });

    });
</script>
}
