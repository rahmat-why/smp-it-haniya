@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Schedule";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold text-gray-900">
        My Class Schedule
    </h2>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="overflow-x-auto px-4 pt-4">
        <table id="schedule-table"
               class="min-w-full text-sm text-gray-700 border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr class="text-gray-600">
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">Day</th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">Time</th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">Subject</th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">Teacher</th>
                    <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider">Class</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3 border-t border-gray-100 bg-white">
        <div id="schedule-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info"></div>
            <div id="table-pagination"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadStudentSchedule();
        });

        function loadStudentSchedule() {
            const dayOrder = {
                Senin: 1,
                Selasa: 2,
                Rabu: 3,
                Kamis: 4,
                Jumat: 5,
                Sabtu: 6,
                Minggu: 7
            };

            $.ajax({
                url: '/StSchedule/GetMySchedule',
                type: 'GET',
                success: function (res) {
                    if (!res.success) {
                        alert(res.message || 'Failed load schedule');
                        return;
                    }

                    const rows = (res.data || []).map(function (x) {
                        return {
                            ...x,
                            day_order: dayOrder[x.day] ?? 99,
                            time_order: x.start_time || ''
                        };
                    });

                    rows.sort(function (a, b) {
                        if (a.day_order !== b.day_order) return a.day_order - b.day_order;
                        return (a.time_order || '').localeCompare(b.time_order || '');
                    });

                    renderScheduleRows(rows);
                    updateScheduleInfo(rows.length);
                },
                error: function () {
                    alert('Failed load schedule');
                }
            });
        }

        function renderScheduleRows(rows) {
            const $tbody = $('#schedule-table tbody');
            $tbody.empty();

            if (!rows || rows.length === 0) {
                $tbody.html(`
                    <tr>
                        <td colspan="5" class="px-4 py-6 text-center text-gray-500">
                            No schedule available
                        </td>
                    </tr>
                `);
                return;
            }

            const grouped = {};
            rows.forEach(function (r) {
                if (!grouped[r.day]) grouped[r.day] = [];
                grouped[r.day].push(r);
            });

            const days = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];
            const today = new Date().toLocaleDateString('id-ID', { weekday: 'long' });
            const isWeekend = today === 'Sabtu' || today === 'Minggu';
            const targetDay = isWeekend ? 'Senin' : today;

            days.forEach(function (day) {
                const items = grouped[day];
                if (!items || items.length === 0) return;

                items.forEach(function (item, idx) {
                    const isTargetDay = day === targetDay;
                    const highlight = isTargetDay ? (isWeekend ? 'bg-amber-50' : 'bg-blue-50') : '';
                    const dayLabel = isTargetDay
                        ? `${day} ${isWeekend ? '(Upcoming)' : '(Today)'}`
                        : day;
                    const dayCell = idx === 0
                        ? `<td rowspan="${items.length}" class="px-4 py-3 font-semibold text-gray-900 whitespace-nowrap align-middle text-center ${highlight}">${dayLabel}</td>`
                        : '';

                    $tbody.append(`
                        <tr class="border-b border-gray-100 ${highlight}">
                            ${dayCell}
                            <td class="px-4 py-3 text-gray-700 whitespace-nowrap">${item.start_time || '-'} - ${item.end_time || '-'}</td>
                            <td class="px-4 py-3 text-gray-700">${item.subject || '-'}</td>
                            <td class="px-4 py-3 text-gray-700">${item.teacher || '-'}</td>
                            <td class="px-4 py-3 text-gray-700 whitespace-nowrap">${item.class_name || '-'}</td>
                        </tr>
                    `);
                });
            });
        }

        function updateScheduleInfo(totalRows) {
            $('#table-info').html(`<span class="text-sm text-gray-600">Showing ${totalRows} schedule item(s)</span>`);

            $('#table-pagination').empty().addClass('hidden');
        }
    </script>
}
