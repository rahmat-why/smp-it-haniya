@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Attendance";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">My Attendance</h2>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="attendance-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        </div>
    </div>
    <div class="px-4 pt-4">
        <div class="overflow-x-auto border border-gray-200 rounded-xl bg-white shadow-sm">
            <table id="attendance-table" class="w-full text-sm text-left text-gray-700 border-collapse">
                <thead class="bg-gray-50 text-gray-600 border-b border-gray-200">
                    <tr>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Date</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Class</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Teacher</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-center">Status</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Notes</th>
                    </tr>
                </thead>

                <tbody class="bg-white"></tbody>

            </table>
        </div>
    </div>
    <div class="px-4 pb-4 pt-3">
        <div id="attendance-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info"></div>
            <div id="table-pagination"></div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    $(document).ready(function () {
        initAttendanceTable();
    });

    function initAttendanceTable() {

        $('#attendance-table').DataTable({
            processing: true,
            serverSide: false,
            searching: true,
            lengthChange: true,
            ordering: true,
            dom: 't',

            ajax: {
                url: '/StAttendance/GetMyAttendance',
                type: 'GET',
                dataSrc: function (res) {
                    if (!res.success) {
                        alert(res.message);
                        return [];
                    }
                    return res.data;
                }
            },

            columns: [
                {
                    data: 'date',
                    className: 'px-5 py-3 font-medium text-gray-900 whitespace-nowrap'
                },
                {
                    data: 'class_name',
                    className: 'px-5 py-3 whitespace-nowrap'
                },
                {
                    data: 'teacher',
                    className: 'px-5 py-3 whitespace-nowrap'
                },
                {
                    data: 'status',
                    className: 'px-5 py-3 text-center font-semibold',
                    render: function (data) {
                        if (data === 'Present')
                            return '<span class="px-2 py-1 text-xs rounded-md bg-green-50 text-green-700 border border-green-100 font-medium">Present</span>';

                        if (data === 'Absent')
                            return '<span class="px-2 py-1 text-xs rounded-md bg-red-50 text-red-700 border border-red-100 font-medium">Absent</span>';

                        if (data === 'Late')
                            return '<span class="px-2 py-1 text-xs rounded-md bg-yellow-50 text-yellow-700 border border-yellow-100 font-medium">Late</span>';

                        return data ?? '-';
                    }
                },
                {
                    data: 'notes',
                    className: 'px-5 py-3 text-gray-600',
                    render: data => data || '-'
                }
            ],

            initComplete: function () {
                renderAttendanceControls(this.api());
            },

            drawCallback: function () {
                mergeDateRows(this.api());
                renderAttendanceControls(this.api());
            }
        });
    }

    function mergeDateRows(api) {
        let rows = api.rows({ page: 'current' }).nodes();
        let lastDate = null;
        let rowspan = 1;
        let lastCell = null;

        api.column(0, { page: 'current' }).data().each(function (date, i) {
            let cell = $('td:eq(0)', rows[i]);

            if (lastDate === date) {
                cell.remove();
                rowspan++;
                lastCell.attr('rowspan', rowspan);
            } else {
                lastDate = date;
                rowspan = 1;
                lastCell = cell;
            }
        });
    }

    function renderAttendanceControls(api) {
        $('#attendance-toolbar').html(`
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 w-full">
                <div class="flex items-center gap-2 text-sm text-gray-600">
                    Show 
                    <select id="dt-length" class="border border-gray-300 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-900">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select> rows
                </div>
                <div>
                    <input id="dt-search"
                        type="text"
                        placeholder="Search attendance..."
                        class="border border-gray-300 rounded-lg px-3 py-2 w-full md:w-72 focus:outline-none focus:ring-2 focus:ring-blue-900"/>
                </div>
            </div>
        `);

        $('#dt-length').val(api.page.len());

        $('#dt-length').off().on('change', function () {
            api.page.len($(this).val()).draw();
        });

        $('#dt-search').off().on('keyup', function () {
            api.search(this.value).draw();
        });

        const info = api.page.info();
        $('#table-info').html(`
            <span class="text-sm text-gray-600">
                Showing ${info.start + 1} to ${info.end} of ${info.recordsTotal} entries
            </span>
        `);

        let paginateHtml = `<div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">`;

        for (let i = 0; i < info.pages; i++) {
            paginateHtml += `
                <button data-page="${i}"
                    class="px-3 py-2 text-sm border-r last:border-r-0 transition
                    ${i === info.page
                        ? 'bg-blue-900 text-white font-semibold'
                        : 'bg-white text-gray-700 hover:bg-gray-50'}">
                    ${i + 1}
                </button>
            `;
        }

        paginateHtml += `</div>`;
        $('#table-pagination').html(paginateHtml);

        $('#table-pagination button').off().on('click', function () {
            api.page($(this).data('page')).draw('page');
        });
    }
</script>
}
