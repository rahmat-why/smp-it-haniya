@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "My Attendance";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">My Attendance List</h2>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4"><div id="attendance-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div></div>
    <div class="px-4 pt-4"><div class="relative overflow-x-auto border border-gray-200 rounded-xl bg-white shadow-sm"><div id="st-attendance-table-loading" class="hidden absolute inset-0 z-20 bg-white/80 backdrop-blur-[1px] flex items-center justify-center"><div class="flex flex-col items-center gap-3 text-gray-600"><div class="w-8 h-8 border-4 border-blue-200 border-t-blue-700 rounded-full animate-spin"></div><p class="text-sm font-medium">Loading attendance data...</p></div></div><table id="attendance-table" class="w-full text-sm text-left text-gray-700 border-collapse"><thead class="bg-gray-50 text-gray-600 border-b border-gray-200"><tr><th data-sort="date" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Date</th><th data-sort="class" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Class</th><th data-sort="teacher" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Teacher</th><th data-sort="status" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Status</th><th data-sort="notes" class="px-5 py-3 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none">Notes</th></tr></thead><tbody class="bg-white"></tbody></table></div></div>
    <div class="px-4 pb-4 pt-3"><div id="attendance-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"><div id="table-info"></div><div id="table-pagination"></div></div></div>
</div>

@section Scripts {
<script>
    const pageState = { page: 1, limit: 10, filters: { search: '' }, sort: { field: 'date', order: 'desc' }, hasNextPage: false, totalRows: 0 };
    let lastRequestKey = '';
    let searchDebounce = null;

    function formatDateId(dateValue) {
        const d = new Date(dateValue);
        if (isNaN(d.getTime())) return '-';
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' });
    }

    function getStateQuery() { return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`; }
    function syncStateToUrl() { history.replaceState({ ...pageState }, '', `?${getStateQuery()}`); }
    function hydrateStateFromUrl() { const q = new URLSearchParams(window.location.search); const page = Number(q.get('page') || 1); const limit = Number(q.get('limit') || 10); pageState.page = Number.isFinite(page) && page > 0 ? page : 1; pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10; pageState.filters.search = q.get('search') || ''; pageState.sort.field = q.get('sortField') || 'date'; pageState.sort.order = q.get('sortOrder') || 'desc'; }

    function renderToolbar() {
        const searchVal = (pageState.filters.search || '').replace(/"/g, '&quot;');
        $('#attendance-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">Show <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select> rows</div>
            <div class="w-full md:w-80"><input id="attendance_search_filter" type="text" value="${searchVal}" class="w-full border border-gray-300 rounded-md p-2 text-sm" placeholder="Search attendance..." /></div>
        `);

        $('#list-limit').val(String(pageState.limit)).off('change').on('change', function () { const next = Number($(this).val() || 10); if (pageState.limit === next) return; pageState.limit = next; pageState.page = 1; lastRequestKey = ''; fetchAttendance(); });
    }

    function renderSortIndicators() {
        $('#attendance-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ↑' : ' ↓') : '';
            const base = $(this).text().replace(/ [↑↓]$/, '');
            $(this).text(base + icon);
        });
    }

    function renderRows(items) {
        const $tbody = $('#attendance-table tbody');
        if (!items || !items.length) {
            $tbody.html(`
                <tr>
                    <td colspan="5" class="px-5 py-10 text-center">
                        <div class="flex flex-col items-center gap-2 text-gray-500">
                            <div class="text-sm font-semibold text-gray-700">Tidak ada data attendance</div>
                            <div class="text-xs">Coba ubah kata pencarian atau cek kembali data absensi siswa.</div>
                        </div>
                    </td>
                </tr>
            `);
            return;
        }

        let html = '';
        items.forEach(row => {
            const st = (row.status || '').toUpperCase();
            let badge = `<span class="px-2 py-1 text-xs rounded-md bg-gray-50 text-gray-700 border border-gray-100 font-medium">${row.status || '-'}</span>`;
            if (st === 'PRESENT') badge = '<span class="px-2 py-1 text-xs rounded-md bg-green-50 text-green-700 border border-green-100 font-medium">Present</span>';
            else if (st === 'ABSENT' || st === 'NOINFO') badge = '<span class="px-2 py-1 text-xs rounded-md bg-red-50 text-red-700 border border-red-100 font-medium">Absent</span>';
            else if (st === 'LATE') badge = '<span class="px-2 py-1 text-xs rounded-md bg-yellow-50 text-yellow-700 border border-yellow-100 font-medium">Late</span>';
            else if (st === 'SICK') badge = '<span class="px-2 py-1 text-xs rounded-md bg-blue-50 text-blue-700 border border-blue-100 font-medium">Sick</span>';
            else if (st === 'EXCUSED') badge = '<span class="px-2 py-1 text-xs rounded-md bg-purple-50 text-purple-700 border border-purple-100 font-medium">Excused</span>';

            html += `<tr class="border-b border-gray-100"><td class="px-5 py-3 whitespace-nowrap">${row.date ? formatDateId(row.date) : '-'}</td><td class="px-5 py-3 whitespace-nowrap">${row.class_name || '-'}</td><td class="px-5 py-3 whitespace-nowrap">${row.teacher || '-'}</td><td class="px-5 py-3">${badge}</td><td class="px-5 py-3 text-gray-600">${row.notes || '-'}</td></tr>`;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#table-info').html(`<span class="text-sm text-gray-600">Menampilkan ${start} sampai ${end} dari ${pageState.totalRows} data</span>`);

        const totalPages = Math.max(1, Math.ceil(pageState.totalRows / pageState.limit));
        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        const pageStart = Math.max(1, Math.min(pageState.page - 1, totalPages - 2));
        const pageEnd = Math.min(totalPages, pageStart + 2);
        const pageButtons = [];
        for (let i = pageStart; i <= pageEnd; i++) {
            const active = i === pageState.page;
            pageButtons.push(`<button type="button" data-page="${i}" class="page-number inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 ${active ? 'bg-blue-900 text-white' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${active ? 'disabled' : ''}>${i}</button>`);
        }

        $('#table-pagination').html(`<div class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden min-w-max"><button id="page-first" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${prevDisabled ? 'disabled' : ''}>First</button><button id="page-prev" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>${pageButtons.join('')}<button id="page-next" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${nextDisabled ? 'disabled' : ''}>Next</button><button id="page-last" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${nextDisabled ? 'disabled' : ''}>Last</button></div>`);

        function goToPage(page) {
            const nextPage = Math.min(Math.max(1, page), totalPages);
            if (nextPage === pageState.page) return;
            pageState.page = nextPage;
            lastRequestKey = '';
            fetchAttendance();
        }

        $('#page-first').off('click').on('click', function () { if (prevDisabled) return; goToPage(1); });
        $('#page-prev').off('click').on('click', function () { if (prevDisabled) return; goToPage(pageState.page - 1); });
        $('.page-number').off('click').on('click', function () { goToPage(Number($(this).data('page'))); });
        $('#page-next').off('click').on('click', function () { if (nextDisabled) return; goToPage(pageState.page + 1); });
        $('#page-last').off('click').on('click', function () { if (nextDisabled) return; goToPage(totalPages); });
    }

    function setStAttendanceLoading(isLoading) {
        $('#st-attendance-table-loading').toggleClass('hidden', !isLoading);
    }

    async function fetchAttendance() {
        const payload = { page: pageState.page, limit: pageState.limit, filters: { ...pageState.filters }, sort: { ...pageState.sort } };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();
        setStAttendanceLoading(true);

        try {
            const res = await $.ajax({ url: '/StAttendance/GetMyAttendance', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload) });
            if (!res || !res.success) {
                lastRequestKey = '';
                await tailwindMessageModal('Failed', (res && res.message) ? res.message : 'Failed to load attendance.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.page = Number(result.currentPage || pageState.page);
            pageState.limit = Number(result.limit || pageState.limit || 10);
            pageState.totalRows = Number(result.totalRows || 0);
            pageState.hasNextPage = !!result.hasNextPage;
            syncStateToUrl();
            renderRows(items);
            renderPagination(items.length);
        } catch {
            lastRequestKey = '';
            await tailwindMessageModal('Error', 'An error occurred while loading attendance.');
        } finally {
            setStAttendanceLoading(false);
        }
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();
        fetchAttendance();

        $('#attendance-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            else { pageState.sort.field = field; pageState.sort.order = 'asc'; }
            pageState.page = 1;
            lastRequestKey = '';
            fetchAttendance();
        });

        $(document).on('input', '#attendance_search_filter', function () {
            const val = ($(this).val() || '').trim();
            if ((pageState.filters.search || '') === val) return;
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                pageState.filters.search = val;
                pageState.page = 1;
                lastRequestKey = '';
                fetchAttendance();
            }, 300);
        });
    });
</script>
}
