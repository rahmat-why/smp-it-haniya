@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
}

<section class="pt-24 pb-10 px-4 sm:px-6 lg:px-10">
    <div class="max-w-7xl mx-auto">
        <div class="mb-8">
            <p class="text-xs uppercase tracking-[0.25em] text-blue-700">School Insights</p>
            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-2">Latest Articles</h1>
        </div>

        <div id="articleContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>

        <div class="flex justify-center gap-4 mt-10">
            <button id="prevBtn" onclick="prevPage()" class="px-4 py-2 bg-gray-300 rounded">Prev</button>
            <button id="nextBtn" onclick="nextPage()" class="px-4 py-2 bg-blue-600 text-white rounded">Next</button>
        </div>
    </div>
</section>

<script>
    let currentPage = 1;
    let currentData = [];

    document.addEventListener("DOMContentLoaded", function () {
        loadArticles(currentPage);
    });

    function loadArticles(page) {
        fetch(`/LandingPage/GetArticleData?page=${page}`)
            .then(res => res.json())
            .then(data => {
                currentData = Array.isArray(data) ? data : [];
                const container = document.getElementById("articleContainer");
                container.innerHTML = "";

                if (currentData.length === 0) {
                    container.innerHTML = "<p class='col-span-3 text-center text-gray-500'>No data available</p>";
                    updatePagerState();
                    return;
                }

                currentData.forEach(item => {
                    container.innerHTML += `
                        <a href="/news-article/${encodeURIComponent(item.id)}"
                           class="relative rounded-2xl overflow-hidden shadow-lg group cursor-pointer">
                            <img src="${item.image ? '/image/landingpage/' + item.image : '/image/landingpage/default.jpg'}"
                                 class="w-full h-[420px] object-cover group-hover:scale-105 transition duration-500"
                                 alt="${escapeHtml(item.name || 'Article')}">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                            <div class="absolute bottom-0 p-6 text-white">
                                <h3 class="text-xl font-semibold leading-snug">${escapeHtml(item.name || "-")}</h3>
                                <p class="mt-2 text-sm opacity-80">${escapeHtml(item.date || "-")}</p>
                            </div>
                        </a>
                    `;
                });

                updatePagerState();
            });
    }

    function nextPage() {
        currentPage++;
        loadArticles(currentPage);
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            loadArticles(currentPage);
        }
    }

    function updatePagerState() {
        const prev = document.getElementById("prevBtn");
        const next = document.getElementById("nextBtn");
        prev.disabled = currentPage <= 1;
        prev.classList.toggle("opacity-50", currentPage <= 1);
        prev.classList.toggle("cursor-not-allowed", currentPage <= 1);
        next.disabled = currentData.length === 0;
        next.classList.toggle("opacity-50", currentData.length === 0);
        next.classList.toggle("cursor-not-allowed", currentData.length === 0);
    }

    function escapeHtml(value) {
        return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
    }
</script>
