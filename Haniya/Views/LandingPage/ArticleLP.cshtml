@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "Articles";
}

<section id="articleHero" class="relative overflow-hidden bg-slate-900 pt-28 sm:pt-32">
    <div class="absolute inset-0">
        <img id="articleHeroImage" src="/image/landingpage/default.jpg" alt="Article Hero" class="h-full w-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-r from-brand-900/85 via-brand-800/75 to-brand-700/65"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 text-white sm:px-6 sm:py-20 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-100">School Insights</p>
        <h1 class="mt-3 text-4xl font-black sm:text-5xl">Latest Articles</h1>
        <p class="mt-3 max-w-2xl text-blue-50">Temukan kabar terbaru, informasi kegiatan, dan wawasan pendidikan dari SMP IT Haniya.</p>
    </div>
</section>

<section class="pb-16 pt-10 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-2xl font-black text-slate-900">Latest Articles</h2>
            <span id="articlePageLabel" class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700">Page 1</span>
        </div>

        <div id="articleContainer" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"></div>

        <div class="mt-10 flex justify-center gap-3">
            <button id="prevBtn" onclick="prevPage()" class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Previous</button>
            <button id="nextBtn" onclick="nextPage()" class="rounded-xl bg-brand-800 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Next</button>
        </div>
    </div>
</section>

<script>
    let currentPage = 1;
    let currentData = [];

    document.addEventListener("DOMContentLoaded", function () {
        loadArticles(currentPage);
    });

    function loadArticles(page) {
        fetch(`/LandingPage/GetArticleData?page=${page}`)
            .then(res => res.json())
            .then(data => {
                currentData = Array.isArray(data) ? data : [];
                setHeroImage(currentData);
                document.getElementById("articlePageLabel").innerText = `Page ${currentPage}`;
                const container = document.getElementById("articleContainer");
                container.innerHTML = "";

                if (currentData.length === 0) {
                    container.innerHTML = "<p class='col-span-3 text-center text-slate-500'>No data available</p>";
                    updatePagerState();
                    return;
                }

                currentData.forEach(item => {
                    container.innerHTML += `
                        <a href="/news-article/${encodeURIComponent(item.id)}" class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                            <div class="relative">
                                <img src="${item.image ? '/image/landingpage/' + item.image : '/image/landingpage/default.jpg'}" class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" alt="${escapeHtml(item.name || 'Article')}">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
                            </div>
                            <div class="p-5">
                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Article</p>
                                <h3 class="mt-2 text-xl font-bold leading-snug text-slate-900">${escapeHtml(item.name || "-")}</h3>
                                <p class="mt-3 text-sm text-slate-500">${escapeHtml(formatArticleDate(item.date))}</p>
                                <p class="mt-4 text-sm font-semibold text-brand-700">Read More</p>
                            </div>
                        </a>`;
                });

                updatePagerState();
            });
    }

    function setHeroImage(data) {
        const heroImage = document.getElementById("articleHeroImage");
        if (!heroImage) return;
        const firstImage = Array.isArray(data) && data.length > 0 ? data[0].image : "";
        heroImage.src = firstImage ? `/image/landingpage/${firstImage}` : "/image/landingpage/default.jpg";
    }

    function nextPage() {
        currentPage++;
        loadArticles(currentPage);
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            loadArticles(currentPage);
        }
    }

    function updatePagerState() {
        const prev = document.getElementById("prevBtn");
        const next = document.getElementById("nextBtn");
        prev.disabled = currentPage <= 1;
        prev.classList.toggle("opacity-50", currentPage <= 1);
        prev.classList.toggle("cursor-not-allowed", currentPage <= 1);
        next.disabled = currentData.length === 0;
        next.classList.toggle("opacity-50", currentData.length === 0);
        next.classList.toggle("cursor-not-allowed", currentData.length === 0);
    }

    function escapeHtml(value) {
        return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
    }

    function formatArticleDate(value) {
        if (!value) return "-";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;
        const day = String(date.getDate()).padStart(2, "0");
        const month = date.toLocaleString("en-US", { month: "short" });
        const year = date.getFullYear();
        return `${day} ${month} ${year}`;
    }
</script>
