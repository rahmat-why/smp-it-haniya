@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "Kontak";
}

<section id="contactImage" class="relative overflow-hidden bg-cover bg-center pt-28 sm:pt-32">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-900/85 via-brand-800/75 to-brand-700/65"></div>
    <div class="relative mx-auto max-w-5xl px-4 py-16 text-center text-white sm:px-6 sm:py-20 lg:px-8">
        <p id="contact1Name" class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-100"></p>
        <h1 id="contact1Desc" class="mt-3 text-4xl font-black sm:text-5xl"></h1>
    </div>
</section>

<section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Pusat Bantuan</p>
            <h2 class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">Pertanyaan yang Sering Diajukan</h2>
            <p class="mx-auto mt-4 max-w-3xl text-slate-600">
                Kami telah merangkum pertanyaan umum dari siswa dan orang tua. Klik setiap pertanyaan untuk melihat jawabannya.
            </p>
        </div>

        <div class="space-y-4">
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                <button id="contact2Name" class="faq-toggle flex w-full items-center justify-between p-5 text-left text-base font-semibold text-slate-800 sm:p-6">
                    <span class="flex-1"></span>
                    <svg class="faq-icon h-5 w-5 text-brand-700 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div class="faq-content hidden px-5 pb-5 text-sm leading-relaxed text-slate-600 sm:px-6 sm:pb-6">
                    <p id="contact2Desc"></p>
                </div>
            </div>

            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                <button id="contact3Name" class="faq-toggle flex w-full items-center justify-between p-5 text-left text-base font-semibold text-slate-800 sm:p-6">
                    <span class="flex-1"></span>
                    <svg class="faq-icon h-5 w-5 text-brand-700 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div class="faq-content hidden px-5 pb-5 text-sm leading-relaxed text-slate-600 sm:px-6 sm:pb-6">
                    <p id="contact3Desc"></p>
                </div>
            </div>

            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                <button id="contact4Name" class="faq-toggle flex w-full items-center justify-between p-5 text-left text-base font-semibold text-slate-800 sm:p-6">
                    <span class="flex-1"></span>
                    <svg class="faq-icon h-5 w-5 text-brand-700 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div class="faq-content hidden px-5 pb-5 text-sm leading-relaxed text-slate-600 sm:px-6 sm:pb-6">
                    <p id="contact4Desc"></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-slate-100 py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-6 text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Formulir Kontak</p>
            <h2 id="contact5Name" class="mt-3 text-3xl font-black text-slate-900"></h2>
        </div>
        <div id="contactFormContainer" class="overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-slate-200"></div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetch('/LandingPage/GetContactData')
            .then(response => response.json())
            .then(data => {
                const hero = document.getElementById("contactImage");
                const imageName = data["CONTACT_BANNER2_DESC"];
                if (imageName) {
                    hero.style.backgroundImage = `url('/image/landingpage/${imageName}')`;
                }

                document.getElementById("contact1Name").innerText = data["CONTACT_BANNER1_NAME"] || "";
                document.getElementById("contact1Desc").innerText = data["CONTACT_BANNER1_DESC"] || "";
                document.getElementById("contact2Name").querySelector("span").innerText = data["CONTACT_FAQ1_NAME"] || "";
                document.getElementById("contact2Desc").innerText = data["CONTACT_FAQ1_DESC"] || "";
                document.getElementById("contact3Name").querySelector("span").innerText = data["CONTACT_FAQ2_NAME"] || "";
                document.getElementById("contact3Desc").innerText = data["CONTACT_FAQ2_DESC"] || "";
                document.getElementById("contact4Name").querySelector("span").innerText = data["CONTACT_FAQ3_NAME"] || "";
                document.getElementById("contact4Desc").innerText = data["CONTACT_FAQ3_DESC"] || "";
                document.getElementById("contact5Name").innerText = data["CONTACT_FORM1_NAME"] || "";

                const formUrl = data["CONTACT_FORM1_DESC"];
                if (formUrl) {
                    document.getElementById("contactFormContainer").innerHTML = `
                        <iframe
                            src="${formUrl}"
                            width="100%"
                            height="850"
                            frameborder="0"
                            marginheight="0"
                            marginwidth="0"
                            class="w-full bg-white">
                        </iframe>`;
                }
            });

        document.querySelectorAll(".faq-toggle").forEach(button => {
            button.addEventListener("click", function () {
                const content = this.parentElement.querySelector(".faq-content");
                const icon = this.querySelector(".faq-icon");
                const isOpen = !content.classList.contains("hidden");

                document.querySelectorAll(".faq-content").forEach(c => c.classList.add("hidden"));
                document.querySelectorAll(".faq-icon").forEach(i => i.classList.remove("rotate-180"));

                if (!isOpen) {
                    content.classList.remove("hidden");
                    icon.classList.add("rotate-180");
                }
            });
        });
    });
</script>
