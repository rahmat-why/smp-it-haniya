@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "Detail Artikel";
    var articleId = ViewBag.ArticleId?.ToString() ?? "";
}

<section class="pt-28 pb-16 sm:pt-32 sm:pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <a href="/news-article" class="mb-5 inline-flex items-center text-sm font-semibold text-brand-700 hover:underline">&larr; Kembali ke Artikel</a>

        <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl">
            <img id="articleImage" class="h-72 w-full object-cover sm:h-[28rem]" src="/image/landingpage/default.jpg" alt="Gambar artikel" />

            <div class="p-6 sm:p-8 lg:p-10">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Artikel</p>
                <h1 id="articleTitle" class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">Memuat...</h1>
                <p id="articleDate" class="mt-3 text-sm font-medium text-slate-500"></p>
                <p id="articleStatus" class="mt-3 inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"></p>
                <div id="articleDescription" class="mt-6 whitespace-pre-wrap leading-relaxed text-slate-700"></div>
            </div>
        </article>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const id = '@articleId';
        if (!id) return;

        fetch(`/LandingPage/GetArticleDetail?id=${encodeURIComponent(id)}`)
            .then(res => res.json())
            .then(data => {
                if (!data) {
                    document.getElementById("articleTitle").innerText = "Artikel tidak ditemukan";
                    return;
                }

                document.getElementById("articleTitle").innerText = data.name || "-";
                document.getElementById("articleDate").innerText = data.date || "-";
                document.getElementById("articleStatus").innerText = data.status || "-";
                document.getElementById("articleDescription").innerText = data.description || "-";
                document.getElementById("articleImage").src = data.image ? `/image/landingpage/${data.image}` : "/image/landingpage/default.jpg";
            });
    });
</script>
