@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "Home";
}

<section class="relative overflow-hidden pt-28 sm:pt-32">
    <div class="absolute inset-0">
        <img id="banner2Image" class="h-full w-full object-cover" alt="School Banner" />
        <div class="absolute inset-0 bg-gradient-to-r from-brand-900/85 via-brand-800/75 to-brand-700/65"></div>
    </div>
    <div class="relative mx-auto grid min-h-[74vh] max-w-7xl items-end gap-10 px-4 pb-16 pt-12 sm:px-6 lg:grid-cols-12 lg:px-8 lg:pb-20">
        <div class="lg:col-span-8">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-100">SMP IT Haniya</p>
            <h1 id="banner1Desc" class="mt-4 max-w-3xl text-4xl font-black leading-tight text-white sm:text-5xl lg:text-6xl"></h1>
            <p id="banner1Name" class="mt-5 max-w-2xl text-base text-blue-50 sm:text-lg"></p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a asp-controller="LandingPage" asp-action="AboutUsLP" class="rounded-xl bg-white px-6 py-3 text-sm font-bold text-brand-800 shadow-lg transition hover:-translate-y-0.5 hover:bg-slate-100">Explore School</a>
                <a asp-controller="LandingPage" asp-action="ContactLP" class="rounded-xl border border-white/50 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10">Contact Us</a>
            </div>
        </div>
    </div>
</section>

<section class="bg-slate-50 px-4 pb-6 pt-8 sm:px-6 sm:pb-8 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-4 rounded-3xl bg-white p-6 shadow-xl ring-1 ring-slate-200 sm:grid-cols-3 sm:p-8">
        <div class="rounded-2xl bg-brand-50 p-5 text-center">
            <p id="summary1Desc" class="text-3xl font-extrabold text-brand-800 sm:text-4xl"></p>
            <p id="summary1Name" class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700"></p>
        </div>
        <div class="rounded-2xl bg-brand-50 p-5 text-center">
            <p id="summary2Desc" class="text-3xl font-extrabold text-brand-800 sm:text-4xl"></p>
            <p id="summary2Name" class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700"></p>
        </div>
        <div class="rounded-2xl bg-brand-50 p-5 text-center">
            <p id="summary3Desc" class="text-3xl font-extrabold text-brand-800 sm:text-4xl"></p>
            <p id="summary3Name" class="mt-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-700"></p>
        </div>
    </div>
</section>

<section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Welcome</p>
        <h2 id="welcomeName" class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl"></h2>
        <p id="welcomeDesc" class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg"></p>
    </div>
</section>

<section class="bg-slate-100 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 flex items-end justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Environment</p>
                <h2 class="mt-2 text-3xl font-black text-slate-900">School Atmosphere</h2>
            </div>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
            <article class="group relative overflow-hidden rounded-3xl shadow-lg">
                <img id="school1Image" class="h-80 w-full object-cover transition duration-500 group-hover:scale-105" alt="School Image 1" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent"></div>
                <div class="absolute bottom-0 p-6 text-white">
                    <h3 id="school1Name" class="text-2xl font-bold"></h3>
                    <p id="school1Desc" class="mt-2 text-sm leading-relaxed text-slate-100"></p>
                </div>
            </article>
            <article class="group relative overflow-hidden rounded-3xl shadow-lg">
                <img id="school2Image" class="h-80 w-full object-cover transition duration-500 group-hover:scale-105" alt="School Image 2" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent"></div>
                <div class="absolute bottom-0 p-6 text-white">
                    <h3 id="school2Name" class="text-2xl font-bold"></h3>
                    <p id="school2Desc" class="mt-2 text-sm leading-relaxed text-slate-100"></p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Highlights</p>
                <h2 class="mt-2 text-3xl font-black text-slate-900">Stories From Haniya</h2>
            </div>
            <div class="flex gap-2">
                <button onclick="prevSlide()" class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">Prev</button>
                <button onclick="nextSlide()" class="rounded-xl bg-brand-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700">Next</button>
            </div>
        </div>

        <div class="overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-slate-200">
            <div id="slider" class="flex transition-transform duration-500">
                <article class="min-w-full p-6 sm:p-8 lg:p-10">
                    <div class="grid items-center gap-8 lg:grid-cols-2">
                        <div class="overflow-hidden rounded-2xl">
                            <img id="test1Image" class="h-72 w-full object-cover sm:h-80" alt="Highlight 1" />
                        </div>
                        <div>
                            <h3 id="test1Name" class="text-2xl font-extrabold text-slate-900 sm:text-3xl"></h3>
                            <p id="test1Desc" class="mt-4 leading-relaxed text-slate-600"></p>
                        </div>
                    </div>
                </article>

                <article class="min-w-full p-6 sm:p-8 lg:p-10">
                    <div class="grid items-center gap-8 lg:grid-cols-2">
                        <div class="overflow-hidden rounded-2xl">
                            <img id="test2Image" class="h-72 w-full object-cover sm:h-80" alt="Highlight 2" />
                        </div>
                        <div>
                            <h3 id="test2Name" class="text-2xl font-extrabold text-slate-900 sm:text-3xl"></h3>
                            <p id="test2Desc" class="mt-4 leading-relaxed text-slate-600"></p>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<script>
    let currentIndex = 0;
    const slider = document.getElementById("slider");
    const totalSlides = 2;

    function updateSlider() {
        slider.style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    function nextSlide() {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateSlider();
    }

    function prevSlide() {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateSlider();
    }
</script>

<script>
    fetch('/LandingPage/GetHomeData')
        .then(response => response.json())
        .then(data => {
            document.getElementById("banner1Name").innerText = data["HOME_BANNER1_NAME"] || "";
            document.getElementById("banner1Desc").innerText = data["HOME_BANNER1_DESC"] || "";
            document.getElementById("banner2Image").src = "/image/landingpage/" + (data["HOME_BANNER2_DESC"] || "");

            document.getElementById("summary1Name").innerText = data["HOME_SUMMARY1_NAME"] || "";
            document.getElementById("summary1Desc").innerText = data["HOME_SUMMARY1_DESC"] || "";
            document.getElementById("summary2Name").innerText = data["HOME_SUMMARY2_NAME"] || "";
            document.getElementById("summary2Desc").innerText = data["HOME_SUMMARY2_DESC"] || "";
            document.getElementById("summary3Name").innerText = data["HOME_SUMMARY3_NAME"] || "";
            document.getElementById("summary3Desc").innerText = data["HOME_SUMMARY3_DESC"] || "";

            document.getElementById("welcomeName").innerText = data["HOME_WELCOME1_NAME"] || "";
            document.getElementById("welcomeDesc").innerText = data["HOME_WELCOME1_DESC"] || "";

            document.getElementById("school1Image").src = "/image/landingpage/" + (data["HOME_SCHOOL_IMAGE1_DESC"] || "");
            document.getElementById("school1Name").innerText = data["HOME_SCHOOL_TITLE1_NAME"] || "";
            document.getElementById("school1Desc").innerText = data["HOME_SCHOOL_TITLE1_DESC"] || "";
            document.getElementById("school2Image").src = "/image/landingpage/" + (data["HOME_SCHOOL_IMAGE2_DESC"] || "");
            document.getElementById("school2Name").innerText = data["HOME_SCHOOL_TITLE2_NAME"] || "";
            document.getElementById("school2Desc").innerText = data["HOME_SCHOOL_TITLE2_DESC"] || "";

            document.getElementById("test1Image").src = "/image/landingpage/" + (data["HOME_TESTI_IMAGE1_DESC"] || "");
            document.getElementById("test1Name").innerText = data["HOME_TESTIMONI1_NAME"] || "";
            document.getElementById("test1Desc").innerText = data["HOME_TESTIMONI1_DESC"] || "";
            document.getElementById("test2Image").src = "/image/landingpage/" + (data["HOME_TESTI_IMAGE2_DESC"] || "");
            document.getElementById("test2Name").innerText = data["HOME_TESTIMONI2_NAME"] || "";
            document.getElementById("test2Desc").innerText = data["HOME_TESTIMONI2_DESC"] || "";
        });
</script>
