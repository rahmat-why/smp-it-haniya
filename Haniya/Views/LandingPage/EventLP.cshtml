@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "Events";
}

<section id="eventHero" class="relative overflow-hidden bg-slate-900 pt-28 sm:pt-32">
    <div class="absolute inset-0">
        <img id="eventHeroImage" src="/image/landingpage/default.jpg" alt="Event Hero" class="h-full w-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-r from-brand-900/85 via-brand-800/75 to-brand-700/65"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 text-white sm:px-6 sm:py-20 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-100">Agenda Sekolah</p>
        <h1 class="mt-3 text-4xl font-black sm:text-5xl">Event Timeline</h1>
        <p class="mt-4 max-w-2xl text-sm text-blue-50 sm:text-base">
            Ikuti event terbaru dari sekolah. Klik setiap event untuk melihat detail lengkap.
        </p>
    </div>
</section>

<section class="pb-16 pt-10 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-2xl font-black text-slate-900">Latest Events</h2>
            <span id="eventPageLabel" class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700">Page 1</span>
        </div>

        <div id="eventTimeline" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3"></div>

        <div class="mt-8 flex justify-center gap-3">
            <button id="prevBtn" onclick="prevPage()" class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Previous</button>
            <button id="nextBtn" onclick="nextPage()" class="rounded-xl bg-brand-800 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Next</button>
        </div>
    </div>
</section>

<script>
    let currentPage = 1;
    let currentData = [];

    document.addEventListener("DOMContentLoaded", function () {
        loadEvents(currentPage);
    });

    function loadEvents(page) {
        fetch(`/LandingPage/GetEventData?page=${page}`)
            .then(res => res.json())
            .then(data => {
                currentData = Array.isArray(data) ? data : [];
                setHeroImage(currentData);
                document.getElementById("eventPageLabel").innerText = `Page ${currentPage}`;
                renderTimeline(currentData);
                updatePagerState();
            });
    }

    function setHeroImage(data) {
        const heroImage = document.getElementById("eventHeroImage");
        if (!heroImage) return;
        const firstImage = Array.isArray(data) && data.length > 0 ? data[0].image : "";
        heroImage.src = firstImage ? `/image/landingpage/${firstImage}` : "/image/landingpage/default.jpg";
    }

    function renderTimeline(data) {
        const timeline = document.getElementById("eventTimeline");
        timeline.innerHTML = "";

        if (!data.length) {
            timeline.innerHTML = `
                <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500 md:col-span-2 xl:col-span-3">
                    Belum ada event pada halaman ini.
                </div>`;
            return;
        }

        data.forEach(item => {
            timeline.innerHTML += `
                <a href="/news-event/${encodeURIComponent(item.id)}" class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                    <div class="relative">
                        <img src="${getImage(item.image)}" alt="${escapeHtml(item.name || "Event")}" class="h-64 w-full object-cover transition duration-500 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
                        <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-brand-800">Event</span>
                    </div>
                    <div class="p-5">
                        <h3 class="text-xl font-bold leading-snug text-slate-900">${escapeHtml(item.name || "-")}</h3>
                        <p class="mt-3 text-sm font-medium text-slate-500">Date: ${escapeHtml(item.date || "-")}</p>
                        <p class="mt-1 text-sm text-slate-500">Location: ${escapeHtml(item.location || "-")}</p>
                        <p class="mt-4 text-sm font-semibold text-brand-700">View Event</p>
                    </div>
                </a>`;
        });
    }

    function nextPage() {
        currentPage++;
        loadEvents(currentPage);
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            loadEvents(currentPage);
        }
    }

    function updatePagerState() {
        const prev = document.getElementById("prevBtn");
        const next = document.getElementById("nextBtn");
        prev.disabled = currentPage <= 1;
        prev.classList.toggle("opacity-50", currentPage <= 1);
        prev.classList.toggle("cursor-not-allowed", currentPage <= 1);

        next.disabled = currentData.length === 0;
        next.classList.toggle("opacity-50", currentData.length === 0);
        next.classList.toggle("cursor-not-allowed", currentData.length === 0);
    }

    function getImage(imageName) {
        return imageName ? `/image/landingpage/${imageName}` : "/image/landingpage/default.jpg";
    }

    function escapeHtml(value) {
        return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
    }
</script>
