@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    var eventId = ViewBag.EventId?.ToString() ?? "";
    var isLoggedIn = User?.Identity?.IsAuthenticated ?? false;
}

<section class="pt-24 pb-12 px-4 sm:px-6 lg:px-10">
    <div class="max-w-4xl mx-auto">
        @if (!isLoggedIn)
        {
            <a href="/news-event" class="inline-flex items-center text-sm text-blue-700 hover:underline mb-6">&larr; Back</a>
        }

        <article class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <img id="eventImage" class="w-full h-72 object-cover" src="/image/landingpage/default.jpg" alt="Event image">

            <div class="p-6 sm:p-8">
                <h1 id="eventTitle" class="text-3xl font-bold text-slate-900">Loading...</h1>
                <p id="eventDate" class="mt-2 text-sm text-gray-500"></p>
                <p id="eventLocation" class="mt-1 text-sm text-gray-600"></p>
                <p id="eventStatus" class="mt-2 inline-flex px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-medium"></p>
                <div id="eventDescription" class="mt-6 text-gray-700 leading-relaxed whitespace-pre-wrap"></div>
            </div>
        </article>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const id = '@eventId';
        if (!id) return;

        fetch(`/LandingPage/GetEventDetail?id=${encodeURIComponent(id)}`)
            .then(res => res.json())
            .then(data => {
                if (!data) {
                    document.getElementById("eventTitle").innerText = "Event not found";
                    return;
                }

                document.getElementById("eventTitle").innerText = data.name || "-";
                document.getElementById("eventDate").innerText = data.date || "-";
                document.getElementById("eventLocation").innerText = "Location: " + (data.location || "-");
                document.getElementById("eventStatus").innerText = data.status || "-";
                document.getElementById("eventDescription").innerText = data.description || "-";
                document.getElementById("eventImage").src = data.image ? `/image/landingpage/${data.image}` : "/image/landingpage/default.jpg";
            });
    });
</script>
