@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "Event Detail";
    var eventId = ViewBag.EventId?.ToString() ?? "";
    var isLoggedIn = User?.Identity?.IsAuthenticated ?? false;
}

<section class="pt-28 pb-16 sm:pt-32 sm:pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        @if (!isLoggedIn)
        {
            <a href="/news-event" class="mb-5 inline-flex items-center text-sm font-semibold text-brand-700 hover:underline">&larr; Back to Events</a>
        }

        <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl">
            <img id="eventImage" class="h-72 w-full object-cover sm:h-[28rem]" src="/image/landingpage/default.jpg" alt="Event image" />

            <div class="p-6 sm:p-8 lg:p-10">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Event Information</p>
                <h1 id="eventTitle" class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">Loading...</h1>
                <p id="eventDate" class="mt-3 text-sm font-medium text-slate-500"></p>
                <p id="eventLocation" class="mt-1 text-sm text-slate-600"></p>
                <p id="eventStatus" class="mt-3 inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"></p>
                <div id="eventDescription" class="mt-6 whitespace-pre-wrap leading-relaxed text-slate-700"></div>
            </div>
        </article>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const id = '@eventId';
        if (!id) return;

        fetch(`/LandingPage/GetEventDetail?id=${encodeURIComponent(id)}`)
            .then(res => res.json())
            .then(data => {
                if (!data) {
                    document.getElementById("eventTitle").innerText = "Event not found";
                    return;
                }

                document.getElementById("eventTitle").innerText = data.name || "-";
                document.getElementById("eventDate").innerText = data.date || "-";
                document.getElementById("eventLocation").innerText = "Location: " + (data.location || "-");
                document.getElementById("eventStatus").innerText = data.status || "-";
                document.getElementById("eventDescription").innerText = data.description || "-";
                document.getElementById("eventImage").src = data.image ? `/image/landingpage/${data.image}` : "/image/landingpage/default.jpg";
            });
    });
</script>
