@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "About Us";
}

<section class="relative overflow-hidden pt-28 sm:pt-32">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-900 via-brand-800 to-brand-700"></div>
    <div class="relative mx-auto max-w-5xl px-4 py-16 text-center text-white sm:px-6 sm:py-20 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-100">Who We Are</p>
        <h1 id="about1Name" class="mt-4 text-4xl font-black sm:text-5xl"></h1>
        <p id="about1Desc" class="mx-auto mt-6 max-w-4xl text-base leading-relaxed text-blue-50 sm:text-lg"></p>
    </div>
</section>

<section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <article class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Mission</p>
            <h2 id="missionName" class="mt-3 text-3xl font-black text-slate-900"></h2>
            <p id="missionDesc" class="mt-4 leading-relaxed text-slate-600"></p>
        </article>
        <article class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Vision</p>
            <h2 id="visionName" class="mt-3 text-3xl font-black text-slate-900"></h2>
            <p id="visionDesc" class="mt-4 leading-relaxed text-slate-600"></p>
        </article>
    </div>
</section>

<section class="bg-slate-100 py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <div class="overflow-hidden rounded-3xl shadow-lg w-96 border-4 border-white shadow-md mx-auto">
            <img id="headschoolImage"
                 class="h-108 w-full object-cover object-center"
                 alt="Headschool Photo" />
        </div>
        <article class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Pesan Kepala Sekolah</p>
            <h2 id="headschoolName" class="mt-3 text-3xl font-black text-slate-900"></h2>
            <p id="headschoolDesc" class="mt-4 leading-relaxed text-slate-600"></p>
        </article>
    </div>
</section>

<section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">School Culture</p>
            <h2 class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">Our Core Values</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
            <article class="group relative overflow-hidden rounded-3xl shadow-lg">
                <img id="values1Image" class="h-80 w-full object-cover transition duration-500 group-hover:scale-105" alt="Value 1" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-black/35"></div>
                <div class="absolute bottom-0 p-6 text-white">
                    <h3 id="values1Name" class="text-xl font-bold"></h3>
                    <p id="values1Desc" class="mt-2 text-sm leading-relaxed text-slate-100"></p>
                </div>
            </article>
            <article class="group relative overflow-hidden rounded-3xl shadow-lg">
                <img id="values2Image" class="h-80 w-full object-cover transition duration-500 group-hover:scale-105" alt="Value 2" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-black/35"></div>
                <div class="absolute bottom-0 p-6 text-white">
                    <h3 id="values2Name" class="text-xl font-bold"></h3>
                    <p id="values2Desc" class="mt-2 text-sm leading-relaxed text-slate-100"></p>
                </div>
            </article>
            <article class="group relative overflow-hidden rounded-3xl shadow-lg">
                <img id="values3Image" class="h-80 w-full object-cover transition duration-500 group-hover:scale-105" alt="Value 3" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-black/35"></div>
                <div class="absolute bottom-0 p-6 text-white">
                    <h3 id="values3Name" class="text-xl font-bold"></h3>
                    <p id="values3Desc" class="mt-2 text-sm leading-relaxed text-slate-100"></p>
                </div>
            </article>
        </div>
    </div>
</section>

<script>
    fetch('/LandingPage/GetAboutData')
        .then(response => response.json())
        .then(data => {
            document.getElementById("about1Name").innerText = data["ABOUT_US1_NAME"] || "";
            document.getElementById("about1Desc").innerText = data["ABOUT_US1_DESC"] || "";

            document.getElementById("missionName").innerText = data["ABOUT_MISSION1_NAME"] || "";
            document.getElementById("missionDesc").innerText = data["ABOUT_MISSION1_DESC"] || "";
            document.getElementById("visionName").innerText = data["ABOUT_VISION1_NAME"] || "";
            document.getElementById("visionDesc").innerText = data["ABOUT_VISION1_DESC"] || "";

            document.getElementById("headschoolImage").src = "/image/landingpage/" + (data["ABOUT_HEADSC_IMAGE1_DESC"] || "");
            document.getElementById("headschoolName").innerText = data["ABOUT_HEADSCHOOL1_NAME"] || "";
            document.getElementById("headschoolDesc").innerText = data["ABOUT_HEADSCHOOL1_DESC"] || "";

            document.getElementById("values1Image").src = "/image/landingpage/" + (data["ABOUT_VALUES_IMAGE1_DESC"] || "");
            document.getElementById("values2Image").src = "/image/landingpage/" + (data["ABOUT_VALUES_IMAGE2_DESC"] || "");
            document.getElementById("values3Image").src = "/image/landingpage/" + (data["ABOUT_VALUES_IMAGE3_DESC"] || "");
            document.getElementById("values1Name").innerText = data["ABOUT_VALUES_TITLE1_NAME"] || "";
            document.getElementById("values1Desc").innerText = data["ABOUT_VALUES_TITLE1_DESC"] || "";
            document.getElementById("values2Name").innerText = data["ABOUT_VALUES_TITLE2_NAME"] || "";
            document.getElementById("values2Desc").innerText = data["ABOUT_VALUES_TITLE2_DESC"] || "";
            document.getElementById("values3Name").innerText = data["ABOUT_VALUES_TITLE3_NAME"] || "";
            document.getElementById("values3Desc").innerText = data["ABOUT_VALUES_TITLE3_DESC"] || "";
        });
</script>
