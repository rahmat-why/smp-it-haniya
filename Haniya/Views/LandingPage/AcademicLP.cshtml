@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    ViewData["Title"] = "Akademik";
}

<section id="academicImage" class="relative overflow-hidden bg-cover bg-center pt-28 sm:pt-32">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-900/85 via-brand-800/75 to-brand-700/65"></div>
    <div class="relative mx-auto max-w-5xl px-4 py-16 text-center text-white sm:px-6 sm:py-20 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-100">Program Akademik</p>
        <h1 id="academic1Name" class="mt-3 text-4xl font-black sm:text-5xl"></h1>
        <p id="academic1Desc" class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-blue-50 sm:text-lg"></p>
    </div>
</section>

<section class="bg-slate-100 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-2">
            <article class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Kurikulum</p>
                <h2 class="mt-3 text-2xl font-black text-slate-900">SMP IT HANIYA</h2>
                <ul class="mt-6 space-y-3 text-sm leading-relaxed text-slate-600 marker:text-brand-700 sm:text-base">
                    <li id="academic7Desc" class="list-disc"></li>
                    <li id="academic8Desc" class="list-disc"></li>
                    <li id="academic9Desc" class="list-disc"></li>
                    <li id="academic10Desc" class="list-disc"></li>
                    <li id="academic11Desc" class="list-disc"></li>
                </ul>
            </article>
            <article class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">Kegiatan</p>
                <h2 class="mt-3 text-2xl font-black text-slate-900">Ekstrakurikuler</h2>
                <ul class="mt-6 space-y-3 text-sm leading-relaxed text-slate-600 marker:text-brand-700 sm:text-base">
                    <li id="academic12Desc" class="list-disc"></li>
                    <li id="academic13Desc" class="list-disc"></li>
                    <li id="academic14Desc" class="list-disc"></li>
                    <li id="academic15Desc" class="list-disc"></li>
                    <li id="academic16Desc" class="list-disc"></li>
                    <li id="academic17Desc" class="list-disc"></li>
                    <li id="academic18Desc" class="list-disc"></li>
                </ul>
            </article>
        </div>
    </div>
</section>

<script>
    fetch('/LandingPage/GetAcademicData')
        .then(response => response.json())
        .then(data => {
            const hero = document.getElementById("academicImage");
            const imageName = data["ACADEMIC_BANNER2_DESC"];

            if (imageName) {
                hero.style.backgroundImage = `url('/image/landingpage/${imageName}')`;
            }

            document.getElementById("academic1Name").innerText = data["ACADEMIC_BANNER1_NAME"] || "";
            document.getElementById("academic1Desc").innerText = data["ACADEMIC_BANNER1_DESC"] || "";

            document.getElementById("academic7Desc").innerText = data["ACADEMIC_CURRIC_SMP1_DESC"] || "";
            document.getElementById("academic8Desc").innerText = data["ACADEMIC_CURRIC_SMP2_DESC"] || "";
            document.getElementById("academic9Desc").innerText = data["ACADEMIC_CURRIC_SMP3_DESC"] || "";
            document.getElementById("academic10Desc").innerText = data["ACADEMIC_CURRIC_SMP4_DESC"] || "";
            document.getElementById("academic11Desc").innerText = data["ACADEMIC_CURRIC_SMP5_DESC"] || "";

            document.getElementById("academic12Desc").innerText = data["ACADEMIC_EXTRAC1_DESC"] || "";
            document.getElementById("academic13Desc").innerText = data["ACADEMIC_EXTRAC2_DESC"] || "";
            document.getElementById("academic14Desc").innerText = data["ACADEMIC_EXTRAC3_DESC"] || "";
            document.getElementById("academic15Desc").innerText = data["ACADEMIC_EXTRAC4_DESC"] || "";
            document.getElementById("academic16Desc").innerText = data["ACADEMIC_EXTRAC5_DESC"] || "";
            document.getElementById("academic17Desc").innerText = data["ACADEMIC_EXTRAC6_DESC"] || "";
            document.getElementById("academic18Desc").innerText = data["ACADEMIC_EXTRAC7_DESC"] || "";
        });
</script>
