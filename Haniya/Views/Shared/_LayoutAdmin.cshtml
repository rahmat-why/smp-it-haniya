@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var userType = User?.FindFirst("UserType")?.Value;

    if (!isAuthenticated)
    {
        Context.Response.Redirect("/LoginAdmin");
        return;
    }

    if (!string.Equals(userType, "Employee", System.StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(userType, "Teacher", System.StringComparison.OrdinalIgnoreCase))
    {
        Context.Response.Redirect("/LoginAdmin/AccessDenied");
        return;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SMP IT Haniya</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/image/logo-haniya.png" asp-append-version="true" />

    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.dataTables.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/lib/jquery/jquery-3.6.0.min.js"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.js"></script>

    <style>
        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_filter label,
        .dataTables_wrapper .dt-length label,
        .dataTables_wrapper .dt-search label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #4b5563;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dt-length select {
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
            color: #374151;
            background-color: #ffffff;
        }

            .dataTables_wrapper .dataTables_length select:focus,
            .dataTables_wrapper .dt-length select:focus {
                outline: 2px solid #3b82f6;
                outline-offset: 2px;
                border-color: #3b82f6;
            }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dt-search input {
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            background-color: #ffffff;
            width: 100%;
        }

            .dataTables_wrapper .dataTables_filter input:focus,
            .dataTables_wrapper .dt-search input:focus {
                outline: 2px solid #3b82f6;
                outline-offset: 2px;
                border-color: #3b82f6;
            }

            .dataTables_wrapper .dataTables_filter input::placeholder,
            .dataTables_wrapper .dt-search input::placeholder {
                color: #9ca3af;
            }

        table.dataTable thead th {
            position: relative;
            cursor: pointer;
            padding-right: 2rem !important;
        }

            table.dataTable thead th.sorting:before,
            table.dataTable thead th.sorting:after,
            table.dataTable thead th.sorting_asc:before,
            table.dataTable thead th.sorting_desc:after {
                position: absolute;
                right: 0.75rem;
                display: inline-block;
                opacity: 0.3;
                font-family: Arial, sans-serif;
                line-height: 1;
            }

            table.dataTable thead th.sorting:before {
                content: "\25B2";
                top: 0.5rem;
                font-size: 0.65rem;
                color: #4b5563;
            }

            table.dataTable thead th.sorting:after {
                content: "\25BC";
                bottom: 0.5rem;
                font-size: 0.65rem;
                color: #4b5563;
            }

            table.dataTable thead th.sorting_asc:before {
                content: "\25B2";
                top: 50%;
                transform: translateY(-50%);
                font-size: 0.75rem;
                color: #1e3a8a;
                opacity: 1;
            }

            table.dataTable thead th.sorting_desc:after {
                content: "\25BC";
                top: 50%;
                transform: translateY(-50%);
                font-size: 0.75rem;
                color: #1e3a8a;
                opacity: 1;
            }

            table.dataTable thead th.sorting_asc:after,
            table.dataTable thead th.sorting_desc:before {
                display: none;
            }

        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dt-info {
            font-size: 0.875rem;
            color: #4b5563;
        }

        .dataTables_wrapper .dataTables_paginate,
        .dataTables_wrapper .dt-paging {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            margin-left: auto;
            flex-wrap: nowrap;
            white-space: nowrap;
            max-width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            overflow: hidden;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button,
        .dataTables_wrapper .dataTables_paginate a,
        .dataTables_wrapper .dataTables_paginate span,
        .dataTables_wrapper .dataTables_paginate button,
        .dataTables_wrapper .dt-paging .dt-paging-button,
        .dataTables_wrapper .dt-paging a,
        .dataTables_wrapper .dt-paging span,
        .dataTables_wrapper .dt-paging button {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            padding: 0.5rem 0.75rem !important;
            font-size: 0.875rem;
            font-weight: 500;
            border-right: 1px solid #d1d5db;
            min-width: 40px;
            transition: all 0.15s;
            background-color: white !important;
            color: #374151 !important;
            box-sizing: border-box;
            margin: 0 !important;
            border-radius: 0 !important;
            border-top: none !important;
            border-bottom: none !important;
            border-left: none !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:last-child,
        .dataTables_wrapper .dataTables_paginate a:last-child,
        .dataTables_wrapper .dataTables_paginate span:last-child,
        .dataTables_wrapper .dataTables_paginate button:last-child,
        .dataTables_wrapper .dt-paging .dt-paging-button:last-child,
        .dataTables_wrapper .dt-paging a:last-child,
        .dataTables_wrapper .dt-paging span:last-child,
        .dataTables_wrapper .dt-paging button:last-child {
            border-right: none !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .current,
        .dataTables_wrapper .dt-paging .dt-paging-button.current,
        .dataTables_wrapper .dt-paging .current {
            background-color: #1e3a8a !important;
            color: white !important;
            cursor: default;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
        .dataTables_wrapper .dataTables_paginate .disabled,
        .dataTables_wrapper .dt-paging .dt-paging-button.disabled,
        .dataTables_wrapper .dt-paging .disabled {
            background-color: #f9fafb !important;
            color: #9ca3af !important;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:not(.current):not(.disabled):hover,
        .dataTables_wrapper .dataTables_paginate a:not(.current):not(.disabled):hover,
        .dataTables_wrapper .dataTables_paginate button:not(.current):not(.disabled):hover,
        .dataTables_wrapper .dt-paging .dt-paging-button:not(.current):not(.disabled):hover,
        .dataTables_wrapper .dt-paging a:not(.current):not(.disabled):hover,
        .dataTables_wrapper .dt-paging button:not(.current):not(.disabled):hover {
            background-color: #f3f4f6 !important;
            color: #1e3a8a !important;
        }

        .select2-container--default .select2-selection--single {
            height: 2.5rem;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            background-color: #ffffff;
        }

            .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #374151;
                padding-left: 0;
                line-height: 1.5rem;
                font-weight: 500;
            }

            .select2-container--default .select2-selection--single .select2-selection__placeholder {
                color: #9ca3af;
                font-weight: 400;
            }

            .select2-container--default .select2-selection--single .select2-selection__arrow {
                height: 100%;
                right: 0.5rem;
            }

                .select2-container--default .select2-selection--single .select2-selection__arrow b {
                    border-color: #4b5563 transparent transparent transparent;
                    border-width: 6px 5px 0 5px;
                }

        .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
            border-color: transparent transparent #4b5563 transparent;
            border-width: 0 5px 6px 5px;
        }

        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            outline: 2px solid #3b82f6;
            outline-offset: 2px;
            border-color: #3b82f6;
        }

        .select2-dropdown {
            border-radius: 0.375rem;
            border: 1px solid #d1d5db;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
        }

        .select2-container--default .select2-results__option {
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
            color: #374151;
        }

        .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
            background-color: #1e3a8a;
            color: #ffffff;
        }

        .select2-container--default .select2-results__option--selected {
            background-color: #dbeafe;
            color: #1e40af;
        }

        .select2-container--default .select2-search--dropdown .select2-search__field {
            border-radius: 0.375rem;
            border: 1px solid #d1d5db;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
        }

            .select2-container--default .select2-search--dropdown .select2-search__field:focus {
                outline: 2px solid #3b82f6;
                outline-offset: 2px;
                border-color: #3b82f6;
            }

        .select2-container--default .select2-selection--single .select2-selection__clear {
            color: #4b5563;
            font-size: 1.25rem;
            font-weight: bold;
            margin-right: 0.5rem;
        }

            .select2-container--default .select2-selection--single .select2-selection__clear:hover {
                color: #1e40af;
            }

        #bottom-menu::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>
<body class="h-screen flex flex-col bg-gray-100 text-gray-800 overflow-hidden">
    <!-- Top Header -->
    <header class="bg-white shadow-md z-10">
        <div class="flex items-center justify-between px-6 py-4">
            <!-- Left: Logo/Title -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-900 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-800">SMP IT HANIYA</h1>
                    <p class="text-xs text-gray-500">Smart System</p>
                </div>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
                <div class="flex items-center gap-4">
                    <!-- User Info -->
                    <div class="relative inline-block text-left">
    <!-- Profile Trigger -->
                        <div onclick="toggleProfileMenu()" class="flex items-center gap-3 px-4 py-2 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer select-none">

                            @if (!string.IsNullOrEmpty(User.FindFirst("ProfilePhoto")?.Value))
                            {
                                <img src="@User.FindFirst("ProfilePhoto")?.Value"
                                    class="w-10 h-10 rounded-full object-cover border-2 border-blue-600" alt=""/>
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg">
                                    @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                            }

                            <div class="text-left hidden sm:block">
                                <p class="text-sm font-semibold text-gray-800">
                                    @User.FindFirst("FullName")?.Value
                                </p>
                                <p class="text-xs text-gray-500">
                                    @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                                </p>
                            </div>
                        </div>

                        <!-- Dropdown Menu -->
                        <div id="profileMenu" class="hidden absolute right-0 mt-3 w-48 bg-white rounded-xl shadow-xl border border-gray-100 z-50 overflow-hidden transition-all duration-200">

                            <button type="button"
                                    onclick="handleLogout(event)"
                                    class="w-full flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors duration-200">

                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>

                                <span>Logout</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a href="/LoginAdmin" class="px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white rounded-lg font-medium transition">
                    Login
                </a>
            }
        </div>
    </header>
    <div class="flex flex-1 overflow-hidden">
        <!-- Sidebar Desktop -->
        <aside class="hidden md:flex w-64 bg-blue-900 text-white flex-shrink-0 flex-col">
            <nav id="sidebar-menu" class="flex-1 px-4 py-6 space-y-2 overflow-y-auto text-sm">
            </nav>

            <div class="p-4 border-t border-blue-700 text-center text-xs text-blue-200">
                <p>&copy; 2026 SMP IT HANIYA</p>
                <p class="mt-1">Version 1.0</p>
            </div>
        </aside>

        <!-- Main -->
        <main class="flex-1 overflow-auto p-4 md:p-6 pb-20 md:pb-6">
            @RenderBody()
        </main>
    </div>

    <!-- Bottom Nav Mobile -->
    <nav id="bottom-menu" class="md:hidden fixed bottom-0 inset-x-0 bg-white border-t border-gray-200 shadow-lg z-30 overflow-x-auto">
        <div id="bottom-menu-wrapper"
            class="flex px-2">
        </div>
    </nav>
    <script>
        const currentUserRole = '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value';
        const currentUserType = '@User.FindFirst("UserType")?.Value';

        $(document).ready(function () {
            loadMenu();
        });

        if ($.fn.dataTable) {
            $.extend(true, $.fn.dataTable.defaults, {
                pagingType: 'simple_numbers'
            });
        }

        function toggleProfileMenu() {
            const menu = document.getElementById("profileMenu");
            menu.classList.toggle("hidden");
        }

        // Close kalau klik luar
        document.addEventListener("click", function (event) {
            const menu = document.getElementById("profileMenu");
            const container = event.target.closest(".relative");

            if (!container) {
                menu.classList.add("hidden");
            }
        });

        function applyAdminPaginationStyle($scope) {
            const $root = $scope && $scope.length ? $scope : $(document);
            $root.find('.dataTables_paginate, .dt-paging').each(function () {
                const $paginate = $(this);
                $paginate.addClass('inline-flex items-center border border-gray-300 rounded-md overflow-hidden min-w-max');

                $paginate.find('a, span, button, .paginate_button, .dt-paging-button').each(function () {
                    const $btn = $(this);
                    const isCurrent = $btn.hasClass('current') || $btn.hasClass('active') || $btn.attr('aria-current') === 'page';
                    const isDisabled = $btn.hasClass('disabled') || $btn.prop('disabled') || $btn.attr('aria-disabled') === 'true';
                    const baseClasses = 'inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 last:border-r-0 min-w-[40px] transition-colors duration-150';

                    $btn.addClass(baseClasses);
                    $btn.removeClass('bg-blue-900 text-white cursor-default bg-gray-50 text-gray-400 cursor-not-allowed bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900 cursor-pointer');

                    if (isCurrent) {
                        $btn.addClass('bg-blue-900 text-white cursor-default');
                    } else if (isDisabled) {
                        $btn.addClass('bg-gray-50 text-gray-400 cursor-not-allowed');
                    } else {
                        $btn.addClass('bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900 cursor-pointer');
                    }

                    const text = ($btn.text() || '').trim().toLowerCase();
                    if (text === 'previous') $btn.html('&lsaquo;');
                    if (text === 'next') $btn.html('&rsaquo;');
                    if (text === 'first') $btn.html('&laquo;');
                    if (text === 'last') $btn.html('&raquo;');
                });
            });
        }

        $(document).on('init.dt draw.dt', function (e, settings) {
            if (settings && settings.nTableWrapper) {
                applyAdminPaginationStyle($(settings.nTableWrapper));
            } else {
                applyAdminPaginationStyle($(document));
            }
        });

        function loadMenu() {
            $.ajax({
                url: '/Menu/GetMenus',
                type: 'GET',
                success: function (res) {
                    if (!res.success) return;

                    const currentPath = (window.location.pathname || '/')
                        .toLowerCase()
                        .replace(/\/index$/, '');

                    let sidebarHtml = '';
                    let bottomHtml = '';

                    const totalMenu = res.data.length;

                    res.data.forEach(m => {

                        const menuUrl = (m.url || '')
                            .toLowerCase()
                            .replace(/\/index$/, '');

                        const isActive =
                            currentPath === menuUrl ||
                            currentPath.startsWith(menuUrl + '/');

                        const activeDesktop = isActive
                            ? 'bg-blue-700 border-l-4 border-white font-semibold'
                            : 'hover:bg-blue-700';

                        const activeMobile = isActive
                            ? 'text-blue-600'
                            : 'text-gray-500';

                        const iconHtml = m.icon
                            ? `<i class="fa-solid ${m.icon} w-5 text-center"></i>`
                            : `<span class="w-5"></span>`;

                        // Desktop
                        sidebarHtml += `
                            <a href="${m.url}"
                            class="flex items-center gap-3 px-4 py-2 rounded transition ${activeDesktop}">
                                ${iconHtml}
                                <span>${m.menu_name}</span>
                            </a>
                        `;

                        // Mobile
                        bottomHtml += `
                            <a href="${m.url}"
                            class="flex flex-col items-center justify-center py-2 ${totalMenu <= 5 ? 'flex-1' : 'px-4 min-w-[70px]'} ${activeMobile}">
                                ${m.icon ? `<i class="fa-solid ${m.icon} text-lg"></i>` : ''}
                                <span class="text-[11px] mt-1 whitespace-nowrap">${m.menu_name}</span>
                            </a>
                        `;
                    });

                    $('#sidebar-menu').html(sidebarHtml);

                    const wrapper = $('#bottom-menu-wrapper');
                    wrapper.html(bottomHtml);

                    if (totalMenu <= 5) {
                        wrapper.removeClass('justify-start').addClass('justify-between');
                    } else {
                        wrapper.removeClass('justify-between').addClass('justify-start');
                    }
                },
                error: function () {
                    console.error("Failed load menu");
                }
            });
        }

        function handleLogout(event) {
            const btn = event.target.closest('button');

            const askLogoutConfirmation = () => {
                if (typeof window.tailwindConfirmModal !== 'function') {
                    console.error('tailwindConfirmModal is not available.');
                    return Promise.resolve(false);
                }

                return window.tailwindConfirmModal({
                    title: 'Logout Confirmation',
                    message: 'Are you sure you want to logout?',
                    confirmText: 'Yes, logout',
                    cancelText: 'Cancel'
                });
            };

            const confirmLogout = askLogoutConfirmation();

            confirmLogout.then((isConfirmed) => {
                if (!isConfirmed) return;

                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = `
                        <svg class="animate-spin h-4 w-4 inline-block" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span class="ml-2">Logging out...</span>
                    `;
                }

                if (currentUserType === "Employee" || currentUserRole === "Employee" || currentUserRole === "Admin") {
                    window.location.href = '/LoginAdmin/Logout';
                } else if (currentUserType === "Teacher" || currentUserRole === "Teacher") {
                    window.location.href = '/LoginTeacher/Logout';
                } else {
                    window.location.href = '/LoginAdmin/Logout';
                }
            });
        }

        // Format date to "25 Jan 2026"
        function formatDate(dateString) {
            if (!dateString) return '';

            const date = new Date(dateString);
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            const day = date.getDate();
            const month = months[date.getMonth()];
            const year = date.getFullYear();

            return `${day} ${month} ${year}`;
        }

        function toggleFilter() {
            const dropdown = document.getElementById('filterDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Only close when clicking outside BOTH the dropdown and any Select2 popup
        document.addEventListener('click', function (e) {
            const btn = document.getElementById('filterToggleBtn');
            const dropdown = document.getElementById('filterDropdown');
            const isSelect2 = $(e.target).closest('.select2-container, .select2-dropdown').length > 0;

            if (!btn.contains(e.target) && !dropdown.contains(e.target) && !isSelect2) {
                dropdown.classList.add('hidden');
            }
        });
    </script>
    @await Html.PartialAsync("_TailwindConfirmModal")
    @RenderSection("Scripts", required: false)
</body>
</html>

