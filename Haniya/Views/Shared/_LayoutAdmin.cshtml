<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SMP IT Haniya</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Prevent caching for authenticated pages -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        /* ===== DATATABLE STYLING ===== */
        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_filter label,
        .dataTables_wrapper .dt-length label,
        .dataTables_wrapper .dt-search label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #1e3a8a;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dt-length select {
            border: 1px solid #1e3a8a;
            border-radius: 0.375rem;
            padding: 0.375rem 2rem 0.375rem 0.75rem;
            font-size: 0.875rem;
            color: #1e3a8a;
            background-color: #ffffff;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%231e3a8a' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 0.5rem center;
            background-repeat: no-repeat;
            background-size: 1.5em 1.5em;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

            .dataTables_wrapper .dataTables_length select:focus,
            .dataTables_wrapper .dt-length select:focus {
                outline: 2px solid #1e40af;
                outline-offset: 2px;
                border-color: #1e40af;
            }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dt-search input {
            border: 1px solid #1e3a8a;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: #1e3a8a;
            background-color: #ffffff;
        }

            .dataTables_wrapper .dataTables_filter input:focus,
            .dataTables_wrapper .dt-search input:focus {
                outline: 2px solid #1e40af;
                outline-offset: 2px;
                border-color: #1e40af;
            }

            .dataTables_wrapper .dataTables_filter input::placeholder,
            .dataTables_wrapper .dt-search input::placeholder {
                color: #64748b;
            }

        /* Table Header Sorting */
        table.dataTable thead th {
            position: relative;
            cursor: pointer;
            padding-right: 2rem !important;
        }

            table.dataTable thead th.sorting:before,
            table.dataTable thead th.sorting:after,
            table.dataTable thead th.sorting_asc:before,
            table.dataTable thead th.sorting_desc:after {
                position: absolute;
                right: 0.75rem;
                display: inline-block;
                opacity: 0.3;
                font-family: Arial, sans-serif;
                line-height: 1;
            }

            table.dataTable thead th.sorting:before {
                content: "▲";
                top: 0.5rem;
                font-size: 0.65rem;
                color: #1e3a8a;
            }

            table.dataTable thead th.sorting:after {
                content: "▼";
                bottom: 0.5rem;
                font-size: 0.65rem;
                color: #1e3a8a;
            }

            table.dataTable thead th.sorting_asc:before {
                content: "▲";
                top: 50%;
                transform: translateY(-50%);
                font-size: 0.75rem;
                color: #1e3a8a;
                opacity: 1;
            }

            table.dataTable thead th.sorting_desc:after {
                content: "▼";
                top: 50%;
                transform: translateY(-50%);
                font-size: 0.75rem;
                color: #1e3a8a;
                opacity: 1;
            }

            table.dataTable thead th.sorting_asc:after,
            table.dataTable thead th.sorting_desc:before {
                display: none;
            }

        /* Pagination */
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dt-info {
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
            font-size: 0.875rem;
            color: #1e3a8a;
            font-weight: 500;
        }

        .dataTables_wrapper .dataTables_paginate,
        .dataTables_wrapper .dt-paging {
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button,
            .dataTables_wrapper .dt-paging .dt-paging-button {
                border-radius: 0.375rem;
                border: 1px solid #1e3a8a;
                padding: 0.375rem 0.75rem;
                margin-left: 0.125rem;
                margin-right: 0.125rem;
                font-size: 0.875rem;
                color: #1e3a8a;
                background-color: #ffffff;
                font-weight: 500;
                transition: all 0.15s ease-in-out;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button:hover,
                .dataTables_wrapper .dt-paging .dt-paging-button:hover {
                    background-color: #dbeafe;
                    color: #1e40af;
                    border-color: #1e40af;
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                .dataTables_wrapper .dt-paging .dt-paging-button.current {
                    background-color: #1e3a8a;
                    color: #ffffff !important;
                    border-color: #1e3a8a;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover,
                    .dataTables_wrapper .dt-paging .dt-paging-button.current:hover {
                        background-color: #1e40af;
                        border-color: #1e40af;
                    }

                .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
                .dataTables_wrapper .dt-paging .dt-paging-button.disabled {
                    opacity: 0.4;
                    cursor: not-allowed;
                    background-color: #f1f5f9;
                    border-color: #cbd5e1;
                    color: #64748b;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover,
                    .dataTables_wrapper .dt-paging .dt-paging-button.disabled:hover {
                        background-color: #f1f5f9;
                        border-color: #cbd5e1;
                        color: #64748b;
                    }

        /* ===== SELECT2 STYLING ===== */
        .select2-container--default .select2-selection--single {
            height: 2.5rem;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            background-color: #ffffff;
        }

            .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #1e3a8a;
                padding-left: 0;
                line-height: 1.5rem;
                font-weight: 500;
            }

            .select2-container--default .select2-selection--single .select2-selection__placeholder {
                color: #64748b;
                font-weight: 400;
            }

            .select2-container--default .select2-selection--single .select2-selection__arrow {
                height: 100%;
                right: 0.5rem;
            }

                .select2-container--default .select2-selection--single .select2-selection__arrow b {
                    border-color: #1e3a8a transparent transparent transparent;
                    border-width: 6px 5px 0 5px;
                }

        .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
            border-color: transparent transparent #1e3a8a transparent;
            border-width: 0 5px 6px 5px;
        }

        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--focus .select2-selection--single {
            outline: 2px solid #1e40af;
            outline-offset: 2px;
            border-color: #1e40af;
        }

        .select2-dropdown {
            border-radius: 0.375rem;
            border: 1px solid #d1d5db;
            box-shadow: 0 10px 15px -3px rgba(30, 58, 138, 0.1), 0 4px 6px -4px rgba(30, 58, 138, 0.1);
        }

        .select2-container--default .select2-results__option {
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
            color: #1e3a8a;
        }

        .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
            background-color: #1e3a8a;
            color: #ffffff;
        }

        .select2-container--default .select2-results__option--selected {
            background-color: #dbeafe;
            color: #1e40af;
        }

        .select2-container--default .select2-search--dropdown .select2-search__field {
            border-radius: 0.375rem;
            border: 1px solid #d1d5db;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
        }

            .select2-container--default .select2-search--dropdown .select2-search__field:focus {
                outline: 2px solid #1e40af;
                outline-offset: 2px;
                border-color: #1e40af;
            }

        /* Select2 Clear Button */
        .select2-container--default .select2-selection--single .select2-selection__clear {
            color: #1e3a8a;
            font-size: 1.25rem;
            font-weight: bold;
            margin-right: 0.5rem;
        }

            .select2-container--default .select2-selection--single .select2-selection__clear:hover {
                color: #1e40af;
            }

        /* Three Dots Menu */
        .actions-menu {
            position: absolute;
            right: 0;
            top: 100%;
            margin-top: 0.25rem;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 0.375rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            z-index: 50;
            min-width: 120px;
        }

            .actions-menu a,
            .actions-menu button {
                display: block;
                width: 100%;
                text-align: left;
                padding: 0.5rem 0.75rem;
                font-size: 0.875rem;
                transition: background-color 0.15s ease-in-out;
            }

                .actions-menu a:hover,
                .actions-menu button:hover {
                    background-color: #f3f4f6;
                }

                .actions-menu a:first-child,
                .actions-menu button:first-child {
                    border-radius: 0.375rem 0.375rem 0 0;
                }

                .actions-menu a:last-child,
                .actions-menu button:last-child {
                    border-radius: 0 0 0.375rem 0.375rem;
                }

        /* Custom sorting icons */
        table.dataTable thead th.sorting,
        table.dataTable thead th.sorting_asc,
        table.dataTable thead th.sorting_desc {
            position: relative;
            padding-right: 2rem !important;
        }

            table.dataTable thead th.sorting:after,
            table.dataTable thead th.sorting_asc:after,
            table.dataTable thead th.sorting_desc:after {
                position: absolute;
                right: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                font-family: 'Font Awesome 5 Free';
                font-weight: 900;
                font-size: 0.75rem;
                color: #1e3a8a;
            }

            table.dataTable thead th.sorting:after {
                content: "\f0dc";
                opacity: 0.3;
            }

            table.dataTable thead th.sorting_asc:after {
                content: "\f0de";
                opacity: 1;
            }

            table.dataTable thead th.sorting_desc:after {
                content: "\f0dd";
                opacity: 1;
            }
    </style>
</head>
<body class="h-screen flex flex-col bg-gray-100 text-gray-800 overflow-hidden">
    <!-- Top Header -->
    <header class="bg-white shadow-md z-10">
        <div class="flex items-center justify-between px-6 py-4">
            <!-- Left: Logo/Title -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-900 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-800">SMP IT HANIYA</h1>
                    <p class="text-xs text-gray-500">Management System</p>
                </div>
            </div>

            <!-- Right: User Info & Logout -->
            @if (User.Identity.IsAuthenticated)
            {
                <div class="flex items-center gap-4">
                    <!-- User Info -->
                    <div class="flex items-center gap-3 px-4 py-2 bg-gray-50 rounded-lg border border-gray-200">
                        <!-- Profile Photo -->
                        @if (!string.IsNullOrEmpty(User.FindFirst("ProfilePhoto")?.Value))
                        {
                            <img src="@User.FindFirst("ProfilePhoto")?.Value"
                                 alt="Profile"
                                 class="w-10 h-10 rounded-full object-cover border-2 border-blue-600" />
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                        }

                        <!-- User Details -->
                        <div class="text-left">
                            <p class="text-sm font-semibold text-gray-800">@User.FindFirst("FullName")?.Value</p>
                            <p class="text-xs text-gray-500">@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</p>
                        </div>

                        <!-- Separator -->
                        <div class="h-8 w-px bg-gray-300 mx-2"></div>

                        <!-- Logout Button -->
                        <button type="button"
                                onclick="handleLogout()"
                                class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg font-medium transition duration-200 flex items-center gap-2 text-sm">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span>Logout</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <a href="/LoginAdmin/Index"
                   class="px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white rounded-lg font-medium transition">
                    Login
                </a>
            }
        </div>
    </header>

    <!-- Main Layout: Sidebar + Content -->
    <div class="flex flex-1 overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-blue-900 text-white flex-shrink-0 flex flex-col">
            <!-- Menu -->
            <nav id="sidebar-menu" class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            </nav>

            <!-- Footer Info -->
            <div class="p-4 border-t border-blue-700 text-center text-xs text-blue-200">
                <p>&copy; 2024 SMP IT HANIYA</p>
                <p class="mt-1">Version 1.0</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-auto p-6">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script>
        $(document).ready(function () {
            loadMenu();
        });

        function loadMenu() {
            $.ajax({
                url: '/Menu/GetMenus',
                type: 'GET',
                success: function (res) {
                    if (!res.success) {
                        console.error(res.message);
                        return;
                    }

                    // Path sekarang (tanpa query string), dibuat lower-case
                    const rawPath = window.location.pathname || '/';
                    const currentPath = rawPath.toLowerCase();

                    let html = '';

                    res.data.forEach(m => {
                        // URL menu dari database, bisa kapital/kecil campur ‑ kita normalkan
                        const menuUrlRaw = m.url || '';
                        const menuUrl = menuUrlRaw.toLowerCase();

                        // Normalisasi: hilangkan '/index' di akhir supaya
                        // '/student' dan '/student/index' dianggap sama
                        const normalizedCurrent = currentPath.replace(/\/index$/, '');
                        const normalizedMenu = menuUrl.replace(/\/index$/, '');

                        // Logika aktif:
                        // - persis sama (/student == /student)
                        // - atau current berada di bawah menu (/student/create, /student/edit, dll.)
                        let isActive = false;
                        if (normalizedMenu) {
                            isActive =
                                normalizedCurrent === normalizedMenu ||
                                normalizedCurrent.startsWith(normalizedMenu + '/');
                        }

                        const activeClass = isActive
                            ? 'bg-blue-700 border-l-4 border-white font-semibold'
                            : 'hover:bg-blue-700';

                        html += `
                                <a href="${m.url}"
                                   class="flex items-center gap-3 px-4 py-2 rounded transition ${activeClass}"
                                   data-url="${m.url}">
                                    ${m.icon ? `<i class="${m.icon}"></i>` : ''}
                                    <span>${m.menu_name}</span>
                                </a>
                            `;
                    });

                    $('#sidebar-menu').html(html);

                    // Klik menu akan mengubah active state juga (tanpa ubah logika URL)
                    $('#sidebar-menu a').on('click', function () {
                        $('#sidebar-menu a')
                            .removeClass('bg-blue-700 border-l-4 border-white font-semibold');
                        $(this)
                            .addClass('bg-blue-700 border-l-4 border-white font-semibold');
                    });
                },
                error: function () {
                    console.error('Failed load menu');
                }
            });
        }

        // Logout function
        function handleLogout() {
            if (confirm('Are you sure you want to logout?')) {
                // Show loading state
                const btn = event.target.closest('button');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = `
                                                <svg class="animate-spin h-4 w-4 inline-block" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                </svg>
                                                <span class="ml-2">Logging out...</span>
                                            `;
                }

                // Redirect to logout endpoint
                window.location.href = '/LoginAdmin/Logout';
            }
        }

        // Format date to "25 Jan 2026"
        function formatDate(dateString) {
            if (!dateString) return '';

            const date = new Date(dateString);
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            const day = date.getDate();
            const month = months[date.getMonth()];
            const year = date.getFullYear();

            return `${day} ${month} ${year}`;
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>