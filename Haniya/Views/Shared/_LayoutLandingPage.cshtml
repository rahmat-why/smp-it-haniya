<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SMP IT Haniya</title>
    <link rel="icon" href="~/image/logo-haniya.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Merriweather:wght@700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["Plus Jakarta Sans", "sans-serif"],
                        display: ["Merriweather", "serif"]
                    },
                    colors: {
                        brand: {
                            50: "#eff7ff",
                            100: "#dbeeff",
                            600: "#0f5fa8",
                            700: "#0b4f8b",
                            800: "#0a3f6f",
                            900: "#072f53"
                        }
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/30 bg-white/85 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
            <a asp-controller="LandingPage" asp-action="HomeLP" class="flex items-center gap-3">
                <img src="~/image/logo-haniya.png" asp-append-version="true" alt="Logo Haniya" class="h-9 w-9 rounded-full object-cover ring-2 ring-brand-100" />
                <div>
                    <p class="font-display text-lg leading-none text-brand-800">HANIYA</p>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Sekolah Islam</p>
                </div>
            </a>

            <button id="mobileMenuButton"
                    type="button"
                    class="inline-flex items-center justify-center rounded-lg border border-slate-300 p-2 text-slate-700 md:hidden"
                    aria-label="Buka menu navigasi"
                    aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm1 4a1 1 0 100 2h12a1 1 0 100-2H4z" clip-rule="evenodd" />
                </svg>
            </button>

            <nav class="hidden items-center gap-1 md:flex">
                <a asp-controller="LandingPage" asp-action="HomeLP" class="rounded-lg px-3 py-2 text-sm font-semibold @(currentController == "LandingPage" && currentAction == "HomeLP" ? "bg-brand-100 text-brand-800" : "text-slate-700 hover:bg-slate-100")">Beranda</a>
                <a asp-controller="LandingPage" asp-action="AboutUsLP" class="rounded-lg px-3 py-2 text-sm font-semibold @(currentController == "LandingPage" && currentAction == "AboutUsLP" ? "bg-brand-100 text-brand-800" : "text-slate-700 hover:bg-slate-100")">Tentang</a>
                <a asp-controller="LandingPage" asp-action="AcademicLP" class="rounded-lg px-3 py-2 text-sm font-semibold @(currentController == "LandingPage" && currentAction == "AcademicLP" ? "bg-brand-100 text-brand-800" : "text-slate-700 hover:bg-slate-100")">Akademik</a>
                <a asp-controller="LandingPage" asp-action="EventLP" class="rounded-lg px-3 py-2 text-sm font-semibold @(currentController == "LandingPage" && currentAction == "EventLP" ? "bg-brand-100 text-brand-800" : "text-slate-700 hover:bg-slate-100")">Acara</a>
                <a asp-controller="LandingPage" asp-action="ArticleLP" class="rounded-lg px-3 py-2 text-sm font-semibold @(currentController == "LandingPage" && currentAction == "ArticleLP" ? "bg-brand-100 text-brand-800" : "text-slate-700 hover:bg-slate-100")">Artikel</a>
                <a asp-controller="LandingPage" asp-action="ContactLP" class="rounded-lg px-3 py-2 text-sm font-semibold @(currentController == "LandingPage" && currentAction == "ContactLP" ? "bg-brand-100 text-brand-800" : "text-slate-700 hover:bg-slate-100")">Kontak</a>
            </nav>
        </div>

        <div id="mobileMenu" class="hidden border-t border-slate-200 bg-white md:hidden">
            <nav class="mx-auto grid max-w-7xl grid-cols-2 gap-2 px-4 py-4 sm:px-6">
                <a asp-controller="LandingPage" asp-action="HomeLP" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Home</a>
                <a asp-controller="LandingPage" asp-action="AboutUsLP" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">About</a>
                <a asp-controller="LandingPage" asp-action="AcademicLP" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Academic</a>
                <a asp-controller="LandingPage" asp-action="EventLP" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Event</a>
                <a asp-controller="LandingPage" asp-action="ArticleLP" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Article</a>
                <a asp-controller="LandingPage" asp-action="ContactLP" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Contact</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="mt-16 bg-brand-900 text-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-4 lg:px-8">
            <div class="lg:col-span-2">
                <p class="text-xs uppercase tracking-[0.24em] text-brand-100">SMP IT Haniya</p>
                <h3 id="layoutContactBannerDesc" class="mt-2 text-xl font-bold leading-snug"></h3>
                <div class="mt-6 space-y-4 text-sm text-slate-100">
                    <p><span class="font-semibold">Phone:</span> <span id="contactLayout2Desc"></span></p>
                    <p><span class="font-semibold">Location:</span> <span id="contactLayout3Desc"></span></p>
                </div>
            </div>

            <div>
                <h4 class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-100">Tautan Cepat</h4>
                <ul class="mt-4 space-y-2 text-sm">
                    <li><a asp-controller="LandingPage" asp-action="HomeLP" class="hover:text-brand-100">Home</a></li>
                    <li><a asp-controller="LandingPage" asp-action="AboutUsLP" class="hover:text-brand-100">About Us</a></li>
                    <li><a asp-controller="LandingPage" asp-action="AcademicLP" class="hover:text-brand-100">Academic</a></li>
                    <li><a asp-controller="LandingPage" asp-action="ContactLP" class="hover:text-brand-100">Contact</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-100">Ikuti Kami</h4>
                <div class="mt-4 flex items-center gap-4">
                    <a id="instagramLink" target="_blank" rel="noopener noreferrer" class="rounded-full bg-white/10 p-3 transition hover:bg-white/20" aria-label="Instagram">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M7 2C4.24 2 2 4.24 2 7v10c0 2.76 2.24 5 5 5h10c2.76 0 5-2.24 5-5V7c0-2.76-2.24-5-5-5H7zm10 2a1 1 0 110 2 1 1 0 010-2zM12 7a5 5 0 110 10 5 5 0 010-10zm0 2a3 3 0 100 6 3 3 0 000-6z" />
                        </svg>
                    </a>
                    <a id="tiktokLink" target="_blank" rel="noopener noreferrer" class="rounded-full bg-white/10 p-3 transition hover:bg-white/20" aria-label="TikTok">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12.5 2v12.25a2.75 2.75 0 11-2.75-2.75c.25 0 .5.03.75.1V9.5a5.75 5.75 0 105.75 5.75V7.25c1.1 1.05 2.5 1.75 4 1.75V6.5c-1.5 0-3-.75-4-2V2h-3.75z" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="border-t border-white/20 py-4 text-center text-xs text-brand-100">
            © 2026 SMP IT Haniya. Semua hak dilindungi.
        </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const menuButton = document.getElementById("mobileMenuButton");
            const mobileMenu = document.getElementById("mobileMenu");

            if (menuButton && mobileMenu) {
                menuButton.addEventListener("click", function () {
                    const isHidden = mobileMenu.classList.contains("hidden");
                    mobileMenu.classList.toggle("hidden");
                    menuButton.setAttribute("aria-expanded", String(isHidden));
                });
            }

            fetch('/Layout/GetLayoutData')
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    const setText = function (id, value) {
                        const element = document.getElementById(id);
                        if (element) element.innerText = value || "";
                    };

                    setText("layoutContactBannerDesc", data["CONTACT_BANNER1_DESC"]);
                    setText("contactLayout2Desc", data["CONTACT_PHONE1_DESC"]);
                    setText("contactLayout3Desc", data["CONTACT_LOCATION1_DESC"]);
                    setText("contactLayout4Desc", data["CONTACT_LOCATION2_DESC"]);

                    const instagram = document.getElementById("instagramLink");
                    const tiktok = document.getElementById("tiktokLink");

                    if (instagram && data["CONTACT_SOCIAL1_DESC"]) {
                        instagram.href = data["CONTACT_SOCIAL1_DESC"];
                    }
                    if (tiktok && data["CONTACT_SOCIAL2_DESC"]) {
                        tiktok.href = data["CONTACT_SOCIAL2_DESC"];
                    }
                });
        });
    </script>
</body>
</html>
