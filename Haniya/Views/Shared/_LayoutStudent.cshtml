@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var userType = User?.FindFirst("UserType")?.Value;

    if (!isAuthenticated)
    {
        Context.Response.Redirect("/LoginStudent/Index");
        return;
    }

    if (!string.Equals(userType, "Student", System.StringComparison.OrdinalIgnoreCase))
    {
        Context.Response.Redirect("/LoginStudent/AccessDenied");
        return;
    }
}
@{
    var fullName = User.FindFirst("FullName")?.Value ?? "Student";
    var nis = User.FindFirst("NIS")?.Value ?? "";
    var profilePhoto = User.FindFirst("ProfilePhoto")?.Value ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SMP IT HANIYA Student</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/image/logo-haniya.png" asp-append-version="true" />

    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.dataTables.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/lib/jquery/jquery-3.6.0.min.js"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.js"></script>

    <style>
        #student-grade-table thead th {
            cursor: pointer;
            position: relative;
        }
        
        #student-grade-table thead th.sorting,
        #student-grade-table thead th.sorting_asc,
        #student-grade-table thead th.sorting_desc {
            padding-right: 35px !important;
        }
        
        #student-grade-table thead th.sorting::after,
        #student-grade-table thead th.sorting_asc::after,
        #student-grade-table thead th.sorting_desc::after {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 12px;
            font-weight: bold;
        }
        
        #student-grade-table thead th.sorting::after {
            content: '\21C5';
            color: #9ca3af;
        }
        
        #student-grade-table thead th.sorting_asc::after {
            content: '\25B2';
            color: #1e40af;
        }
        
        #student-grade-table thead th.sorting_desc::after {
            content: '\25BC';
            color: #1e40af;
        }
        
        #student-grade-table thead th.sorting_disabled {
            cursor: default;
        }
        
        #student-grade-table thead th.sorting_disabled::after {
            display: none;
        }
    </style>
</head>
<body class="h-screen flex flex-col bg-gray-100 text-gray-800 overflow-hidden">
    <!-- Header -->
    <header class="bg-white shadow-md z-20">
        <div class="flex items-center justify-between px-4 md:px-6 py-3 md:py-4">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-blue-900 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 md:w-6 md:h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-base md:text-xl font-bold text-gray-800">SMP IT HANIYA</h1>
                    <p class="text-[10px] md:text-xs text-gray-500">Student Portal</p>
                </div>
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="flex items-center gap-3 md:gap-4">
                    <div class="relative inline-block text-left">
                        <div onclick="toggleProfileMenu()" class="flex items-center gap-2 md:gap-3 px-3 md:px-4 py-1.5 md:py-2 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer select-none">
                            @if (!string.IsNullOrEmpty(profilePhoto))
                            {
                                <img src="@profilePhoto"
                                     alt="Profile"
                                     class="w-8 h-8 md:w-10 md:h-10 rounded-full object-cover border-2 border-blue-600" />
                            }
                            else
                            {
                                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-sm md:text-lg">
                                    @(fullName.Substring(0, 1).ToUpper())
                                </div>
                            }

                            <div class="hidden sm:block text-left">
                                <p class="text-xs md:text-sm font-semibold text-gray-800 truncate max-w-[140px] md:max-w-[200px]">@fullName</p>
                                <p class="text-[10px] md:text-xs text-gray-500">NIS: @nis</p>
                                <p class="text-[10px] md:text-xs text-gray-500">Level: <span id="student-memorization-achievement">-</span></p>
                            </div>
                        </div>

                        <div id="profileMenu" class="hidden absolute right-0 mt-3 w-48 bg-white rounded-xl shadow-xl border border-gray-100 z-50 overflow-hidden transition-all duration-200">
                            <button type="button"
                                    onclick="handleLogout(event)"
                                    class="w-full flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors duration-200">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>

                                <span>Logout</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a href="/LoginStudent/Index"
                   class="px-3 md:px-4 py-1.5 md:py-2 bg-blue-900 hover:bg-blue-800 text-white rounded-lg font-medium text-xs md:text-sm transition">
                    Login
                </a>
            }
        </div>
    </header>

    <!-- Layout utama -->
    <div class="flex flex-1 overflow-hidden">
        <!-- Sidebar Desktop -->
        <aside class="hidden md:flex w-64 bg-blue-900 text-white flex-shrink-0 flex-col">
            <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto text-sm">
                <a href="/StDashboard"
                   class="student-menu-item flex items-center gap-3 px-4 py-2 rounded transition"
                   data-route="/StDashboard">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6" />
                    </svg>
                    <span>Dashboard</span>
                </a>
                <a href="/StGrade"
                   class="student-menu-item flex items-center gap-3 px-4 py-2 rounded transition"
                   data-route="/StGrade">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0v7" />
                    </svg>
                    <span>Grade</span>
                </a>
                <a href="/StPayment"
                   class="student-menu-item flex items-center gap-3 px-4 py-2 rounded transition"
                   data-route="/StPayment">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z" />
                    </svg>
                    <span>Payment</span>
                </a>
                <a href="/StSchedule"
                   class="student-menu-item flex items-center gap-3 px-4 py-2 rounded transition"
                   data-route="/StSchedule">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Schedule</span>
                </a>
                <a href="/StAttendance"
                   class="student-menu-item flex items-center gap-3 px-4 py-2 rounded transition"
                   data-route="/StAttendance">
                    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    <span>Attendance</span>
                </a>
                <div id="student-portal-menu-container"></div>
            </nav>

            <div class="p-4 border-t border-blue-700 text-center text-xs text-blue-200">
                <p>&copy; 2026 SMP IT HANIYA</p>
                <p class="mt-1">Student Portal v1.0</p>
            </div>
        </aside>

        <!-- Konten Utama -->
        <main class="flex-1 overflow-auto p-4 md:p-6 pb-20 md:pb-6">
            @RenderBody()
        </main>
    </div>

    <!-- Bottom Nav Mobile -->
    <nav class="md:hidden fixed bottom-0 inset-x-0 bg-white border-t border-gray-200 shadow-lg z-30">
        <div id="student-bottom-menu-grid" class="grid grid-cols-5">
            <button type="button"
                    class="student-bottom-item flex flex-col items-center justify-center py-2 w-full text-xs"
                    data-route="/StDashboard"
                    onclick="navigateStudent('/StDashboard')">
                <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6" />
                </svg>
                <span>Dashboard</span>
            </button>
            <button type="button"
                    class="student-bottom-item flex flex-col items-center justify-center py-2 w-full text-xs"
                    data-route="/StGrade"
                    onclick="navigateStudent('/StGrade')">
                <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0v7" />
                </svg>
                <span>Grade</span>
            </button>
            <button type="button"
                    class="student-bottom-item flex flex-col items-center justify-center py-2 w-full text-xs"
                    data-route="/StPayment"
                    onclick="navigateStudent('/StPayment')">
                <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z" />
                </svg>
                <span>Payment</span>
            </button>
            <button type="button"
                    class="student-bottom-item flex flex-col items-center justify-center py-2 w-full text-xs"
                    data-route="/StSchedule"
                    onclick="navigateStudent('/StSchedule')">
                <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>Schedule</span>
            </button>
            <button type="button"
                    class="student-bottom-item flex flex-col items-center justify-center py-2 w-full text-xs"
                    data-route="/StAttendance"
                    onclick="navigateStudent('/StAttendance')">
                <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
                <span>Attend</span>
            </button>
        </div>
    </nav>

    <script>
        function setActiveStudentMenu() {
            const currentPath = window.location.pathname;

            // Sidebar desktop
            $('.student-menu-item').each(function () {
                const route = $(this).data('route');
                if (currentPath === route || currentPath.startsWith(route + '/')) {
                    $(this).addClass('bg-blue-700 border-l-4 border-white font-semibold');
                } else {
                    $(this).removeClass('bg-blue-700 border-l-4 border-white font-semibold');
                }
            });

            // Bottom nav mobile
            $('.student-bottom-item').each(function () {
                const route = $(this).data('route');
                if (currentPath === route || currentPath.startsWith(route + '/')) {
                    $(this).addClass('text-blue-600');
                } else {
                    $(this).removeClass('text-blue-600');
                }
            });
        }

        function navigateStudent(url) {
            window.location.href = url;
        }

        function toggleProfileMenu() {
            const menu = document.getElementById("profileMenu");
            menu.classList.toggle("hidden");
        }

        document.addEventListener("click", function (event) {
            const menu = document.getElementById("profileMenu");
            const container = event.target.closest(".relative");

            if (!container && menu) {
                menu.classList.add("hidden");
            }
        });

        function handleLogout(event) {
            const btn = event.target.closest('button');

            const askLogoutConfirmation = () => {
                if (typeof window.tailwindConfirmModal !== 'function') {
                    console.error('tailwindConfirmModal is not available.');
                    return Promise.resolve(false);
                }

                return window.tailwindConfirmModal({
                    title: 'Logout Confirmation',
                    message: 'Are you sure you want to logout?',
                    confirmText: 'Yes, logout',
                    cancelText: 'Cancel'
                });
            };

            askLogoutConfirmation().then((isConfirmed) => {
                if (isConfirmed) {
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = `
                            <svg class="animate-spin h-4 w-4 inline-block" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span class="ml-2">Logging out...</span>
                        `;
                    }
                    window.location.href = '/LoginStudent/Logout';
                }
            });
        }

        $(document).ready(function () {
            setActiveStudentMenu();
            loadPortalMenuStudent();
            loadMemorizationAchievement();
        });

        function loadMemorizationAchievement() {
            $.ajax({
                url: '/StDashboard/GetMemorizationAchievement',
                type: 'GET',
                success: function (res) {
                    if (!res || !res.success) return;
                    $('#student-memorization-achievement').text(res.data || '-');
                }
            });
        }

        function loadPortalMenuStudent() {
            $.ajax({
                url: '/Menu/GetPortalMenus',
                type: 'GET',
                success: function (res) {
                    if (!res || !res.success || !Array.isArray(res.data) || !res.data.length) return;

                    let desktopHtml = '';
                    let mobileHtml = '';

                    res.data.forEach(m => {
                        const iconClass = m.icon || 'fa-book-open';
                        const name = m.menu_name || 'Portal';
                        const url = m.url || '#';

                        desktopHtml += `
                            <a href="${url}"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="student-menu-item flex items-center gap-3 px-4 py-2 rounded transition hover:bg-blue-700">
                                <i class="fa-solid ${iconClass} w-5 text-center"></i>
                                <span>${name}</span>
                            </a>
                        `;

                        mobileHtml += `
                            <a href="${url}"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="student-bottom-item flex flex-col items-center justify-center py-2 w-full text-xs text-gray-500">
                                <i class="fa-solid ${iconClass} w-5 h-5 mb-0.5 text-base"></i>
                                <span>${name}</span>
                            </a>
                        `;
                    });

                    $('#student-portal-menu-container').html(desktopHtml);

                    if (mobileHtml) {
                        $('#student-bottom-menu-grid').append(mobileHtml);
                    }
                }
            });
        }
    </script>

    @await Html.PartialAsync("_TailwindConfirmModal")
    @RenderSection("Scripts", required: false)
</body>
</html>


