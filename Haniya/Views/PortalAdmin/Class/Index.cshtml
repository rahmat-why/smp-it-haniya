@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Class";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Class</h2>
    <a id="class-add-link" href="/Class/Create" class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900" data-testid="class-add-button">
        + Add Class
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="class-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="overflow-x-auto px-4 pt-4">
        <table id="class-table" class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th data-sort="academicYear" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Academic Year</th>
                    <th data-sort="semester" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Semester</th>
                    <th data-sort="class" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Class</th>
                    <th data-sort="homeroom" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Homeroom Teacher</th>
                    <th data-sort="students" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Students</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase !text-right" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3">
        <div id="class-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="class-table-info"></div>
            <div id="class-table-pagination"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
    const pageState = {
        page: 1,
        limit: 10,
        filters: { search: '', academic_year_id: '' },
        sort: { field: 'academicYear', order: 'asc' },
        hasNextPage: false
    };
    let lastRequestKey = '';

    function formatYearShort(d) {
        if (!d) return '';
        const date = new Date(d);
        if (isNaN(date.getTime())) return '';
        return date.getFullYear();
    }

    function getStateQuery() {
        return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&academic_year_id=${encodeURIComponent(pageState.filters.academic_year_id || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`;
    }

    function syncStateToUrl() {
        history.replaceState({ ...pageState }, '', `?${getStateQuery()}`);
        $('#class-add-link').attr('href', `/Class/Create?returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`);
    }

    function hydrateStateFromUrl() {
        const q = new URLSearchParams(window.location.search);
        const page = Number(q.get('page') || 1);
        const limit = Number(q.get('limit') || 10);
        pageState.page = Number.isFinite(page) && page > 0 ? page : 1;
        pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10;
        pageState.filters.search = q.get('search') || '';
        pageState.filters.academic_year_id = q.get('academic_year_id') || '';
        pageState.sort.field = q.get('sortField') || 'academicYear';
        pageState.sort.order = q.get('sortOrder') || 'asc';
    }

    function renderToolbar() {
        $('#class-table-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">
                Show
                <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select> rows
            </div>
            <div class="flex items-center gap-2">
                <input id="list-search" type="text" placeholder="Search..."
                       class="w-full md:w-64 border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"/>
                <div class="relative">
                <button id="filterToggleBtn"
                        onclick="toggleFilter()"
                        class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                    </svg>
                    Filter
                </button>

                <div id="filterDropdown"
                        class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                        <button type="button"
                                onclick="toggleFilter()"
                                class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </div>
                    <div class="px-5 py-4 space-y-4">
                        <div class="w-full">
                            <label class="block text-xs font-medium mb-1" for="academic_year_filter">Academic Year</label>
                            <select id="academic_year_filter" class="w-full"></select>
                        </div>
                    </div>
                    <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                        <button type="button"
                                onclick="applyClassFilter()"
                                class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">
                            Filter
                        </button>
                    </div>
                </div>
            </div>
            </div>
        `);

        $('#class-table-toolbar').addClass('flex flex-col md:flex-row md:items-center md:justify-between gap-4');

        $('#list-limit').val(String(pageState.limit));
        $('#list-search').val(pageState.filters.search || '');
        $('#list-search').off('input').on('input', function () {
            pageState.filters.search = ($(this).val() || '').trim();
            pageState.page = 1;
            lastRequestKey = '';
            fetchClasses();
        });

        $('#list-limit').off('change').on('change', function () {
            const next = Number($(this).val() || 10);
            if (pageState.limit === next) return;
            pageState.limit = next;
            pageState.page = 1;
            lastRequestKey = '';
            fetchClasses();
        });

        $('#academic_year_filter').select2({
            placeholder: 'All Academic Years',
            allowClear: true,
            ajax: {
                url: '/Select2/AcademicYears',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { q: params.term || '', page: params.page || 1 };
                },
                processResults: function (data) {
                    return { results: data.results, pagination: data.pagination };
                },
                cache: true
            },
            minimumInputLength: 0
        });

        if (pageState.filters.academic_year_id) {
            const currentId = pageState.filters.academic_year_id;
            $.ajax({
                url: '/Select2/AcademicYears',
                data: { page: 1 },
                success: function (data) {
                    const found = (data.results || []).find(x => x.id === currentId);
                    if (found) {
                        $('#academic_year_filter').append(new Option(found.text, found.id, true, true)).trigger('change');
                    }
                }
            });
        }

        $('#list-search').val(pageState.filters.search || '');
    }

    function applyClassFilter() {
        pageState.filters.academic_year_id = $('#academic_year_filter').val() || '';
        pageState.page = 1;
        lastRequestKey = '';
        fetchClasses();
        toggleFilter();
    }

    function renderSortIndicators() {
        $('#class-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' (asc)' : ' (desc)') : '';
            const base = $(this).text().replace(/ \((asc|desc)\)$/, '');
            $(this).text(base + icon);
        });
    }

    function renderRows(items) {
        const $tbody = $('#class-table tbody');
        if (!items || !items.length) {
            $tbody.html(`<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No data found.</td></tr>`);
            return;
        }

        let html = '';
        items.forEach(row => {
            const id = row.academic_class_id || '';
            const photo = (typeof row.homeroom_teacher_photo === 'string' && row.homeroom_teacher_photo.trim() !== '')
                ? row.homeroom_teacher_photo
                : '/image/no-image.png';
            const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            html += `
                <tr class="bg-white divide-y divide-gray-100">
                    <td class="px-4 py-3">${formatYearShort(row.start_date)} - ${formatYearShort(row.end_date)}</td>
                    <td class="px-4 py-3">${row.semester ? `Semester ${row.semester}` : '-'}</td>
                    <td class="px-4 py-3 text-gray-900">${row.class_name || '-'}</td>
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <img src="${photo}" class="w-10 h-10 rounded-full object-cover border border-gray-200" alt="Teacher">
                            <div>
                                <div class="font-medium text-gray-900">${row.homeroom_teacher_name || '-'}</div>
                                <div class="text-xs text-gray-600">${row.homeroom_teacher_npk ? `NPK: ${row.homeroom_teacher_npk}` : ''}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-3">${row.student_count || 0} student(s)</td>
                    <td class="px-4 py-3 text-right">
                        <div class="inline-flex justify-end class-actions-wrapper relative">
                            <button type="button" onclick="toggleActionsMenu(event, '${id}')" class="p-1.5 hover:bg-gray-100 rounded-md">
                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                </svg>
                            </button>
                            <div id="actions-menu-${id}" class="class-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10 border border-gray-100">
                                <a href="/Class/Edit?id=${encodeURIComponent(id)}&returnUrl=${returnUrl}" class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50">Edit</a>
                                <button type="button" onclick="delClass('${id}')" class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100">Delete</button>
                            </div>
                        </div>
                    </td>
                </tr>
            `;
        });

        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#class-table-info').html(`<span class="text-sm text-gray-600">Showing ${start} to ${end}</span>`);

        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        $('#class-table-pagination').html(`
            <div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                <button id="page-prev" class="px-3 py-2 text-sm border-r border-gray-200 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>
                <span class="px-3 py-2 text-sm bg-blue-900 text-white font-semibold">${pageState.page}</span>
                <button id="page-next" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Next</button>
            </div>
        `);

        $('#page-prev').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            pageState.page -= 1;
            lastRequestKey = '';
            fetchClasses();
        });

        $('#page-next').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            pageState.page += 1;
            lastRequestKey = '';
            fetchClasses();
        });
    }

    async function fetchClasses() {
        const payload = {
            page: pageState.page,
            limit: pageState.limit,
            filters: { ...pageState.filters },
            sort: { ...pageState.sort }
        };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();

        try {
            const res = await $.ajax({
                url: '/Class/GetAll',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });

            if (!res.success) {
                lastRequestKey = '';
                tailwindMessageModal('Failed', res.message || 'Failed to load class data.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.hasNextPage = !!result.hasNextPage;
            renderRows(items);
            renderPagination(items.length);
        } catch (xhr) {
            lastRequestKey = '';
            const message = (xhr && xhr.responseJSON && xhr.responseJSON.message)
                ? xhr.responseJSON.message
                : 'An error occurred while loading class data.';
            tailwindMessageModal('Error', message);
        }
    }

    function toggleActionsMenu(event, id) {
        event.stopPropagation();
        $('.class-actions-menu').addClass('hidden');
        $('#actions-menu-' + id).toggleClass('hidden');
    }

    async function delClass(id) {
        $('.class-actions-menu').addClass('hidden');
        const yes = await tailwindConfirmModal({
            title: 'Delete Confirmation',
            message: 'Are you sure you want to delete this data?',
            confirmText: 'Delete',
            cancelText: 'Cancel'
        });
        if (!yes) return;

        try {
            const res = await $.ajax({
                url: '/Class/Delete',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    action: 'delete',
                    id: id,
                    data: null
                })
            });

            if (!res || !res.success) {
                await tailwindMessageModal('Failed', (res && res.message) ? res.message : 'Delete failed.');
                return;
            }

            lastRequestKey = '';
            await fetchClasses();
            await tailwindMessageModal('Deleted', 'Class data has been deleted.');
        } catch {
            await tailwindMessageModal('Error', 'An error occurred while deleting the class.');
        }
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();
        fetchClasses();

        $(document).on('click', function (e) {
            if (!$(e.target).closest('.class-actions-wrapper').length) {
                $('.class-actions-menu').addClass('hidden');
            }
        });

        $('#class-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;

            if (pageState.sort.field === field) {
                pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            } else {
                pageState.sort.field = field;
                pageState.sort.order = 'asc';
            }

            pageState.page = 1;
            lastRequestKey = '';
            fetchClasses();
        });
    });
</script>
}
