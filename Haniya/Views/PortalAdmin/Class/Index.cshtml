@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Class";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Class</h2>
    <a href="/Class/Create" class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900" data-testid="class-add-button">
        + Add Class
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="class-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        </div>
    </div>

    <div class="overflow-x-auto px-4 pt-4">
        <table id="class-table" class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Academic Year</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Semester</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Class</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Homeroom Teacher</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Students</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div> 
    <div class="px-4 pb-4 pt-3">
        <div id="class-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentAcademicYearId = '';
        let classTable = null;

        $(document).ready(function () {
            initClassTable();
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.class-actions-wrapper').length) {
                    $('.class-actions-menu').addClass('hidden');
                }
            });
        });

        function initClassTable() {
            classTable = $('#class-table').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                lengthChange: true,
                ajax: {
                    url: '/Class/GetAll',
                    type: 'GET',
                    data: function (d) {
                        d.academic_year_id = currentAcademicYearId;
                    }
                },
                dom: 'lftip',
                language: {
                    lengthMenu: "Show _MENU_ rows",
                    search: "",
                    searchPlaceholder: "Search...",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                },
                order: [[0, 'asc']],
                columns: [
                    {
                        data: null,
                        className: 'py-3',
                        render: function (data, type, row) {
                            return `${formatYearShort(row.start_date)} - ${formatYearShort(row.end_date)}`;
                        }
                    },
                    {
                        data: 'semester',
                        className: 'py-3',
                        render: function (data) {
                            return data ? `Semester ${data}` : '-';
                        }
                    },
                    {
                        data: 'class_name',
                        className: 'py-3 text-gray-900'
                    },
                    {
                        data: null,
                        className: 'py-3',
                        render: function (data, type, row) {
                            var photo = row.homeroom_teacher_photo || '/image/no-image.png';
                            var name = row.homeroom_teacher_name || '-';
                            var npk = row.homeroom_teacher_npk || '';
                            return `
                                        <div class="flex items-center gap-3">
                                            <img src="${photo}"
                                                 class="w-10 h-10 rounded-full object-cover border border-gray-200"
                                                 alt="Teacher">
                                            <div>
                                                <div class="font-medium text-gray-900">${name}</div>
                                                <div class="text-xs text-gray-600">${npk ? `NPK: ${npk}` : ''}</div>
                                            </div>
                                        </div>
                                    `;
                        }
                    },
                    {
                        data: 'student_count',
                        className: 'py-3',
                        render: function (data) {
                            return `${data || 0} student(s)`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-center py-3',
                        render: function (data, type, row) {
                            var id = row.academic_class_id;
                            var editUrl = '/Class/Edit?id=' + id;
                            return `
                                        <div class="flex justify-center class-actions-wrapper relative">
                                            <button type="button"
                                                    onclick="toggleActionsMenu(event, '${id}')"
                                                    class="p-1.5 hover:bg-gray-100 rounded-md transition-colors duration-150"
                                                    data-testid="class-actions-toggle-${id}">
                                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                                </svg>
                                            </button>
                                            <div id="actions-menu-${id}" class="class-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">
                                                <a href="${editUrl}"
                                                   class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50"
                                                   data-testid="class-edit-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    Edit
                                                </a>
                                                <button type="button"
                                                        onclick="delClass('${id}')"
                                                        class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100"
                                                        data-testid="class-delete-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    const wrapper = $('#class-table_wrapper');
                    const $length = wrapper.find('.dataTables_length, .dt-length');
                    const $filter = wrapper.find('.dataTables_filter, .dt-search');
                    const initialSearch = (classTable.search() || '').replace(/"/g, '&quot;');

                    $filter.hide();

                    const $toggleFilter = $(`
                        <div class="relative">
                            <button id="filterToggleBtn"
                                    onclick="toggleFilter()"
                                    class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                                </svg>
                                Filter
                            </button>

                            <div id="filterDropdown"
                                 class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                                    <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                                    <button type="button"
                                            onclick="toggleFilter()"
                                            class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </button>
                                </div>
                                <div class="px-5 py-4 space-y-4">
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="academic_year_filter">Academic Year</label>
                                        <select id="academic_year_filter" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="class_search_filter">Search</label>
                                        <input id="class_search_filter"
                                               type="text"
                                               value="${initialSearch}"
                                               class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                               placeholder="Search..." />
                                    </div>
                                </div>
                                <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                                    <button type="button"
                                            onclick="applyClassFilter()"
                                            class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">
                                        Filter
                                    </button>
                                </div>
                            </div>
                        </div>
                    `);

                    $('#class-table-toolbar').empty().append($length).append($toggleFilter);

                    $length.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $length.find('label').addClass('flex items-center gap-2');
                    $length.find('select').addClass(
                        'border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 ' +
                        'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                    );

                    $('#class-table-toolbar').addClass('flex flex-col md:flex-row md:items-center md:justify-between gap-4');

                    $('#academic_year_filter').select2({
                        placeholder: "All Academic Years",
                        allowClear: true,
                        ajax: {
                            url: '/Select2/AcademicYears',
                            dataType: 'json',
                            delay: 250,
                            data: function (params) {
                                return { q: params.term || '', page: params.page || 1 };
                            },
                            processResults: function (data) {
                                return {
                                    results: data.results,
                                    pagination: data.pagination
                                };
                            },
                            cache: true
                        },
                        minimumInputLength: 0
                    });
                    
                    $.ajax({
                        url: '/Select2/AcademicYears',
                        data: { page: 1 },
                        success: function (data) {
                            if (data.results && data.results.length === 1) {
                                const activeYear = data.results[0];
                                $('#academic_year_filter').val(activeYear.id).trigger('change');
                            }
                        }
                    });

                    stylePagination();
                },
                drawCallback: function () {
                    setTimeout(stylePagination, 50);
                }
            });
        }

        function applyClassFilter() {
            currentAcademicYearId = $('#academic_year_filter').val() || '';
            const searchKeyword = ($('#class_search_filter').val() || '').trim();
            classTable.search(searchKeyword);
            classTable.ajax.reload(null, true);
            toggleFilter();
        }

        function stylePagination() {
            const wrapper = $('#class-table_wrapper');
            let $info = wrapper.find('.dataTables_info').first();
            if ($info.length === 0) $info = wrapper.find('.dt-info').first();

            let $paginate = wrapper.find('.dataTables_paginate').first();
            if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

            if ($info.length > 0) {
                $('#table-info-container').empty().append($info);
                $info.removeClass().addClass('text-sm text-gray-600');
            }

            if ($paginate.length > 0) {
                $('#table-pagination-container').empty().append($paginate);
            }

            $('#table-pagination-container').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
            if (typeof applyAdminPaginationStyle === 'function') {
                applyAdminPaginationStyle($('#table-pagination-container'));
            }
        }

        function formatYearShort(d) {
            if (!d) return "";
            const date = new Date(d);
            if (isNaN(date.getTime())) return "";
            return date.getFullYear();
        }

        function toggleActionsMenu(event, id) {
            event.stopPropagation();
            $('.class-actions-menu').addClass('hidden');
            const menu = $('#actions-menu-' + id);
            menu.toggleClass('hidden');
        }

        function delClass(id) {
            $('.class-actions-menu').addClass('hidden');

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if(!result.isConfirmed) return;

                $.ajax({
                    url: "/Class/Delete",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({
                        action: "delete",
                        id: id,
                        data: null
                    }),
                    success: res => {
                        if (res.success) {
                            $('#class-table').DataTable().ajax.reload(null, false);
                            Swal.fire(
                                'Deleted!',
                                'Class data has been deleted.',
                                'success'
                            );
                        } else {
                            Swal.fire(
                                'Failed!',
                                res.message,
                                'error'
                            );
                        }
                    },
                    error: function () {
                        Swal.fire(
                            'Error!',
                            'An error occurred while deleting the class.',
                            'error'
                        );
                    }
                });
            })
        }
    </script>
}

