@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Ubah Kelas";
    var academicClassId = ViewBag.academicClassId as string;
}

<h2 class="text-xl font-semibold mb-4">Ubah Kelas</h2>
<div class="bg-white p-6 rounded-lg shadow w-full space-y-6">
    <form id="frm" class="space-y-6 w-full flex flex-col">
        <input type="hidden" id="academic_class_id" value="@academicClassId" />
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 w-full flex-grow">
            <!-- LEFT: Academic Information (4 columns) -->
            <div class="md:col-span-4 border border-gray-200 rounded-lg overflow-hidden w-full flex flex-col h-full">
                <button type="button"
                        onclick="toggleSection('academic-info')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left">
                    <span class="font-semibold text-white">
                        Informasi Akademik
                    </span>
                    <svg id="icon-academic-info"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="academic-info"
                     class="px-4 pb-4 pt-3 space-y-4 border-t border-gray-100 flex-grow">
                    <!-- Academic Year -->
                    <div>
                        <label for="academic_year_id" class="block text-sm font-medium text-gray-700 mb-1">
                            Tahun Akademik <span class="text-red-500">*</span>
                        </label>
                        <select id="academic_year_id"
                                class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-placeholder="-- Pilih Tahun Akademik --">
                        </select>
                        <p id="error-academic_year_id"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"></p>
                    </div>
                    <!-- Class -->
                    <div>
                        <label for="class_id" class="block text-sm font-medium text-gray-700 mb-1">
                            Kelas <span class="text-red-500">*</span>
                        </label>
                        <select id="class_id"
                                class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-placeholder="-- Pilih Kelas --">
                        </select>
                        <p id="error-class_id"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"></p>
                    </div>
                    <!-- Homeroom Teacher -->
                    <div>
                        <label for="homeroom_teacher_id" class="block text-sm font-medium text-gray-700 mb-1">
                            Wali Kelas <span class="text-red-500">*</span>
                        </label>
                        <select id="homeroom_teacher_id"
                                class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-placeholder="-- Pilih Wali Kelas --">
                        </select>
                        <p id="error-homeroom_teacher_id"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"></p>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Students (8 columns) -->
            <div class="md:col-span-8 border border-gray-200 rounded-lg overflow-hidden w-full flex flex-col h-full">
                <button type="button"
                        onclick="toggleSection('student-section')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left">
                    <span class="font-semibold text-white">
                        Siswa
                    </span>
                    <svg id="icon-student-section"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="student-section"
                     class="px-4 pb-4 pt-3 space-y-3 border-t border-gray-100 flex-grow">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-gray-700">
                            Pilih siswa untuk kelas ini
                        </span>
                        <label class="inline-flex items-center text-sm text-gray-700 cursor-pointer">
                            <input type="checkbox" id="select-all-students" class="mr-1" />
                            <span>Pilih Semua</span>
                        </label>
                    </div>
                    <div class="border rounded-md max-h-72 overflow-auto bg-white flex-grow">
                        <table class="min-w-full text-sm">
                            <thead class="bg-gray-50 sticky top-0 text-left">
                                <tr>
                                    <th class="p-2 w-10 text-left"></th>
                                    <th class="p-2 text-left">Siswa</th>
                                    <th class="p-2 text-left">Jenis Kelamin</th>
                                    <th class="p-2 text-left">Status</th>
                                </tr>
                            </thead>
                            <tbody id="student-list-body"></tbody>
                        </table>
                    </div>
                    <p id="error-student_ids"
                       class="mt-1 text-xs text-red-600 hidden validation-error-message"></p>
                </div>
            </div>
        </div>

        <!-- Save & Back buttons OUTSIDE student section -->
        <div class="flex justify-end space-x-2 pt-4 border-t border-gray-200">
            <button type="button"
                    onclick="goBack()"
                    class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm">
                Kembali
            </button>
            <button type="button"
                    onclick="updateClass()"
                    class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm">
                <span>Simpan</span>
            </button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
    <script>
        const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Class';
        function toggleSection(id) {
            const section = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);
            if (!section || !icon) return;
            const isHidden = section.classList.contains('hidden');
            if (isHidden) {
                section.classList.remove('hidden');
                icon.classList.remove('-rotate-90');
            } else {
                section.classList.add('hidden');
                icon.classList.add('-rotate-90');
            }
        }

        function goBack() {
            window.location.href = returnUrl;
        }

        function showError($el, message) {
            $el.text(message).removeClass('hidden');
        }

        function clearError($el) {
            $el.text('').addClass('hidden');
        }

        function formatAcademicYearLabel(startDate, endDate, semester) {
            if (!startDate || !endDate) return '';
            const startYear = new Date(startDate).getFullYear();
            const endYear = new Date(endDate).getFullYear();
            return `${startYear} - ${endYear} (Semester ${semester || '?'})`;
        }

        function formatTeacherLabel(name, npk, fallbackId) {
            if (name && npk) return `${name} - ${npk}`;
            if (name) return name;
            return fallbackId || '';
        }

        function renderStudents(students) {
            const body = $('#student-list-body').empty();
            if (!students.length) {
                body.append(`
                            <tr>
                                <td colspan="4" class="p-4 text-center text-gray-500">
                                    Tidak ada siswa tersedia
                                </td>
                            </tr>
                        `);
                return;
            }
            students.forEach(s => {
                const checked = s.is_assigned ? 'checked' : '';
                const status = (s.status || 'Active').toString();
                const normalizedStatus = status.trim().toLowerCase();
                const statusBadgeClass = normalizedStatus === 'active'
                    ? 'bg-blue-100 text-blue-800'
                    : 'bg-gray-100 text-gray-800';

                body.append(`
                            <tr class="border-b last:border-0" data-student-id="${s.student_id}">
                                <td class="p-2 text-center">
                                    <input type="checkbox" class="student-checkbox" ${checked} />
                                </td>
                                <td class="p-2">
                                    <div class="flex items-center gap-3">
                                        <img src="${s.profile_photo}"
                                             class="w-10 h-10 rounded-full object-cover border border-gray-200"
                                             alt="Student">
                                        <div>
                                            <div class="font-medium text-gray-900">${s.full_name ?? ""}</div>
                                            <div class="text-xs text-gray-600">NIS: ${s.nis ?? ""}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-2">${s.gender ?? "Unknown"}</td>
                                <td class="p-2">
                                    <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full ${statusBadgeClass}">
                                        ${status}
                                    </span>
                                </td>
                            </tr>
                        `);
            });
        }

        function validateForm() {
            let valid = true;
            const yearId = ($('#academic_year_id').val() || '').trim();
            const classId = ($('#class_id').val() || '').trim();
            const homeroomId = ($('#homeroom_teacher_id').val() || '').trim();

            clearError($('#error-academic_year_id'));
            clearError($('#error-class_id'));
            clearError($('#error-homeroom_teacher_id'));
            clearError($('#error-student_ids'));

            if (!yearId) {
                showError($('#error-academic_year_id'), 'Tahun akademik wajib diisi.');
                valid = false;
            }
            if (!classId) {
                showError($('#error-class_id'), 'Kelas wajib diisi.');
                valid = false;
            }
            if (!homeroomId) {
                showError($('#error-homeroom_teacher_id'), 'Wali kelas wajib diisi.');
                valid = false;
            }
            const selectedStudents = $('.student-checkbox:checked').length;
            if (selectedStudents === 0) {
                showError($('#error-student_ids'), 'Minimal satu siswa harus dipilih.');
                valid = false;
            }

            return valid;
        }

        async function updateClass() {
            if (!validateForm()) return;
            const yes = await tailwindConfirmModal({
                title: 'Konfirmasi Pembaruan',
                message: 'Apakah Anda yakin ingin memperbarui data ini?',
                confirmText: 'Simpan',
                cancelText: 'Batal'
            });
            if (!yes) return;

            const fd = new FormData();
            fd.append("academic_class_id", $('#academic_class_id').val());
            fd.append("academic_year_id", $('#academic_year_id').val());
            fd.append("class_id", $('#class_id').val());
            fd.append("homeroom_teacher_id", $('#homeroom_teacher_id').val());

            $('.student-checkbox:checked').each(function () {
                const sid = $(this).closest('tr').data('student-id');
                fd.append("student_ids", sid);
            });

            $.ajax({
                url: "/Class/Update",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: res => {
                    if (res.success) {
                        tailwindMessageModal('Berhasil', res.message || 'Kelas berhasil diperbarui.')
                            .then(() => { window.location.href = returnUrl; });
                    } else {
                        tailwindMessageModal('Gagal', res.message || "Gagal memperbarui kelas");
                    }
                },
                error: function () {
                    tailwindMessageModal('Kesalahan', "Terjadi kesalahan saat memperbarui kelas.");
                }
            });
        }

        $(document).ready(function () {
            // Select All checkbox
            $('#select-all-students').on('change', function () {
                const checked = $(this).is(':checked');
                $('#student-list-body').find('.student-checkbox').prop('checked', checked);
            });

            // Initialize Select2 for Academic Year
            $('#academic_year_id').select2({
                placeholder: "-- Pilih Tahun Akademik --",
                allowClear: true,
                ajax: {
                    url: '/Select2/AcademicYears',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term || '', page: params.page || 1 };
                    },
                    processResults: function (data) {
                        return {
                            results: data.results,
                            pagination: data.pagination
                        };
                    },
                    cache: true
                },
                minimumInputLength: 0
            });

            // Initialize Select2 for Class
            $('#class_id').select2({
                placeholder: "-- Pilih Kelas --",
                allowClear: true,
                ajax: {
                    url: '/Select2/Classes',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term || '', page: params.page || 1 };
                    },
                    processResults: function (data) {
                        return {
                            results: data.results,
                            pagination: data.pagination
                        };
                    },
                    cache: true
                },
                minimumInputLength: 0
            });

            // Initialize Select2 for Homeroom Teacher
            $('#homeroom_teacher_id').select2({
                placeholder: "-- Pilih Wali Kelas --",
                allowClear: true,
                ajax: {
                    url: '/Select2/Teachers',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term || '', page: params.page || 1 };
                    },
                    processResults: function (data) {
                        return {
                            results: data.results,
                            pagination: data.pagination
                        };
                    },
                    cache: true
                },
                minimumInputLength: 0
            });

            const acId = $('#academic_class_id').val();

            // Load current class info and pre-select values
            $.get("/Class/GetById", { id: acId }, res => {
                if (!res.success) {
                    tailwindMessageModal('Gagal', res.message || 'Gagal memuat info kelas');
                    return;
                }
                const d = res.data;

                // IMPORTANT: Manually add the option if not already loaded, then select it
                const addOption = (selectId, value, text) => {
                    const $select = $(`#${selectId}`);
                    if (!$select.find(`option[value="${value}"]`).length) {
                        $select.append(new Option(text, value, true, true));
                    }
                    $select.val(value).trigger('change');
                };

                const academicYearText = formatAcademicYearLabel(d.start_date, d.end_date, d.semester) || d.academic_year_id;
                const teacherText = formatTeacherLabel(d.homeroom_teacher_name, d.homeroom_teacher_npk, d.homeroom_teacher_id);

                // For Academic Year
                addOption('academic_year_id', d.academic_year_id, academicYearText);

                // For Class
                addOption('class_id', d.class_id, `${d.class_name || d.class_id} (${d.class_level || ''})`);

                // For Homeroom Teacher
                addOption('homeroom_teacher_id', d.homeroom_teacher_id, teacherText);

                // Load students with assignment status
                $.get("/Class/GetStudentsWithAssignmentStatus", { academicClassId: acId }, stRes => {
                    if (!stRes.success) {
                        tailwindMessageModal('Gagal', stRes.message || 'Gagal memuat siswa');
                        return;
                    }
                    renderStudents(stRes.data || []);
                });
            });

            // Auto-select ACTIVE year if only one (fallback)
            $.ajax({
                url: '/Select2/AcademicYears',
                data: { page: 1 },
                success: function (data) {
                    if (data.results && data.results.length === 1) {
                        const activeYear = data.results[0];
                        $('#academic_year_id').append(new Option(activeYear.text, activeYear.id, true, true));
                        $('#academic_year_id').val(activeYear.id).trigger('change');
                    }
                }
            });
        });
    </script>
}
