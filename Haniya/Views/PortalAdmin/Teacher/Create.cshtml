@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Tambah Guru";
}

<h2 class="text-xl font-semibold mb-4">Tambah Guru</h2>

<div class="bg-white p-6 rounded-lg shadow w-full space-y-6">

    <form id="frm" enctype="multipart/form-data" class="space-y-6 w-full">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">

            <!-- TEACHER PERSONAL INFO -->
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full">
                <button type="button"
                        onclick="toggleSection('teacher-personal')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"
                        data-testid="teacher-personal-toggle">
                    <span class="font-semibold text-white">
                        Data Guru
                    </span>
                    <svg id="icon-teacher-personal"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div id="teacher-personal"
                     class="px-4 pb-4 pt-3 space-y-3 border-t border-gray-100"
                     data-testid="teacher-personal-section">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">
                                Nama Depan <span class="text-red-500">*</span>
                            </label>
                            <input id="first_name"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="teacher-first-name-input" />
                            <p id="error-first_name"
                               class="mt-1 text-xs text-red-600 hidden validation-error-message"
                               data-testid="teacher-error-first_name"></p>
                        </div>
                        <div>
                            <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">
                                Nama Belakang
                            </label>
                            <input id="last_name"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="teacher-last-name-input" />
                        </div>
                    </div>

                    <div>
                        <label for="npk" class="block text-sm font-medium text-gray-700 mb-1">
                            NPK <span class="text-red-500">*</span>
                        </label>
                        <input id="npk"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="teacher-npk-input" />
                        <p id="error-npk"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="teacher-error-npk"></p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label for="birth_date" class="block text-sm font-medium text-gray-700 mb-1">
                                Tanggal Lahir <span class="text-red-500">*</span>
                            </label>
                            <input type="date"
                                   id="birth_date"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="teacher-birth-date-input" />
                            <p id="error-birth_date"
                               class="mt-1 text-xs text-red-600 hidden validation-error-message"
                               data-testid="teacher-error-birth_date"></p>
                        </div>
                        <div>
                            <label for="birth_place" class="block text-sm font-medium text-gray-700 mb-1">
                                Tempat Lahir <span class="text-red-500">*</span>
                            </label>
                            <input id="birth_place"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="teacher-birth-place-input" />
                            <p id="error-birth_place"
                               class="mt-1 text-xs text-red-600 hidden validation-error-message"
                               data-testid="teacher-error-birth_place"></p>
                        </div>
                    </div>

                    <!-- GENDER DROPDOWN -->
                    <div>
                        <label for="gender" class="block text-sm font-medium text-gray-700 mb-1">
                            Jenis Kelamin <span class="text-red-500">*</span>
                        </label>

                        <select id="gender"
                                class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-testid="teacher-gender-select">
                        </select>

                        <p id="error-gender"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="teacher-error-gender"></p>
                    </div>

                    <div>
                        <label for="address" class="block text-sm font-medium text-gray-700 mb-1">
                            Alamat <span class="text-red-500">*</span>
                        </label>
                        <textarea id="address"
                                  class="w-full border border-gray-300 rounded-md p-2 min-h-[80px] resize-y focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                  data-testid="teacher-address-textarea"></textarea>
                        <p id="error-address"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="teacher-error-address"></p>
                    </div>

                    <div>
                        <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
                            Nomor Telepon <span class="text-red-500">*</span>
                        </label>
                        <input id="phone"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="teacher-phone-input" />
                        <p id="error-phone"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="teacher-error-phone"></p>
                    </div>
                </div>
            </div>

            <!-- EMPLOYMENT INFO -->
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full">
                <button type="button"
                        onclick="toggleSection('teacher-employment')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"
                        data-testid="teacher-employment-toggle">
                    <span class="font-semibold text-white">
                        Informasi Kepegawaian
                    </span>
                    <svg id="icon-teacher-employment"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div id="teacher-employment"
                     class="px-4 pb-4 pt-3 space-y-3 border-t border-gray-100"
                     data-testid="teacher-employment-section">
                    <div>
                        <label for="entry_date" class="block text-sm font-medium text-gray-700 mb-1">
                            Tanggal Masuk <span class="text-red-500">*</span>
                        </label>
                        <input type="date"
                               id="entry_date"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="teacher-entry-date-input" />
                        <p id="error-entry_date"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="teacher-error-entry_date"></p>
                    </div>

                    <!-- LEVEL DROPDOWN (Honorer / PNS) -->
                    <div>
                        <label for="level" class="block text-sm font-medium text-gray-700 mb-1">
                            Status Kepegawaian <span class="text-red-500">*</span>
                        </label>

                        <select id="level"
                                class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-testid="teacher-employment-select">
                        </select>

                        <p id="error-level"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="teacher-error-level"></p>
                    </div>

                    <!-- Photo -->
                    <div>
                        <label for="photo" class="block text-sm font-medium text-gray-700 mb-1">
                            Foto <span class="text-red-500">*</span>
                        </label>
                        <div class="flex items-center gap-3">
                            <label for="photo"
                                   class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
                                Pilih File
                            </label>
                            <span id="photo-filename"
                                  class="text-sm text-gray-600 truncate max-w-[200px]"
                                  data-testid="teacher-photo-filename">
                                Belum ada file yang dipilih
                            </span>
                            <input type="file"
                                   id="photo"
                                   class="hidden"
                                   accept="image/*"
                                   onchange="updatePhotoName()"
                                   data-testid="teacher-photo-input" />
                        </div>

                        <div class="mt-3">
                            <img id="photo-preview"
                                 src=""
                                 alt="Photo preview"
                                 class="hidden w-32 h-32 object-cover rounded-md border border-gray-300"
                                 data-testid="teacher-photo-preview" />
                        </div>

                        <p id="error-photo"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="teacher-error-photo"></p>
                    </div>

                    <div class="pt-4 flex items-center justify-end space-x-2">
                        <a id="teacher-back-link" href="/Teacher"
                           class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300"
                           data-testid="teacher-back-button">
                            <svg class="w-4 h-4 mr-2 text-gray-600"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M15 19l-7-7 7-7" />
                            </svg>
                            <span>Kembali</span>
                        </a>

                        <button type="button"
                                onclick="saveTeacher()"
                                class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
                                data-testid="teacher-save-button">
                            <span>Simpan</span>
                            <svg class="w-4 h-4 ml-2 text-white"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M5 13l4 4L19 7" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
    <script>
        const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Teacher';
        function toggleSection(id) {
            const section = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);

            if (!section || !icon) return;

            const isHidden = section.classList.contains('hidden');

            if (isHidden) {
                section.classList.remove('hidden');
                icon.classList.remove('-rotate-90');
            } else {
                section.classList.add('hidden');
                icon.classList.add('-rotate-90');
            }
        }

        function updatePhotoName() {
            const input = document.getElementById('photo');
            const labelSpan = document.getElementById('photo-filename');
            const preview = document.getElementById('photo-preview');

            if (!input || !labelSpan || !preview) return;

            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                labelSpan.textContent = file.name;

                const url = URL.createObjectURL(file);
                preview.src = url;
                preview.classList.remove('hidden');
            } else {
                labelSpan.textContent = 'No file chosen';
                preview.src = '';
                preview.classList.add('hidden');
            }
        }

        function showError($input, $error, message) {
            if (!$input.length || !$error.length) return;
            $input.removeClass('border-gray-300').addClass('border-red-500');
            $error.text(message).removeClass('hidden');
        }

        function clearError($input, $error) {
            if (!$input.length || !$error.length) return;
            $input.removeClass('border-red-500').addClass('border-gray-300');
            $error.text('').addClass('hidden');
        }

        function clearAllValidation() {
            const fields = [
                'first_name', 'npk', 'birth_date', 'birth_place',
                'gender', 'address', 'phone', 'entry_date',
                'level', 'photo'
            ];
            fields.forEach(function (id) {
                const $input = $('#' + id);
                const $error = $('#error-' + id);
                clearError($input, $error);
            });
        }

        function validateForm() {
            clearAllValidation();

            let isValid = true;

            const requiredFields = [
                { id: 'first_name', label: 'First Name' },
                { id: 'npk', label: 'NPK' },
                { id: 'birth_date', label: 'Birth Date' },
                { id: 'birth_place', label: 'Birth Place' },
                { id: 'gender', label: 'Gender' },
                { id: 'address', label: 'Address' },
                { id: 'phone', label: 'Phone' },
                { id: 'entry_date', label: 'Entry Date' },
                { id: 'level', label: 'Level' },
                { id: 'photo', label: 'Photo', type: 'file' }
            ];

            requiredFields.forEach(function (field) {
                const $input = $('#' + field.id);
                const $error = $('#error-' + field.id);

                if (!field.type || field.type !== 'file') {
                    const value = ($input.val() || '').toString().trim();
                    if (!value) {
                        isValid = false;
                        showError($input, $error, field.label + ' is required.');
                    } else {
                        clearError($input, $error);
                    }
                } else {
                    const inputEl = $input.get(0);
                    const hasFile = inputEl && inputEl.files && inputEl.files.length > 0;
                    if (!hasFile) {
                        isValid = false;
                        showError($input, $error, field.label + ' is required.');
                    } else {
                        clearError($input, $error);
                    }
                }
            });

            if (!isValid) {
                const $firstError = $('.validation-error-message:not(.hidden)').first();
                if ($firstError.length) {
                    $('html, body').animate({
                        scrollTop: $firstError.offset().top - 100
                    }, 400);
                }
            }

            return isValid;
        }

        $(document).ready(function () {
            $('#teacher-back-link').attr('href', returnUrl);
            // Gender Select2
            $('#gender').select2({
                placeholder: '-- Gender --',
                allowClear: true,
                ajax: {
                    url: '/Select2/Gender',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            q: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.results,
                            pagination: data.pagination
                        };
                    },
                    cache: true
                }
            }).on('change', function () {
                clearError($('#gender'), $('#error-gender'));
            });

            // Employment Select2
            $('#level').select2({
                placeholder: '-- Employment --',
                allowClear: true,
                ajax: {
                    url: '/Select2/Employment',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            q: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.results,
                            pagination: data.pagination
                        };
                    },
                    cache: true
                }
            }).on('change', function () {
                clearError($('#level'), $('#error-level'));
            });
        });

        async function saveTeacher() {
            if (!validateForm()) {
                return;
            }
            const confirmed = await tailwindConfirmModal({
                title: 'Create Confirmation',
                message: 'Are you sure you want to create this data?',
                confirmText: 'Create',
                cancelText: 'Cancel'
            });
            if (!confirmed) return;

            let fd = new FormData();

            $("#frm").find("input,select,textarea").each(function () {
                if (this.type !== "file") {
                    fd.append(this.id, $(this).val());
                }
            });

            const photoInput = document.getElementById("photo");
            if (photoInput && photoInput.files[0]) {
                fd.append("profile_photo", photoInput.files[0]);
            }

            $.ajax({
                url: "/Teacher/Create",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: async res => {
                    if (res.success) {
                        await tailwindMessageModal('Success', res.message || 'Teacher created successfully.');
                        window.location.href = returnUrl;
                    } else {
                        await tailwindMessageModal('Failed', res.message || 'Failed to create teacher');
                    }
                },
                error: async () => await tailwindMessageModal('Error', 'An error occurred while creating teacher data.')
            });
        }
    </script>
}
