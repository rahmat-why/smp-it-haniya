@using System.Collections.Generic
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Edit Article";
    var id = ViewBag.articleId;
}

<input type="hidden" id="article_id" name="article_id" value="@id">

<h2 class="text-xl font-semibold mb-4">Edit Article</h2>
<div class="bg-white p-6 rounded-lg shadow w-full space-y-6">
    <form id="frm" enctype="multipart/form-data" class="space-y-6 w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full"><button type="button" onclick="toggleSection('article-info')" class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"><span class="font-semibold text-white">Article Information</span><svg id="icon-article-info" class="w-5 h-5 text-white transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></button><div id="article-info" class="px-4 pb-4 pt-3 space-y-4 border-t border-gray-100"><div><label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title <span class="text-red-500">*</span></label><input id="title" class="w-full border border-gray-300 rounded-md p-2" /><p id="error-title" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div><label for="image" class="block text-sm font-medium text-gray-700 mb-1">Image <span class="text-red-500">*</span></label><div class="flex items-center gap-3"><label for="image" class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md cursor-pointer shadow-sm">Choose File</label><span id="image-filename" class="text-sm text-gray-600 truncate max-w-[200px]">No new file chosen</span><input type="file" id="image" class="hidden" accept="image/*" onchange="updateImageName()" /></div><div class="mt-3"><img id="image-preview" src="" alt="Image preview" class="w-32 h-32 object-cover rounded-md border border-gray-300" /></div><p id="error-image" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div></div></div>
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full"><button type="button" onclick="toggleSection('article-extra')" class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"><span class="font-semibold text-white">Content & Tags</span><svg id="icon-article-extra" class="w-5 h-5 text-white transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></button><div id="article-extra" class="px-4 pb-4 pt-3 space-y-4 border-t border-gray-100"><div><label for="content" class="block text-sm font-medium text-gray-700 mb-1">Content <span class="text-red-500">*</span></label><textarea id="content" class="w-full border border-gray-300 rounded-md p-2 min-h-[200px] resize-y"></textarea><p id="error-content" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div><label for="tags" class="block text-sm font-medium text-gray-700 mb-1">Tags <span class="text-red-500">*</span></label><select id="tags" class="w-full border border-gray-300 rounded-md" multiple="multiple"></select><p id="error-tags" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div class="pt-4 flex items-center justify-end space-x-2"><button type="button" onclick="goBack()" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm">Back</button><button type="button" onclick="updateArticle()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm">Update</button></div></div></div>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Article';
function toggleSection(id){const s=document.getElementById(id);const i=document.getElementById('icon-'+id);if(!s||!i)return;const h=s.classList.contains('hidden');if(h){s.classList.remove('hidden');i.classList.remove('-rotate-90');}else{s.classList.add('hidden');i.classList.add('-rotate-90');}}
function showError($i,$e,m){if(!$e.length)return;if($i&&$i.length)$i.removeClass('border-gray-300').addClass('border-red-500');$e.text(m).removeClass('hidden');}
function clearError($i,$e){if($i&&$i.length)$i.removeClass('border-red-500').addClass('border-gray-300');$e.text('').addClass('hidden');}
function clearAllValidation(){clearError($('#title'),$('#error-title'));clearError($('#content'),$('#error-content'));clearError($('#tags'),$('#error-tags'));clearError($('#image'),$('#error-image'));}
function updateImageName(){const input=document.getElementById('image');const label=document.getElementById('image-filename');const preview=document.getElementById('image-preview');if(!input||!label||!preview)return;if(input.files&&input.files.length>0){const file=input.files[0];label.textContent=file.name;preview.src=URL.createObjectURL(file);clearError($('#image'),$('#error-image'));}else{label.textContent='No new file chosen';}}
function validateForm(){clearAllValidation();let ok=true;const title=($('#title').val()||'').trim();const content=($('#content').val()||'').trim();const tags=$('#tags').val()||[];const imageInput=document.getElementById('image');const hasNewImage=imageInput&&imageInput.files&&imageInput.files.length>0;const hasExistingImage=$('#image-preview').attr('src')&&$('#image-preview').attr('src')!=='';if(!title){ok=false;showError($('#title'),$('#error-title'),'Title is required.');}if(!content){ok=false;showError($('#content'),$('#error-content'),'Content is required.');}if(tags.length===0){ok=false;showError($('#tags'),$('#error-tags'),'At least one tag is required.');}if(!hasNewImage&&!hasExistingImage){ok=false;showError($('#image'),$('#error-image'),'Image is required.');}return ok;}
function goBack(){window.location.href=returnUrl;}
async function updateArticle(){if(!validateForm())return;const yes=await tailwindConfirmModal({title:'Update Confirmation',message:'Are you sure you want to update this data?',confirmText:'Update',cancelText:'Cancel'});if(!yes)return;const fd=new FormData();fd.append('article_id',$('#article_id').val());$('#frm').find('input,textarea,select').each(function(){if(this.type!=='file'){if(this.id==='tags')fd.append(this.id,($(this).val()||[]).join(','));else fd.append(this.id,$(this).val());}});const imageInput=document.getElementById('image');if(imageInput&&imageInput.files&&imageInput.files[0])fd.append('image',imageInput.files[0]);$.ajax({url:'/Article/Update',type:'POST',data:fd,processData:false,contentType:false,success:async res=>{if(res.success){await tailwindMessageModal('Success',res.message||'Article updated successfully.');window.location.href=returnUrl;}else await tailwindMessageModal('Failed',res.message||'Failed to update article');},error:async()=>await tailwindMessageModal('Error','An error occurred while updating the article.')});}
function loadArticle(){const id=$('#article_id').val();if(!id)return;$.ajax({url:'/Article/GetById',type:'GET',data:{id:id},dataType:'json',success:async function(res){if(!res.success){await tailwindMessageModal('Failed',res.message||'Failed to load article');return;}const d=res.data;$('#title').val(d.title||'');$('#content').val(d.content||'');if(d.image){$('#image-preview').attr('src',d.image+'?t='+new Date().getTime()).removeClass('hidden');const parts=d.image.split('/');$('#image-filename').text('Current: '+parts[parts.length-1]);}if(Array.isArray(d.tags)&&d.tags.length>0){const $s=$('#tags');$s.empty();d.tags.forEach(code=>$s.append(new Option(code,code,true,true)));$s.trigger('change');}},error:async function(){await tailwindMessageModal('Error','An error occurred while loading the article.');}});}
$(document).ready(function(){$('#tags').select2({placeholder:'-- Select Tags --',allowClear:true,multiple:true,ajax:{url:'/Select2/TagsArticle',dataType:'json',delay:250,data:p=>({q:p.term||'',page:p.page||1}),processResults:(d,p)=>({results:d.results,pagination:d.pagination}),cache:true},minimumInputLength:0}).on('change',function(){clearError($('#tags'),$('#error-tags'));});loadArticle();});
</script>
}
