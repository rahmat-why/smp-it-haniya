@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Articles";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Article List</h2>
    <a href="/Article/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
       data-testid="article-add-button">
        + Add Article
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <!-- Toolbar & search -->
    <div class="px-4 pt-4">
        <div id="article-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <!-- DataTables akan inject length & search di sini -->
        </div>
    </div>

    <div class="overflow-x-auto px-4 pt-4">
        <table id="article-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 120px;">Image</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Title</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Slug</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 120px;">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Content Preview</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Tags</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 160px;">Created</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <!-- Info + pagination -->
    <div class="px-4 pb-4 pt-3">
        <div id="article-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            initArticleTable();

            // Close menu when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.article-actions-wrapper').length) {
                    $('.article-actions-menu').addClass('hidden');
                }
            });
        });

        function initArticleTable() {
            const table = $('#article-table').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                lengthChange: true,
                ajax: {
                    url: '/Article/GetAll',
                    type: 'GET'
                },
                dom: 'lftip',
                language: {
                    lengthMenu: "Show _MENU_ rows",
                    search: "",
                    searchPlaceholder: "Search...",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                },
                columns: [
                    {
                        data: 'image',
                        className: 'py-3',
                        render: function (data) {
                            var src = data || '/image/no-image.png';
                            return `
                                        <img src="${src}"
                                             class="w-16 h-16 rounded object-cover border border-gray-200 shadow-sm"
                                             alt="Article Image">
                                    `;
                        }
                    },
                    {
                        data: 'title',
                        className: 'py-3 font-medium text-gray-900'
                    },
                    {
                        data: 'slug',
                        className: 'py-3 text-gray-600'
                    },
                    {
                        data: 'status',
                        className: 'py-3 text-center',
                        render: function (data) {
                            var badgeClass = data === 'Published' ? 'bg-green-100 text-green-800' :
                                data === 'Draft' ? 'bg-yellow-100 text-yellow-800' :
                                    'bg-gray-100 text-gray-800';
                            return `<span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full ${badgeClass}">${data || '-'}</span>`;
                        }
                    },
                    {
                        data: 'content',
                        className: 'py-3 text-gray-600',
                        render: function (data) {
                            if (!data) return '-';
                            var preview = data.length > 200 ? data.substring(0, 197) + '...' : data;
                            return `<div class="line-clamp-2" title="${data.replace(/"/g, '&quot;')}">${preview}</div>`;
                        }
                    },
                    {
                        data: 'tags',
                        className: 'py-3',
                        render: function (data) {
                            if (!data || data.trim() === '') return '-';

                            var tagsArray = data.split(',').map(t => t.trim());
                            var badges = tagsArray.map(tag => {
                                return `<span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800 mr-1 mb-1">${tag}</span>`;
                            });

                            return `<div class="flex flex-wrap gap-1">${badges.join('')}</div>`;
                        }
                    },
                    {
                        data: 'created_at',
                        className: 'py-3',
                        render: function (data) {
                            if (!data) return '-';
                            var date = new Date(data);
                            return date.toLocaleString('id-ID', {
                                year: 'numeric',
                                month: 'short',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            });
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-center py-3',
                        render: function (data, type, row) {
                            var id = row.article_id;
                            var editUrl = '/Article/Edit?id=' + id;
                            return `
                                        <div class="flex justify-center article-actions-wrapper relative">
                                            <button type="button"
                                                    onclick="toggleActionsMenu(event, '${id}')"
                                                    class="p-1.5 hover:bg-gray-100 rounded-md transition-colors duration-150"
                                                    data-testid="article-actions-toggle-${id}">
                                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                                </svg>
                                            </button>
                                            <div id="actions-menu-${id}" class="article-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">
                                                <a href="${editUrl}"
                                                   class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50"
                                                   data-testid="article-edit-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    Edit
                                                </a>
                                                <button type="button"
                                                        onclick="delArticle('${id}')"
                                                        class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100"
                                                        data-testid="article-delete-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    const wrapper = $('#article-table_wrapper');
                    const $length = wrapper.find('.dataTables_length, .dt-length');
                    const $filter = wrapper.find('.dataTables_filter, .dt-search');
                    $('#article-table-toolbar').empty().append($length).append($filter);

                    $length.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $length.find('label').addClass('flex items-center gap-2');
                    $length.find('select').addClass(
                        'border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 ' +
                        'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                    );

                    $filter.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $filter.find('label').addClass('flex items-center gap-2');
                    const $searchInput = $filter.find('input');
                    $searchInput
                        .addClass(
                            'border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white text-gray-700 ' +
                            'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full md:w-64'
                        )
                        .attr('placeholder', 'Search...');
                    $filter.addClass('w-full md:w-auto justify-end');

                    stylePagination();
                },
                drawCallback: function () {
                    setTimeout(stylePagination, 50);
                }
            });
        }

        function stylePagination() {
            const wrapper = $('#article-table_wrapper');
            let $info = wrapper.find('.dataTables_info').first();
            if ($info.length === 0) $info = wrapper.find('.dt-info').first();

            let $paginate = wrapper.find('.dataTables_paginate').first();
            if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

            if ($info.length > 0) {
                $('#table-info-container').empty().append($info);
                $info.removeClass().addClass('text-sm text-gray-600');
            }

            if ($paginate.length > 0) {
                $('#table-pagination-container').empty().append($paginate);
            }

            $('#table-pagination-container').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
            if (typeof applyAdminPaginationStyle === 'function') {
                applyAdminPaginationStyle($('#table-pagination-container'));
            }
        }

        function toggleActionsMenu(event, id) {
            event.stopPropagation();
            $('.article-actions-menu').addClass('hidden');
            const menu = $('#actions-menu-' + id);
            menu.toggleClass('hidden');
        }

        function delArticle(id) {
            $('.article-actions-menu').addClass('hidden');
            if (!confirm("Delete this article?")) return;

            $.ajax({
                url: "/Article/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    action: "delete",
                    id: id,
                    data: null
                }),
                success: res => {
                    if (res.success) {
                        $('#article-table').DataTable().ajax.reload(null, false);
                    } else {
                        alert(res.message || "Failed to delete article");
                    }
                },
                error: function () {
                    alert("An error occurred while deleting the article.");
                }
            });
        }
    </script>
}
