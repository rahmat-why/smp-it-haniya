<!-- ~/Views/PortalAdmin/Schedule/Create.cshtml -->
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Create Schedule";
}

<h2 class="text-2xl font-bold text-gray-800 mb-6">Create Schedule</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="scheduleForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="academic_class_id" class="block text-sm font-medium text-gray-700 mb-2">
                    Academic Class <span class="text-red-600">*</span>
                </label>
                <select id="academic_class_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Academic Class --" required></select>
                <p id="error-class" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="day" class="block text-sm font-medium text-gray-700 mb-2">
                    Day <span class="text-red-600">*</span>
                </label>
                <select id="day" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Day --" required></select>
                <p id="error-day" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>
        </div>

        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-semibold text-gray-800">Schedule Details</h3>
                <button type="button" onclick="addDetailRow()"
                        class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md">
                    + Add Row
                </button>
            </div>

            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[500px] shadow-inner">
                <table class="min-w-full divide-y divide-gray-200 table-fixed">
                    <thead class="bg-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Subject</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Teacher</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-2/12">Start Time</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-2/12">End Time</th>
                            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-700">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-details"></tbody>
                </table>
            </div>
            <p id="error-details" class="text-sm text-red-600 hidden"></p>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <button type="button" onclick="goBackSchedule()" class="px-6 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-lg font-medium transition">Back</button>
            <button type="button" onclick="saveSchedule()" class="px-6 py-2.5 bg-blue-700 hover:bg-blue-800 text-white rounded-lg font-medium transition">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function addDetailRow() {
            const row = `
                        <tr class="hover:bg-gray-50 border-b last:border-0">
                            <td class="px-4 py-3">
                                <select class="subject-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" data-placeholder="-- Select Subject --"></select>
                            </td>
                            <td class="px-4 py-3">
                                <select class="teacher-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" data-placeholder="-- Select Teacher --"></select>
                            </td>
                            <td class="px-4 py-3">
                                <input type="time" class="start-time w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" />
                            </td>
                            <td class="px-4 py-3">
                                <input type="time" class="end-time w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" />
                            </td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" onclick="removeRow(this)" class="px-4 py-1.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-md">Remove</button>
                            </td>
                        </tr>`;
            $('#tbody-details').append(row);

            const $newRow = $('#tbody-details tr:last');
            $newRow.find('.subject-select').select2({
                placeholder: "-- Select Subject --",
                allowClear: true,
                ajax: {
                    url: '/Select2/Subjects',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            $newRow.find('.teacher-select').select2({
                placeholder: "-- Select Teacher --",
                allowClear: true,
                ajax: {
                    url: '/Select2/Teachers',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
        }

        function collectDetails() {
            const details = [];
            $('#tbody-details tr').each(function () {
                const $row = $(this);
                const subject_id = $row.find('.subject-select').val()?.trim() || '';
                const teacher_id = $row.find('.teacher-select').val()?.trim() || '';
                const start_time = $row.find('.start-time').val()?.trim() || '';
                const end_time = $row.find('.end-time').val()?.trim() || '';

                if (subject_id || teacher_id || start_time || end_time) {
                    details.push({ subject_id, teacher_id, start_time, end_time });
                }
            });
            return details;
        }

        function validateForm() {
            $('.text-red-600').addClass('hidden');
            let valid = true;

            if (!$('#academic_class_id').val()) {
                $('#error-class').removeClass('hidden');
                valid = false;
            }
            if (!$('#day').val()) {
                $('#error-day').removeClass('hidden');
                valid = false;
            }

            const details = collectDetails();
            if (details.length === 0) {
                $('#error-details').text('At least one detail row is required').removeClass('hidden');
                valid = false;
            } else {
                let allComplete = true;
                details.forEach(d => {
                    if (!d.subject_id || !d.teacher_id || !d.start_time || !d.end_time) allComplete = false;
                });
                if (!allComplete) {
                    $('#error-details').text('All fields in each row are required').removeClass('hidden');
                    valid = false;
                }
            }

            return valid;
        }

        function goBackSchedule() {
            window.location.href = "/Schedule";
        }

        function saveSchedule() {
            if (!validateForm()) return;

            const fd = new FormData();
            fd.append("academic_class_id", $('#academic_class_id').val());
            fd.append("day", $('#day').val());
            fd.append("details", JSON.stringify(collectDetails()));

            $.ajax({
                url: "/Schedule/Create",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: res => res.success ? location.href = "/Schedule" : alert(res.message || "Save failed"),
                error: () => alert("Error saving schedule")
            });
        }

        $(document).ready(function () {
            $('#academic_class_id').select2({
                placeholder: "-- Select Academic Class --",
                allowClear: false,
                ajax: {
                    url: '/Select2/AcademicClasses',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            // Day called from Select2 /Select2/Days
            $('#day').select2({
                placeholder: "-- Select Day --",
                allowClear: false,
                ajax: {
                    url: '/Select2/Days',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            addDetailRow(); // Start with one empty row
        });
    </script>
}