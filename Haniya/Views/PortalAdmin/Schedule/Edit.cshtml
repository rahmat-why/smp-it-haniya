<!-- ~/Views/PortalAdmin/Schedule/Edit.cshtml -->
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Ubah Jadwal";
}

<input type="hidden" id="schedule_id" value="@ViewBag.scheduleId">
<input type="hidden" id="academic_class_id">

<h2 class="text-2xl font-bold text-gray-800 mb-6">Ubah Jadwal</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="scheduleForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Kelas <span class="text-red-600">*</span>
                </label>
                <div id="class_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-- Loading --</div>
            </div>

            <div>
                <label for="day" class="block text-sm font-medium text-gray-700 mb-2">
                    Hari <span class="text-red-600">*</span>
                </label>
                <select id="day" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Pilih Hari --" required></select>
                <p id="error-day" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>
        </div>

        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-semibold text-gray-800">Detail Jadwal</h3>
                <button type="button" onclick="addDetailRow()"
                        class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md">
                    + Tambah Mapel
                </button>
            </div>

            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[500px] shadow-inner">
                <table class="min-w-full divide-y divide-gray-200 table-fixed">
                    <thead class="bg-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Mata Pelajaran</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Guru</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-2/12">Jam Mulai</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-2/12">Jam Selesai</th>
                            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-700">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-details"></tbody>
                </table>
            </div>
            <p id="error-details" class="text-sm text-red-600 hidden"></p>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <button type="button" onclick="goBackSchedule()" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Kembali
            </button>
            <button type="button" onclick="updateSchedule()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
                Ubah
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
    <script>
        let preloadedDay = null;
        const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Schedule';

        function addDetailRow(prefill = {}) {
            const row = `
                        <tr class="hover:bg-gray-50 border-b last:border-0">
                            <td class="px-4 py-3">
                                <select class="subject-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" data-placeholder="-- Pilih Mapel --"></select>
                            </td>
                            <td class="px-4 py-3">
                                <select class="teacher-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" data-placeholder="-- Pilih Guru --"></select>
                            </td>
                            <td class="px-4 py-3">
                                <input type="time" class="start-time w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" value="${prefill.start_time || ''}" />
                            </td>
                            <td class="px-4 py-3">
                                <input type="time" class="end-time w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" value="${prefill.end_time || ''}" />
                            </td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" onclick="removeRow(this)" class="inline-flex items-center justify-center p-2 bg-red-600 hover:bg-red-700 text-white rounded-md" aria-label="Remove row" title="Remove row">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </td>
                        </tr>`;
            $('#tbody-details').append(row);

            const $newRow = $('#tbody-details tr:last');
            const $subject = $newRow.find('.subject-select');
            const $teacher = $newRow.find('.teacher-select');

            $subject.select2({
                placeholder: "-- Pilih Mapel --",
                allowClear: true,
                width: '100%',
                ajax: {
                    url: '/Select2/Subjects',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            $teacher.select2({
                placeholder: "-- Pilih Guru --",
                allowClear: true,
                width: '100%',
                ajax: {
                    url: '/Select2/Teachers',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            if (prefill.subject_id && prefill.subject_name) {
                $subject.append(new Option(prefill.subject_name, prefill.subject_id, true, true)).trigger('change');
            }
            if (prefill.teacher_id && prefill.teacher_name) {
                $teacher.append(new Option(prefill.teacher_name, prefill.teacher_id, true, true)).trigger('change');
            }
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
        }

        function collectDetails() {
            const details = [];
            $('#tbody-details tr').each(function () {
                const $row = $(this);
                const subject_id = $row.find('.subject-select').val()?.trim() || '';
                const teacher_id = $row.find('.teacher-select').val()?.trim() || '';
                const start_time = $row.find('.start-time').val()?.trim() || '';
                const end_time = $row.find('.end-time').val()?.trim() || '';

                if (subject_id || teacher_id || start_time || end_time) {
                    details.push({ subject_id, teacher_id, start_time, end_time });
                }
            });
            return details;
        }

        function validateForm() {
            $('.text-red-600').addClass('hidden');
            let valid = true;

            if (!$('#day').val()) {
                $('#error-day').removeClass('hidden');
                valid = false;
            }

            const details = collectDetails();
            if (details.length === 0) {
                $('#error-details').text('At least one detail row is required').removeClass('hidden');
                valid = false;
            } else {
                let allComplete = true;
                details.forEach(d => {
                    if (!d.subject_id || !d.teacher_id || !d.start_time || !d.end_time) allComplete = false;
                });
                if (!allComplete) {
                    $('#error-details').text('All fields in each row are required').removeClass('hidden');
                    valid = false;
                }
            }

            return valid;
        }

        function goBackSchedule() {
            window.location.href = returnUrl;
        }

        async function updateSchedule() {
            if (!validateForm()) {
                await tailwindMessageModal('Validation Error', 'Please complete all required fields.');
                return;
            }

            const yes = await tailwindConfirmModal({
                title: 'Update Confirmation',
                message: 'Are you sure you want to update this data?',
                confirmText: 'Save',
                cancelText: 'Cancel'
            });
            if (!yes) return;

            const fd = new FormData();
            fd.append("schedule_id", $('#schedule_id').val());
            fd.append("academic_class_id", $('#academic_class_id').val());
            fd.append("day", $('#day').val());
            fd.append("details", JSON.stringify(collectDetails()));

            $.ajax({
                url: "/Schedule/Update",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: async res => {
                    if (res.success) {
                        await tailwindMessageModal('Success', res.message || 'Schedule updated successfully.');
                        location.href = returnUrl;
                    } else {
                        await tailwindMessageModal('Failed', res.message || 'Update failed');
                    }
                },
                error: async () => await tailwindMessageModal('Error', 'Error updating schedule')
            });
        }

        function loadSchedule() {
            const id = $('#schedule_id').val().trim();
            if (!id) {
                tailwindMessageModal('Error', "Invalid schedule ID");
                return;
            }

            $.ajax({
                url: `/Schedule/GetById?id=${id}`,
                type: 'GET',
                dataType: 'json',
                success: res => {
                    if (!res.success) {
                        tailwindMessageModal('Failed', res.message || "Failed to load schedule");
                        return;
                    }
                    const d = res.data;

                    $('#academic_class_id').val(d.academic_class_id);
                    const classText = (d.class_name || '--').replace(/\s*\(\d+\)\s*$/, '').trim();
                    $('#class_display').text(classText || '--');

                    // Preload selected day with description
                    preloadedDay = { id: d.day, text: d.day_desc || d.day };
                    $('#day').append(new Option(preloadedDay.text, preloadedDay.id, true, true)).trigger('change');

                    $('#tbody-details').empty();
                    if (d.details && d.details.length > 0) {
                        d.details.forEach(detail => {
                            addDetailRow({
                                subject_id: detail.subject_id,
                                subject_name: detail.subject_name,
                                teacher_id: detail.teacher_id,
                                teacher_name: detail.teacher_name,
                                start_time: detail.start_time,
                                end_time: detail.end_time
                            });
                        });
                    } else {
                        addDetailRow();
                    }
                },
                error: () => tailwindMessageModal('Error', "Error loading schedule data")
            });
        }

        $(document).ready(function () {
            // Day called from Select2 /Select2/Days with preload support
            $('#day').select2({
                placeholder: "-- Select Day --",
                allowClear: false,
                width: '100%',
                ajax: {
                    url: '/Select2/Days',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            // Ensure preloaded day is available when searching
            $('#day').on('select2:open', () => {
                if (preloadedDay) {
                    const $select = $('#day');
                    if ($select.find(`option[value="${preloadedDay.id}"]`).length === 0) {
                        $select.append(new Option(preloadedDay.text, preloadedDay.id));
                    }
                }
            });

            loadSchedule();
        });
    </script>
}
