@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutAdmin";
}

<div class="max-w-7xl mx-auto space-y-10 py-8 px-4" id="admin-dashboard">
    <div>
        <h1 class="text-3xl font-bold text-indigo-900">Admin Dashboard</h1>
        <p class="text-gray-600 mt-2">Welcome back, @User.FindFirst("FullName")?.Value</p>
    </div>

    <div id="loading" class="text-center py-20">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-4 border-indigo-600"></div>
        <p class="mt-4 text-gray-600">Loading...</p>
    </div>

    <div id="content" class="space-y-10">
        <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100" id="summaryContainer"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-3xl font-bold text-indigo-900 mb-8">Upcoming Events</h2>
                <div id="events-list" class="space-y-6"></div>
                <div class="flex items-center justify-between mt-6">
                    <span id="events-info" class="text-sm text-gray-600"></span>
                    <div id="events-pagination" class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden"></div>
                </div>
            </div>

            <!-- Articles -->
            <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-3xl font-bold text-indigo-900 mb-8">Latest Articles</h2>
                <div id="articles-list" class="space-y-6"></div>
                <div class="flex items-center justify-between mt-6">
                    <span id="articles-info" class="text-sm text-gray-600"></span>
                    <div id="articles-pagination" class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let allEvents = [];
    let allArticles = [];
    const itemsPerPage = 3; 

    $(document).ready(function () {
        loadAdminDashboard();
    });

    function loadAdminDashboard(academicYear) {
        $.ajax({
            url: '/Dashboard/GetAdminData',
            type: 'GET',
            data: { academicYear: academicYear },
            success: function (res) {
                if (!res.success) {
                    alert(res.message);
                    return;
                }

                const d = res.data;

                $('#summaryContainer').html(
                    `   
                        <h2 class="text-3xl font-bold text-indigo-900 mb-8">
                            Summary
                        </h2>
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                            <!-- LEFT SECTION -->
                            <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-6">

                                <!-- TOTAL BILL -->
                                <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-2xl p-5 sm:p-6 text-center">
                                    <p class="text-sm sm:text-base font-medium text-indigo-700">
                                        Total Bill
                                    </p>
                                    <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-indigo-900 mt-2">
                                        ${formatRupiah(d.payment.totalPembayaranMasuk ?? 0)}
                                    </p>
                                    <p class="text-xs sm:text-sm text-indigo-700 mt-2">
                                        Students: ${d.studentPayment.totalSiswa ?? '-'}
                                    </p>
                                </div>

                                <!-- LUNAS -->
                                <div class="bg-gradient-to-br from-cyan-50 to-cyan-100 rounded-2xl p-5 sm:p-6 text-center">
                                    <p class="text-sm sm:text-base font-medium font-medium text-cyan-700">
                                        Total Payment
                                    </p>
                                    <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-cyan-900 mt-2">
                                        ${formatRupiah(d.payment.totalLunas ?? 0)}
                                    </p>
                                    <p class="text-xs sm:text-sm text-cyan-700 mt-2">
                                        ${d.studentPayment.totalLunas ?? '-'}/${d.studentPayment.totalSiswa ?? '-'}
                                    </p>
                                </div>

                                <!-- BELUM LUNAS -->
                                <div class="bg-gradient-to-br from-cyan-50 to-red-100 rounded-2xl p-5 sm:p-6 text-center sm:col-span-2">
                                    <p class="text-sm sm:text-base font-medium font-medium text-red-700">Total Unpaid</p>
                                    <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-red-900 mt-2">
                                        ${formatRupiah(d.payment.totalBelumLunas ?? 0)}
                                    </p>
                                    <p class="text-xs sm:text-sm text-red-700 mt-2">
                                        ${d.studentPayment.totalBelumLunas ?? '-'}/${d.studentPayment.totalSiswa ?? '-'}
                                    </p>
                                </div>

                            </div>

                            <!-- RIGHT SECTION -->
                            <div class="space-y-6">

                                <!-- FILTER -->
                                <div class="bg-white rounded-2xl p-4 border border-gray-200 shadow-sm">
                                    <label class="block text-sm font-medium mb-2 text-gray-700">
                                        School Year
                                    </label>
                                    <select id="academic_year_filter"
                                            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500">
                                    </select>
                                </div>

                                <!-- CHARTS -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div class="bg-blue-50 rounded-2xl p-4">
                                        <h3 class="text-sm font-semibold text-blue-900 mb-2 text-center">Teachers</h3>
                                        <div class="relative h-32 sm:h-40">
                                            <canvas id="teacherChart"></canvas>
                                        </div>
                                    </div>

                                    <div class="bg-green-50 rounded-2xl p-4">
                                        <h3 class="text-sm font-semibold text-green-900 mb-2 text-center">Students</h3>
                                        <div class="relative h-32 sm:h-40">
                                            <canvas id="studentChart"></canvas>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    `
                );

                const $select = $('#academic_year_filter');

                d.academicYearList.forEach(item => {
                    $select.append(`<option value="${item.value}">${item.text}</option>`);
                });

                const usedYear = d.academicYearUsed;

                $select.val(usedYear);

                $select.on('change', function () {
                    loadAdminDashboard($(this).val());
                });

                initDashboardCharts(d.students, d.teachers);

                allEvents = d.events || [];
                allArticles = d.articles || [];
                
                renderEvents(1);
                renderArticles(1);

                $('#loading').addClass('hidden');
                $('#content').removeClass('hidden');
            },
            error: function () {
                Swal.fire(
                    'Error!',
                    'Gagal memuat data.',
                    'error'
                );
            }
        });
    }

    function renderEvents(page) {
        const startIndex = (page - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const pageEvents = allEvents.slice(startIndex, endIndex);
        const totalPages = Math.ceil(allEvents.length / itemsPerPage);

        let eventsHtml = '';
        pageEvents.forEach(e => {
            let tagHtml = '';
            (e.tags || []).forEach(tag => {
                tagHtml += `<span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-xs font-medium">${tag}</span>`;
            });
            eventsHtml += `
                <div class="flex gap-6 hover:bg-gray-50 p-6 rounded-2xl transition">
                    <div class="w-24 h-24 bg-gradient-to-br from-purple-200 to-indigo-200 rounded-2xl flex-shrink-0 bg-cover bg-center" style="background-image: url('${e.photo || ''}')"></div>
                    <div class="flex-1">
                        <p class="text-xl font-semibold text-indigo-900">${e.name || ''}</p>
                        <p class="text-gray-600 mt-1">${e.date || ''} • ${e.location || ''}</p>
                        <p class="text-gray-500 mt-2">${e.desc || ''}</p>
                        <div class="flex flex-wrap gap-2 mt-3">${tagHtml}</div>
                    </div>
                </div>`;
        });

        $('#events-list').html(eventsHtml);
        $('#events-info').text(`Showing ${startIndex + 1} to ${Math.min(endIndex, allEvents.length)} of ${allEvents.length} events`);

        let paginationHtml = '';
        for (let i = 1; i <= totalPages; i++) {
            paginationHtml += `
                <button onclick="renderEvents(${i})" 
                    class="px-3 py-2 text-sm font-medium border-r border-gray-300 last:border-r-0 min-w-[40px] transition-colors duration-150
                    ${i === page 
                        ? 'bg-indigo-900 text-white cursor-default' 
                        : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-indigo-900 cursor-pointer'}">
                    ${i}
                </button>`;
        }
        $('#events-pagination').html(paginationHtml);
    }

    function formatRupiah(value) {
        return 'Rp ' + new Intl.NumberFormat('id-ID', {
            minimumFractionDigits: 0
        }).format(value || 0);
    }


    function renderArticles(page) {
        const startIndex = (page - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const pageArticles = allArticles.slice(startIndex, endIndex);
        const totalPages = Math.ceil(allArticles.length / itemsPerPage);

        let articlesHtml = '';
        pageArticles.forEach(a => {
            let tagHtml = '';
            (a.tags || []).forEach(tag => {
                tagHtml += `<span class="px-3 py-1 bg-rose-100 text-rose-800 rounded-full text-xs font-medium">${tag}</span>`;
            });
            articlesHtml += `
                <div class="flex gap-6 hover:bg-gray-50 p-6 rounded-2xl transition">
                    <div class="w-32 h-32 bg-gradient-to-br from-rose-200 to-pink-200 rounded-2xl flex-shrink-0 bg-cover bg-center" style="background-image: url('${a.image || ''}')"></div>
                    <div class="flex-1">
                        <p class="text-xl font-semibold text-indigo-900">${a.title || ''}</p>
                        <p class="text-gray-500 mt-1">${a.date || ''}</p>
                        <p class="text-gray-600 mt-2 line-clamp-3">${a.content || ''}</p>
                        <div class="flex flex-wrap gap-2 mt-3">${tagHtml}</div>
                    </div>
                </div>`;
        });

        $('#articles-list').html(articlesHtml);
        $('#articles-info').text(`Showing ${startIndex + 1} to ${Math.min(endIndex, allArticles.length)} of ${allArticles.length} articles`);

        let paginationHtml = '';
        for (let i = 1; i <= totalPages; i++) {
            paginationHtml += `
                <button onclick="renderArticles(${i})" 
                    class="px-3 py-2 text-sm font-medium border-r border-gray-300 last:border-r-0 min-w-[40px] transition-colors duration-150
                    ${i === page 
                        ? 'bg-indigo-900 text-white cursor-default' 
                        : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-indigo-900 cursor-pointer'}">
                    ${i}
                </button>`;
        }
        $('#articles-pagination').html(paginationHtml);
    }

    function initDashboardCharts(students, teachers) {
        // Teacher Donut Chart
        const teacherCtx = document.getElementById('teacherChart');
        if (teacherCtx) {
            new Chart(teacherCtx.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['PNS', 'Honorer'],
                    datasets: [{
                        data: [teachers?.pns ?? 0, teachers?.honorer ?? 0],
                        backgroundColor: ['#3b82f6', '#f97316'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { display: true },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed;
                                }
                            }
                        }
                    }
                }
            });
        }

        // Student Donut Chart
        const studentCtx = document.getElementById('studentChart');
        if (studentCtx) {
            new Chart(studentCtx.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Class 7', 'Class 8', 'Class 9'],
                    datasets: [{
                        data: [
                            students[0]?.totalStudents ?? 0, 
                            students[1]?.totalStudents ?? 0,
                            students[2]?.totalStudents ?? 0,
                        ],
                        backgroundColor: ['#22c55e', '#eab308', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { display: true },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed + ' students';
                                }
                            }
                        }
                    }
                }
            });
        }
    }
</script>