@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutAdmin";
}

<div class="max-w-7xl mx-auto space-y-10 py-8 px-4" id="teacher-dashboard">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-indigo-900">Teacher Dashboard</h1>
            <p class="text-gray-600 mt-2">Welcome back, @User.FindFirst("FullName")?.Value</p>
        </div>

        <div id="loading" class="text-center py-20">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-4 border-indigo-600"></div>
            <p class="mt-4 text-gray-600">Loading...</p>
        </div>

        <!-- FILTER BUTTON -->
        <div class="relative">
            <button id="filterToggleBtn"
                    onclick="toggleFilter()"
                    class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                </svg>
                Filter
            </button>
            <!-- FILTER DROPDOWN -->
            <div id="filterDropdown"
                 class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                <!-- Header -->
                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                    <button onclick="toggleFilter()"
                            class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
                <!-- Fields -->
                <div class="px-5 py-4 space-y-4">
                    <div class="w-full">
                        <label class="text-xs font-medium" for="academic_year_filter">Academic Year</label>
                        <select id="academic_year_filter" class="w-full"></select>
                    </div>
                    <div class="w-full">
                        <label class="text-xs font-medium" for="class_level_filter">Class</label>
                        <select id="class_level_filter" class="w-full"></select>
                    </div>
                </div>
                <!-- Footer Buttons -->
                <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                    <button onclick="resetFilter()"
                            class="px-5 py-2 rounded-full text-sm font-medium text-indigo-400 bg-indigo-50 hover:bg-indigo-100 transition">
                        Reset
                    </button>
                    <button onclick="applyFilter()"
                            class="px-5 py-2 rounded-full text-sm font-medium text-white bg-indigo-500 hover:bg-indigo-600 transition">
                        Filter
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="content" class="hidden space-y-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Schedule (50%) -->
            <div class="bg-white rounded-2xl shadow-lg p-4 sm:p-6 lg:p-8 border border-gray-100">
                <h2 class="text-3xl font-bold text-indigo-900 mb-8">
                    Schedule
                </h2>
                <div class="mb-6">
                    <div class="overflow-x-auto">
                        <div id="classFilterButtons" class="flex gap-2 w-max"></div>
                    </div>
                </div>
                <div class="overflow-x-auto rounded-xl border border-gray-100">
                    <table class="w-full text-left">
                        <thead class="bg-gray-50 text-gray-700 uppercase text-xs">
                            <tr>
                                <th class="px-3 sm:px-6 py-3">Day</th>
                                <th class="px-3 sm:px-6 py-3">Time</th>
                                <th class="px-3 sm:px-6 py-3">Subject</th>
                                <th class="px-3 sm:px-6 py-3">Teacher</th>
                            </tr>
                        </thead>
                        <tbody id="weekly-schedule"></tbody>
                    </table>
                </div>
            </div>

            <!-- Right side: Grade + Attendance stacked (50%) -->
            <div class="flex flex-col gap-6">
                <!-- Grade -->
                <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100 flex-1">
                    <h2 class="text-3xl font-bold text-indigo-900 mb-8">
                        Grade
                    </h2>
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                        <div class="relative h-48 sm:h-56 md:h-64">
                            <canvas id="gradesBarChart"></canvas>
                        </div>
                        <div id="gradesLegend" class="flex flex-wrap gap-3 mt-4 text-xs sm:text-sm"></div>
                    </div>
                </div>

                <!-- Attendance -->
                <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100 flex-1">
                    <h2 class="text-3xl font-bold text-indigo-900 mb-8">
                        Attendance
                    </h2>
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                        <div class="relative h-48 sm:h-56 md:h-64">
                            <canvas id="attendanceBarChart"></canvas>
                        </div>
                        <div class="flex flex-wrap gap-3 mt-4 text-xs sm:text-sm">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-emerald-500"></span> Hadir
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-yellow-400"></span> Sakit
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-blue-400"></span> Izin
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-gray-400"></span> Alpa
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Articles (2/3) -->
            <div class="lg:col-span-2 bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-3xl font-bold text-indigo-900 mb-8">Latest Articles</h2>
                <div id="articles-list" class="space-y-6"></div>
                <div class="flex items-center justify-between mt-6">
                    <span id="articles-info" class="text-sm text-gray-600"></span>
                    <div id="articles-pagination" class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden"></div>
                </div>
            </div>
            <!-- Other card (1/3) -->
            <div class="lg:col-span-1 bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-3xl font-bold text-indigo-900 mb-8">Calendar Haniya</h2>
            </div>
        </div>
    </div>
</div>


<script>
    let selectedClassId = null;

    function renderClassButtons(classes) {
        const container = $('#classFilterButtons');
        container.empty();

        classes.forEach((cls, index) => {
            container.append(`
                <button 
                    class="class-btn px-4 py-2 rounded-full border bg-white hover:bg-indigo-50 whitespace-nowrap"
                    data-id="${cls.id}">
                    ${cls.text}
                </button>
            `);
        });

        const firstBtn = container.find('.class-btn').first();
        if (firstBtn.length) {
            firstBtn
                .removeClass('bg-white')
                .addClass('bg-indigo-600 text-white');
            selectedClassId = firstBtn.data('id');
            loadTeacherDashboard();
        }
    }


    $(document).on('click', '.class-btn', function () {
        $('.class-btn')
            .removeClass('bg-indigo-600 text-white')
            .addClass('bg-white');

        $(this)
            .removeClass('bg-white')
            .addClass('bg-indigo-600 text-white');

        selectedClassId = $(this).data('id');
        loadTeacherDashboard();
    });


    function renderWeeklySchedule(schedule) {
        let html = '';

        if (!schedule || schedule.length === 0) {
            html = `
                <tr>
                    <td colspan="4" class="text-center py-8 text-gray-500">
                        Tidak ada jadwal untuk kelas ini
                    </td>
                </tr>`;
        } else {
            const today = new Date().toLocaleDateString('id-ID', { weekday: 'long' });

            const grouped = {};
            schedule.forEach(item => {
                if (!grouped[item.day]) grouped[item.day] = [];
                grouped[item.day].push(item);
            });

            const daysOrder = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];

            daysOrder.forEach(day => {
                const items = grouped[day];
                if (!items) return;

                const isToday = day === today;

                items.forEach((i, index) => {
                    html += `
                        <tr class="
                            ${isToday ? 'bg-amber-50 border-l-4 border-amber-400' : 'hover:bg-gray-50'}
                            ${index === 0 ? 'border-t-2 border-gray-200' : ''}
                        ">
                            ${index === 0 ? `
                                <td rowspan="${items.length}" 
                                    class="px-6 py-4 font-medium align-middle text-center ${isToday ? 'text-amber-900' : 'text-gray-900'}">
                                    ${day} ${isToday ? '(Today)' : ''}
                                </td>
                            ` : ''}

                            <td class="px-6 py-4 text-indigo-900 font-medium">
                                ${i.time}
                            </td>
                            <td class="px-6 py-4 font-semibold">
                                ${i.subject}
                            </td>
                            <td class="px-6 py-4 text-gray-600">
                                ${i.teacher}
                            </td>
                        </tr>`;
                });
            });
        }

        $('#weekly-schedule').html(html);
    }

    let gradesChart;
    function renderGradesLegend(data) {
        const colors = [
            '#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#ef4444',
            '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#84cc16'
        ];
        const classes = [...new Set((data || []).map(d => d.grade_type))];
        const legend = document.getElementById('gradesLegend');
        legend.innerHTML = classes.map((cls, i) => `
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full" style="background:${colors[i % colors.length]}"></span> ${cls}
            </div>
        `).join('');
    }

    function renderGradesChart(data) {
        const ctx = document.getElementById('gradesBarChart').getContext('2d');
        if (window.gradesChart instanceof Chart) window.gradesChart.destroy();

        // X-axis: unique classes
        const classes = [...new Set((data || []).map(d => d.class_name))];

        // One dataset per grade type
        const gradeTypes = [...new Set((data || []).map(d => d.grade_type))];

        const colors = [
            '#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#ef4444',
            '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#84cc16'
        ];

        const datasets = gradeTypes.map((gt, i) => ({
            label: gt,
            data: classes.map(cls => {
                const match = data.find(d => d.class_name === cls && d.grade_type === gt);
                return match ? parseFloat(match.avg) : 0;
            }),
            backgroundColor: colors[i % colors.length],
            borderRadius: 6,
            barThickness: 16,
        }));

        window.gradesChart = new Chart(ctx, {
            type: 'bar',
            data: { labels: classes, datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.dataset.label}: ${ctx.raw.toFixed(2)}`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { stepSize: 20 }
                    }
                }
            }
        });
    }

    let attendanceChart;
    function renderAttendanceChart(data) {
        const ctx = document.getElementById('attendanceBarChart').getContext('2d');
        if (window.attendanceChart instanceof Chart) window.attendanceChart.destroy();

        const classMap = {};
        (data || []).forEach(item => {
            const cls = item.class_name || 'Unknown';
            const status = (item.attendance_status || '').toUpperCase().trim();
            const count = Number(item.total_attendance || 0);

            if (!classMap[cls]) {
                classMap[cls] = { HADIR: 0, SAKIT: 0, IZIN: 0, ALPA: 0 };
            }
            if (classMap[cls].hasOwnProperty(status)) {
                classMap[cls][status] = count;
            }
        });

        const classes = Object.keys(classMap);

        const presentData = [], sickData = [], excusedData = [], alpaData = [];

        classes.forEach(cls => {
            const mapped = classMap[cls];
            const total = Object.values(mapped).reduce((a, b) => a + b, 0) || 1;
            presentData.push(parseFloat(((mapped.HADIR / total) * 100).toFixed(2)));
            sickData.push(parseFloat(((mapped.SAKIT / total) * 100).toFixed(2)));
            excusedData.push(parseFloat(((mapped.IZIN / total) * 100).toFixed(2)));
            alpaData.push(parseFloat(((mapped.ALPA / total) * 100).toFixed(2)));
        });

        window.attendanceChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: classes,
                datasets: [
                    {
                        label: 'Hadir',
                        data: presentData,
                        backgroundColor: '#10b981',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Sakit',
                        data: sickData,
                        backgroundColor: '#facc15',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Izin',
                        data: excusedData,
                        backgroundColor: '#60a5fa',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Alpa',
                        data: alpaData,
                        backgroundColor: '#9ca3af',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.dataset.label}: ${ctx.raw.toFixed(2)}%`
                        }
                    }
                },
                scales: {
                    x: { stacked: true, grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        max: 100,
                        stacked: true,
                        ticks: { callback: val => val + '%' }
                    }
                }
            }
        });
    }

    let currentAcademicYearId = null;
    let currentClass = null;

    function loadTeacherDashboard() {
        $.ajax({
            url: '/Dashboard/GetTeacherData',
            type: 'GET',
            data: {
                classId: selectedClassId,
                academicYear: currentAcademicYearId,
                academicClass: currentClass,
            },
            success: function (res) {
                if (!res.success) {
                    alert(res.message);
                    return;
                }

                fullData = res.data;

                renderWeeklySchedule(fullData.weeklySchedule);
                renderAttendanceChart(fullData.attendanceChart);
                renderGradesChart(fullData.gradesChart);
                renderGradesLegend(fullData.gradesChart);

                allArticles = fullData.articles || [];
                renderArticles(1);

                $('#loading').addClass('hidden');
                $('#content').removeClass('hidden');
            },
            error: function () {
                Swal.fire('Error!', 'Gagal memuat data.', 'error');
            }
        });
    }

    function renderArticles(page) {
        const itemsPerPage = 6;
        const startIndex = (page - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const pageArticles = allArticles.slice(startIndex, endIndex);
        const totalPages = Math.ceil(allArticles.length / itemsPerPage);

        let articlesHtml = '<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">';
        pageArticles.forEach(a => {
            let tagHtml = '';
            (a.tags || []).forEach(tag => {
                tagHtml += `<span class="px-2 py-1 bg-rose-100 text-rose-800 rounded-full text-xs font-medium">${tag}</span>`;
            });
            articlesHtml += `
                    <div class="flex flex-col hover:bg-gray-50 p-4 rounded-2xl transition border border-gray-100">
                        <div class="w-full h-36 bg-gradient-to-br from-rose-200 to-pink-200 rounded-xl flex-shrink-0 bg-cover bg-center mb-3" style="background-image: url('${a.image || ''}')"></div>
                        <div class="flex-1 flex flex-col">
                            <p class="text-base font-semibold text-indigo-900 line-clamp-2">${a.title || ''}</p>
                            <p class="text-gray-500 text-xs mt-1">${a.date || ''}</p>
                            <p class="text-gray-600 text-sm mt-2 line-clamp-2">${a.content || ''}</p>
                            <div class="flex flex-wrap gap-1 mt-3">${tagHtml}</div>
                        </div>
                    </div>`;
        });
        articlesHtml += '</div>';

        $('#articles-list').html(articlesHtml);
        $('#articles-info').text(`Showing ${startIndex + 1} to ${Math.min(endIndex, allArticles.length)} of ${allArticles.length} articles`);

        let paginationHtml = '';
        for (let i = 1; i <= totalPages; i++) {
            paginationHtml += `
                    <button onclick="renderArticles(${i})"
                        class="px-3 py-2 text-sm font-medium border-r border-gray-300 last:border-r-0 min-w-[40px] transition-colors duration-150
                        ${i === page
                    ? 'bg-indigo-900 text-white cursor-default'
                    : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-indigo-900 cursor-pointer'}">
                        ${i}
                    </button>`;
        }
        $('#articles-pagination').html(paginationHtml);
    }


    $(document).ready(function () {
        $.ajax({
            url: '/Select2/AcademicClasses',
            type: 'GET',
            dataType: 'json',
            data: {
                q: '',
                page: 1
            },
            success: function (data) {
                renderClassButtons(data.results);
            },
            error: function (err) {
                console.error('Error fetch AcademicClasses:', err);
            }
        });

        $('#academic_year_filter').select2({
            placeholder: 'Academic Year',
            allowClear: true,
            width: '100%',
            ajax: {
                url: '/Select2/AcademicYears',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { q: params.term || '', page: params.page || 1 };
                },
                processResults: function (data) {
                    return {
                        results: data.results,
                        pagination: data.pagination
                    };
                },
                cache: true
            },
            minimumInputLength: 0
        }).on('change', function () {
            currentAcademicYearId = $(this).val() || '';
        });

        $('#class_level_filter').select2({
            placeholder: 'Select Class Level',
            allowClear: true,
            width: '100%',
            dropdownParent: $('#filterDropdown'),
            data: [
                { id: '', text: 'All Levels' },
                { id: '7', text: 'Class 7' },
                { id: '8', text: 'Class 8' },
                { id: '9', text: 'Class 9' }
            ]
        });
    });
</script>