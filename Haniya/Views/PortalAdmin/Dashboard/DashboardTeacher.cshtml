@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutAdmin";
}

<div class="max-w-7xl mx-auto space-y-10 py-8 px-4" id="teacher-dashboard">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-indigo-900">Teacher Dashboard</h1>
            <p class="text-gray-600 mt-2">Welcome back!, @User.FindFirst("FullName")?.Value</p>
        </div>

        <div id="loading" class="text-center py-20">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-4 border-indigo-600"></div>
            <p class="mt-4 text-gray-600">Loading...</p>
        </div>

        <!-- FILTER BUTTON -->
        <div class="relative">
            <button id="filterToggleBtn"
                    onclick="toggleFilter()"
                    class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                </svg>
                Filter
            </button>
            <!-- FILTER DROPDOWN -->
            <div id="filterDropdown"
                 class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                <!-- Header -->
                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                    <button onclick="toggleFilter()"
                            class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
                <!-- Fields -->
                <div class="px-5 py-4 space-y-4">
                    <div class="w-full">
                        <label class="text-xs font-medium" for="academic_year_filter">Academic Year</label>
                        <select id="academic_year_filter" class="w-full"></select>
                    </div>
                    <div class="w-full">
                        <label class="text-xs font-medium" for="class_level_filter">Class</label>
                        <select id="class_level_filter" class="w-full"></select>
                    </div>
                </div>
                <!-- Footer Buttons -->
                <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                    <button onclick="applyFilter()"
                            class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">
                        Filter
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="content" class="hidden space-y-10">
        <!-- Row 1: Schedule -->
        <div class="bg-white rounded-2xl shadow-lg p-4 sm:p-6 lg:p-8 border border-gray-100">
            <h2 class="text-lg font-bold text-indigo-900 mb-8">
                Schedule
            </h2>
            <div class="mb-6">
                <div class="overflow-x-auto">
                    <div id="classFilterButtons" class="flex gap-2 w-max"></div>
                </div>
            </div>
            <div class="overflow-x-auto rounded-xl border border-gray-100">
                <table class="w-full text-left">
                    <thead class="bg-gray-50 text-gray-700 uppercase text-xs">
                        <tr>
                            <th class="px-3 sm:px-6 py-3">Day</th>
                            <th class="px-3 sm:px-6 py-3">Time</th>
                            <th class="px-3 sm:px-6 py-3">Subject</th>
                            <th class="px-3 sm:px-6 py-3">Teacher</th>
                        </tr>
                    </thead>
                    <tbody id="weekly-schedule"></tbody>
                </table>
            </div>
        </div>

        <!-- Row 2: Grade+Attendance (single container) + Calendar -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100 lg:col-span-2">
                <h2 class="text-lg font-bold text-indigo-900 mb-8">
                    Grade
                </h2>
                <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                    <div class="relative h-32 sm:h-40">
                        <canvas id="gradesBarChart"></canvas>
                    </div>
                    <div id="gradesLegend" class="flex flex-wrap gap-3 mt-4 text-xs sm:text-sm"></div>
                </div>

                <h2 class="text-lg font-bold text-indigo-900 mt-8 mb-8">
                    Attendance
                </h2>
                <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100 mb-2">
                    <div class="relative h-32 sm:h-40">
                        <canvas id="attendanceBarChart"></canvas>
                    </div>
                    <div class="flex flex-wrap gap-3 mt-4 text-xs sm:text-sm">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-emerald-500"></span> Hadir
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-yellow-400"></span> Sakit
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-blue-400"></span> Izin
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-gray-400"></span> Alpa
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100">
                <h2 class="text-lg font-bold text-indigo-900 mb-8">Calendar Haniya</h2>
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <button id="calendarPrevBtn" type="button"
                                onclick="changeCalendarMonth(-1)"
                                class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm hover:bg-gray-50">
                            Prev
                        </button>
                        <p id="calendarMonthLabel" class="text-sm font-semibold text-gray-700"></p>
                        <button id="calendarNextBtn" type="button"
                                onclick="changeCalendarMonth(1)"
                                class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm hover:bg-gray-50">
                            Next
                        </button>
                    </div>

                    <div id="calendarClassLegend" class="flex flex-wrap gap-3 text-xs"></div>

                    <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                        <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-gray-500 mb-2">
                            <div>Mon</div>
                            <div>Tue</div>
                            <div>Wed</div>
                            <div>Thu</div>
                            <div>Fri</div>
                            <div>Sat</div>
                            <div>Sun</div>
                        </div>
                        <div id="academicCalendarGrid" class="grid grid-cols-7 gap-1"></div>
                    </div>
                    <div id="calendarEventHighlights" class="flex flex-wrap gap-2 text-xs"></div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-8">
            <!-- Articles -->
            <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-lg font-bold text-indigo-900 mb-8">Latest Articles</h2>
                <div id="articles-list" class="space-y-6"></div>
                <div class="flex items-center justify-between mt-6">
                    <span id="articles-info" class="text-sm text-gray-600"></span>
                    <div id="articles-pagination" class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    let selectedClassId = null;

    function renderClassButtons(classes) {
        const container = $('#classFilterButtons');
        container.empty();

        classes.forEach((cls, index) => {
            container.append(`
                <button 
                    class="class-btn px-4 py-2 rounded-full border bg-white hover:bg-indigo-50 whitespace-nowrap"
                    data-id="${cls.id}"
                    data-name="${cls.text}">
                    ${cls.text}
                </button>
            `);
        });

        const firstBtn = container.find('.class-btn').first();
        if (firstBtn.length) {
            firstBtn
                .removeClass('bg-white')
                .addClass('bg-indigo-600 text-white');
            selectedClassId = firstBtn.data('id');
            currentClass = firstBtn.data('name') || '';
            loadTeacherDashboard();
        }
    }


    $(document).on('click', '.class-btn', function () {
        $('.class-btn')
            .removeClass('bg-indigo-600 text-white')
            .addClass('bg-white');

        $(this)
            .removeClass('bg-white')
            .addClass('bg-indigo-600 text-white');

        selectedClassId = $(this).data('id');
        currentClass = $(this).data('name') || '';
        loadTeacherDashboard();
    });


    function renderWeeklySchedule(schedule) {
        let html = '';

        const dayReverseMap = {
            'DAY_MON': 'Senin',
            'DAY_TUE': 'Selasa',
            'DAY_WED': 'Rabu',
            'DAY_THU': 'Kamis',
            'DAY_FRI': 'Jumat',
            'DAY_SAT': 'Sabtu',
            'DAY_SUN': 'Minggu'
        };

        if (!schedule || schedule.length === 0) {
            html = `
                <tr>
                    <td colspan="4" class="text-center py-8 text-gray-500">
                        Tidak ada jadwal untuk kelas ini
                    </td>
                </tr>`;
        } else {
            const now = new Date();
            const jsDay = now.getDay(); // 0=Sunday, 6=Saturday
            const isWeekendToday = jsDay === 0 || jsDay === 6;

            const todayName = now.toLocaleDateString('id-ID', { weekday: 'long' });
            const normalizedTodayName = todayName
                ? todayName.charAt(0).toUpperCase() + todayName.slice(1).toLowerCase()
                : '';

            // grouping berdasarkan nama hari Indonesia
            const grouped = {};
            schedule.forEach(item => {
                const dayName = dayReverseMap[item.day];
                if (!dayName) return; // skip kalau tidak valid

                if (!grouped[dayName]) grouped[dayName] = [];
                grouped[dayName].push(item);
            });

            const daysOrder = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];

            // cari hari terdekat saat weekend
            const upcomingDay = isWeekendToday
                ? daysOrder.find(day => Array.isArray(grouped[day]) && grouped[day].length > 0)
                : null;

            daysOrder.forEach(day => {
                const items = grouped[day];
                if (!items) return;

                const isToday = !isWeekendToday && day === normalizedTodayName;
                const isUpcoming = isWeekendToday && day === upcomingDay;
                const isHighlighted = isToday || isUpcoming;

                const dayLabel = isToday
                    ? '<span class="ml-1 text-xs font-semibold text-amber-700">(Today)</span>'
                    : (isUpcoming
                        ? '<span class="ml-1 text-xs font-semibold text-amber-700">(Upcoming)</span>'
                        : '');

                items.forEach((i, index) => {
                    html += `
                        <tr class="
                            ${isHighlighted ? 'bg-amber-50 border-l-4 border-amber-400' : 'hover:bg-gray-50'}
                            ${index === 0 ? 'border-t-2 border-gray-200' : ''}
                        ">
                            ${index === 0 ? `
                                <td rowspan="${items.length}"
                                    class="px-6 py-4 font-medium align-middle text-center ${isHighlighted ? 'text-amber-900' : 'text-gray-900'}">
                                    <div class="leading-tight">
                                        <span>${day}</span>${dayLabel}
                                    </div>
                                </td>
                            ` : ''}

                            <td class="px-6 py-4 text-indigo-900 font-medium">
                                ${i.time}
                            </td>
                            <td class="px-6 py-4 font-semibold">
                                ${i.subject}
                            </td>
                            <td class="px-6 py-4 text-gray-600">
                                ${i.teacher}
                            </td>
                        </tr>`;
                });
            });
        }

        $('#weekly-schedule').html(html);
    }

    let gradesChart;
    function renderGradesLegend(data) {
        const colors = [
            '#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#ef4444',
            '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#84cc16'
        ];
        const classes = [...new Set((data || []).map(d => d.grade_type))];
        const legend = document.getElementById('gradesLegend');
        legend.innerHTML = classes.map((cls, i) => `
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full" style="background:${colors[i % colors.length]}"></span> ${cls}
            </div>
        `).join('');
    }

    function renderGradesChart(data) {
        const ctx = document.getElementById('gradesBarChart').getContext('2d');
        if (window.gradesChart instanceof Chart) window.gradesChart.destroy();

        // X-axis: unique classes
        const classes = [...new Set((data || []).map(d => d.class_name))];

        // One dataset per grade type
        const gradeTypes = [...new Set((data || []).map(d => d.grade_type))];

        const colors = [
            '#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#ef4444',
            '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#84cc16'
        ];

        const datasets = gradeTypes.map((gt, i) => ({
            label: gt,
            data: classes.map(cls => {
                const match = data.find(d => d.class_name === cls && d.grade_type === gt);
                return match ? parseFloat(match.avg) : 0;
            }),
            backgroundColor: colors[i % colors.length],
            borderRadius: 6,
            barThickness: 16,
        }));

        window.gradesChart = new Chart(ctx, {
            type: 'bar',
            data: { labels: classes, datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.dataset.label}: ${ctx.raw.toFixed(2)}`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { stepSize: 20 }
                    }
                }
            }
        });
    }

    let attendanceChart;
    function renderAttendanceChart(data) {
        const ctx = document.getElementById('attendanceBarChart').getContext('2d');
        if (window.attendanceChart instanceof Chart) window.attendanceChart.destroy();

        const classMap = {};
        (data || []).forEach(item => {
            const cls = item.class_name || 'Unknown';
            const status = (item.attendance_status || '').toUpperCase().trim();
            const count = Number(item.total_attendance || 0);

            if (!classMap[cls]) {
                classMap[cls] = { HADIR: 0, SAKIT: 0, IZIN: 0, ALPA: 0 };
            }
            if (classMap[cls].hasOwnProperty(status)) {
                classMap[cls][status] = count;
            }
        });

        const classes = Object.keys(classMap);

        const presentData = [], sickData = [], excusedData = [], alpaData = [];

        classes.forEach(cls => {
            const mapped = classMap[cls];
            const total = Object.values(mapped).reduce((a, b) => a + b, 0) || 1;
            presentData.push(parseFloat(((mapped.HADIR / total) * 100).toFixed(2)));
            sickData.push(parseFloat(((mapped.SAKIT / total) * 100).toFixed(2)));
            excusedData.push(parseFloat(((mapped.IZIN / total) * 100).toFixed(2)));
            alpaData.push(parseFloat(((mapped.ALPA / total) * 100).toFixed(2)));
        });

        window.attendanceChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: classes,
                datasets: [
                    {
                        label: 'Hadir',
                        data: presentData,
                        backgroundColor: '#10b981',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Sakit',
                        data: sickData,
                        backgroundColor: '#facc15',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Izin',
                        data: excusedData,
                        backgroundColor: '#60a5fa',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    },
                    {
                        label: 'Alpa',
                        data: alpaData,
                        backgroundColor: '#9ca3af',
                        borderRadius: 6,
                        barThickness: 28,
                        stack: 'attendance'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.dataset.label}: ${ctx.raw.toFixed(2)}%`
                        }
                    }
                },
                scales: {
                    x: { stacked: true, grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        max: 100,
                        stacked: true,
                        ticks: { callback: val => val + '%' }
                    }
                }
            }
        });
    }

    let academicCalendarDays = [];
    let calendarEventPinPoints = [];
    let currentCalendarDate = new Date();
    const classColorMap = {
        '7': { bg: 'bg-violet-500', text: 'text-violet-700', soft: 'bg-violet-100' },
        '8': { bg: 'bg-teal-500', text: 'text-teal-700', soft: 'bg-teal-100' },
        '9': { bg: 'bg-orange-500', text: 'text-orange-700', soft: 'bg-orange-100' }
    };

    function parseDateOnly(raw) {
        if (!raw) return null;
        const d = new Date(raw);
        if (isNaN(d.getTime())) return null;
        return new Date(d.getFullYear(), d.getMonth(), d.getDate());
    }

    function toDateKey(dateObj) {
        if (!dateObj) return '';
        const y = dateObj.getFullYear();
        const m = String(dateObj.getMonth() + 1).padStart(2, '0');
        const d = String(dateObj.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function formatDateID(dateObj) {
        if (!dateObj) return '-';
        return dateObj.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function getCalendarBounds() {
        const dates = (academicCalendarDays || [])
            .map(d => parseDateOnly(d.calendar_date || d.calendarDate))
            .filter(Boolean)
            .sort((a, b) => a.getTime() - b.getTime());

        if (!dates.length) return null;
        return {
            minMonth: new Date(dates[0].getFullYear(), dates[0].getMonth(), 1),
            maxMonth: new Date(dates[dates.length - 1].getFullYear(), dates[dates.length - 1].getMonth(), 1)
        };
    }

    function setCalendarNavState() {
        const bounds = getCalendarBounds();
        const $prev = $('#calendarPrevBtn');
        const $next = $('#calendarNextBtn');
        if (!$prev.length || !$next.length) return;

        if (!bounds) {
            $prev.prop('disabled', true).addClass('opacity-50 cursor-not-allowed');
            $next.prop('disabled', true).addClass('opacity-50 cursor-not-allowed');
            return;
        }

        const currentMonth = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth(), 1);
        const atMin = currentMonth.getTime() <= bounds.minMonth.getTime();
        const atMax = currentMonth.getTime() >= bounds.maxMonth.getTime();

        $prev.prop('disabled', atMin).toggleClass('opacity-50 cursor-not-allowed', atMin);
        $next.prop('disabled', atMax).toggleClass('opacity-50 cursor-not-allowed', atMax);
    }

    function isHolidayEvent(event) {
        return event?.is_holiday === true ||
            event?.is_holiday === 1 ||
            event?.isHoliday === true ||
            event?.isHoliday === 1;
    }

    function getEventsOnDate(dateObj) {
        const time = dateObj.getTime();
        return (calendarEventPinPoints || []).filter(ev => {
            const start = parseDateOnly(ev.start_date || ev.startDate);
            const end = parseDateOnly(ev.end_date || ev.endDate) || start;
            if (!start || !end) return false;
            return time >= start.getTime() && time <= end.getTime();
        });
    }

    function openEventDetail(eventId) {
        if (!eventId) return;
        const url = `/news-event/${encodeURIComponent(eventId)}`;
        window.open(url, '_blank', 'noopener');
    }

    function summarizeEventsByClass(events) {
        const grouped = new Map();
        (events || []).forEach(ev => {
            const name = ev.event_name || ev.eventName || 'Event';
            const key = name;
            const cls = String(ev.class_level || ev.classLevel || '-');
            if (!grouped.has(key)) {
                grouped.set(key, { name, holiday: new Set(), nonHoliday: new Set() });
            }
            if (isHolidayEvent(ev)) grouped.get(key).holiday.add(cls);
            else grouped.get(key).nonHoliday.add(cls);
        });
        return grouped;
    }

    function renderMonthlyEventHighlights() {
        const container = $('#calendarEventHighlights');
        if (!container.length) return;

        const monthStart = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth(), 1);
        const monthEnd = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth() + 1, 0);

        const monthly = (calendarEventPinPoints || []).filter(ev => {
            const start = parseDateOnly(ev.start_date || ev.startDate);
            const end = parseDateOnly(ev.end_date || ev.endDate) || start;
            if (!start || !end) return false;
            return start.getTime() <= monthEnd.getTime() && end.getTime() >= monthStart.getTime();
        });

        if (monthly.length === 0) {
            container.html('<span class="text-gray-500">Tidak ada event pada bulan ini.</span>');
            return;
        }

        const grouped = summarizeEventsByClass(monthly);

        let html = '';
        grouped.forEach(ev => {
            const related = monthly.filter(m => (m.event_name || m.eventName || 'Event') === ev.name);
            let clippedStart = null;
            let clippedEnd = null;
            related.forEach(item => {
                const start = parseDateOnly(item.start_date || item.startDate);
                const end = parseDateOnly(item.end_date || item.endDate) || start;
                if (!start || !end) return;
                const s = start.getTime() < monthStart.getTime() ? monthStart : start;
                const e = end.getTime() > monthEnd.getTime() ? monthEnd : end;
                if (!clippedStart || s.getTime() < clippedStart.getTime()) clippedStart = s;
                if (!clippedEnd || e.getTime() > clippedEnd.getTime()) clippedEnd = e;
            });

            const holidayClasses = [...ev.holiday].sort();
            const nonHolidayClasses = [...ev.nonHoliday].sort();
            const holidayText = holidayClasses.length ? `Libur: ${holidayClasses.join(', ')}` : 'Libur: -';
            const nonHolidayText = nonHolidayClasses.length ? `Masuk: ${nonHolidayClasses.join(', ')}` : 'Masuk: -';
            const rangeText = clippedStart && clippedEnd
                ? `${formatDateID(clippedStart)} - ${formatDateID(clippedEnd)}`
                : '-';
            html += `<span class="inline-block px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 border border-amber-200 leading-relaxed">` +
                `<strong>${ev.name}</strong> | ${rangeText}<br>${holidayText} | ${nonHolidayText}</span>`;
        });
        container.html(html);
    }

    function renderCalendarClassLegend() {
        const container = $('#calendarClassLegend');
        if (!container.length) return;
        container.html(`
            <div class="inline-flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full ${classColorMap['7'].bg}"></span>
                <span>Kelas 7</span>
            </div>
            <div class="inline-flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full ${classColorMap['8'].bg}"></span>
                <span>Kelas 8</span>
            </div>
            <div class="inline-flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full ${classColorMap['9'].bg}"></span>
                <span>Kelas 9</span>
            </div>
        `);
    }

    function renderAcademicCalendar() {
        const label = $('#calendarMonthLabel');
        const grid = $('#academicCalendarGrid');
        if (!label.length || !grid.length) return;

        const bounds = getCalendarBounds();
        if (bounds) {
            const currentMonth = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth(), 1);
            if (currentMonth.getTime() < bounds.minMonth.getTime()) currentCalendarDate = new Date(bounds.minMonth);
            if (currentMonth.getTime() > bounds.maxMonth.getTime()) currentCalendarDate = new Date(bounds.maxMonth);
        }

        const year = currentCalendarDate.getFullYear();
        const month = currentCalendarDate.getMonth();
        const monthStart = new Date(year, month, 1);
        const monthEnd = new Date(year, month + 1, 0);

        label.text(monthStart.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }));

        const calendarMap = {};
        (academicCalendarDays || []).forEach(item => {
            const d = parseDateOnly(item.calendar_date || item.calendarDate);
            if (!d) return;
            calendarMap[toDateKey(d)] = {
                isWeekend: item.is_weekend === true || item.is_weekend === 1 || item.isWeekend === true || item.isWeekend === 1
            };
        });

        const firstWeekday = (monthStart.getDay() + 6) % 7; // Monday = 0
        let html = '';

        for (let i = 0; i < firstWeekday; i++) {
            html += '<div class="h-10 rounded-md bg-transparent"></div>';
        }

        for (let day = 1; day <= monthEnd.getDate(); day++) {
            const d = new Date(year, month, day);
            const key = toDateKey(d);
            const cal = calendarMap[key];
            const dayEvents = getEventsOnDate(d);
            const firstEventId = dayEvents.length > 0
                ? (dayEvents[0].event_id || dayEvents[0].eventId || '')
                : '';
            const isWeekend = cal?.isWeekend === true;
            const isToday = toDateKey(d) === toDateKey(new Date());

            const tooltipLines = [];
            if (isWeekend) tooltipLines.push('Libur (Weekend)');

            const groupedEvents = summarizeEventsByClass(dayEvents);
            const participantClasses = new Set();
            groupedEvents.forEach(ev => {
                const holidayClasses = [...ev.holiday].sort();
                const nonHolidayClasses = [...ev.nonHoliday].sort();
                holidayClasses.forEach(c => participantClasses.add(c));
                const holidayText = holidayClasses.length ? `Libur: ${holidayClasses.join(', ')}` : 'Libur: -';
                const nonHolidayText = nonHolidayClasses.length ? `Masuk: ${nonHolidayClasses.join(', ')}` : 'Masuk: -';
                tooltipLines.push(`${ev.name} | ${holidayText} | ${nonHolidayText}`);
            });
            const title = (tooltipLines.length ? tooltipLines.join(' | ') : 'Tidak ada keterangan')
                .replace(/"/g, '&quot;');

            let bgClass = 'bg-white border-gray-200';
            let textClass = 'text-gray-700';
            if (dayEvents.length > 0) {
                bgClass = 'bg-yellow-50 border-yellow-300';
                textClass = 'text-yellow-700';
            } else if (isWeekend) {
                bgClass = 'bg-red-50 border-red-200';
                textClass = 'text-red-700';
            }
            const todayClass = isToday ? 'ring-2 ring-indigo-500' : '';
            const classMarkers = ['7', '8', '9']
                .filter(c => participantClasses.has(c))
                .map(c => `<span class="w-1.5 h-1.5 rounded-full ${classColorMap[c].bg}" title="Kelas ${c}"></span>`)
                .join('');
            const isClickable = dayEvents.length > 0 && firstEventId;
            const clickAttr = isClickable ? `onclick="openEventDetail('${firstEventId}')"` : '';
            const cursorClass = isClickable ? 'cursor-pointer hover:shadow-sm' : 'cursor-help';

            html += `
                <div ${clickAttr} class="h-10 rounded-md border ${bgClass} ${todayClass} px-1.5 py-1 text-center ${cursorClass}" title="${title}">
                    <div class="text-xs font-semibold ${textClass}">${day}</div>
                    <div class="mt-0.5 flex items-center justify-center gap-0.5">${classMarkers}</div>
                </div>
            `;
        }

        grid.html(html);
        renderCalendarClassLegend();
        renderMonthlyEventHighlights();
        setCalendarNavState();
    }

    function changeCalendarMonth(step) {
        const bounds = getCalendarBounds();
        const target = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth() + step, 1);
        if (bounds) {
            if (target.getTime() < bounds.minMonth.getTime()) return;
            if (target.getTime() > bounds.maxMonth.getTime()) return;
        }
        currentCalendarDate = target;
        renderAcademicCalendar();
    }

    let currentAcademicYearId = null;
    let currentClass = null;

    function loadTeacherDashboard() {
        $.ajax({
            url: '/Dashboard/GetTeacherData',
            type: 'GET',
            data: {
                academicYear: currentAcademicYearId,
                classLevel: currentClass
            },
            success: function (res) {
                if (!res.success) {
                    alert(res.message);
                    return;
                }

                fullData = res.data;

                renderWeeklySchedule(fullData.weeklySchedule);
                renderAttendanceChart(fullData.attendanceChart);
                renderGradesChart(fullData.gradesChart);
                renderGradesLegend(fullData.gradesChart);
                academicCalendarDays = fullData.calendarDays || [];
                calendarEventPinPoints = fullData.calendarEvents || [];
                const bounds = getCalendarBounds();
                if (bounds) {
                    const currentMonth = new Date(currentCalendarDate.getFullYear(), currentCalendarDate.getMonth(), 1);
                    if (currentMonth.getTime() < bounds.minMonth.getTime()) currentCalendarDate = new Date(bounds.minMonth);
                    if (currentMonth.getTime() > bounds.maxMonth.getTime()) currentCalendarDate = new Date(bounds.maxMonth);
                }
                renderAcademicCalendar();

                allArticles = fullData.articles || [];
                renderArticles(1);

                $('#loading').addClass('hidden');
                $('#content').removeClass('hidden');
            },
            error: function () {
                Swal.fire('Error!', 'Gagal memuat data.', 'error');
            }
        });
    }

    function applyFilter() {
        currentAcademicYearId = $('#academic_year_filter').val() || '';
        currentClass = $('#class_level_filter').val() || '';
        loadTeacherDashboard();
        toggleFilter();
    }

    function renderArticles(page) {
        const itemsPerPage = 6;
        const startIndex = (page - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const pageArticles = allArticles.slice(startIndex, endIndex);
        const totalPages = Math.ceil(allArticles.length / itemsPerPage);

        let articlesHtml = '<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">';
        pageArticles.forEach(a => {
            let tagHtml = '';
            (a.tags || []).forEach(tag => {
                tagHtml += `<span class="px-2 py-1 bg-rose-100 text-rose-800 rounded-full text-xs font-medium">${tag}</span>`;
            });
            articlesHtml += `
                    <div class="flex flex-col hover:bg-gray-50 p-4 rounded-2xl transition border border-gray-100">
                        <div class="w-full h-36 bg-gradient-to-br from-rose-200 to-pink-200 rounded-xl flex-shrink-0 bg-cover bg-center mb-3" style="background-image: url('${a.image || ''}')"></div>
                        <div class="flex-1 flex flex-col">
                            <p class="text-base font-semibold text-indigo-900 line-clamp-2">${a.title || ''}</p>
                            <p class="text-gray-500 text-xs mt-1">${a.date || ''}</p>
                            <p class="text-gray-600 text-sm mt-2 line-clamp-2">${a.content || ''}</p>
                            <div class="flex flex-wrap gap-1 mt-3">${tagHtml}</div>
                        </div>
                    </div>`;
        });
        articlesHtml += '</div>';

        $('#articles-list').html(articlesHtml);
        $('#articles-info').text(`Showing ${startIndex + 1} to ${Math.min(endIndex, allArticles.length)} of ${allArticles.length} articles`);

        let paginationHtml = '';
        for (let i = 1; i <= totalPages; i++) {
            paginationHtml += `
                    <button onclick="renderArticles(${i})"
                        class="px-3 py-2 text-sm font-medium border-r border-gray-300 last:border-r-0 min-w-[40px] transition-colors duration-150
                        ${i === page
                    ? 'bg-indigo-900 text-white cursor-default'
                    : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-indigo-900 cursor-pointer'}">
                        ${i}
                    </button>`;
        }
        $('#articles-pagination').html(paginationHtml);
    }


    $(document).ready(function () {
        $.ajax({
            url: '/Select2/AcademicClasses',
            type: 'GET',
            dataType: 'json',
            data: {
                q: '',
                page: 1
            },
            success: function (data) {
                renderClassButtons(data.results);
            },
            error: function (err) {
                console.error('Error fetch AcademicClasses:', err);
            }
        });

        $('#academic_year_filter').select2({
            placeholder: 'Academic Year',
            allowClear: true,
            width: '100%',
            ajax: {
                url: '/Select2/AcademicYears',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { q: params.term || '', page: params.page || 1 };
                },
                processResults: function (data) {
                    return {
                        results: data.results,
                        pagination: data.pagination
                    };
                },
                cache: true
            },
            minimumInputLength: 0
        }).on('change', function () {
            currentAcademicYearId = $(this).val() || '';
        });

        $('#class_level_filter').select2({
            placeholder: 'Select Class Level',
            allowClear: true,
            width: '100%',
            dropdownParent: $('#filterDropdown'),
            data: [
                { id: '', text: 'All Levels' },
                { id: '7', text: 'Class 7' },
                { id: '8', text: 'Class 8' },
                { id: '9', text: 'Class 9' }
            ]
        }).val('7').trigger('change');
        currentClass = $('#class_level_filter').val() || '';

        $.ajax({
            url: '/Select2Default/ActiveAcademicYear',
            type: 'GET',
            success: function (data) {
                if (data && data.id) {
                    var option = new Option(data.text, data.id, true, true);
                    $('#academic_year_filter').append(option).trigger('change');
                    currentAcademicYearId = data.id;
                    loadTeacherDashboard();
                }
            },
            error: function (err) {
                console.error('Failed to fetch default academic year:', err);
            }
        });
    });
</script>
