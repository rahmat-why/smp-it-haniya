@{
    ViewData["Title"] = "Dashboard Guru";
    Layout = "_LayoutAdmin";
}

<div class="max-w-7xl mx-auto space-y-10 py-8 px-4" id="teacher-dashboard">
    <div>
        <h1 class="text-3xl font-bold text-indigo-900">Teacher Dashboard</h1>
        <p class="text-gray-600 mt-2">Welcome back</p>
    </div>

    <div id="loading" class="text-center py-20">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-4 border-indigo-600"></div>
        <p class="mt-4 text-gray-600">Loading...</p>
    </div>

    <div id="content" class="hidden space-y-10">
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
            <div class="xl:col-span-2 bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
                <h2 class="text-2xl font-bold text-indigo-900 mb-8">Class Schedule</h2>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2" for="">Choose Class</label>
                    <div class="overflow-x-auto">
                        <div id="classFilterButtons" class="flex gap-2 w-max"></div>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-gray-50 text-gray-700 uppercase text-xs">
                            <tr>
                                <th class="px-6 py-4">Day</th>
                                <th class="px-6 py-4">Time</th>
                                <th class="px-6 py-4">Subject</th>
                                <th class="px-6 py-4">Teacher</th>
                            </tr>
                        </thead>
                        <tbody id="weekly-schedule"></tbody>
                    </table>
                </div>
            </div>
            <div class="bg-white rounded-2xl shadow-xl p-6 border border-gray-100 space-y-6">
                <h3 class="text-xl font-bold text-indigo-900">Class Analythics</h3>
                <div class="grid grid-cols-1 md:grid-cols-6 xl:grid-cols-12 gap-4">
                    <div class="md:col-span-3 xl:col-span-4">
                        <label class="text-xs font-medium text-gray-500" for="gradeFilterClass">Class</label>
                        <select id="gradesFilterClass" class="mt-1 w-full rounded-xl border-gray-300 focus:ring-indigo-500 focus:border-indigo-500"></select>
                    </div>
                    <div class="md:col-span-3 xl:col-span-4">
                        <label class="text-xs font-medium text-gray-500" for="filterAcademicYear">School Year</label>
                        <select id="filterAcademicYear" class="mt-1 w-full rounded-xl border-gray-300 focus:ring-indigo-500 focus:border-indigo-500"></select>
                    </div>
                    <div class="md:col-span-3 xl:col-span-4">
                        <label class="text-xs font-medium text-gray-500" for="gradesFilterSubject">Subject</label>
                        <select id="gradesFilterSubject" class="mt-1 w-full rounded-xl border-gray-300 focus:ring-indigo-500 focus:border-indigo-500"></select>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-6">
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                        <h4 class="text-lg font-bold text-indigo-900 mb-4">Student Grades Class</h4>
                        <canvas id="gradesBarChart" height="200"></canvas>
                        <div class="flex flex-wrap gap-4 mt-4 text-sm">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-indigo-500"></span> Average
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-gray-300"></span> Remaining towards 100
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                        <h4 class="text-lg font-bold text-indigo-900 mb-4">Student Attendances</h4>
                        <canvas id="attendanceBarChart" height="200"></canvas>
                        <div class="flex flex-wrap gap-4 mt-4 text-sm">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-emerald-500"></span> Present
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-yellow-500"></span> Sick
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-blue-400"></span> Excused
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-gray-400"></span> No Info
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    let selectedClassId = null;
    function prefetchAcademicClasses() {
        $.ajax({
            url: '/Select2/AcademicClasses',
            type: 'GET',
            dataType: 'json',
            data: {
                q: '',
                page: 1
            },
            success: function (data) {
                renderClassButtons(data.results);
            },
            error: function (err) {
                console.error('Error fetch AcademicClasses:', err);
            }
        });
    }

    function renderClassButtons(classes) {
        const container = $('#classFilterButtons');
        container.empty();

        classes.forEach((cls, index) => {
            container.append(`
                <button 
                    class="class-btn px-4 py-2 rounded-full border bg-white hover:bg-indigo-50 whitespace-nowrap"
                    data-id="${cls.id}">
                    ${cls.text}
                </button>
            `);
        });

        const firstBtn = container.find('.class-btn').first();
        if (firstBtn.length) {
            firstBtn
                .removeClass('bg-white')
                .addClass('bg-indigo-600 text-white');
            selectedClassId = firstBtn.data('id');
            loadTeacherDashboard();
        }
    }


    $(document).on('click', '.class-btn', function () {
        $('.class-btn')
            .removeClass('bg-indigo-600 text-white')
            .addClass('bg-white');

        $(this)
            .removeClass('bg-white')
            .addClass('bg-indigo-600 text-white');

        selectedClassId = $(this).data('id');
        loadTeacherDashboard();
    });


    function renderWeeklySchedule(schedule) {
        let html = '';

        if (!schedule || schedule.length === 0) {
            html = `
                <tr>
                    <td colspan="4" class="text-center py-8 text-gray-500">
                        Tidak ada jadwal untuk kelas ini
                    </td>
                </tr>`;
        } else {
            const today = new Date().toLocaleDateString('id-ID', { weekday: 'long' });

            const grouped = {};
            schedule.forEach(item => {
                if (!grouped[item.day]) grouped[item.day] = [];
                grouped[item.day].push(item);
            });

            const daysOrder = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];

            daysOrder.forEach(day => {
                const items = grouped[day];
                if (!items) return;

                const isToday = day === today;

                items.forEach((i, index) => {
                    html += `
                        <tr class="
                            ${isToday ? 'bg-amber-50 border-l-4 border-amber-400' : 'hover:bg-gray-50'}
                            ${index === 0 ? 'border-t-2 border-gray-200' : ''}
                        ">
                            ${index === 0 ? `
                                <td rowspan="${items.length}" 
                                    class="px-6 py-4 font-medium align-middle text-center ${isToday ? 'text-amber-900' : 'text-gray-900'}">
                                    ${day} ${isToday ? '(Today)' : ''}
                                </td>
                            ` : ''}

                            <td class="px-6 py-4 text-indigo-900 font-medium">
                                ${i.time}
                            </td>
                            <td class="px-6 py-4 font-semibold">
                                ${i.subject}
                            </td>
                            <td class="px-6 py-4 text-gray-600">
                                ${i.teacher}
                            </td>
                        </tr>`;
                });
            });
        }

        $('#weekly-schedule').html(html);
    }

    let gradesChart;
    function renderGradesChart(data) {
        const ctx = document.getElementById('gradesBarChart').getContext('2d');

        if (gradesChart) gradesChart.destroy();

        let classAvg = 0;

        if (data && data.length > 0) {
            const total = data.reduce((sum, item) => sum + parseFloat(item.avg || 0), 0);
            classAvg = total / data.length;
        }

        const remain = 100 - classAvg;

        gradesChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Average', 'Remaining towards 100'],
                datasets: [{
                    data: [classAvg, remain],
                    backgroundColor: ['#6366f1', '#e5e7eb'],
                    borderWidth: 0
                }]
            },
            options: {
                cutout: '70%',
                radius: '70%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `${ctx.raw.toFixed(2)}`
                        }
                    }
                }
            }
        });
    }

    let attendanceChart;
    function renderAttendanceChart(data) {
        const ctx = document.getElementById('attendanceBarChart').getContext('2d');

        if (attendanceChart) attendanceChart.destroy();

        const classMap = {};

        data.forEach(item => {
            const cls = item.kelas || 'Unknown';
            const status = item.status?.toUpperCase();

            if (!classMap[cls]) {
                classMap[cls] = {
                    PRESENT: 0,
                    SICK: 0,
                    EXCUSED: 0,
                    NOINFO: 0
                };
            }

            if (classMap[cls].hasOwnProperty(status)) {
                classMap[cls][status] = item.count;
            }
        });

        const classes = Object.keys(classMap);

        const presentData = [];
        const sickData = [];
        const excusedData = [];
        const noInfoData = [];

        classes.forEach(cls => {
            const mapped = classMap[cls];
            const total = Object.values(mapped).reduce((a, b) => a + b, 0) || 1;

            presentData.push((mapped.PRESENT / total) * 100);
            sickData.push((mapped.SICK / total) * 100);
            excusedData.push((mapped.EXCUSED / total) * 100);
            noInfoData.push((mapped.NOINFO / total) * 100);
        });

        attendanceChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: classes,
                datasets: [
                    {
                        data: presentData,
                        backgroundColor: '#10b981',
                        borderRadius: 6
                    },
                    {
                        data: sickData,
                        backgroundColor: '#facc15',
                        borderRadius: 6
                    },
                    {
                        data: excusedData,
                        backgroundColor: '#60a5fa',
                        borderRadius: 6
                    },
                    {
                        data: noInfoData,
                        backgroundColor: '#9ca3af',
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => `${ctx.raw.toFixed(2)}%`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            callback: (val) => val + '%'
                        }
                    }
                }
            }
        });
    }


    let currentAcademicYear = null;
    let currentClass = null;
    let currentSubject = null;
    function loadTeacherDashboard() {
        $.ajax({
            url: '/Dashboard/GetTeacherData',
            type: 'GET',
            data: {
                classId: selectedClassId,
                academicYear: currentAcademicYear,
                academicClass: currentClass,
                subjectId: currentSubject,
            },
            success: function (res) {
                if (!res.success) {
                    alert(res.message);
                    return;
                }

                fullData = res.data;

                console.log(fullData);

                const $selectYear = $("#filterAcademicYear");
                const $selectClass = $("#gradesFilterClass");
                const $selectSubject = $("#gradesFilterSubject");

                $selectYear.empty();
                $selectClass.empty();
                $selectSubject.empty();

                fullData.academicYearList.forEach(item => {
                    $selectYear.append(`<option value="${item.value}">${item.text}</option>`);
                });

                if (!currentAcademicYear) {
                    currentAcademicYear = fullData.academicYearUsed;
                }
                $selectYear.val(currentAcademicYear);

                fullData.academicClassList.forEach(item => {
                    $selectClass.append(`<option value="${item.value}">${item.text}</option>`);
                });

                if (!currentClass || !fullData.academicClassList.some(x => x.value === currentClass)) {
                    currentClass = fullData.academicClassList.length > 0
                        ? fullData.academicClassList[0].value
                        : null;
                }

                $selectClass.val(currentClass);


                fullData.academicSubjectList.forEach(item => {
                    $selectSubject.append(`<option value="${item.value}">${item.text}</option>`);
                });

                if (!currentSubject && fullData.academicSubjectList.length > 0) {
                    currentSubject = fullData.academicSubjectList[0].value;
                }
                $selectSubject.val(currentSubject);

                renderWeeklySchedule(fullData.weeklySchedule);
                renderAttendanceChart(fullData.attendanceChart);
                renderGradesChart(fullData.gradesChart);

                $('#loading').addClass('hidden');
                $('#content').removeClass('hidden');
            },
            error: function () {
                Swal.fire('Error!', 'Gagal memuat data.', 'error');
            }
        });
    }


    $(document).ready(function () {
        prefetchAcademicClasses();

        $("#filterAcademicYear").on('change', function () {
            currentAcademicYear = $(this).val();
            loadTeacherDashboard();
        });

        $("#gradesFilterClass").on('change', function () {
            currentClass = $(this).val();
            currentSubject = null; 
            loadTeacherDashboard();
        });

        $("#gradesFilterSubject").on('change', function () {
            currentSubject = $(this).val();
            loadTeacherDashboard();
        });


    });
</script>