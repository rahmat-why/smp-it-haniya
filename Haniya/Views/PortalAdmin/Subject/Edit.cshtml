@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Ubah Mata Pelajaran";
    var id = ViewBag.subjectId;
    var subjectTypes = ViewBag.SubjectTypes as System.Collections.Generic.List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? new System.Collections.Generic.List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}
<input type="hidden" id="subject_id" name="subject_id" value="@id">

<h2 class="text-xl font-semibold mb-4">Ubah Mata Pelajaran</h2>
<div class="bg-white p-6 rounded-lg shadow w-full space-y-6">
    <form id="frm" class="space-y-6 w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
            <!-- SUBJECT INFO (LEFT) -->
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full">
                <button type="button"
                        onclick="toggleSection('subject-info')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"
                        data-testid="subject-info-toggle">
                    <span class="font-semibold text-white">
                        Informasi Mata Pelajaran
                    </span>
                    <svg id="icon-subject-info"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="subject-info"
                     class="px-4 pb-4 pt-3 space-y-3 border-t border-gray-100"
                     data-testid="subject-info-section">
                    <div>
                        <label for="subject_name" class="block text-sm font-medium text-gray-700 mb-1">
                            Nama Mata Pelajaran <span class="text-red-500">*</span>
                        </label>
                        <input id="subject_name"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="subject-name-input" />
                        <p id="error-subject_name"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-subject_name"></p>
                    </div>
                    <div>
                        <label for="subject_code" class="block text-sm font-medium text-gray-700 mb-1">
                            Kode Mata Pelajaran <span class="text-red-500">*</span>
                        </label>
                        <input id="subject_code"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="subject-code-input" />
                        <p id="error-subject_code"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-subject_code"></p>
                    </div>
                    <div>
                        <label for="subject_type" class="block text-sm font-medium text-gray-700 mb-1">
                            Jenis Mata Pelajaran <span class="text-red-500">*</span>
                        </label>
                        <select id="subject_type"
                                class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-testid="subject-type-select">
                            <option value="">Pilih jenis mata pelajaran</option>
                            @foreach (var item in subjectTypes)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <p id="error-subject_type"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-subject_type"></p>
                    </div>
                    <div>
                        <label for="class_level" class="block text-sm font-medium text-gray-700 mb-1">
                            Tingkat Kelas <span class="text-red-500">*</span>
                        </label>
                        <input id="class_level"
                               type="number"
                               min="1"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="class-level-input" />
                        <p id="error-class_level"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-class_level"></p>
                    </div>
                    <div>
                        <label for="minimum_value" class="block text-sm font-medium text-gray-700 mb-1">
                            Nilai Minimum <span class="text-red-500">*</span>
                        </label>
                        <input id="minimum_value"
                               type="number"
                               step="0.01"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="minimum-value-input" />
                        <p id="error-minimum_value"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-minimum_value"></p>
                    </div>
                </div>
            </div>

            <!-- DESCRIPTION + BUTTONS (RIGHT) -->
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full">
                <button type="button"
                        onclick="toggleSection('subject-extra')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"
                        data-testid="subject-extra-toggle">
                    <span class="font-semibold text-white">
                        Informasi Tambahan
                    </span>
                    <svg id="icon-subject-extra"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div id="subject-extra"
                     class="px-4 pb-4 pt-3 space-y-3 border-t border-gray-100"
                     data-testid="subject-extra-section">
                    <div>
                        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                            Deskripsi <span class="text-red-500">*</span>
                        </label>
                        <textarea id="description"
                                  class="w-full border border-gray-300 rounded-md p-2 min-h-[120px] resize-y focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                  data-testid="description-textarea"></textarea>
                        <p id="error-description"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-description"></p>
                    </div>
                    <div class="pt-4 flex items-center justify-end space-x-2">
                        <button type="button"
                                onclick="goBack()"
                                class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300"
                                data-testid="subject-back-button">
                            <svg class="w-4 h-4 mr-2 text-gray-600"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M15 19l-7-7 7-7" />
                            </svg>
                            <span>Kembali</span>
                        </button>
                        <button type="button"
                                onclick="updateSubject()"
                                class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
                                data-testid="subject-update-button">
                            <span>Ubah</span>
                            <svg class="w-4 h-4 ml-2 text-white"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M5 13l4 4L19 7" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
    <script>
        const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Subject';
        function toggleSection(id) {
            const section = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);
            if (!section || !icon) return;
            const isHidden = section.classList.contains('hidden');
            if (isHidden) {
                section.classList.remove('hidden');
                icon.classList.remove('-rotate-90');
            } else {
                section.classList.add('hidden');
                icon.classList.add('-rotate-90');
            }
        }

        function showError($input, $error, message) {
            if (!$error.length) return;
            if ($input && $input.length) {
                $input.removeClass('border-gray-300').addClass('border-red-500');
            }
            $error.text(message).removeClass('hidden');
        }

        function clearError($input, $error) {
            if ($input && $input.length) {
                $input.removeClass('border-red-500').addClass('border-gray-300');
            }
            $error.text('').addClass('hidden');
        }

        function clearAllValidation() {
            clearError($('#subject_name'), $('#error-subject_name'));
            clearError($('#subject_code'), $('#error-subject_code'));
            clearError($('#subject_type'), $('#error-subject_type'));
            clearError($('#class_level'), $('#error-class_level'));
            clearError($('#minimum_value'), $('#error-minimum_value'));
            clearError($('#description'), $('#error-description'));
        }

        function validateForm() {
            clearAllValidation();
            let isValid = true;

            const subjectName = ($('#subject_name').val() || '').trim();
            const subjectCode = ($('#subject_code').val() || '').trim();
            const subjectType = ($('#subject_type').val() || '').trim();
            const classLevel = ($('#class_level').val() || '').trim();
            const minVal = ($('#minimum_value').val() || '').trim();
            const description = ($('#description').val() || '').trim();

            if (!subjectName) {
                isValid = false;
                showError($('#subject_name'), $('#error-subject_name'), 'Subject name is required.');
            }

            if (!subjectCode) {
                isValid = false;
                showError($('#subject_code'), $('#error-subject_code'), 'Subject code is required.');
            }

            if (!subjectType) {
                isValid = false;
                showError($('#subject_type'), $('#error-subject_type'), 'Subject type is required.');
            }

            if (!classLevel) {
                isValid = false;
                showError($('#class_level'), $('#error-class_level'), 'Class level is required.');
            } else if (isNaN(parseInt(classLevel))) {
                isValid = false;
                showError($('#class_level'), $('#error-class_level'), 'Class level must be a valid number.');
            }

            if (!minVal) {
                isValid = false;
                showError($('#minimum_value'), $('#error-minimum_value'), 'Minimum value is required.');
            } else if (isNaN(parseFloat(minVal))) {
                isValid = false;
                showError($('#minimum_value'), $('#error-minimum_value'), 'Minimum value must be a valid number.');
            }

            if (!description) {
                isValid = false;
                showError($('#description'), $('#error-description'), 'Description is required.');
            }

            if (!isValid) {
                const $firstError = $('.validation-error-message:not(.hidden)').first();
                if ($firstError.length) {
                    $('html, body').animate({
                        scrollTop: $firstError.offset().top - 100
                    }, 400);
                }
            }

            return isValid;
        }

        function goBack() {
            window.location.href = returnUrl;
        }

        $(document).ready(function () {
            loadSubject();
        });

        function loadSubject() {
            const id = $('#subject_id').val();
            if (!id) return;

            $.get("/Subject/GetById", { id: id }, function (res) {
                if (!res.success) {
                    tailwindMessageModal('Failed', res.message || 'Failed to load subject');
                    return;
                }
                const d = res.data;
                $('#subject_name').val(d.subject_name || '');
                $('#subject_code').val(d.subject_code || '');
                $('#subject_type').val(d.subject_type || '');
                $('#class_level').val(d.class_level || '');
                $('#minimum_value').val(d.minimum_value || '');
                $('#description').val(d.description || '');
            });
        }

        async function updateSubject() {
            if (!validateForm()) return;
            const yes = await tailwindConfirmModal({
                title: 'Update Confirmation',
                message: 'Are you sure you want to update this data?',
                confirmText: 'Update',
                cancelText: 'Cancel'
            });
            if (!yes) return;

            const fd = new FormData();
            fd.append("subject_id", $('#subject_id').val());
            $('#frm').find('input,textarea,select').each(function () {
                fd.append(this.id, $(this).val());
            });

            $.ajax({
                url: "/Subject/Update",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: async res => {
                    if (res.success) {
                        await tailwindMessageModal('Success', res.message || 'Subject updated successfully.');
                        window.location.href = returnUrl;
                    } else {
                        await tailwindMessageModal('Failed', res.message || 'Failed to update subject');
                    }
                },
                error: async function () { await tailwindMessageModal('Error', 'An error occurred while updating the subject.'); }
            });
        }
    </script>
}
