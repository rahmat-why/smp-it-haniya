@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Subject";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Subject List</h2>
    <a href="/Subject/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
       data-testid="subject-add-button">
        + Add Subject
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <!-- Toolbar & search -->
    <div class="px-4 pt-4">
        <div id="subject-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <!-- DataTables akan inject length & search di sini -->
        </div>
    </div>

    <div class="overflow-x-auto px-4 pt-4">
        <table id="subject-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Subject</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 140px;">Code</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 140px;">Class</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 120px;">Minimum Value</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Description</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase !text-right" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <!-- Info + pagination -->
    <div class="px-4 pb-4 pt-3">
        <div id="subject-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            initSubjectTable();

            // Close menu when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.subject-actions-wrapper').length) {
                    $('.subject-actions-menu').addClass('hidden');
                }
            });
        });

        function initSubjectTable() {
            const table = $('#subject-table').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                lengthChange: true,
                ajax: {
                    url: '/Subject/GetAll',
                    type: 'POST'
                },
                dom: 'lftip',
                language: {
                    lengthMenu: "Show _MENU_ rows",
                    search: "",
                    searchPlaceholder: "Search...",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                },
                columns: [
                    {
                        data: 'subject_name',
                        className: 'py-3'
                    },
                    {
                        data: 'subject_code',
                        className: 'py-3'
                    },
                    {
                        data: 'class_level',
                        className: 'py-3'
                    },
                    {
                        data: 'minimum_value',
                        className: 'py-3'
                    },
                    {
                        data: 'description',
                        className: 'py-3'
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-right py-3',
                        render: function (data, type, row) {
                            var id = row.subject_id;
                            var editUrl = '/Subject/Edit?id=' + id;
                            return `
                                        <div class="flex justify-end subject-actions-wrapper relative">
                                            <button type="button"
                                                    onclick="toggleActionsMenu(event, '${id}')"
                                                    class="p-1.5 hover:bg-gray-100 rounded-md transition-colors duration-150"
                                                    data-testid="subject-actions-toggle-${id}">
                                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                                </svg>
                                            </button>
                                            <div id="actions-menu-${id}" class="subject-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">
                                                <a href="${editUrl}"
                                                   class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50"
                                                   data-testid="subject-edit-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    Edit
                                                </a>
                                                <button type="button"
                                                        onclick="delSubject('${id}')"
                                                        class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100"
                                                        data-testid="subject-delete-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    const wrapper = $('#subject-table_wrapper');
                    const $length = wrapper.find('.dataTables_length, .dt-length');
                    const $filter = wrapper.find('.dataTables_filter, .dt-search');
                    $('#subject-table-toolbar').empty().append($length).append($filter);

                    $length.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $length.find('label').addClass('flex items-center gap-2');
                    $length.find('select').addClass(
                        'border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 ' +
                        'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                    );

                    $filter.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $filter.find('label').addClass('flex items-center gap-2');
                    const $searchInput = $filter.find('input');
                    $searchInput
                        .addClass(
                            'border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white text-gray-700 ' +
                            'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full md:w-64'
                        )
                        .attr('placeholder', 'Search...');
                    $filter.addClass('w-full md:w-auto justify-end');

                    stylePagination();
                },
                drawCallback: function () {
                    setTimeout(stylePagination, 50);
                }
            });
        }

        function stylePagination() {
            const wrapper = $('#subject-table_wrapper');
            let $info = wrapper.find('.dataTables_info').first();
            if ($info.length === 0) $info = wrapper.find('.dt-info').first();

            let $paginate = wrapper.find('.dataTables_paginate').first();
            if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

            if ($info.length > 0) {
                $('#table-info-container').empty().append($info);
                $info.removeClass().addClass('text-sm text-gray-600');
            }

            if ($paginate.length > 0) {
                $('#table-pagination-container').empty().append($paginate);
            }

            $('#table-pagination-container').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
            if (typeof applyAdminPaginationStyle === 'function') {
                applyAdminPaginationStyle($('#table-pagination-container'));
            }
        }

        function toggleActionsMenu(event, id) {
            event.stopPropagation();
            $('.subject-actions-menu').addClass('hidden');
            const menu = $('#actions-menu-' + id);
            menu.toggleClass('hidden');
        }

        function delSubject(id) {
            $('.subject-actions-menu').addClass('hidden');
            if (!confirm("Delete this subject?")) return;

            $.ajax({
                url: "/Subject/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    action: "delete",
                    id: id,
                    data: null
                }),
                success: res => {
                    if (res.success) {
                        $('#subject-table').DataTable().ajax.reload(null, false);
                    } else {
                        alert(res.message || "Failed to delete subject");
                    }
                },
                error: function () {
                    alert("An error occurred while deleting the subject.");
                }
            });
        }
    </script>
}
