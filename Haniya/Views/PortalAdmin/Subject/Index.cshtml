@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Subject";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Subject List</h2>
    <a id="subject-add-link" href="/Subject/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
        + Add Subject
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="subject-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="relative overflow-x-auto px-4 pt-4">
        <div id="subject-table-loading" class="hidden absolute inset-0 z-20 bg-white/80 backdrop-blur-[1px] flex items-center justify-center">
            <div class="flex flex-col items-center gap-3 text-gray-600">
                <div class="w-8 h-8 border-4 border-blue-200 border-t-blue-700 rounded-full animate-spin"></div>
                <p class="text-sm font-medium">Loading subject data...</p>
            </div>
        </div>
        <table id="subject-table" class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th data-sort="subject" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Subject</th>
                    <th data-sort="code" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 140px;">Code</th>
                    <th data-sort="class" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 140px;">Class</th>
                    <th data-sort="minimumValue" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 120px;">Minimum Value</th>
                    <th data-sort="description" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Description</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 110px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3">
        <div id="subject-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
    const pageState = {
        page: 1,
        limit: 10,
        filters: { search: '' },
        sort: { field: 'subject', order: 'asc' },
        hasNextPage: false,
        totalRows: 0
    };
    let lastRequestKey = '';
    let searchDebounce = null;

    function getStateQuery() {
        return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`;
    }

    function syncStateToUrl() {
        history.replaceState({ ...pageState }, '', `?${getStateQuery()}`);
        $('#subject-add-link').attr('href', `/Subject/Create?returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`);
    }

    function hydrateStateFromUrl() {
        const q = new URLSearchParams(window.location.search);
        const page = Number(q.get('page') || 1);
        const limit = Number(q.get('limit') || 10);
        pageState.page = Number.isFinite(page) && page > 0 ? page : 1;
        pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10;
        pageState.filters.search = q.get('search') || '';
        pageState.sort.field = q.get('sortField') || 'subject';
        pageState.sort.order = q.get('sortOrder') || 'asc';
    }

    function renderToolbar() {
        const searchValue = (pageState.filters.search || '').replace(/"/g, '&quot;');
        $('#subject-table-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">
                Show
                <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select> rows
            </div>
            <div class="w-full md:w-80">
                <input id="subject_search_filter" type="text" value="${searchValue}" class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Search..." />
            </div>
        `);

        $('#list-limit').val(String(pageState.limit));
        $('#list-limit').off('change').on('change', function () {
            const next = Number($(this).val() || 10);
            if (pageState.limit === next) return;
            pageState.limit = next;
            pageState.page = 1;
            lastRequestKey = '';
            fetchSubjects();
        });
    }

    function renderSortIndicators() {
        $('#subject-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ↑' : ' ↓') : '';
            const base = $(this).text().replace(/ [↑↓]$/, '');
            $(this).text(base + icon);
        });
    }

    function renderRows(items) {
        const $tbody = $('#subject-table tbody');
        if (!items || !items.length) {
            $tbody.html(`
                <tr>
                    <td colspan="6" class="px-4 py-10 text-center">
                        <div class="flex flex-col items-center gap-2 text-gray-500">
                            <div class="text-sm font-semibold text-gray-700">Tidak ada data subject</div>
                            <div class="text-xs">Coba ubah kata kunci pencarian yang digunakan.</div>
                        </div>
                    </td>
                </tr>
            `);
            return;
        }

        let html = '';
        items.forEach(row => {
            const id = row.subject_id || '';
            const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            html += `
                <tr class="bg-white divide-y divide-gray-100">
                    <td class="px-4 py-3">${row.subject_name || '-'}</td>
                    <td class="px-4 py-3">${row.subject_code || '-'}</td>
                    <td class="px-4 py-3">${row.class_level || '-'}</td>
                    <td class="px-4 py-3">${row.minimum_value || '-'}</td>
                    <td class="px-4 py-3">${row.description || '-'}</td>
                    <td class="px-4 py-3 text-center">
                        <div class="flex flex-wrap gap-2 justify-center">
                            <a href="/Subject/Edit?id=${encodeURIComponent(id)}&returnUrl=${returnUrl}" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-blue-100 text-blue-700 hover:bg-blue-200" title="Edit">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                            </a>
                            <button type="button" onclick="delSubject('${id}')" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-red-100 text-red-700 hover:bg-red-200" title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#table-info-container').html(`<span class="text-sm text-gray-600">Menampilkan ${start} sampai ${end} dari ${pageState.totalRows} data</span>`);

        const totalPages = Math.max(1, Math.ceil(pageState.totalRows / pageState.limit));
        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        const pageStart = Math.max(1, Math.min(pageState.page - 1, totalPages - 2));
        const pageEnd = Math.min(totalPages, pageStart + 2);
        const pageButtons = [];
        for (let i = pageStart; i <= pageEnd; i++) {
            const active = i === pageState.page;
            pageButtons.push(`<button type="button" data-page="${i}" class="page-number px-3 py-2 text-sm border-l border-gray-200 ${active ? 'bg-blue-900 text-white font-semibold' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${active ? 'disabled' : ''}>${i}</button>`);
        }

        $('#table-pagination-container').html(`
            <div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                <button id="page-first" class="px-3 py-2 text-sm ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>First</button>
                <button id="page-prev" class="px-3 py-2 text-sm border-l border-gray-200 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>
                ${pageButtons.join('')}
                <button id="page-next" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Next</button>
                <button id="page-last" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Last</button>
            </div>
        `);

        function goToPage(page) {
            const nextPage = Math.min(Math.max(1, page), totalPages);
            if (nextPage === pageState.page) return;
            pageState.page = nextPage;
            lastRequestKey = '';
            fetchSubjects();
        }

        $('#page-first').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            goToPage(1);
        });

        $('#page-prev').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            goToPage(pageState.page - 1);
        });

        $('.page-number').off('click').on('click', function () {
            goToPage(Number($(this).data('page') || 1));
        });

        $('#page-next').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            goToPage(pageState.page + 1);
        });

        $('#page-last').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            goToPage(totalPages);
        });
    }

    function setSubjectLoading(isLoading) {
        $('#subject-table-loading').toggleClass('hidden', !isLoading);
    }

    async function fetchSubjects() {
        const payload = {
            page: pageState.page,
            limit: pageState.limit,
            filters: { ...pageState.filters },
            sort: { ...pageState.sort }
        };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();
        setSubjectLoading(true);

        try {
            const res = await $.ajax({
                url: '/Subject/GetAll',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });

            if (!res.success) {
                lastRequestKey = '';
                await tailwindMessageModal('Failed', res.message || 'Failed to load subject data.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.page = Number(result.currentPage || pageState.page);
            pageState.limit = Number(result.limit || 10);
            pageState.hasNextPage = !!result.hasNextPage;
            pageState.totalRows = Number(result.totalRows || 0);
            syncStateToUrl();
            renderRows(items);
            renderPagination(items.length);
        } catch {
            lastRequestKey = '';
            await tailwindMessageModal('Error', 'An error occurred while loading subject data.');
        } finally {
            setSubjectLoading(false);
        }
    }

    async function delSubject(id) {
        const yes = await tailwindConfirmModal({
            title: 'Delete Confirmation',
            message: 'Are you sure you want to delete this data?',
            confirmText: 'Delete',
            cancelText: 'Cancel'
        });
        if (!yes) return;

        try {
            const res = await $.ajax({
                url: '/Subject/Delete',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ action: 'delete', id: id, data: null })
            });
            if (!res || !res.success) {
                await tailwindMessageModal('Failed', (res && res.message) ? res.message : 'Delete failed.');
                return;
            }
            lastRequestKey = '';
            await fetchSubjects();
            await tailwindMessageModal('Deleted', 'Subject data has been deleted.');
        } catch {
            await tailwindMessageModal('Error', 'An error occurred while deleting the subject.');
        }
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();
        fetchSubjects();

        $('#subject-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) {
                pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            } else {
                pageState.sort.field = field;
                pageState.sort.order = 'asc';
            }
            pageState.page = 1;
            lastRequestKey = '';
            fetchSubjects();
        });

        $(document).on('input', '#subject_search_filter', function () {
            const val = ($(this).val() || '').trim();
            if ((pageState.filters.search || '') === val) return;
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                pageState.filters.search = val;
                pageState.page = 1;
                lastRequestKey = '';
                fetchSubjects();
            }, 300);
        });
    });
</script>
}
