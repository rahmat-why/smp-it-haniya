@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Edit Attendance";
    var id = ViewBag.attendanceId;
}

<input type="hidden" id="attendance_id" name="attendance_id" value="@id">

<h2 class="text-2xl font-bold text-gray-800 mb-6">Edit Attendance</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="attendanceForm" class="space-y-8">
        <!-- Header Fields -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Date -->
            <div>
                <label for="attendance_date" class="block text-sm font-medium text-gray-700 mb-2">
                    Date <span class="text-red-600">*</span>
                </label>
                <input type="date" id="attendance_date"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                       required data-testid="attendance-date-input" />
                <p id="error-date" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <!-- Class (Readonly Text) -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Class <span class="text-red-600">*</span>
                </label>
                <div id="class_display"
                     class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700 cursor-not-allowed"
                     data-testid="attendance-class-display">
                    -- Loading Class --
                </div>
                <input type="hidden" id="academic_class_id" name="academic_class_id" />
                <p id="error-class" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <!-- Teacher (Readonly Text) -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Teacher <span class="text-red-600">*</span>
                </label>
                <div id="teacher_display"
                     class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700 cursor-not-allowed"
                     data-testid="attendance-teacher-display">
                    -- Loading Teacher --
                </div>
                <input type="hidden" id="teacher_id" name="teacher_id" />
                <p id="error-teacher" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>
        </div>

        <!-- Attendance Details -->
        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-gray-800">Attendance Details</h3>

            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[500px] shadow-inner">
                <table class="min-w-full divide-y divide-gray-200 table-fixed">
                    <thead class="bg-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-5/12">Student</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12">Status</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Notes</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-details" data-testid="attendance-details-body"></tbody>
                </table>
            </div>

            <p id="error-details" class="text-sm text-red-600 hidden"></p>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <button type="button" onclick="goBackAttendance()"
                    class="px-6 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-lg font-medium transition focus:outline-none focus:ring-2 focus:ring-gray-300 flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back
            </button>
            <button type="button" onclick="updateAttendance()"
                    class="px-6 py-2.5 bg-blue-700 hover:bg-blue-800 text-white rounded-lg font-medium transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 flex items-center">
                Update
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Render student row (same as Create)
        function renderStudentRow(detail) {
            const photo = detail.profile_photo || '/image/no-image.png';
            const name = detail.student_name || 'Unknown Student';
            const nis = detail.nis || '-';
            const status = detail.status || 'PRESENT';

            const rowHtml = `
                        <tr class="hover:bg-gray-50 transition-colors border-b last:border-0">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <img src="${photo}" alt="${name}"
                                         class="w-10 h-10 rounded-full object-cover border border-gray-200 flex-shrink-0"
                                         onerror="this.src='/image/no-image.png'">
                                    <div>
                                        <div class="font-medium text-gray-900">${name}</div>
                                        <div class="text-xs text-gray-600">NIS: ${nis}</div>
                                    </div>
                                </div>
                                <input type="hidden" name="student_ids" value="${detail.student_id}" />
                            </td>
                            <td class="px-4 py-3">
                                <select name="statuses" class="status-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
                                    <option value="">-- Pilih Status --</option>
                                    <option value="PRESENT">Hadir</option>
                                    <option value="SICK">Sakit</option>
                                    <option value="EXCUSED">Izin</option>
                                    <option value="NOINFO">Alpa</option>
                                </select>
                            </td>
                            <td class="px-4 py-3">
                                <input type="text" name="notes" value="${detail.notes || ''}"
                                       class="w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" />
                            </td>
                        </tr>
                    `;

            $('#tbody-details').append(rowHtml);

            // Set status after append
            const $select = $('#tbody-details tr:last-child .status-select');
            $select.val(status).trigger('change');
        }

        function collectDetails() {
            const rows = [];
            $('#tbody-details tr').each(function () {
                const $row = $(this);
                const student_id = $row.find('input[name="student_ids"]').val();
                const status = $row.find('.status-select').val();
                const notes = $row.find('input[name="notes"]').val() || '';

                if (student_id && status) {
                    rows.push({ student_id, status, notes });
                }
            });
            return rows;
        }

        function showError($el, message) {
            $el.text(message).removeClass('hidden');
        }

        function clearError($el) {
            $el.text('').addClass('hidden');
        }

        function clearAllErrors() {
            clearError($('#error-date'));
            clearError($('#error-class'));
            clearError($('#error-teacher'));
            clearError($('#error-details'));
        }

        function validateForm() {
            clearAllErrors();
            let isValid = true;

            if (!$('#attendance_date').val()) {
                showError($('#error-date'), 'Please select a date.');
                isValid = false;
            }
            if (!$('#academic_class_id').val()) {
                showError($('#error-class'), 'Class is required.');
                isValid = false;
            }
            if (!$('#teacher_id').val()) {
                showError($('#error-teacher'), 'Teacher is required.');
                isValid = false;
            }

            const details = collectDetails();
            if (details.length === 0) {
                showError($('#error-details'), 'At least one detail row is required.');
                isValid = false;
            } else {
                let allValid = true;
                details.forEach(d => {
                    if (!d.status) allValid = false;
                });
                if (!allValid) {
                    showError($('#error-details'), 'All students must have a status selected.');
                    isValid = false;
                }
            }

            return isValid;
        }

        function goBackAttendance() {
            window.location.href = "/Attendance";
        }

        function updateAttendance() {
            if (!validateForm()) return;

            const formData = new FormData();
            formData.append("attendance_id", $('#attendance_id').val());
            formData.append("attendance_date", $('#attendance_date').val());
            formData.append("academic_class_id", $('#academic_class_id').val());
            formData.append("teacher_id", $('#teacher_id').val());
            formData.append("details", JSON.stringify(collectDetails()));

            $.ajax({
                url: "/Attendance/Update",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        window.location.href = "/Attendance";
                    } else {
                        alert(res.message || "Failed to update attendance.");
                    }
                },
                error: function () {
                    alert("An error occurred while updating attendance.");
                }
            });
        }

        function loadAttendance() {
            const id = $('#attendance_id').val();
            if (!id) return;

            $.getJSON(`/Attendance/GetById?id=${id}`, function (res) {
                if (!res.success) {
                    alert(res.message || "Failed to load attendance");
                    return;
                }

                const data = res.data;

                $('#attendance_date').val(data.attendance_date || '');

                // Set Class (readonly)
                $('#academic_class_id').val(data.academic_class_id || '');
                $('#class_display').text(data.class_name || '-- No Class --');

                // Set Teacher (readonly)
                $('#teacher_id').val(data.teacher_id || '');
                $('#teacher_display').text(data.teacher_name || '-- No Teacher --');  // Jika backend return teacher_name

                $('#tbody-details').empty();

                if (data.details && data.details.length > 0) {
                    data.details.forEach(detail => {
                        renderStudentRow(detail);
                    });
                } else {
                    $('#tbody-details').html(`
                                <tr>
                                    <td colspan="3" class="px-6 py-8 text-center text-gray-500 italic">
                                        No attendance details found
                                    </td>
                                </tr>
                            `);
                }
            }).fail(function () {
                alert("Error loading attendance data");
            });
        }

        $(document).ready(function () {
            loadAttendance();
        });
    </script>
}