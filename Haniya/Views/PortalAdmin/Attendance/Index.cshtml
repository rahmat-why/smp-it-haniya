@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Attendance";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Attendance List</h2>
    <a href="/Attendance/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
       data-testid="attendance-add-button">
        + Add Attendance
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="attendance-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="overflow-x-auto px-4 pt-4">
        <table id="attendance-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Academic Year</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Semester</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Date</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Class</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Teacher</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 200px;">Summary</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <!-- Info + pagination -->
    <div class="px-4 pb-4 pt-3">
        <div id="attendance-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let attendanceTable = null;
        let currentAttendanceMonth = '';
        let currentAcademicYearId = '';
        let currentAcademicClassId = '';

        $(document).ready(function () {
            // Default to current month (yyyy-MM)
            const today = new Date();
            currentAttendanceMonth = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;

            initAttendanceTable();

            // Close menu when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.attendance-actions-wrapper').length) {
                    $('.attendance-actions-menu').addClass('hidden');
                }
            });
        });

        function initAttendanceTable() {
            attendanceTable = $('#attendance-table').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                lengthChange: true,
                ajax: {
                    url: '/Attendance/GetAll',
                    type: 'POST',
                    data: function (d) {
                        d.academic_year_id = currentAcademicYearId || null;
                        d.academic_class_id = currentAcademicClassId || null;
                        d.attendance_month = currentAttendanceMonth || null;
                    }
                },
                dom: 'lftip',
                language: {
                    lengthMenu: "Show _MENU_ rows",
                    search: "",
                    searchPlaceholder: "Search...",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                },
                columns: [
                    {
                        data: null,
                        className: 'py-3',
                        render: function (data, type, row) {
                            return `${formatYearShort(row.start_date)} - ${formatYearShort(row.end_date)}`;
                        }
                    },
                    {
                        data: 'semester',
                        className: 'py-3',
                        render: function (data) {
                            return data ? `Semester ${data}` : '-';
                        }
                    },
                    {
                        data: 'attendance_date',
                        className: 'py-3 text-gray-900',
                        render: function (data) {
                            if (!data) return '-';
                            return new Date(data).toLocaleDateString('id-ID', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            });
                        }
                    },
                    {
                        data: 'class_name',
                        className: 'py-3 text-gray-700'
                    },
                    {
                        data: 'teacher_name',
                        className: 'py-3 text-gray-700'
                    },
                    {
                        data: null,
                        className: 'py-3',
                        render: function (row) {
                            return `Hadir: ${row.present || 0} | Sakit: ${row.sick || 0} | Izin: ${row.permit || 0} | Alpa: ${row.alpha || 0}`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-center py-3',
                        render: function (data, type, row) {
                            var id = row.attendance_id;
                            var editUrl = '/Attendance/Edit?id=' + id;
                            return `
                                        <div class="flex justify-center attendance-actions-wrapper relative">
                                            <button type="button"
                                                    onclick="toggleActionsMenu(event, '${id}')"
                                                    class="p-1.5 hover:bg-gray-100 rounded-md transition-colors duration-150"
                                                    data-testid="attendance-actions-toggle-${id}">
                                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                                </svg>
                                            </button>
                                            <div id="actions-menu-${id}" class="attendance-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">
                                                <a href="${editUrl}"
                                                   class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50"
                                                   data-testid="attendance-edit-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    Edit
                                                </a>
                                                <button type="button"
                                                        onclick="delAttendance('${id}')"
                                                        class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100"
                                                        data-testid="attendance-delete-action-${id}">
                                                    <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    const wrapper = $('#attendance-table_wrapper');

                    const $length = wrapper.find('.dataTables_length, .dt-length');
                    const $filter = wrapper.find('.dataTables_filter, .dt-search');

                    $filter.hide();

                    const $toggleFilter = $(`
                        <div class="relative">
                            <button id="filterToggleBtn"
                                    onclick="toggleFilter()"
                                    class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                                </svg>
                                Filter
                            </button>

                            <div id="filterDropdown"
                                 class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                                    <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                                    <button type="button"
                                            onclick="toggleFilter()"
                                            class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </button>
                                </div>
                                <div class="px-5 py-4 space-y-4">
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_academic_year">Academic Year</label>
                                        <select id="filter_academic_year" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_month">Attendance Month</label>
                                        <input type="month" id="filter_month"
                                               value="${currentAttendanceMonth}"
                                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_class">Class</label>
                                        <select id="filter_class" class="w-full"></select>
                                    </div>
                                </div>
                                <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                                    <button type="button"
                                            onclick="applyAttendanceFilter()"
                                            class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">
                                        Filter
                                    </button>
                                </div>
                            </div>
                        </div>
                    `);

                    $('#attendance-table-toolbar').empty().append($length).append($toggleFilter);

                    $length.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $length.find('label').addClass('flex items-center gap-2');
                    $length.find('select').addClass(
                        'border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 ' +
                        'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                    );

                    $('#attendance-table-toolbar').addClass('flex flex-col md:flex-row md:items-center md:justify-between gap-4');

                    $('#filter_academic_year').select2({
                        placeholder: "All Academic Years",
                        allowClear: true,
                        width: '100%',
                        ajax: {
                            url: '/Select2/AcademicYears',
                            dataType: 'json',
                            delay: 250,
                            data: params => ({ q: params.term || '', page: params.page || 1 }),
                            processResults: data => ({ results: data.results, pagination: data.pagination }),
                            cache: true
                        },
                        minimumInputLength: 0
                    });

                    $('#filter_class').select2({
                        placeholder: "-- All Classes --",
                        allowClear: true,
                        width: '100%',
                        ajax: {
                            url: '/Select2/AcademicClasses',
                            dataType: 'json',
                            delay: 250,
                            data: params => ({ q: params.term || '', page: params.page || 1, activeOnly: true }),
                            processResults: data => ({ results: data.results, pagination: data.pagination }),
                            cache: true
                        },
                        minimumInputLength: 0
                    });

                    $.ajax({
                        url: '/Attendance/GetActiveAcademicYear',
                        type: 'GET',
                        success: function (res) {
                            if (!res || !res.success || !res.data || !res.data.id) return;

                            currentAcademicYearId = res.data.id;

                            if ($('#filter_academic_year option[value="' + res.data.id + '"]').length === 0) {
                                const option = new Option(res.data.text || '', res.data.id, true, true);
                                $('#filter_academic_year').append(option);
                            }

                            $('#filter_academic_year').val(res.data.id).trigger('change');
                            attendanceTable.ajax.reload(null, true);
                        }
                    });

                    stylePagination();
                },
                drawCallback: function () {
                    setTimeout(stylePagination, 50);
                }
            });
        }

        function applyAttendanceFilter() {
            currentAcademicYearId = $('#filter_academic_year').val() || '';
            currentAttendanceMonth = $('#filter_month').val() || '';
            currentAcademicClassId = $('#filter_class').val() || '';
            attendanceTable.ajax.reload(null, true);
            toggleFilter();
        }

        function formatYearShort(d) {
            if (!d) return "";
            const date = new Date(d);
            if (isNaN(date.getTime())) return "";
            return date.getFullYear();
        }

        function stylePagination() {
            const wrapper = $('#attendance-table_wrapper');
            let $info = wrapper.find('.dataTables_info').first();
            if ($info.length === 0) $info = wrapper.find('.dt-info').first();

            let $paginate = wrapper.find('.dataTables_paginate').first();
            if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

            if ($info.length > 0) {
                $('#table-info-container').empty().append($info);
                $info.removeClass().addClass('text-sm text-gray-600');
            }

            if ($paginate.length > 0) {
                $('#table-pagination-container').empty().append($paginate);
            }

            $('#table-pagination-container').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
            if (typeof applyAdminPaginationStyle === 'function') {
                applyAdminPaginationStyle($('#table-pagination-container'));
            }
        }

        function toggleActionsMenu(event, id) {
            event.stopPropagation();
            $('.attendance-actions-menu').addClass('hidden');
            const menu = $('#actions-menu-' + id);
            menu.toggleClass('hidden');
        }

        function delAttendance(id) {
            $('.attendance-actions-menu').addClass('hidden');
            if (!confirm("Delete this attendance record?")) return;

            $.ajax({
                url: "/Attendance/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    action: "delete",
                    id: id,
                    data: null
                }),
                success: res => {
                    if (res.success) {
                        $('#attendance-table').DataTable().ajax.reload(null, false);
                    } else {
                        alert(res.message || "Failed to delete attendance record");
                    }
                },
                error: function () {
                    alert("An error occurred while deleting the attendance record.");
                }
            });
        }
    </script>
}
