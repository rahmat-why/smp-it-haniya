@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Attendance";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Attendance List</h2>
    <a id="attendance-add-link" href="/Attendance/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
        + Add Attendance
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="attendance-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="relative overflow-x-auto px-4 pt-4">
        <div id="attendance-table-loading" class="hidden absolute inset-0 z-20 bg-white/80 backdrop-blur-[1px] flex items-center justify-center">
            <div class="flex flex-col items-center gap-3 text-gray-600">
                <div class="w-8 h-8 border-4 border-blue-200 border-t-blue-700 rounded-full animate-spin"></div>
                <p class="text-sm font-medium">Loading attendance data...</p>
            </div>
        </div>
        <table id="attendance-table" class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th data-sort="academicYear" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Academic Year</th>
                    <th data-sort="semester" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Semester</th>
                    <th data-sort="date" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Date</th>
                    <th data-sort="class" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Class</th>
                    <th data-sort="teacher" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Teacher</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Summary</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 110px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3">
        <div id="attendance-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
    const pageState = {
        page: 1,
        limit: 10,
        filters: { academic_year_id: '', academic_class_id: '', attendance_month: '' },
        sort: { field: 'date', order: 'desc' },
        hasNextPage: false,
        totalRows: 0
    };
    let lastRequestKey = '';

    function getStateQuery() {
        return `page=${pageState.page}&limit=${pageState.limit}&academicYear=${encodeURIComponent(pageState.filters.academic_year_id || '')}&academicClass=${encodeURIComponent(pageState.filters.academic_class_id || '')}&month=${encodeURIComponent(pageState.filters.attendance_month || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`;
    }

    function syncStateToUrl() {
        history.replaceState({ ...pageState }, '', `?${getStateQuery()}`);
        $('#attendance-add-link').attr('href', `/Attendance/Create?returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`);
    }

    function hydrateStateFromUrl() {
        const q = new URLSearchParams(window.location.search);
        const page = Number(q.get('page') || 1);
        const limit = Number(q.get('limit') || 10);
        pageState.page = Number.isFinite(page) && page > 0 ? page : 1;
        pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10;
        pageState.filters.academic_year_id = q.get('academicYear') || '';
        pageState.filters.academic_class_id = q.get('academicClass') || '';
        pageState.filters.attendance_month = q.get('month') || '';
        pageState.sort.field = q.get('sortField') || 'date';
        pageState.sort.order = q.get('sortOrder') || 'desc';
    }

    function renderToolbar() {
        $('#attendance-table-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">
                Show
                <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select> rows
            </div>
            <div class="relative">
                <button id="attendanceFilterToggleBtn" type="button" class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                    Filter
                </button>
                <div id="attendanceFilterDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                        <button type="button" id="attendanceFilterCloseBtn" class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">?</button>
                    </div>
                    <div class="px-5 py-4 space-y-4">
                        <div><label class="block text-xs font-medium mb-1" for="filter_academic_year">Academic Year</label><select id="filter_academic_year" class="w-full"></select></div>
                        <div><label class="block text-xs font-medium mb-1" for="filter_month">Attendance Month</label><input type="month" id="filter_month" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" /></div>
                        <div><label class="block text-xs font-medium mb-1" for="filter_class">Class</label><select id="filter_class" class="w-full"></select></div>
                    </div>
                    <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                        <button type="button" id="apply-attendance-filter-btn" class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">Filter</button>
                    </div>
                </div>
            </div>
        `);

        $('#list-limit').val(String(pageState.limit)).off('change').on('change', function () {
            const next = Number($(this).val() || 10);
            if (pageState.limit === next) return;
            pageState.limit = next;
            pageState.page = 1;
            lastRequestKey = '';
            fetchAttendances();
        });

        const $dropdown = $('#attendanceFilterDropdown');
        $('#attendanceFilterToggleBtn').off('click').on('click', function () { $dropdown.toggleClass('hidden'); });
        $('#attendanceFilterCloseBtn').off('click').on('click', function () { $dropdown.addClass('hidden'); });
        $('#apply-attendance-filter-btn').off('click').on('click', applyAttendanceFilter);

        $('#filter_month').val(pageState.filters.attendance_month || '');

        $('#filter_academic_year').select2({
            placeholder: 'All Academic Years',
            allowClear: true,
            width: '100%',
            ajax: {
                url: '/Select2/AcademicYears',
                dataType: 'json',
                delay: 250,
                data: params => ({ q: params.term || '', page: params.page || 1 }),
                processResults: data => ({ results: data.results, pagination: data.pagination }),
                cache: true
            },
            minimumInputLength: 0
        });

        $('#filter_class').select2({
            placeholder: '-- All Classes --',
            allowClear: true,
            width: '100%',
            ajax: {
                url: '/Select2/AcademicClasses',
                dataType: 'json',
                delay: 250,
                data: params => ({ q: params.term || '', page: params.page || 1, activeOnly: true }),
                processResults: data => ({ results: data.results, pagination: data.pagination }),
                cache: true
            },
            minimumInputLength: 0
        });

        if (pageState.filters.academic_year_id) {
            upsertSelect2Value('#filter_academic_year', pageState.filters.academic_year_id, pageState.filters.academic_year_id);
        }
        if (pageState.filters.academic_class_id) {
            upsertSelect2Value('#filter_class', pageState.filters.academic_class_id, pageState.filters.academic_class_id);
        }
    }

    function upsertSelect2Value(selector, id, text) {
        if (!id) return;
        if ($(selector + ` option[value="${id}"]`).length === 0) {
            const option = new Option(text || id, id, true, true);
            $(selector).append(option);
        }
        $(selector).val(id).trigger('change');
    }

    async function initDefaultAcademicYear() {
        if (!pageState.filters.academic_year_id) return;
        try {
            const res = await $.get('/Attendance/GetActiveAcademicYear');
            if (!res || !res.success || !res.data || !res.data.id) return;
            const text = res.data.id === pageState.filters.academic_year_id ? res.data.text : pageState.filters.academic_year_id;
            upsertSelect2Value('#filter_academic_year', pageState.filters.academic_year_id, text);
        } catch { }
    }

    function applyAttendanceFilter() {
        pageState.filters.academic_year_id = $('#filter_academic_year').val() || '';
        pageState.filters.academic_class_id = $('#filter_class').val() || '';
        pageState.filters.attendance_month = $('#filter_month').val() || '';
        pageState.page = 1;
        lastRequestKey = '';
        fetchAttendances();
        $('#attendanceFilterDropdown').addClass('hidden');
    }

    function renderSortIndicators() {
        $('#attendance-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ↑' : ' ↓') : '';
            const base = $(this).text().replace(/ [↑↓]$/, '');
            $(this).text(base + icon);
        });
    }

    function formatDate(value) {
        if (!value) return '-';
        const date = new Date(value);
        if (isNaN(date.getTime())) return '-';
        return date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
    }

    function renderRows(items) {
        const $tbody = $('#attendance-table tbody');
        if (!items || !items.length) {
            $tbody.html(`
                <tr>
                    <td colspan="7" class="px-4 py-10 text-center">
                        <div class="flex flex-col items-center gap-2 text-gray-500">
                            <div class="text-sm font-semibold text-gray-700">Tidak ada data attendance</div>
                            <div class="text-xs">Coba ubah bulan, tahun ajaran, atau class yang digunakan.</div>
                        </div>
                    </td>
                </tr>
            `);
            return;
        }

        let html = '';
        const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
        items.forEach(row => {
            const id = row.attendance_id || '';
            html += `
                <tr>
                    <td class="px-4 py-3">${new Date(row.start_date).getFullYear()} - ${new Date(row.end_date).getFullYear()}</td>
                    <td class="px-4 py-3">${row.semester ? `Semester ${row.semester}` : '-'}</td>
                    <td class="px-4 py-3">${formatDate(row.attendance_date)}</td>
                    <td class="px-4 py-3">${row.class_name || '-'}</td>
                    <td class="px-4 py-3">${row.teacher_name || '-'}</td>
                    <td class="px-4 py-3">Hadir: ${row.present || 0} | Sakit: ${row.sick || 0} | Izin: ${row.permit || 0} | Alpa: ${row.alpha || 0}</td>
                    <td class="px-4 py-3 text-center">
                        <div class="flex flex-wrap gap-2 justify-center">
                            <a href="/Attendance/Edit?id=${encodeURIComponent(id)}&returnUrl=${returnUrl}" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-blue-100 text-blue-700 hover:bg-blue-200" title="Edit">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                            </a>
                            <button type="button" onclick="delAttendance('${id}')" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-red-100 text-red-700 hover:bg-red-200" title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#table-info-container').html(`<span class="text-sm text-gray-600">Menampilkan ${start} sampai ${end} dari ${pageState.totalRows} data</span>`);

        const totalPages = Math.max(1, Math.ceil(pageState.totalRows / pageState.limit));
        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        const pageStart = Math.max(1, Math.min(pageState.page - 1, totalPages - 2));
        const pageEnd = Math.min(totalPages, pageStart + 2);
        const pageButtons = [];
        for (let i = pageStart; i <= pageEnd; i++) {
            const active = i === pageState.page;
            pageButtons.push(`<button type="button" data-page="${i}" class="page-number px-3 py-2 text-sm border-l border-gray-200 ${active ? 'bg-blue-900 text-white font-semibold' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${active ? 'disabled' : ''}>${i}</button>`);
        }

        $('#table-pagination-container').html(`
            <div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                <button id="page-first" class="px-3 py-2 text-sm ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>First</button>
                <button id="page-prev" class="px-3 py-2 text-sm border-l border-gray-200 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>
                ${pageButtons.join('')}
                <button id="page-next" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Next</button>
                <button id="page-last" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Last</button>
            </div>
        `);

        function goToPage(page) {
            const nextPage = Math.min(Math.max(1, page), totalPages);
            if (nextPage === pageState.page) return;
            pageState.page = nextPage;
            lastRequestKey = '';
            fetchAttendances();
        }

        $('#page-first').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            goToPage(1);
        });

        $('#page-prev').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            goToPage(pageState.page - 1);
        });

        $('.page-number').off('click').on('click', function () {
            goToPage(Number($(this).data('page') || 1));
        });

        $('#page-next').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            goToPage(pageState.page + 1);
        });

        $('#page-last').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            goToPage(totalPages);
        });
    }

    function setAttendanceLoading(isLoading) {
        $('#attendance-table-loading').toggleClass('hidden', !isLoading);
    }

    async function fetchAttendances() {
        const payload = {
            page: pageState.page,
            limit: pageState.limit,
            filters: { ...pageState.filters },
            sort: { ...pageState.sort }
        };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();
        setAttendanceLoading(true);

        try {
            const res = await $.ajax({
                url: '/Attendance/GetAll',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });

            if (!res || !res.success) {
                lastRequestKey = '';
                await tailwindMessageModal('Failed', (res && res.message) ? res.message : 'Failed to load attendance data.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.page = Number(result.currentPage || pageState.page);
            pageState.limit = Number(result.limit || 10);
            pageState.hasNextPage = !!result.hasNextPage;
            pageState.totalRows = Number(result.totalRows || 0);
            syncStateToUrl();
            renderRows(items);
            renderPagination(items.length);
        } catch {
            lastRequestKey = '';
            await tailwindMessageModal('Error', 'An error occurred while loading attendance data.');
        } finally {
            setAttendanceLoading(false);
        }
    }

    async function delAttendance(id) {
        const yes = await tailwindConfirmModal({
            title: 'Delete Confirmation',
            message: 'Are you sure you want to delete this attendance record?',
            confirmText: 'Delete',
            cancelText: 'Cancel'
        });
        if (!yes) return;

        try {
            const res = await $.ajax({
                url: '/Attendance/Delete',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ action: 'delete', id: id, data: null })
            });
            if (!res || !res.success) {
                await tailwindMessageModal('Failed', (res && res.message) ? res.message : 'Delete failed.');
                return;
            }
            lastRequestKey = '';
            await fetchAttendances();
            await tailwindMessageModal('Deleted', 'Attendance has been deleted.');
        } catch {
            await tailwindMessageModal('Error', 'An error occurred while deleting the attendance.');
        }
    }

    $(document).ready(async function () {
        hydrateStateFromUrl();
        renderToolbar();
        await initDefaultAcademicYear();
        renderSortIndicators();
        fetchAttendances();

        $(document).on('click', function (e) {
            const $dropdown = $('#attendanceFilterDropdown');
            const isToggle = $(e.target).closest('#attendanceFilterToggleBtn').length > 0;
            const isInsideDropdown = $(e.target).closest('#attendanceFilterDropdown').length > 0;
            const isSelect2 = $(e.target).closest('.select2-container, .select2-dropdown').length > 0;
            if (!isToggle && !isInsideDropdown && !isSelect2) $dropdown.addClass('hidden');
        });

        $('#attendance-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) {
                pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            } else {
                pageState.sort.field = field;
                pageState.sort.order = 'asc';
            }
            pageState.page = 1;
            lastRequestKey = '';
            fetchAttendances();
        });
    });
</script>
}
