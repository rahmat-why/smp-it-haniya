@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Tambah Absensi";
}

<h2 class="text-2xl font-bold text-gray-800 mb-6">Tambah Absensi</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="attendanceForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label for="attendance_date" class="block text-sm font-medium text-gray-700 mb-2">Tanggal Absensi <span class="text-red-600">*</span></label>
                <input type="date" id="attendance_date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" required />
                <p id="error-date" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="academic_class_id" class="block text-sm font-medium text-gray-700 mb-2">Kelas <span class="text-red-600">*</span></label>
                <select id="academic_class_id" class="w-full"></select>
                <p id="error-class" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Guru <span class="text-red-600">*</span></label>
                <div id="teacher_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-- Pilih Kelas Terlebih Dahulu --</div>
                <input type="hidden" id="teacher_id" name="teacher_id" />
                <p id="error-teacher" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>
        </div>

        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-gray-800">Detail Absensi</h3>
            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[500px] shadow-inner">
                <table class="min-w-full divide-y divide-gray-200 table-fixed">
                    <thead class="bg-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-5/12 uppercase">Siswa</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12 uppercase">Status</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12 uppercase">Catatan</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-details"></tbody>
                </table>
            </div>
            <p id="error-details" class="text-sm text-red-600 hidden"></p>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <button type="button" onclick="goBackAttendance()" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm">
                Kembali
            </button>
            <button type="button" onclick="saveAttendance()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm">
                Simpan
            </button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
    const statusOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StatusOptions));
    const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Attendance';
    document.getElementById('attendance_date').value = new Date().toISOString().split('T')[0];

    function showError($el, message) { $el.text(message).removeClass('hidden'); }
    function clearError($el) { $el.text('').addClass('hidden'); }
    function clearAllErrors() {
        clearError($('#error-date')); clearError($('#error-class')); clearError($('#error-teacher')); clearError($('#error-details'));
    }

    function renderStudents(students) {
        const tbody = $('#tbody-details').empty();
        if (!students || !students.length) {
            tbody.html('<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500 italic">Tidak ada siswa di kelas ini</td></tr>');
            return;
        }

        students.forEach(student => {
            const photo = student.profile_photo || '/image/no-image.png';
            const name = student.full_name || 'Unknown Student';
            const nis = student.nis || '-';

            let statusSelectHtml = `<select name="statuses" class="status-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">`;
            if (statusOptions && statusOptions.length) {
                statusOptions.forEach(opt => {
                    const selected = opt.Id === 'PRESENT' ? 'selected' : '';
                    statusSelectHtml += `<option value="${opt.Id}" ${selected}>${opt.Name}</option>`;
                });
            } else {
                statusSelectHtml += `
                    <option value="PRESENT" selected>Present</option>
                    <option value="SICK">Sick</option>
                    <option value="EXCUSED">Excused</option>
                    <option value="NOINFO">Absent</option>
                `;
            }
            statusSelectHtml += `</select>`;

            tbody.append(`
                <tr class="hover:bg-gray-50 transition-colors border-b last:border-0">
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <img src="${photo}" alt="${name}" class="w-10 h-10 rounded-full object-cover border border-gray-200 flex-shrink-0" onerror="this.src='/image/no-image.png'">
                            <div><div class="font-medium text-gray-900">${name}</div><div class="text-xs text-gray-600">NIS: ${nis}</div></div>
                        </div>
                        <input type="hidden" name="student_ids" value="${student.id}" />
                    </td>
                    <td class="px-4 py-3">
                        ${statusSelectHtml}
                    </td>
                    <td class="px-4 py-3"><input type="text" name="notes" class="w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" /></td>
                </tr>
            `);
        });
    }

    function validateForm() {
        clearAllErrors();
        let isValid = true;
        if (!$('#attendance_date').val()) { showError($('#error-date'), 'Please select a date.'); isValid = false; }
        if (!$('#academic_class_id').val()) { showError($('#error-class'), 'Please select a class.'); isValid = false; }
        if (!$('#teacher_id').val()) { showError($('#error-teacher'), 'Teacher is required.'); isValid = false; }
        if ($('#tbody-details tr').length === 0) { showError($('#error-details'), 'At least one student detail is required.'); isValid = false; }
        return isValid;
    }

    function goBackAttendance() { window.location.href = returnUrl; }

    async function saveAttendance() {
        if (!validateForm()) return;

        const yes = await tailwindConfirmModal({
            title: 'Create Confirmation',
            message: 'Are you sure you want to create this data?',
            confirmText: 'Create',
            cancelText: 'Cancel'
        });
        if (!yes) return;

        const formData = new FormData();
        formData.append('attendance_date', $('#attendance_date').val());
        formData.append('academic_class_id', $('#academic_class_id').val());
        formData.append('teacher_id', $('#teacher_id').val());

        const studentIds = [];
        const statuses = [];
        const notes = [];
        $('#tbody-details tr').each(function () {
            const $row = $(this);
            studentIds.push($row.find('input[name="student_ids"]').val());
            statuses.push($row.find('.status-select').val());
            notes.push($row.find('input[name="notes"]').val() || '');
        });

        formData.append('student_ids', JSON.stringify(studentIds));
        formData.append('statuses', JSON.stringify(statuses));
        formData.append('notes', JSON.stringify(notes));

        $.ajax({
            url: '/Attendance/Create',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: async function (res) {
                if (res.success) {
                    await tailwindMessageModal('Success', res.message || 'Attendance created successfully.');
                    window.location.href = returnUrl;
                } else {
                    await tailwindMessageModal('Failed', res.message || 'Failed to save attendance.');
                }
            },
            error: async function () { await tailwindMessageModal('Error', 'An error occurred while saving attendance.'); }
        });
    }

    $(document).ready(function () {
        $('#academic_class_id').select2({
            placeholder: '-- Pilih Kelas --',
            allowClear: true,
            width: '100%',
            ajax: {
                url: '/Select2/AcademicClasses',
                dataType: 'json',
                delay: 250,
                data: params => ({ q: params.term || '', page: params.page || 1, activeOnly: true }),
                processResults: data => ({ results: data.results, pagination: data.pagination }),
                cache: true
            },
            minimumInputLength: 0
        });

        $('#academic_class_id').on('change', function () {
            const classId = $(this).val();
            if (!classId) {
                $('#teacher_display').text('-- Pilih Kelas Terlebih Dahulu --');
                $('#teacher_id').val('');
                $('#tbody-details').empty();
                return;
            }

            $.getJSON(`/Attendance/GetTeacherByClass?academicClassId=${classId}`, function (res) {
                if (res.success && res.data) {
                    $('#teacher_display').text(res.data.text);
                    $('#teacher_id').val(res.data.id);
                } else {
                    $('#teacher_display').text('Tidak ada wali kelas yang ditugaskan');
                    $('#teacher_id').val('');
                }
            }).fail(function () { $('#teacher_display').text('Gagal memuat data'); });

            $.getJSON(`/Attendance/GetStudentsByClass?academicClassId=${classId}`, function (res) {
                if (res.success) {
                    renderStudents(res.data || []);
                } else {
                    $('#tbody-details').html('<tr><td colspan="3" class="px-6 py-8 text-center text-red-600">Gagal memuat data</td></tr>');
                }
            }).fail(function () {
                $('#tbody-details').html('<tr><td colspan="3" class="px-6 py-8 text-center text-red-600">Gagal memuat data</td></tr>');
            });
        });
    });
</script>
}
