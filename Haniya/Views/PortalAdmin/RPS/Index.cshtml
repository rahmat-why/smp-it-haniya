<!-- ~/Views/PortalAdmin/RPS/Index.cshtml -->
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "RPS (Rencana Pembelajaran Study)";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">RPS List</h2>
    <a href="/RPS/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
        + Add RPS
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="rps-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="overflow-x-auto px-4 pt-4">
        <table id="rps-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Subject</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center">Minimum Value</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Class</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Teacher</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Academic Year</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center">Meetings</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-right" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3">
        <div id="rps-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let rpsTable = null;
        let currentAcademicClassId = '';
        let currentSubjectId = '';
        let currentTeacherId = '';

        $(document).ready(function () {
            initRPSTable();

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.rps-actions-wrapper').length) {
                    $('.rps-actions-menu').addClass('hidden');
                }
            });
        });

        function initRPSTable() {
            rpsTable = $('#rps-table').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                lengthChange: true,
                ajax: {
                    url: '/RPS/GetAll',
                    type: 'GET',
                    data: function (d) {
                        d.subject_id = currentSubjectId || null;
                        d.academic_class_id = currentAcademicClassId || null;
                        d.teacher_id = currentTeacherId || null;
                    }
                },
                dom: 'lftip',
                language: {
                    lengthMenu: "Show _MENU_ rows",
                    search: "",
                    searchPlaceholder: "Search...",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                },
                columns: [
                    { data: 'subject_name', className: 'py-3 text-gray-900' },
                    { data: 'minimum_value', className: 'py-3' },
                    { data: 'class_name', className: 'py-3 text-gray-700' },
                    { data: 'teacher_name', className: 'py-3 text-gray-700' },
                    { data: 'academic_year_id', className: 'py-3 text-gray-700' },
                    {
                        data: 'meeting_count',
                        className: 'py-3 text-center',
                        render: data => data || 0
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-center py-3',
                        render: function (data, type, row) {
                            var id = row.rps_id;
                            var editUrl = '/RPS/Edit?id=' + id;
                            return `
                                        <div class="flex justify-center rps-actions-wrapper relative">
                                            <button type="button" onclick="toggleActionsMenu(event, '${id}')"
                                                    class="p-1.5 hover:bg-gray-100 rounded-md transition-colors duration-150">
                                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                                </svg>
                                            </button>
                                            <div id="actions-menu-${id}" class="rps-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">
                                                <a href="${editUrl}" class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50">
                                                    Edit
                                                </a>
                                                <button type="button" onclick="delRPS('${id}')"
                                                        class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100">
                                                    Delete
                                                </button>
                                            </div>
                                        </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    const wrapper = $('#rps-table_wrapper');
                    const $length = wrapper.find('.dataTables_length, .dt-length');
                    const $filter = wrapper.find('.dataTables_filter, .dt-search');
                    const initialSearch = (rpsTable.search() || '').replace(/"/g, '&quot;');

                    $filter.hide();

                    const $toggleFilter = $(`
                        <div class="relative">
                            <button id="filterToggleBtn"
                                    onclick="toggleFilter()"
                                    class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                                </svg>
                                Filter
                            </button>

                            <div id="filterDropdown"
                                 class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                                    <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                                    <button type="button"
                                            onclick="toggleFilter()"
                                            class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </button>
                                </div>
                                <div class="px-5 py-4 space-y-4">
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_class">Class</label>
                                        <select id="filter_class" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_subject">Subject</label>
                                        <select id="filter_subject" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_teacher">Teacher</label>
                                        <select id="filter_teacher" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="rps_search_filter">Search</label>
                                        <input id="rps_search_filter"
                                               type="text"
                                               value="${initialSearch}"
                                               class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                               placeholder="Search..." />
                                    </div>
                                </div>
                                <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                                    <button type="button"
                                            onclick="applyRPSFilter()"
                                            class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">
                                        Filter
                                    </button>
                                </div>
                            </div>
                        </div>
                    `);

                    $('#rps-table-toolbar').empty().append($length).append($toggleFilter);

                    $length.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $length.find('label').addClass('flex items-center gap-2');
                    $length.find('select').addClass(
                        'border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 ' +
                        'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                    );

                    $('#rps-table-toolbar').addClass('flex flex-col md:flex-row md:items-center md:justify-between gap-4');

                    $('#filter_class').select2({
                        placeholder: "-- All Classes --",
                        allowClear: true,
                        width: '100%',
                        ajax: {
                            url: '/Select2/AcademicClasses',
                            dataType: 'json',
                            delay: 250,
                            data: params => ({ q: params.term || '', page: params.page || 1 }),
                            processResults: data => ({ results: data.results, pagination: data.pagination }),
                            cache: true
                        },
                        minimumInputLength: 0
                    }).on('change', function () {
                        const cid = $(this).val();
                        if (cid) {
                            $.ajax({
                                url: `/Class/GetById?id=${cid}`,
                                type: 'GET',
                                dataType: 'json',
                                success: res => {
                                    initSubject(res.data.class_level);
                                },
                                error: () => {
                                    initSubject('');
                                }
                            });
                        } else {
                            initSubject('');
                        }
                    });

                    $('#filter_teacher').select2({
                        placeholder: "-- All Teachers --",
                        allowClear: true,
                        width: '100%',
                        ajax: {
                            url: '/Select2/Teachers',
                            dataType: 'json',
                            delay: 250,
                            data: params => ({ q: params.term || '', page: params.page || 1 }),
                            processResults: data => ({ results: data.results, pagination: data.pagination }),
                            cache: true
                        },
                        minimumInputLength: 0
                    });

                    initSubject('');

                    stylePagination();
                },
                drawCallback: function () {
                    setTimeout(stylePagination, 50);
                }
            });
        }

        function applyRPSFilter() {
            currentAcademicClassId = $('#filter_class').val() || '';
            currentSubjectId = $('#filter_subject').val() || '';
            currentTeacherId = $('#filter_teacher').val() || '';
            const searchKeyword = ($('#rps_search_filter').val() || '').trim();
            rpsTable.search(searchKeyword);
            rpsTable.ajax.reload(null, true);
            toggleFilter();
        }

        function stylePagination() {
            const wrapper = $('#rps-table_wrapper');
            let $info = wrapper.find('.dataTables_info').first();
            if ($info.length === 0) $info = wrapper.find('.dt-info').first();

            let $paginate = wrapper.find('.dataTables_paginate').first();
            if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

            if ($info.length > 0) {
                $('#table-info-container').empty().append($info);
                $info.removeClass().addClass('text-sm text-gray-600');
            }

            if ($paginate.length > 0) {
                $('#table-pagination-container').empty().append($paginate);
            }

            $('#table-pagination-container').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
            if (typeof applyAdminPaginationStyle === 'function') {
                applyAdminPaginationStyle($('#table-pagination-container'));
            }
        }

        function toggleActionsMenu(event, id) {
            event.stopPropagation();
            $('.rps-actions-menu').addClass('hidden');
            $('#actions-menu-' + id).toggleClass('hidden');
        }

        function delRPS(id) {
            $('.rps-actions-menu').addClass('hidden');
            if (!confirm("Delete this RPS? This will also delete all meeting details.")) return;

            $.ajax({
                url: "/RPS/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ id: id }),
                success: res => {
                    if (res.success) {
                        $('#rps-table').DataTable().ajax.reload(null, false);
                    } else {
                        alert(res.message || "Failed to delete RPS");
                    }
                },
                error: () => alert("Error deleting RPS")
            });
        }

        function initSubject(classLevel) {

            const $subject = $('#filter_subject');

            // Destroy select2 dulu kalau sudah pernah dibuat
            if ($subject.hasClass("select2-hidden-accessible")) {
                $subject.select2('destroy');
            }

            $subject.empty().val(null).trigger('change');

            $subject.select2({
                placeholder: "-- All Subjects --",
                allowClear: true,
                width: '100%',
                ajax: {
                    url: `/Select2/Subjects?classLevel=${classLevel}`,
                    dataType: 'json',
                    delay: 250,
                    data: p => ({
                        q: p.term || '',
                        page: p.page || 1
                    }),
                    processResults: d => ({
                        results: d.results,
                        pagination: d.pagination
                    }),
                    cache: true
                },
                minimumInputLength: 0
            });
        }
    </script>
}
