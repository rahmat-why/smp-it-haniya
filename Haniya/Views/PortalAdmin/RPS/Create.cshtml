<!-- ~/Views/PortalAdmin/RPS/Create.cshtml -->
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Create RPS";
}

<h2 class="text-2xl font-bold text-gray-800 mb-6">Create RPS (Rencana Pembelajaran Study)</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="rpsForm" class="space-y-8">
        <!-- Header Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="academic_class_id" class="block text-sm font-medium text-gray-700 mb-2">
                    Class <span class="text-red-600">*</span>
                </label>
                <select id="academic_class_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Class --" required></select>
                <p id="error-class" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="subject_id" class="block text-sm font-medium text-gray-700 mb-2">
                    Subject <span class="text-red-600">*</span>
                </label>
                <select id="subject_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Subject --" required></select>
                <p id="error-subject" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="teacher_id" class="block text-sm font-medium text-gray-700 mb-2">
                    Teacher <span class="text-red-600">*</span>
                </label>
                <select id="teacher_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Teacher --" required></select>
                <p id="error-teacher" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="minimum_value" class="block text-sm font-medium text-gray-700 mb-2">
                    Minimum Value <span class="text-red-600">*</span>
                </label>
                <input type="number" id="minimum_value" step="0.01" min="0" max="100" value="0" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                       placeholder="Enter minimum value"></input>
            </div>

            <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                    Description
                </label>
                <textarea id="description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                          placeholder="Enter RPS description..."></textarea>
            </div>
        </div>

        <!-- Grading Weights Section -->
        <div class="border-t border-gray-200 pt-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Grading Weights (Total must = 100%)</h3>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                <div>
                    <label for="weight_attendance" class="block text-sm font-medium text-gray-700 mb-2">
                        Attendance (%)
                    </label>
                    <input type="number" id="weight_attendance" step="0.01" min="0" max="100" value="0" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           oninput="calculateTotalWeight()">
                </div>
                <div>
                    <label for="weight_task" class="block text-sm font-medium text-gray-700 mb-2">
                        Task (%)
                    </label>
                    <input type="number" id="weight_task" step="0.01" min="0" max="100" value="0"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           oninput="calculateTotalWeight()">
                </div>
                <div>
                    <label for="weight_uh" class="block text-sm font-medium text-gray-700 mb-2">
                        UH (%)
                    </label>
                    <input type="number" id="weight_uh" step="0.01" min="0" max="100" value="0"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           oninput="calculateTotalWeight()">
                </div>
                <div>
                    <label for="weight_pts" class="block text-sm font-medium text-gray-700 mb-2">
                        PTS (%)
                    </label>
                    <input type="number" id="weight_pts" step="0.01" min="0" max="100" value="0"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           oninput="calculateTotalWeight()">
                </div>
                <div>
                    <label for="weight_pas" class="block text-sm font-medium text-gray-700 mb-2">
                        PAS (%)
                    </label>
                    <input type="number" id="weight_pas" step="0.01" min="0" max="100" value="0"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           oninput="calculateTotalWeight()">
                </div>
            </div>
            <div class="mt-3">
                <p class="text-sm font-medium">
                    Total Weight: <span id="total-weight" class="font-bold text-blue-700">0</span>%
                    <span id="weight-status" class="ml-2"></span>
                </p>
                <p id="error-weight" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>
        </div>

        <!-- Meeting Details Section -->
        <div class="space-y-4 border-t border-gray-200 pt-6">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-semibold text-gray-800">Meeting Details</h3>
                <button type="button" onclick="addMeetingRow()"
                        class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md">
                    + Add Meeting
                </button>
            </div>

            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[500px] shadow-inner">
                <table class="min-w-full divide-y divide-gray-200 table-fixed">
                    <thead class="bg-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-1/12">Meeting #</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-6/12">Topic</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Activity</th>
                            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-700 w-1/12">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-meetings"></tbody>
                </table>
            </div>
            <p id="error-meetings" class="text-sm text-red-600 hidden"></p>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <button type="button" onclick="goBackRPS()" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300">
                <svg class="w-4 h-4 mr-2 text-gray-600"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 19l-7-7 7-7" />
                </svg>
                Back
            </button>
            <button type="button" onclick="saveRPS()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
                Save
                <svg class="w-4 h-4 ml-2 text-white"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7" />
                </svg>
            </button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
    <script>
        let meetingCounter = 0;
        const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/RPS';

        function calculateTotalWeight() {
            const attendance = parseFloat($('#weight_attendance').val() || 0);
            const task = parseFloat($('#weight_task').val() || 0);
            const uh = parseFloat($('#weight_uh').val() || 0);
            const pts = parseFloat($('#weight_pts').val() || 0);
            const pas = parseFloat($('#weight_pas').val() || 0);

            const total = attendance + task + uh + pts + pas;
            $('#total-weight').text(total.toFixed(2));

            const $status = $('#weight-status');
            if (total === 100) {
                $status.html('<span class="text-green-600 font-medium">✓ Valid</span>');
                $('#error-weight').addClass('hidden');
            } else {
                $status.html('<span class="text-red-600 font-medium">✗ Must equal 100%</span>');
            }
        }

        function addMeetingRow(prefill = {}) {
            meetingCounter++;
            const meetingNum = prefill.meeting_number || meetingCounter;

            const row = `
                <tr class="hover:bg-gray-50 border-b last:border-0" data-meeting="${meetingNum}">
                    <td class="px-4 py-3">
                        <input type="number" class="meeting-number w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" 
                               value="${meetingNum}" min="1" readonly />
                    </td>
                    <td class="px-4 py-3">
                        <input type="text" class="topic w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" 
                               placeholder="Enter topic..." value="${prefill.topic || ''}" />
                    </td>
                    <td class="px-4 py-3">
                        <select class="activity-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" 
                                data-placeholder="-- Select Activity --"></select>
                    </td>
                    <td class="px-4 py-3 text-right">
                        <button type="button"
                                onclick="removeMeetingRow(this)"
                                class="inline-flex items-center justify-center p-2 text-red-600 hover:text-red-700 hover:bg-red-50 rounded-md transition"
                                title="Remove meeting">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </td>
                </tr>`;
            $('#tbody-meetings').append(row);

            const $newRow = $('#tbody-meetings tr:last');
            const $activity = $newRow.find('.activity-select');

            $activity.select2({
                placeholder: "-- Select Activity --",
                allowClear: true,
                ajax: {
                    url: '/Select2/RPSActivities',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            if (prefill.activity && prefill.activity_desc) {
                $activity.append(new Option(prefill.activity_desc, prefill.activity, true, true)).trigger('change');
            }
        }

        function removeMeetingRow(btn) {
            $(btn).closest('tr').remove();
            reorderMeetingNumbers();
        }

        function reorderMeetingNumbers() {
            $('#tbody-meetings tr').each(function (index) {
                $(this).find('.meeting-number').val(index + 1);
                $(this).attr('data-meeting', index + 1);
            });
        }

        function collectMeetings() {
            const meetings = [];
            $('#tbody-meetings tr').each(function () {
                const $row = $(this);
                const meeting_number = parseInt($row.find('.meeting-number').val() || 0);
                const topic = $row.find('.topic').val()?.trim() || '';
                const activity = $row.find('.activity-select').val()?.trim() || '';

                if (topic || activity) {
                    meetings.push({ meeting_number, topic, activity });
                }
            });
            return meetings;
        }

        function validateForm() {
            $('.text-red-600').addClass('hidden');
            let valid = true;

            if (!$('#subject_id').val()) {
                $('#error-subject').text('Subject is required').removeClass('hidden');
                valid = false;
            }
            if (!$('#academic_class_id').val()) {
                $('#error-class').text('Class is required').removeClass('hidden');
                valid = false;
            }
            if (!$('#teacher_id').val()) {
                $('#error-teacher').text('Teacher is required').removeClass('hidden');
                valid = false;
            }

            // Validate total weight
            const total = parseFloat($('#total-weight').text());
            if (total !== 100) {
                $('#error-weight').text('Total weight must equal 100%').removeClass('hidden');
                valid = false;
            }

            const meetings = collectMeetings();
            if (meetings.length === 0) {
                $('#error-meetings').text('At least one meeting is required').removeClass('hidden');
                valid = false;
            } else {
                let allComplete = true;
                meetings.forEach(m => {
                    if (!m.topic || !m.activity) allComplete = false;
                });
                if (!allComplete) {
                    $('#error-meetings').text('All fields in each meeting row are required').removeClass('hidden');
                    valid = false;
                }
            }

            return valid;
        }

        function goBackRPS() {
            window.location.href = returnUrl;
        }

        async function saveRPS() {
            if (!validateForm()) {
                await tailwindMessageModal('Validation Error', 'Please complete all required fields.');
                return;
            }

            const confirmed = await tailwindConfirmModal({
                title: 'Save Confirmation',
                message: 'Are you sure you want to save this RPS?',
                confirmText: 'Yes, save',
                cancelText: 'Cancel'
            });
            if (!confirmed) return;

            const fd = new FormData();
            fd.append("subject_id", $('#subject_id').val());
            fd.append("academic_class_id", $('#academic_class_id').val());
            fd.append("teacher_id", $('#teacher_id').val());
            fd.append("description", $('#description').val());
            fd.append("weight_attendance", $('#weight_attendance').val());
            fd.append("weight_task", $('#weight_task').val());
            fd.append("weight_uh", $('#weight_uh').val());
            fd.append("weight_pts", $('#weight_pts').val());
            fd.append("weight_pas", $('#weight_pas').val());
            fd.append("minimum_value", $('#minimum_value').val());
            fd.append("details", JSON.stringify(collectMeetings()));

            $.ajax({
                url: "/RPS/Create",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: async res => {
                    if (res.success) {
                        await tailwindMessageModal('Success', res.message || 'RPS created successfully.');
                        location.href = returnUrl;
                    } else {
                        await tailwindMessageModal('Failed', res.message || 'Save failed');
                    }
                },
                error: async () => await tailwindMessageModal('Error', 'Error saving RPS')
            });
        }

        $(document).ready(function () {
            $('#academic_class_id').select2({
                placeholder: "-- Select Class --",
                allowClear: false,
                ajax: {
                    url: '/Select2/AcademicClasses',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            $('#academic_class_id').on('change', function () {
                const cid = $(this).val();
                $('#tbody-details').empty();
                if (cid) {
                    $.ajax({
                        url: `/Class/GetById?id=${cid}`,
                        type: 'GET',
                        dataType: 'json',
                        success: res => {
                            initSubject(res.data.class_level);
                        },
                        error: () => {
                            $('#tbody-details').html('<tr><td colspan="4" class="px-6 py-8 text-center text-red-600">Error loading students</td></tr>');
                        }
                    });
                }

            });

            $('#teacher_id').select2({
                placeholder: "-- Select Teacher --",
                allowClear: false,
                ajax: {
                    url: '/Select2/Teachers',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            // Add first meeting row on load
            addMeetingRow();
        });

        function initSubject(classLevel) {

            const $subject = $('#subject_id');

            // Destroy select2 dulu kalau sudah pernah dibuat
            if ($subject.hasClass("select2-hidden-accessible")) {
                $subject.select2('destroy');
            }

            $subject.empty().val(null).trigger('change');

            $subject.select2({
                placeholder: "-- Select --",
                allowClear: false,
                ajax: {
                    url: `/Select2/Subjects?classLevel=${classLevel}`,
                    dataType: 'json',
                    delay: 250,
                    data: p => ({
                        q: p.term || '',
                        page: p.page || 1
                    }),
                    processResults: d => ({
                        results: d.results,
                        pagination: d.pagination
                    }),
                    cache: true
                },
                minimumInputLength: 0
            });
        }
    </script>
}
