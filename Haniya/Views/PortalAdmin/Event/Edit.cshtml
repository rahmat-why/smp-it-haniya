@using System.Collections.Generic
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Ubah Acara";
    var id = ViewBag.eventId;
}

<input type="hidden" id="event_id" name="event_id" value="@id">

<h2 class="text-xl font-semibold mb-4">Ubah Acara</h2>
<div class="bg-white p-6 rounded-lg shadow w-full space-y-6">
    <form id="frm" enctype="multipart/form-data" class="space-y-6 w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full"><button type="button" onclick="toggleSection('event-info')" class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"><span class="font-semibold text-white">Informasi Acara</span><svg id="icon-event-info" class="w-5 h-5 text-white transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></button><div id="event-info" class="px-4 pb-4 pt-3 space-y-4 border-t border-gray-100"><div><label for="event_name" class="block text-sm font-medium text-gray-700 mb-1">Nama Acara <span class="text-red-500">*</span></label><input id="event_name" class="w-full border border-gray-300 rounded-md p-2" /><p id="error-event_name" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div><label for="location" class="block text-sm font-medium text-gray-700 mb-1">Lokasi <span class="text-red-500">*</span></label><input id="location" class="w-full border border-gray-300 rounded-md p-2" /><p id="error-location" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label for="start_date" class="block text-sm font-medium text-gray-700 mb-1">Tanggal Mulai <span class="text-red-500">*</span></label><input id="start_date" type="date" class="w-full border border-gray-300 rounded-md p-2" /><p id="error-start_date" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div><label for="end_date" class="block text-sm font-medium text-gray-700 mb-1">Tanggal Selesai <span class="text-red-500">*</span></label><input id="end_date" type="date" class="w-full border border-gray-300 rounded-md p-2" /><p id="error-end_date" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Libur Kelas</label><div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><label class="inline-flex items-center gap-2 px-3 py-2 border border-gray-200 rounded-md"><input type="checkbox" id="holiday_7" value="7" class="rounded border-gray-300 text-blue-900"><span class="text-sm text-gray-700">Kelas 7 Libur</span></label><label class="inline-flex items-center gap-2 px-3 py-2 border border-gray-200 rounded-md"><input type="checkbox" id="holiday_8" value="8" class="rounded border-gray-300 text-blue-900"><span class="text-sm text-gray-700">Kelas 8 Libur</span></label><label class="inline-flex items-center gap-2 px-3 py-2 border border-gray-200 rounded-md"><input type="checkbox" id="holiday_9" value="9" class="rounded border-gray-300 text-blue-900"><span class="text-sm text-gray-700">Kelas 9 Libur</span></label></div></div><div><label for="photo" class="block text-sm font-medium text-gray-700 mb-1">Foto <span class="text-red-500">*</span></label><div class="flex items-center gap-3"><label for="photo" class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md cursor-pointer shadow-sm">Pilih Foto Baru (Opsional)</label><span id="photo-filename" class="text-sm text-gray-600 truncate max-w-[200px]">Belum ada file yang dipilih</span><input type="file" id="photo" class="hidden" accept="image/*" onchange="updatePhotoName()" /></div><div class="mt-3"><img id="photo-preview" src="" alt="Photo preview" class="w-32 h-32 object-cover rounded-md border border-gray-300" /></div><p id="error-photo" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div></div></div>
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full"><button type="button" onclick="toggleSection('event-extra')" class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"><span class="font-semibold text-white">Deskripsi & Tag</span><svg id="icon-event-extra" class="w-5 h-5 text-white transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></button><div id="event-extra" class="px-4 pb-4 pt-3 space-y-4 border-t border-gray-100"><div><label for="description" class="block text-sm font-medium text-gray-700 mb-1">Deskripsi <span class="text-red-500">*</span></label><textarea id="description" class="w-full border border-gray-300 rounded-md p-2 min-h-[160px] resize-y"></textarea><p id="error-description" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div><label for="tags" class="block text-sm font-medium text-gray-700 mb-1">Tag <span class="text-red-500">*</span></label><select id="tags" class="w-full border border-gray-300 rounded-md" multiple="multiple"></select><p id="error-tags" class="mt-1 text-xs text-red-600 hidden validation-error-message"></p></div><div class="pt-4 flex items-center justify-end space-x-2"><button type="button" onclick="goBack()" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm">Kembali</button><button type="button" onclick="updateEvent()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm">Ubah</button></div></div></div>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Event';
function toggleSection(id){const s=document.getElementById(id);const i=document.getElementById('icon-'+id);if(!s||!i)return;const h=s.classList.contains('hidden');if(h){s.classList.remove('hidden');i.classList.remove('-rotate-90');}else{s.classList.add('hidden');i.classList.add('-rotate-90');}}
function showError($i,$e,m){if(!$e.length)return;if($i&&$i.length)$i.removeClass('border-gray-300').addClass('border-red-500');$e.text(m).removeClass('hidden');}
function clearError($i,$e){if($i&&$i.length)$i.removeClass('border-red-500').addClass('border-gray-300');$e.text('').addClass('hidden');}
function clearAllValidation(){clearError($('#event_name'),$('#error-event_name'));clearError($('#location'),$('#error-location'));clearError($('#start_date'),$('#error-start_date'));clearError($('#end_date'),$('#error-end_date'));clearError($('#description'),$('#error-description'));clearError($('#photo'),$('#error-photo'));clearError($('#tags'),$('#error-tags'));}
function updatePhotoName(){const input=document.getElementById('photo');const label=document.getElementById('photo-filename');const preview=document.getElementById('photo-preview');if(!input||!label||!preview)return;if(input.files&&input.files.length>0){const file=input.files[0];label.textContent=file.name;preview.src=URL.createObjectURL(file);preview.classList.remove('hidden');clearError($('#photo'),$('#error-photo'));}else{label.textContent='No new file chosen';}}
function validateForm(){clearAllValidation();let ok=true;const eventName=($('#event_name').val()||'').trim();const location=($('#location').val()||'').trim();const startDate=($('#start_date').val()||'').trim();const endDate=($('#end_date').val()||'').trim();const description=($('#description').val()||'').trim();const tags=$('#tags').val()||[];const photoInput=document.getElementById('photo');const hasNewPhoto=photoInput&&photoInput.files&&photoInput.files.length>0;const hasExistingPhoto=$('#photo-preview').attr('src')&&$('#photo-preview').attr('src')!=='';if(!eventName){ok=false;showError($('#event_name'),$('#error-event_name'),'Event name is required.');}if(!location){ok=false;showError($('#location'),$('#error-location'),'Location is required.');}if(!startDate){ok=false;showError($('#start_date'),$('#error-start_date'),'Start date is required.');}if(!endDate){ok=false;showError($('#end_date'),$('#error-end_date'),'End date is required.');}if(startDate&&endDate){const s=new Date(startDate),e=new Date(endDate);if(!isNaN(s.getTime())&&!isNaN(e.getTime())&&e<s){ok=false;showError($('#end_date'),$('#error-end_date'),'End date cannot be before start date.');}}if(!description){ok=false;showError($('#description'),$('#error-description'),'Description is required.');}if(tags.length===0){ok=false;showError($('#tags'),$('#error-tags'),'At least one tag is required.');}if(!hasNewPhoto&&!hasExistingPhoto){ok=false;showError($('#photo'),$('#error-photo'),'Photo is required.');}return ok;}
function goBack(){window.location.href=returnUrl;}
async function updateEvent(){if(!validateForm())return;const yes=await tailwindConfirmModal({title:'Update Confirmation',message:'Are you sure you want to update this data?',confirmText:'Update',cancelText:'Cancel'});if(!yes)return;const fd=new FormData();fd.append('event_id',$('#event_id').val());$('#frm').find('input,textarea,select').each(function(){if(this.type!=='file'&&this.type!=='checkbox'){if(this.id==='tags')fd.append(this.id,($(this).val()||[]).join(','));else fd.append(this.id,$(this).val());}});const photoInput=document.getElementById('photo');if(photoInput&&photoInput.files&&photoInput.files[0])fd.append('profile_photo',photoInput.files[0]);const holidayClasses=['7','8','9'].filter(l=>$('#holiday_'+l).is(':checked'));fd.append('class_holidays',holidayClasses.join(','));$.ajax({url:'/Event/Update',type:'POST',data:fd,processData:false,contentType:false,success:async res=>{if(res.success){await tailwindMessageModal('Success',res.message||'Event updated successfully.');window.location.href=returnUrl;}else await tailwindMessageModal('Failed',res.message||'Failed to update event');},error:async()=>await tailwindMessageModal('Error','An error occurred while updating the event.')});}
function loadEvent(){const id=$('#event_id').val();if(!id)return;$.ajax({url:'/Event/GetById',type:'GET',data:{id:id},dataType:'json',success:async function(res){if(!res.success){await tailwindMessageModal('Failed',res.message||'Failed to load event');return;}const d=res.data;$('#event_name').val(d.event_name||'');$('#location').val(d.location||'');$('#start_date').val(d.start_date||'');$('#end_date').val(d.end_date||'');$('#description').val(d.description||'');if(d.profile_photo){$('#photo-preview').attr('src',d.profile_photo+'?t='+new Date().getTime()).removeClass('hidden');const parts=d.profile_photo.split('/');$('#photo-filename').text('Current: '+parts[parts.length-1]);}if (Array.isArray(d.tags) && d.tags.length > 0) {const $s = $('#tags');$s.empty();d.tags.forEach(t => {const id = t.id || t;const text = t.text || t;$s.append(new Option(text, id, true, true));});$s.trigger('change');}['7','8','9'].forEach(level=>{$('#holiday_'+level).prop('checked',Array.isArray(d.holiday_classes)&&d.holiday_classes.includes(level));});},error:async()=>await tailwindMessageModal('Error','An error occurred while loading the event.')});}
$(document).ready(function(){$('#tags').select2({placeholder:'-- Select Tags --',allowClear:true,multiple:true,ajax:{url:'/Select2/TagsEvent',dataType:'json',delay:250,data:p=>({q:p.term||'',page:p.page||1}),processResults:(d,p)=>({results:d.results,pagination:d.pagination}),cache:true},minimumInputLength:0}).on('change',()=>clearError($('#tags'),$('#error-tags')));loadEvent();});
</script>
}
