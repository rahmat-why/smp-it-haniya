@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "E-Raport";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">E - Raport</h2>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="eraport-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="relative overflow-x-auto px-4 pt-4">
        <div id="eraport-table-loading" class="hidden absolute inset-0 z-20 bg-white/80 backdrop-blur-[1px] flex items-center justify-center">
            <div class="flex flex-col items-center gap-3 text-gray-600">
                <div class="w-8 h-8 border-4 border-blue-200 border-t-blue-700 rounded-full animate-spin"></div>
                <p class="text-sm font-medium">Loading e-raport data...</p>
            </div>
        </div>
        <table id="eraport-table" class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th data-sort="student" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase align-middle whitespace-nowrap cursor-pointer select-none" style="width: 250px;">Student</th>
                    <th data-sort="academicYears" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center align-middle whitespace-nowrap cursor-pointer select-none" style="width: 140px;">Academic Years</th>
                    <th data-sort="semester" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center align-middle whitespace-nowrap cursor-pointer select-none" style="width: 120px;">Semester</th>
                    <th data-sort="class" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase align-middle whitespace-nowrap cursor-pointer select-none" style="width: 140px;">Class</th>
                    <th data-sort="summaryAttendance" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase align-middle whitespace-nowrap cursor-pointer select-none" style="width: 240px;">Summary Attendance</th>
                    <th data-sort="summaryGrade" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center align-middle whitespace-nowrap cursor-pointer select-none">Summary Grade</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center align-middle whitespace-nowrap" style="width: 110px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3">
        <div id="eraport-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")
<div id="eraport-preview-modal" class="hidden fixed inset-0 z-[120]">
    <div class="absolute inset-0 bg-slate-900/60"></div>
    <div class="relative h-full w-full p-3 sm:p-6">
        <div class="mx-auto h-full w-full max-w-7xl rounded-2xl bg-white shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
            <div class="flex items-center justify-between px-4 sm:px-6 py-3 border-b border-slate-200 bg-slate-50">
                <div>
                    <h3 class="text-sm sm:text-base font-semibold text-slate-800">Preview E-Raport</h3>
                    <p id="eraport-preview-caption" class="text-xs text-slate-500">-</p>
                </div>
                <button type="button" id="eraport-preview-close" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition" aria-label="Close preview">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div class="flex-1 bg-slate-100">
                <iframe id="eraport-preview-frame" class="w-full h-full border-0" title="E-Raport Preview"></iframe>
            </div>
            <div class="flex items-center justify-end gap-2 px-4 sm:px-6 py-3 border-t border-slate-200 bg-white">
                <button type="button" id="eraport-preview-export" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-900 text-white text-sm font-medium hover:bg-blue-800 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Export PDF
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const pageState = {
        page: 1,
        limit: 10,
        filters: {
            search: '',
            academicYearId: '',
            classLevel: ''
        },
        sort: { field: 'student', order: 'asc' },
        hasNextPage: false,
        totalRows: 0
    };
    let lastRequestKey = '';
    let searchDebounce = null;

    function getStateQuery() {
        return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&academicYearId=${encodeURIComponent(pageState.filters.academicYearId || '')}&classLevel=${encodeURIComponent(pageState.filters.classLevel || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`;
    }

    function syncStateToUrl() {
        history.replaceState({ ...pageState }, '', `?${getStateQuery()}`);
    }

    function hydrateStateFromUrl() {
        const q = new URLSearchParams(window.location.search);
        const page = Number(q.get('page') || 1);
        const limit = Number(q.get('limit') || 10);
        pageState.page = Number.isFinite(page) && page > 0 ? page : 1;
        pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10;
        pageState.filters.search = q.get('search') || '';
        pageState.filters.academicYearId = q.get('academicYearId') || '';
        pageState.filters.classLevel = q.get('classLevel') || '';
        pageState.sort.field = q.get('sortField') || 'student';
        pageState.sort.order = q.get('sortOrder') || 'asc';
    }

    function renderToolbar() {
        const searchValue = (pageState.filters.search || '').replace(/"/g, '&quot;');
        $('#eraport-table-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">
                Show
                <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select> rows
            </div>
            <div class="relative">
                <button id="eraportFilterToggleBtn" type="button" class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                    Filter
                </button>
                <div id="eraportFilterDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                        <button type="button" id="eraportFilterCloseBtn" class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">?</button>
                    </div>
                    <div class="px-5 py-4 space-y-4">
                        <div class="w-full"><label class="text-xs font-medium" for="academic_year_filter">Academic Year</label><select id="academic_year_filter" class="w-full"></select></div>
                        <div class="w-full"><label class="text-xs font-medium" for="class_level_filter">Class</label><select id="class_level_filter" class="w-full"></select></div>
                        <div class="w-full"><label class="text-xs font-medium" for="eraport_search_filter">Search</label><input id="eraport_search_filter" type="text" value="${searchValue}" class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Search..." /></div>
                    </div>
                    <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                        <button type="button" id="reset-eraport-filter-btn" class="px-5 py-2 rounded-full text-sm font-medium text-indigo-400 bg-indigo-50 hover:bg-indigo-100 transition">Reset</button>
                        <button type="button" id="apply-eraport-filter-btn" class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">Filter</button>
                    </div>
                </div>
            </div>
        `);

        $('#list-limit').val(String(pageState.limit));
        $('#list-limit').off('change').on('change', function () {
            const next = Number($(this).val() || 10);
            if (pageState.limit === next) return;
            pageState.limit = next;
            pageState.page = 1;
            lastRequestKey = '';
            fetchEraports();
        });

        const $dropdown = $('#eraportFilterDropdown');
        $('#eraportFilterToggleBtn').off('click').on('click', function () { $dropdown.toggleClass('hidden'); });
        $('#eraportFilterCloseBtn').off('click').on('click', function () { $dropdown.addClass('hidden'); });
        $('#apply-eraport-filter-btn').off('click').on('click', applyFilter);
        $('#reset-eraport-filter-btn').off('click').on('click', resetFilter);

        $('#academic_year_filter').select2({
            placeholder: 'Academic Year',
            allowClear: true,
            width: '100%',
            dropdownParent: $dropdown,
            ajax: {
                url: '/Select2/AcademicYears',
                dataType: 'json',
                delay: 250,
                data: function (params) { return { q: params.term || '', page: params.page || 1 }; },
                processResults: function (data) { return { results: data.results, pagination: data.pagination }; },
                cache: true
            },
            minimumInputLength: 0
        });

        $('#class_level_filter').select2({
            placeholder: 'Select Class Level',
            allowClear: true,
            width: '100%',
            dropdownParent: $dropdown,
            data: [
                { id: '', text: 'All Levels' },
                { id: '7', text: 'Class 7' },
                { id: '8', text: 'Class 8' },
                { id: '9', text: 'Class 9' }
            ]
        });

        if (pageState.filters.academicYearId) {
            const optionAy = new Option(pageState.filters.academicYearId, pageState.filters.academicYearId, true, true);
            $('#academic_year_filter').append(optionAy).trigger('change');
        }
        $('#class_level_filter').val(pageState.filters.classLevel || '').trigger('change');
    }

    function renderSortIndicators() {
        $('#eraport-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ↑' : ' ↓') : '';
            const base = $(this).text().replace(/ [↑↓]$/, '');
            $(this).text(base + icon);
        });
    }

    function renderRows(items) {
        const $tbody = $('#eraport-table tbody');
        if (!items || !items.length) {
            $tbody.html(`
                <tr>
                    <td colspan="7" class="px-4 py-10 text-center">
                        <div class="flex flex-col items-center gap-2 text-gray-500">
                            <div class="text-sm font-semibold text-gray-700">Tidak ada data e-raport</div>
                            <div class="text-xs">Coba ubah pencarian, tahun ajaran, atau class yang digunakan.</div>
                        </div>
                    </td>
                </tr>
            `);
            return;
        }

        let html = '';
        items.forEach(row => {
            const id = row.student_id || '';
            const classId = row.academic_class_id || '';
            const src = (typeof row.profile_photo === 'string' && row.profile_photo.trim() !== '') ? row.profile_photo : '/image/no-image.png';
            const previewUrl = `/Eraport/Preview?id=${encodeURIComponent(id)}&classId=${encodeURIComponent(classId)}&embed=1`;
            const exportExcelUrl = `/Eraport/ExportExcel?id=${encodeURIComponent(id)}&classId=${encodeURIComponent(classId)}`;

            const academicYears = (row.start_date && row.end_date)
                ? `${new Date(row.start_date).getFullYear()} / ${new Date(row.end_date).getFullYear()}`
                : '-';

            html += `
                <tr class="bg-white divide-y divide-gray-100">
                    <td class="px-4 py-3 align-middle">
                        <div class="flex items-center gap-3">
                            <img src="${src}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 flex-shrink-0">
                            <div class="min-w-0 flex-1">
                                <div class="font-medium text-gray-900 truncate">${row.full_name || '-'}</div>
                                <div class="text-xs text-gray-500 truncate">NIS: ${row.nis || '-'}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-center align-middle whitespace-nowrap">${academicYears}</td>
                    <td class="px-4 py-3 text-center align-middle whitespace-nowrap">${row.semester ? `Semester ${row.semester}` : '-'}</td>
                    <td class="px-4 py-3 align-middle">${row.class_name || '-'}</td>
                    <td class="px-4 py-3 align-middle">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="inline-flex items-center rounded-full bg-green-100 text-green-700 text-[11px] font-semibold px-2 py-0.5">Hadir: ${row.present || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-yellow-100 text-yellow-700 text-[11px] font-semibold px-2 py-0.5">Sakit: ${row.sick || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-blue-100 text-blue-700 text-[11px] font-semibold px-2 py-0.5">Izin: ${row.permit || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-red-100 text-red-700 text-[11px] font-semibold px-2 py-0.5">Alpa: ${row.alpha || 0}</span>
                        </div>
                    </td>
                    <td class="px-4 py-3 align-middle">
                        <div class="flex flex-wrap justify-center gap-1.5">
                            <span class="inline-flex items-center rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-semibold px-2 py-0.5">Pass: ${row.passed || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-rose-100 text-rose-700 text-[11px] font-semibold px-2 py-0.5">Remedial: ${row.remedial || 0}</span>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-center align-middle">
                        <div class="flex flex-wrap gap-2 justify-center">
                            <button type="button" data-preview-url="${previewUrl}" data-student-name="${(row.full_name || '-').toString().replace(/"/g, '&quot;')}" class="btn-preview-eraport inline-flex items-center justify-center w-8 h-8 rounded-md bg-blue-100 text-blue-700 hover:bg-blue-200" title="Preview">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </button>
                            <a href="${exportExcelUrl}" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-emerald-100 text-emerald-700 hover:bg-emerald-200" title="Download Excel">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h8"></path><path d="M8 17h8"></path></svg>
                            </a>
                        </div>
                    </td>
                </tr>
            `;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#table-info-container').html(`<span class="text-sm text-gray-600">Menampilkan ${start} sampai ${end} dari ${pageState.totalRows} data</span>`);

        const totalPages = Math.max(1, Math.ceil(pageState.totalRows / pageState.limit));
        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        const pageStart = Math.max(1, Math.min(pageState.page - 1, totalPages - 2));
        const pageEnd = Math.min(totalPages, pageStart + 2);
        const pageButtons = [];
        for (let i = pageStart; i <= pageEnd; i++) {
            const active = i === pageState.page;
            pageButtons.push(`<button type="button" data-page="${i}" class="page-number px-3 py-2 text-sm border-l border-gray-200 ${active ? 'bg-blue-900 text-white font-semibold' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${active ? 'disabled' : ''}>${i}</button>`);
        }

        $('#table-pagination-container').html(`
            <div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                <button id="page-first" class="px-3 py-2 text-sm ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>First</button>
                <button id="page-prev" class="px-3 py-2 text-sm border-l border-gray-200 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>
                ${pageButtons.join('')}
                <button id="page-next" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Next</button>
                <button id="page-last" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Last</button>
            </div>
        `);

        function goToPage(page) {
            const nextPage = Math.min(Math.max(1, page), totalPages);
            if (nextPage === pageState.page) return;
            pageState.page = nextPage;
            lastRequestKey = '';
            fetchEraports();
        }

        $('#page-first').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            goToPage(1);
        });

        $('#page-prev').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            goToPage(pageState.page - 1);
        });

        $('.page-number').off('click').on('click', function () {
            goToPage(Number($(this).data('page') || 1));
        });

        $('#page-next').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            goToPage(pageState.page + 1);
        });

        $('#page-last').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            goToPage(totalPages);
        });
    }

    function setEraportLoading(isLoading) {
        $('#eraport-table-loading').toggleClass('hidden', !isLoading);
    }

    async function fetchEraports() {
        const payload = {
            page: pageState.page,
            limit: pageState.limit,
            filters: { ...pageState.filters },
            sort: { ...pageState.sort }
        };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();
        setEraportLoading(true);

        try {
            const res = await $.ajax({
                url: '/Eraport/GetAll',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });

            if (!res.success) {
                lastRequestKey = '';
                await tailwindMessageModal('Failed', res.message || 'Failed to load e-raport data.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.page = Number(result.currentPage || pageState.page);
            pageState.limit = Number(result.limit || 10);
            pageState.hasNextPage = !!result.hasNextPage;
            pageState.totalRows = Number(result.totalRows || 0);
            syncStateToUrl();
            renderRows(items);
            renderPagination(items.length);
        } catch {
            lastRequestKey = '';
            await tailwindMessageModal('Error', 'An error occurred while loading e-raport data.');
        } finally {
            setEraportLoading(false);
        }
    }

    function applyFilter() {
        pageState.filters.academicYearId = $('#academic_year_filter').val() || '';
        pageState.filters.classLevel = $('#class_level_filter').val() || '';
        pageState.filters.search = ($('#eraport_search_filter').val() || '').trim();
        pageState.page = 1;
        lastRequestKey = '';
        fetchEraports();
        $('#eraportFilterDropdown').addClass('hidden');
    }

    function resetFilter() {
        $('#academic_year_filter').val('').trigger('change');
        $('#class_level_filter').val('').trigger('change');
        $('#eraport_search_filter').val('');
        pageState.filters.academicYearId = '';
        pageState.filters.classLevel = '';
        pageState.filters.search = '';
        pageState.page = 1;
        lastRequestKey = '';
        fetchEraports();
    }

    function openPreviewModal(url, studentName) {
        if (!url) return;
        $('#eraport-preview-caption').text(studentName || '-');
        $('#eraport-preview-frame').attr('src', url);
        $('#eraport-preview-modal').removeClass('hidden');
        $('body').addClass('overflow-hidden');
    }

    function closePreviewModal() {
        $('#eraport-preview-modal').addClass('hidden');
        $('#eraport-preview-frame').attr('src', 'about:blank');
        const $export = $('#eraport-preview-export');
        $export.prop('disabled', false).removeClass('opacity-60 cursor-not-allowed').html('<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>Export PDF');
        $('body').removeClass('overflow-hidden');
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();
        fetchEraports();

        $(document).on('click', function (e) {
            const $dropdown = $('#eraportFilterDropdown');
            const isToggle = $(e.target).closest('#eraportFilterToggleBtn').length > 0;
            const isInsideDropdown = $(e.target).closest('#eraportFilterDropdown').length > 0;
            const isSelect2 = $(e.target).closest('.select2-container, .select2-dropdown').length > 0;
            if (!isToggle && !isInsideDropdown && !isSelect2) {
                $dropdown.addClass('hidden');
            }
        });

        $('#eraport-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) {
                pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            } else {
                pageState.sort.field = field;
                pageState.sort.order = 'asc';
            }
            pageState.page = 1;
            lastRequestKey = '';
            fetchEraports();
        });

        $(document).on('input', '#eraport_search_filter', function () {
            const val = ($(this).val() || '').trim();
            if ((pageState.filters.search || '') === val) return;
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                pageState.filters.search = val;
                pageState.page = 1;
                lastRequestKey = '';
                fetchEraports();
            }, 300);
        });

        $(document).on('click', '.btn-preview-eraport', function () {
            openPreviewModal(
                (($(this).data('preview-url') || '').toString()),
                (($(this).data('student-name') || '').toString())
            );
        });

        $('#eraport-preview-close').on('click', closePreviewModal);
        $('#eraport-preview-export').on('click', async function () {
            const $btn = $(this);
            const frame = document.getElementById('eraport-preview-frame');
            if (!frame || !frame.contentWindow) {
                await tailwindMessageModal('Gagal', 'Preview belum siap.');
                return;
            }

            const submitFn = frame.contentWindow.submitEraport;
            if (typeof submitFn !== 'function') {
                await tailwindMessageModal('Gagal', 'Fitur export belum siap pada preview.');
                return;
            }

            if ($btn.prop('disabled')) return;
            $btn.prop('disabled', true).addClass('opacity-60 cursor-not-allowed').html('<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>Exporting...');
            try {
                await submitFn();
            } finally {
                $btn.prop('disabled', false).removeClass('opacity-60 cursor-not-allowed').html('<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>Export PDF');
            }
        });
        $('#eraport-preview-modal').on('click', function (e) {
            if (e.target === this || $(e.target).closest('.bg-slate-900\\/60').length) {
                closePreviewModal();
            }
        });
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && !$('#eraport-preview-modal').hasClass('hidden')) {
                closePreviewModal();
            }
        });
    });
</script>
}
