@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "E-Raport";
}
<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">E - Raport</h2>

    <!-- FILTER BUTTON -->
    <div class="relative">
        <button id="filterToggleBtn"
                onclick="toggleEraportFilter()"
                class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
            </svg>
            Filter
        </button>
        <!-- FILTER DROPDOWN -->
        <div id="filterDropdown"
             class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
            <!-- Header -->
            <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                <button onclick="toggleEraportFilter()"
                        class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
            <!-- Fields -->
            <div class="px-5 py-4 space-y-4">
                <div class="w-full">
                    <label class="text-xs font-medium" for="academic_year_filter">Academic Year</label>
                    <select id="academic_year_filter" class="w-full"></select>
                </div>
                <div class="w-full">
                    <label class="text-xs font-medium" for="class_level_filter">Class</label>
                    <select id="class_level_filter" class="w-full"></select>
                </div>
            </div>
            <!-- Footer Buttons -->
            <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                <button onclick="resetFilter()"
                        class="px-5 py-2 rounded-full text-sm font-medium text-indigo-400 bg-indigo-50 hover:bg-indigo-100 transition">
                    Reset
                </button>
                <button onclick="applyFilter()"
                        class="px-5 py-2 rounded-full text-sm font-medium text-white bg-indigo-500 hover:bg-indigo-600 transition">
                    Filter
                </button>
            </div>
        </div>
    </div>
</div>
<div class="bg-white rounded-lg shadow">
    <!-- Toolbar -->
    <div class="px-4 pt-4">
        <div id="eraport-table-toolbar"
             class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto overflow-y-visible px-4 pt-4">
        <table id="eraport-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 250px;">Student</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Academic Years</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Semester</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Class</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Summary Attendance</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Summary Grade</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase !text-right" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="px-4 pb-4 pt-3">
        <div id="eraport-table-footer"
             class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="eraport-table-info"></div>
            <div id="eraport-table-pagination"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
    const pageState = {
        page: 1,
        limit: 10,
        filters: {
            search: '',
            academicYearId: '',
            classLevel: ''
        },
        sort: { field: 'student', order: 'asc' },
        hasNextPage: false
    };
    let lastRequestKey = '';
    let searchDebounce = null;

    function getStateQuery() {
        return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&academicYearId=${encodeURIComponent(pageState.filters.academicYearId || '')}&classLevel=${encodeURIComponent(pageState.filters.classLevel || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`;
    }

    function syncStateToUrl() {
        history.replaceState({ ...pageState }, '', `?${getStateQuery()}`);
    }

    function hydrateStateFromUrl() {
        const q = new URLSearchParams(window.location.search);
        const page = Number(q.get('page') || 1);
        const limit = Number(q.get('limit') || 10);
        pageState.page = Number.isFinite(page) && page > 0 ? page : 1;
        pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10;
        pageState.filters.search = q.get('search') || '';
        pageState.filters.academicYearId = q.get('academicYearId') || '';
        pageState.filters.classLevel = q.get('classLevel') || '';
        pageState.sort.field = q.get('sortField') || 'student';
        pageState.sort.order = q.get('sortOrder') || 'asc';
    }

    function renderToolbar() {
        $('#eraport-table-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">
                Show
                <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select> rows
            </div>
            <div class="flex items-center gap-2 text-sm text-gray-600 w-full md:w-auto justify-end">
                <input id="list-search" type="text" placeholder="Search..." class="border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500 w-full md:w-64"/>
            </div>
        `);

        $('#list-limit').val(String(pageState.limit));
        $('#list-search').val(pageState.filters.search || '');

        $('#list-limit').off('change').on('change', function () {
            const next = Number($(this).val() || 10);
            if (pageState.limit === next) return;
            pageState.limit = next;
            pageState.page = 1;
            lastRequestKey = '';
            fetchEraports();
        });

        $('#list-search').off('input').on('input', function () {
            const val = ($(this).val() || '').toString().trim();
            if ((pageState.filters.search || '') === val) return;
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                pageState.filters.search = val;
                pageState.page = 1;
                lastRequestKey = '';
                fetchEraports();
            }, 300);
        });
    }

    function renderSortIndicators() {
        $('#eraport-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ▲' : ' ▼') : '';
            const base = $(this).text().replace(/ [▲▼]$/, '');
            $(this).text(base + icon);
        });
    }

    function renderRows(items) {
        const $tbody = $('#eraport-table tbody');
        if (!items || !items.length) {
            $tbody.html(`<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">No data found.</td></tr>`);
            return;
        }

        let html = '';
        items.forEach(row => {
            const id = row.student_id || '';
            const classId = row.academic_class_id || '';
            const uniqueId = `${id}-${classId}`;
            const src = (typeof row.profile_photo === 'string' && row.profile_photo.trim() !== '')
                ? row.profile_photo
                : '/image/no-image.png';
            const previewUrl = `/Eraport/Preview?id=${encodeURIComponent(id)}&classId=${encodeURIComponent(classId)}`;
            const exportPdfUrl = `/Eraport/ExportPdf?id=${encodeURIComponent(id)}&classId=${encodeURIComponent(classId)}`;

            const academicYears = (row.start_date && row.end_date)
                ? `${new Date(row.start_date).getFullYear()} / ${new Date(row.end_date).getFullYear()}`
                : '-';

            html += `
                <tr class="bg-white divide-y divide-gray-100">
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <img src="${src}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 flex-shrink-0">
                            <div class="min-w-0 flex-1">
                                <div class="font-medium text-gray-900 truncate">${row.full_name || '-'}</div>
                                <div class="text-xs text-gray-500 truncate">NIS: ${row.nis || '-'}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-3">${academicYears}</td>
                    <td class="px-4 py-3 text-center">${row.semester ? `Semester ${row.semester}` : '-'}</td>
                    <td class="px-4 py-3">${row.class_name || '-'}</td>
                    <td class="px-4 py-3">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="inline-flex items-center rounded-full bg-green-100 text-green-700 text-[11px] font-semibold px-2 py-0.5">Hadir: ${row.present || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-yellow-100 text-yellow-700 text-[11px] font-semibold px-2 py-0.5">Sakit: ${row.sick || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-blue-100 text-blue-700 text-[11px] font-semibold px-2 py-0.5">Izin: ${row.permit || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-red-100 text-red-700 text-[11px] font-semibold px-2 py-0.5">Alpa: ${row.alpha || 0}</span>
                        </div>
                    </td>
                    <td class="px-4 py-3">
                        <div class="flex flex-wrap justify-center gap-1.5">
                            <span class="inline-flex items-center rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-semibold px-2 py-0.5">Pass: ${row.passed || 0}</span>
                            <span class="inline-flex items-center rounded-full bg-rose-100 text-rose-700 text-[11px] font-semibold px-2 py-0.5">Remedial: ${row.remedial || 0}</span>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-right overflow-visible">
                        <div class="inline-flex justify-end eraport-actions-wrapper relative overflow-visible">
                            <button type="button" class="eraport-action-toggle p-1.5 hover:bg-gray-100 rounded-md relative z-20">
                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/>
                                </svg>
                            </button>
                            <div class="eraport-actions-menu hidden absolute right-0 top-full mt-1 w-48 bg-white rounded-md shadow-lg z-30 border border-gray-100">
                                <a href="${previewUrl}" target="_blank" class="flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50">Preview PDF</a>
                                <a href="${exportPdfUrl}" target="_blank" class="flex items-center px-4 py-2 text-sm text-green-600 hover:bg-green-50 border-t border-gray-100">Download PDF</a>
                            </div>
                        </div>
                    </td>
                </tr>
            `;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#eraport-table-info').html(`<span class="text-sm text-gray-600">Showing ${start} to ${end}</span>`);

        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        $('#eraport-table-pagination').html(`
            <div class="inline-flex items-center border border-gray-300 rounded-md overflow-hidden min-w-max">
                <button id="page-prev" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>
                <span class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium border-r border-gray-300 bg-blue-900 text-white">${pageState.page}</span>
                <button id="page-next" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50 hover:text-blue-900'}" ${nextDisabled ? 'disabled' : ''}>Next</button>
            </div>
        `);

        $('#page-prev').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            pageState.page -= 1;
            lastRequestKey = '';
            fetchEraports();
        });
        $('#page-next').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            pageState.page += 1;
            lastRequestKey = '';
            fetchEraports();
        });
    }

    async function fetchEraports() {
        const payload = {
            page: pageState.page,
            limit: pageState.limit,
            filters: { ...pageState.filters },
            sort: { ...pageState.sort }
        };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();

        try {
            const res = await $.ajax({
                url: '/Eraport/GetAll',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });

            if (!res.success) {
                lastRequestKey = '';
                await tailwindMessageModal('Failed', res.message || 'Failed to load e-raport data.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.hasNextPage = !!result.hasNextPage;
            renderRows(items);
            renderPagination(items.length);
        } catch {
            lastRequestKey = '';
            await tailwindMessageModal('Error', 'An error occurred while loading e-raport data.');
        }
    }

    function toggleActionsMenu(event, button) {
        event.preventDefault();
        event.stopPropagation();
        const $button = $(button);
        const $menu = $button.siblings('.eraport-actions-menu');
        const willShow = $menu.hasClass('hidden');
        $('.eraport-actions-menu').addClass('hidden');
        if (willShow) {
            $menu.removeClass('hidden');
        }
    }

    function toggleEraportFilter() {
        $('#filterDropdown').toggleClass('hidden');
    }

    function applyFilter() {
        pageState.filters.academicYearId = $('#academic_year_filter').val() || '';
        pageState.filters.classLevel = $('#class_level_filter').val() || '';
        pageState.page = 1;
        lastRequestKey = '';
        fetchEraports();
        toggleEraportFilter();
    }

    function resetFilter() {
        $('#academic_year_filter').val('').trigger('change');
        $('#class_level_filter').val('').trigger('change');
        pageState.filters.academicYearId = '';
        pageState.filters.classLevel = '';
        pageState.page = 1;
        lastRequestKey = '';
        fetchEraports();
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();

        $('#academic_year_filter').select2({
            placeholder: 'Academic Year',
            allowClear: true,
            width: '100%',
            dropdownParent: $('#filterDropdown'),
            ajax: {
                url: '/Select2/AcademicYears',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { q: params.term || '', page: params.page || 1 };
                },
                processResults: function (data) {
                    return { results: data.results, pagination: data.pagination };
                },
                cache: true
            },
            minimumInputLength: 0
        });

        $('#class_level_filter').select2({
            placeholder: 'Select Class Level',
            allowClear: true,
            width: '100%',
            dropdownParent: $('#filterDropdown'),
            data: [
                { id: '', text: 'All Levels' },
                { id: '7', text: 'Class 7' },
                { id: '8', text: 'Class 8' },
                { id: '9', text: 'Class 9' }
            ]
        });

        if (pageState.filters.academicYearId) {
            const optionAy = new Option(pageState.filters.academicYearId, pageState.filters.academicYearId, true, true);
            $('#academic_year_filter').append(optionAy).trigger('change');
        }
        $('#class_level_filter').val(pageState.filters.classLevel || '').trigger('change');

        fetchEraports();

        $(document).on('click', '.eraport-action-toggle', function (e) {
            toggleActionsMenu(e, this);
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('.eraport-actions-wrapper').length) {
                $('.eraport-actions-menu').addClass('hidden');
            }
            const isToggle = $(e.target).closest('#filterToggleBtn').length > 0;
            const isInsideDropdown = $(e.target).closest('#filterDropdown').length > 0;
            const isSelect2 = $(e.target).closest('.select2-container, .select2-dropdown').length > 0;
            if (!isToggle && !isInsideDropdown && !isSelect2) {
                $('#filterDropdown').addClass('hidden');
            }
        });

        $('#eraport-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) {
                pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            } else {
                pageState.sort.field = field;
                pageState.sort.order = 'asc';
            }
            pageState.page = 1;
            lastRequestKey = '';
            fetchEraports();
        });
    });
</script>
}
