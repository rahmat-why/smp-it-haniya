<body class="@(isExportMode ? "output-mode" : "")">
<div class="paper">
    <table class="no-border">
        <tr>
            <td width="15%">Nama</td>
            <td width="35%">: @data["full_name"]</td>

            <td width="15%">Kelas</td>
            <td width="35%">: @data["class_name"]</td>
        </tr>

        <tr>
            <td>NISN / NIS</td>
            <td>: @data["nis"]</td>

            <td>Fase</td>
            <td>: D</td>
        </tr>

        <tr>
            <td>Nama Sekolah</td>
            <td>: @data["school_name"]</td>

            <td>Semester</td>
            <td>: @data["semester"] ( @TerbilangSemester(data["semester"].ToString()) )</td>
        </tr>

        <tr>
            <td>Alamat</td>
            <td>: @data["school_address"]</td>

            <td>Tahun Pelajaran</td>
            <td>: @data["academic_year_name"]</td>
        </tr>
    </table>

    <br>

    <h3 class="center">LAPORAN HASIL BELAJAR</h3>

    <table>

        <tr class="bold center">
            <th width="5%">NO</th>
            <th width="31%">MATA PELAJARAN</th>
            <th width="7%">NILAI AKHIR</th>
            @if (isPreviewMode)
            {
                <th width="7%">NILAI TAMBAH</th>
            }
            <th>CAPAIAN KOMPETENSI</th>
        </tr>

        @foreach (DataRow row in report.Rows)
        {
            if (row["subject_type"].ToString() == "SUBJ_PRIMARY")
            {
                var subjectName = row["subject_name"]?.ToString() ?? "";
                var adjustmentValue = GetSavedGradeValue(savedGradeMap, row["subject_id"], "final_score_adjustment", "0");
                var descriptionValue = GetSavedGradeValue(savedGradeMap, row["subject_id"], "competency_description", $"{data["full_name"]} membutuhkan bimbingan dalam pembelajaran {subjectName}.");
                var displayFinalScore = GetDisplayFinalScore(savedGradeMap, row, !isPreviewMode);
                <tr class="row-grade">
                    <td class="center">@noPri</td>
                    <td class="subject-name">
                        @subjectName
                        <input type="hidden" class="subject-id" value="@row["subject_id"]" />
                        <input type="hidden" class="subject-type-id" value="@row["subject_code"]" />
                        <input type="hidden" class="subject-type-name" value="@row["subject_type"]" />
                        <input type="hidden" class="final-score-rps-raw" value="@Math.Round(Convert.ToDecimal(row["final_score"] == DBNull.Value ? 0 : row["final_score"]), 0)" />
                    </td>
                    <td class="final-score-rps center" align="center" style="text-align:center;vertical-align:middle;">
                        @displayFinalScore
                    </td>
                    @if (isPreviewMode)
                    {
                        <td class="center nt">
                            <input type="number"
                                   class="final-score-adjustment"
                                   value="@adjustmentValue"
                                   onfocus="clearZero(this)"
                                   onblur="restoreZero(this)">
                        </td>
                    }
                    <td>
                        @if (isPreviewMode)
                        {
                            <textarea class="desc">@descriptionValue</textarea>
                            <div class="desc-preview"></div>
                        }
                        else
                        {
                            <div class="export-text">@descriptionValue</div>
                        }
                    </td>
                </tr>

                noPri++;
            }

        }
        @for (int filler = noPri; filler <= targetPrimaryRows; filler++)
        {
            <tr class="row-grade filler-row">
                <td class="center">@filler</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                @if (isPreviewMode)
                {
                    <td>&nbsp;</td>
                }
                <td>&nbsp;</td>
            </tr>
        }

    </table>

    <br>

    <h3>MUATAN LOKAL</h3>

    <table>
        <tr class="bold center">
            <th width="5%">NO</th>
            <th width="31%">MATA PELAJARAN</th>
            <th width="7%">NILAI AKHIR</th>
            @if (isPreviewMode)
            {
                <th width="7%">NILAI TAMBAH</th>
            }
            <th>CAPAIAN KOMPETENSI</th>
        </tr>

        @foreach (DataRow row in report.Rows)
        {
            if (row["subject_type"].ToString() == "SUBJ_LOCAL")
            {
                var subjectName = row["subject_name"]?.ToString() ?? "";
                var adjustmentValue = GetSavedGradeValue(savedGradeMap, row["subject_id"], "final_score_adjustment", "0");
                var descriptionValue = GetSavedGradeValue(savedGradeMap, row["subject_id"], "competency_description", $"{data["full_name"]} membutuhkan bimbingan dalam pembelajaran {subjectName}.");
                var displayFinalScore = GetDisplayFinalScore(savedGradeMap, row, !isPreviewMode);
                var calculatedFinalScore = Math.Round(Convert.ToDecimal(row["final_score"] == DBNull.Value ? 0 : row["final_score"]), 0).ToString();
                <tr class="row-grade">
                    <td class="center">@noLoc</td>
                    <td class="subject-name">
                        @subjectName
                        <input type="hidden" class="subject-id" value="@row["subject_id"]" />
                        <input type="hidden" class="subject-type-id" value="@row["subject_code"]" />
                        <input type="hidden" class="subject-type-name" value="@row["subject_type"]" />
                        <input type="hidden" class="final-score-rps-raw" value="@calculatedFinalScore" />
                    </td>
                    <td class="final-score-rps center" align="center" style="text-align:center;vertical-align:middle;">
                        @displayFinalScore
                    </td>
                    @if (isPreviewMode)
                    {
                        <td class="center nt">
                            <input type="number"
                                   class="final-score-adjustment"
                                   value="@adjustmentValue"
                                   onfocus="clearZero(this)"
                                   onblur="restoreZero(this)">
                        </td>
                    }
                    <td>
                        @if (isPreviewMode)
                        {
                            <textarea class="desc">@descriptionValue</textarea>
                            <div class="desc-preview"></div>
                        }
                        else
                        {
                            <div class="export-text">@descriptionValue</div>
                        }
                    </td>
                </tr>

                noLoc++;
            }
        }
        @for (int filler = noLoc; filler <= targetLocalRows; filler++)
        {
            <tr class="row-grade filler-row">
                <td class="center">@filler</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                @if (isPreviewMode)
                {
                    <td>&nbsp;</td>
                }
                <td>&nbsp;</td>
            </tr>
        }

    </table>

    <br>

    <table>
        <tr class="bold center">
            <th colspan="@subjectTableColspan">KOKURIKULER</th>
        </tr>
        <tr>
            <td colspan="@subjectTableColspan">
                @if (isPreviewMode)
                {
                    <textarea class="kokurikuler">@(string.IsNullOrWhiteSpace(savedKokurikuler) ? $"Ananda {data["full_name"]} sudah sangat menghargai sesama teman berdasarkan yang terlihat dari beberapa proyek pembelajaran interdisipliner." : savedKokurikuler)</textarea>
                    <div class="desc-preview"></div>
                }
                else
                {
                    <div class="export-text">@(string.IsNullOrWhiteSpace(savedKokurikuler) ? $"Ananda {data["full_name"]} sudah sangat menghargai sesama teman berdasarkan yang terlihat dari beberapa proyek pembelajaran interdisipliner." : savedKokurikuler)</div>
                }
            </td>
        </tr>
    </table>



    <br>

    <div>
        <h3>EKSTRAKURIKULER</h3>

        @if (isPreviewMode)
        {
            <button id="btnAdd" type="button" onclick="addEkskulRow()">+ Tambah</button>
        }

        <table id="exkulTable" style="width:100%;table-layout:fixed;">

            <tr class="bold center">
                <th width="5%">NO</th>
                <th width="28%">KEGIATAN</th>
                <th width="15%">PREDIKAT</th>
                <th width="52%">KETERANGAN</th>
                @if (isPreviewMode)
                {
                    <th width="5%">Aksi</th>
                }
            </tr>
            @{
                var extraRows = savedExtracurriculars.Count > 0
                    ? savedExtracurriculars.Take(3).ToList()
                    : new List<Dictionary<string, string>>
                    {
                        new Dictionary<string, string>
                        {
                            ["name"] = "-",
                            ["predicate"] = "-",
                            ["description"] = "-"
                        }
                    };
            }
            @for (int i = 0; i < extraRows.Count; i++)
            {
                var extra = extraRows[i];
                <tr class="row-extra">
                    <td class="center" style="width:5%;text-align:center;vertical-align:top;">@(i + 1)</td>
                    <td style="width:28%;vertical-align:top;">
                        @if (isPreviewMode)
                        {
                            <input class="exkul-name" value="@(string.IsNullOrWhiteSpace(extra.GetValueOrDefault("name")) ? "-" : extra.GetValueOrDefault("name"))"
                                   onfocus="clearDash(this)"
                                   onblur="restoreDash(this)" />
                            <div class="input-preview"></div>
                        }
                        else
                        {
                            <div class="export-text">@(string.IsNullOrWhiteSpace(extra.GetValueOrDefault("name")) ? "-" : extra.GetValueOrDefault("name"))</div>
                        }
                    </td>

                    <td class="center" style="width:15%;text-align:center;vertical-align:top;">
                        @if (isPreviewMode)
                        {
                            <input class="exkul-predicate" value="@(string.IsNullOrWhiteSpace(extra.GetValueOrDefault("predicate")) ? "-" : extra.GetValueOrDefault("predicate"))"
                                   onfocus="clearDash(this)"
                                   onblur="restoreDash(this)" />
                            <div class="input-preview"></div>
                        }
                        else
                        {
                            <div class="export-text">@(string.IsNullOrWhiteSpace(extra.GetValueOrDefault("predicate")) ? "-" : extra.GetValueOrDefault("predicate"))</div>
                        }
                    </td>
                    <td style="width:52%;vertical-align:top;">
                        @if (isPreviewMode)
                        {
                            <textarea class="exkul-desc"
                                      onfocus="clearDash(this)"
                                      onblur="restoreDash(this)">@(string.IsNullOrWhiteSpace(extra.GetValueOrDefault("description")) ? "-" : extra.GetValueOrDefault("description"))</textarea>
                            <div class="desc-preview"></div>
                        }
                        else
                        {
                            <div class="export-text">@(string.IsNullOrWhiteSpace(extra.GetValueOrDefault("description")) ? "-" : extra.GetValueOrDefault("description"))</div>
                        }
                    </td>
                    @if (isPreviewMode)
                    {
                        <td class="center">
                            <button type="button" class="btn-remove-row" onclick="removeRow(this)" title="Hapus baris">&times;</button>
                        </td>
                    }
                </tr>
            }

        </table>
    </div>

    <div class="section-after-exkul">
        <table class="excel-spacer">
            <tr>
                <td colspan="4">&nbsp;</td>
            </tr>
        </table>

        <table width="100%" class="stacked-table">
            <tr class="bold center">
                <th width="10%">NO</th>
                <th>KETIDAKHADIRAN</th>
                @if (isExportMode)
                {
                    <th width="20%" colspan="2">JUMLAH</th>
                }
                else
                {
                    <th width="20%">JUMLAH</th>
                }
            </tr>

            <tr>
                <td class="center">1</td>
                <td>Sakit</td>
                @if (isExportMode)
                {
                    <td class="center" colspan="2">@data["sick"] hari</td>
                }
                else
                {
                    <td class="center">@data["sick"] hari</td>
                }
            </tr>

            <tr>
                <td class="center">2</td>
                <td>Izin</td>
                @if (isExportMode)
                {
                    <td class="center" colspan="2">@data["permit"] hari</td>
                }
                else
                {
                    <td class="center">@data["permit"] hari</td>
                }
            </tr>

            <tr>
                <td class="center">3</td>
                <td>Tanpa Keterangan</td>
                @if (isExportMode)
                {
                    <td class="center" colspan="2">@data["alpha"] hari</td>
                }
                else
                {
                    <td class="center">@data["alpha"] hari</td>
                }
            </tr>
        </table>

        <table class="excel-spacer">
            <tr>
                <td colspan="4">&nbsp;</td>
            </tr>
        </table>

        <table width="100%" class="stacked-table">
            <tr>
                <td colspan="4" class="bold center">CATATAN WALI KELAS</td>
            </tr>
            <tr>
                <td colspan="4">
                    @if (isPreviewMode)
                    {
                        <textarea class="wali-notes">@savedWaliNotesPage1</textarea>
                        <div class="desc-preview walas"></div>
                    }
                    else
                    {
                        <div class="export-text walas">@savedWaliNotesPage1</div>
                    }
                </td>
            </tr>
        </table>

        <table class="excel-spacer">
            <tr>
