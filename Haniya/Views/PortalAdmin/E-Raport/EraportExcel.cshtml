    </div>
</div>

<table class="page-break-spacer">
    <tr>
        <td colspan="4">&nbsp;</td>
    </tr>
</table>
<div class="page-break"></div>

<!-- ========================= -->
<!-- HALAMAN 3 -->
<!-- ========================= -->

<div class="paper">
    <table class="no-border">
        <tr>
            <td width="15%">Nama</td>
            <td width="35%">: @data["full_name"]</td>

            <td width="15%">Kelas</td>
            <td width="35%">: @data["class_name"]</td>
        </tr>

        <tr>
            <td>NISN / NIS</td>
            <td>: @data["nis"]</td>

            <td>Fase</td>
            <td>: D</td>
        </tr>

        <tr>
            <td>Nama Sekolah</td>
            <td>: @data["school_name"]</td>

            <td>Semester</td>
            <td>: @data["semester"] ( @TerbilangSemester(data["semester"].ToString()) )</td>
        </tr>

        <tr>
            <td>Alamat</td>
            <td>: @data["school_address"]</td>

            <td>Tahun Pelajaran</td>
            <td>: @data["academic_year_name"]</td>
        </tr>
    </table>

    <br>

    <h3 class="center">LAPORAN HASIL BELAJAR</h3>

    <table>

        <tr class="bold center">
            <th width="5%">NO</th>
            <th width="31%">MATA PELAJARAN</th>
            <th width="7%">NILAI AKHIR</th>
            @if (isPreviewMode)
            {
                <th width="7%">NILAI TAMBAH</th>
            }
            <th>CAPAIAN KOMPETENSI</th>
        </tr>

        @foreach (DataRow row in report.Rows)
        {
            if (row["subject_type"].ToString() == "SUBJ_ISLAMIC")
            {
                var subjectName = row["subject_name"]?.ToString() ?? "";
                var adjustmentValue = GetSavedGradeValue(savedGradeMap, row["subject_id"], "final_score_adjustment", "0");
                var descriptionValue = GetSavedGradeValue(savedGradeMap, row["subject_id"], "competency_description", $"{data["full_name"]} membutuhkan bimbingan dalam pembelajaran {subjectName}.");
                var displayFinalScore = GetDisplayFinalScore(savedGradeMap, row, !isPreviewMode);
                var calculatedFinalScore = Math.Round(Convert.ToDecimal(row["final_score"] == DBNull.Value ? 0 : row["final_score"]), 0).ToString();
                <tr class="row-grade">
                    <td class="center">@noIsl</td>
                    <td class="subject-name">
                        @subjectName
                        <input type="hidden" class="subject-id" value="@row["subject_id"]" />
                        <input type="hidden" class="subject-type-id" value="@row["subject_code"]" />
                        <input type="hidden" class="subject-type-name" value="@row["subject_type"]" />
                        <input type="hidden" class="final-score-rps-raw" value="@calculatedFinalScore" />
                    </td>
                    <td class="final-score-rps center" align="center" style="text-align:center;vertical-align:middle;">
                        @displayFinalScore
                    </td>
                    @if (isPreviewMode)
                    {
                        <td class="center nt">
                            <input type="number"
                                   class="final-score-adjustment"
                                   value="@adjustmentValue"
                                   onfocus="clearZero(this)"
                                   onblur="restoreZero(this)">
                        </td>
                    }
                    <td>
                        @if (isPreviewMode)
                        {
                            <textarea class="desc">@descriptionValue</textarea>
                            <div class="desc-preview"></div>
                        }
                        else
                        {
                            <div class="export-text">@descriptionValue</div>
                        }
                    </td>
                </tr>

                noIsl++;
            }

        }
        @for (int filler = noIsl; filler <= targetIslamicRows; filler++)
        {
            <tr class="row-grade filler-row">
                <td class="center">@filler</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                @if (isPreviewMode)
                {
                    <td>&nbsp;</td>
                }
                <td>&nbsp;</td>
            </tr>
        }

    </table>

    <br>

    <table width="100%">

        <tr>
            <td colspan="@subjectTableColspan" class="bold center">CATATAN WALI KELAS</td>
        </tr>

        <tr>
            <td colspan="@subjectTableColspan">
                @if (isPreviewMode)
                {
                    <textarea class="wali-notes-2">@savedWaliNotesPage2</textarea>
                    <div class="desc-preview walas2"></div>
                }
                else
                {
                    <div class="export-text walas2">@savedWaliNotesPage2</div>
                }
            </td>
        </tr>

    </table>

    <br>
    <br>

    <table class="signature">

        <tr>
            <td width="41%" class="center">
                Mengetahui,<br>
                Orang Tua/Wali
            </td>

            <td class="signature-spacer"></td>

            <td width="41%" class="center">
                Bekasi, @DateTime.Now.ToString("dd MMMM yyyy", new CultureInfo("id-ID"))<br>
                Wali Kelas
            </td>
        </tr>

        <tr>
            <td class="center"><br><br>(.......................)</td>
            <td class="signature-spacer"></td>
            <td class="center"><br><br><b>@data["teacher_name"]</b></td>
        </tr>

    </table>

    <br>
    <br>

    <table class="signature">
        <tr>
            <td></td>
            <td width="52%" class="center">
                Mengetahui,<br>
                Kepala SMP IT Haniya
                <br><br><br><br><br>
                <b>@data["headschool_name"]</b>
            </td>
            <td></td>
        </tr>
    </table>

</div>
@if (isPreviewMode)
{
<div class="download-container">
    <div class="download-card">
        <button id="btnBack" type="button" class="action-btn action-btn-secondary" onclick="goBackToEraportList()">
            Back
        </button>
        <button id="btnSubmit" type="button" class="action-btn action-btn-primary" onclick="submitEraport()">
            Export PDF
        </button>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    const savedData = @Html.Raw(data.ContainsKey("saved_json") ? data["saved_json"]?.ToString() ?? "{}" : "{}");

    function applySavedData() {
        if (!savedData || typeof savedData !== 'object') return;

        const gradeMap = new Map();
        (savedData.grades || []).forEach(g => {
            if (g && g.subject_id) gradeMap.set(String(g.subject_id), g);
        });

        $('.row-grade').each(function () {
            const subjectId = ($(this).find('.subject-id').val() || '').toString();
            const savedGrade = gradeMap.get(subjectId);
            if (!savedGrade) return;

            const adjustment = (savedGrade.final_score_adjustment ?? '').toString().trim();
            if (adjustment !== '') {
                $(this).find('.final-score-adjustment').val(adjustment);
            }

            const desc = (savedGrade.competency_description ?? '').toString();
            if (desc.trim() !== '') {
                $(this).find('.desc').val(desc);
            }
        });

        if ((savedData.kokurikuler || '').toString().trim() !== '') {
            $('.kokurikuler').val(savedData.kokurikuler);
        }
        if ((savedData.wali_notes || '').toString().trim() !== '') {
            const split = String(savedData.wali_notes).split('\n');
            $('.wali-notes').val(split[0] || '');
            if (split.length > 1) {
                $('.wali-notes-2').val(split.slice(1).join('\n'));
            }
        }
        if ((savedData.parent_notes || '').toString().trim() !== '') {
            $('.parent-notes').val(savedData.parent_notes);
        }

        const extras = savedData.extracurriculars || [];
        if (extras.length > 0) {
            $('#exkulTable .row-extra').remove();
            extras.slice(0, 3).forEach((x, idx) => {
                appendEkskulRow({
                    no: idx + 1,
                    name: (x.extracurricular_name || '-'),
                    predicate: (x.predicate || '-'),
                    description: (x.description || '-')
                });
            });
            checkButton();
        }
    }

    function submitEraport() {
        const $btn = $('#btnSubmit');
        if ($btn.prop('disabled')) return;

        $btn.prop('disabled', true).text('Exporting PDF...');
        saveHeader()
            .done(function (res) {
                if (!res || res.success !== true) {
                    alert('Export PDF gagal.');
                    return;
                }

                triggerPdfDownload();
                alert('Data e-raport berhasil disimpan. Download PDF dimulai.');
            })
            .fail(function (err) {
                console.log(err.responseText);
                alert('Terjadi kesalahan saat export PDF.');
            })
            .always(function () {
                $btn.prop('disabled', false).text('Export PDF');
            });
    }

    function goBackToEraportList() {
        if (window.history.length > 1) {
            window.history.back();
            return;
        }
        window.location.href = '/Eraport';
    }

    function triggerPdfDownload() {
        const downloadUrl = `/Eraport/ExportPdf?id=@data["student_id"]&classId=@data["academic_class_id"]&download=true`;
        let iframe = document.getElementById('eraport-pdf-download-frame');
        if (!iframe) {
            iframe = document.createElement('iframe');
            iframe.id = 'eraport-pdf-download-frame';
            iframe.style.display = 'none';
            document.body.appendChild(iframe);
        }
        iframe.src = downloadUrl;
    }

    function autoResize() {
        document.querySelectorAll("textarea").forEach(el => {
            el.style.height = "auto";
            el.style.height = el.scrollHeight + "px";

            el.addEventListener("input", function () {
                this.style.height = "auto";
                this.style.height = this.scrollHeight + "px";
            });
        });
    }

    window.onload = function () {
        applySavedData();
        autoResize();
    };

    function appendEkskulRow(item) {
        const esc = (v) => String(v ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        let table = document.getElementById("exkulTable");
        let row = table.insertRow();
        row.classList.add("row-extra");
        row.innerHTML = `
            <td class="center">${item.no}</td>
            <td>
                <input class="exkul-name" value="${esc(item.name)}"
                onfocus="clearDash(this)"
                onblur="restoreDash(this)" />
                <div class="input-preview"></div>
            </td>
            <td class="center">
                <input class="exkul-predicate" value="${esc(item.predicate)}"
                onfocus="clearDash(this)"
                onblur="restoreDash(this)" />
                <div class="input-preview"></div>
            </td>
            <td>
                <textarea class="exkul-desc"
                onfocus="clearDash(this)"
                onblur="restoreDash(this)">${esc(item.description)}</textarea>
                <div class="desc-preview"></div>
            </td>
            <td class="center">
                <button type="button" class="btn-remove-row" onclick="removeRow(this)" title="Hapus baris">&times;</button>
            </td>
        `;
    }

    function addEkskulRow() {

        let table = document.getElementById("exkulTable");
        let btn = document.getElementById("btnAdd");

        let maxRow = 3;
        let rowCount = table.rows.length - 1; // minus header

        if (rowCount >= maxRow) return;

        appendEkskulRow({
            no: rowCount + 1,
            name: '-',
            predicate: '-',
            description: '-'
        });

        checkButton();
    }

    function removeRow(btn) {

        let row = btn.parentNode.parentNode;
        row.remove();

        renumber();
        checkButton();
    }

    function renumber() {

        let table = document.getElementById("exkulTable");

        for (let i = 1; i < table.rows.length; i++) {

            table.rows[i].cells[0].innerText = i;

        }

    }

    function checkButton() {

        let table = document.getElementById("exkulTable");
        let btn = document.getElementById("btnAdd");

        let maxRow = 3;
        let rowCount = table.rows.length - 1;

        if (rowCount >= maxRow) {
            btn.style.display = "none";
        } else {
            btn.style.display = "inline-block";
        }
    }

    function clearZero(el) {
        if (el.value === "0") {
            el.value = "";
        }
    }

    function restoreZero(el) {
        if (el.value === "") {
            el.value = "0";
        }
    }

    function clearDash(el) {
        if (el.value === "-") {
            el.value = "";
        }
    }

    function restoreDash(el) {
        if (el.value.trim() === "") {
            el.value = "-";
        }
    }

    function getPredicate(score) {
        score = parseInt(score) || 0;

        if (score <= 24) return "D";
        if (score <= 50) return "C";
        if (score <= 75) return "B";
        return "A";
    }

    function saveHeader() {

        let parent_notes = $('.parent-notes').val() || "";
        let wali_notes = $('.wali-notes').val() || "";
        let wali_notes_2 = $('.wali-notes-2').val() || "";
        let kokurikuler = $('.kokurikuler').val() || "";

        let grades = [];
        $('.row-grade').each(function () {

            let adjustmentRaw = $(this).find('.final-score-adjustment').val();
            let adjustment = (adjustmentRaw ?? '').toString().trim();
            if (adjustment === '') adjustment = '0';
            adjustment = adjustment.replace(',', '.');
            let predicate = getPredicate(adjustment);
            grades.push({
                subject_id: $(this).find('.subject-id').val(),
                subject_name: $(this).find('.subject-name').text().trim(),
                subject_type_id: $(this).find('.subject-type-id').val(),
                subject_type_name: $(this).find('.subject-type-name').val(),
                final_score_rps: (($(this).find('.final-score-rps-raw').val() || '').toString().trim() || $(this).find('.final-score-rps').text().trim() || '0'),
                final_score_adjustment: adjustment,
                predicate: predicate,
                competency_description: $(this).find('.desc').val()
            });
        });

        let extracurriculars = [];
        $('.row-extra').each(function () {
            extracurriculars.push({
                extracurricular_id: null,
                extracurricular_name: $(this).find('.exkul-name').val(),
                predicate: $(this).find('.exkul-predicate').val(),
                description: $(this).find('.exkul-desc').val()
            });
        });

        let data = {
            student_id: "@data["student_id"]",
            student_name: "@data["full_name"]",
            nis: "@data["nis"]",
            class_id: "@data["class_id"]",
            academic_class_id: "@data["academic_class_id"]",
            class_name: "@data["class_name"]",
            semester: "@data["semester"]",
            academic_year_id: "@data["academic_year_id"]",
            academic_year_name: "@data["academic_year_name"]",
            school_name: "@data["school_name"]",
            school_address: "@data["school_address"]",
            teacher_npk: "@data["teacher_npk"]",
            teacher_name: "@data["teacher_name"]",
            headschool_name: "@data["headschool_name"]",
            headschool_npk: "@data["headschool_npk"]",
            parent_name: "@data["parent_name"]",
            parent_notes: parent_notes,
            wali_notes: wali_notes,
            wali_notes_2: wali_notes_2,
            kokurikuler: kokurikuler,

            grades: JSON.stringify(grades),
            extracurriculars: JSON.stringify(extracurriculars),
            // attendances: JSON.stringify(attendances)
        };

        return $.ajax({
            url: '/Eraport/SaveHeader',
            type: 'POST',
            data: data
        });
    }

</script>
}
</body>


