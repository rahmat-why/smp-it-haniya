@using System.Globalization
@using System.Data
@using System.Linq

@{
    Layout = null;
    int noPri = 1;
    int noLoc = 1;
    int noIsl = 1;

    var data = (Dictionary<string, object>)Model;
    var report = (System.Data.DataTable)data["report"];
    var savedGradeMap = data.ContainsKey("saved_grade_map")
        ? data["saved_grade_map"] as Dictionary<string, Dictionary<string, string>> ?? new Dictionary<string, Dictionary<string, string>>()
        : new Dictionary<string, Dictionary<string, string>>();
    var savedExtracurriculars = data.ContainsKey("saved_extracurriculars")
        ? data["saved_extracurriculars"] as List<Dictionary<string, string>> ?? new List<Dictionary<string, string>>()
        : new List<Dictionary<string, string>>();
    var savedKokurikuler = data.ContainsKey("saved_kokurikuler") ? data["saved_kokurikuler"]?.ToString() ?? "" : "";
    var savedParentNotes = data.ContainsKey("saved_parent_notes") ? data["saved_parent_notes"]?.ToString() ?? "" : "";
    var savedWaliNotesPage1 = data.ContainsKey("saved_wali_notes_page1") ? data["saved_wali_notes_page1"]?.ToString() ?? "" : "";
    var savedWaliNotesPage2 = data.ContainsKey("saved_wali_notes_page2") ? data["saved_wali_notes_page2"]?.ToString() ?? "" : "";
    var renderMode = data.ContainsKey("render_mode") ? data["render_mode"]?.ToString() ?? "preview" : "preview";
    var isPreviewMode = renderMode == "preview";
    var isExportMode = renderMode == "pdf" || renderMode == "excel";
    var subjectTableColspan = isPreviewMode ? 5 : 4;
    var primaryCount = report.AsEnumerable().Count(row => row["subject_type"].ToString() == "SUBJ_PRIMARY");
    var localCount = report.AsEnumerable().Count(row => row["subject_type"].ToString() == "SUBJ_LOCAL");
    var islamicCount = report.AsEnumerable().Count(row => row["subject_type"].ToString() == "SUBJ_ISLAMIC");
    var targetPrimaryRows = Math.Max(1, primaryCount);
    var targetLocalRows = Math.Max(1, localCount);
    var targetIslamicRows = Math.Max(1, islamicCount);

}

@functions {
    public string TerbilangSemester(string semester)
    {
        switch (semester)
        {
            case "1": return "satu";
            case "2": return "dua";
            default: return "";
        }
    }

    public string GetSavedGradeValue(Dictionary<string, Dictionary<string, string>> savedGradeMap, object subjectId, string key, string fallback = "")
    {
        var sid = subjectId?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(sid)
            && savedGradeMap.TryGetValue(sid, out var item)
            && item.TryGetValue(key, out var value)
            && !string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        return fallback;
    }

    public string GetDisplayFinalScore(Dictionary<string, Dictionary<string, string>> savedGradeMap, DataRow row, bool useAdjustment)
    {
        var finalScoreRpsSaved = GetSavedGradeValue(savedGradeMap, row["subject_id"], "final_score_rps", "");
        var adjustment = GetSavedGradeValue(savedGradeMap, row["subject_id"], "final_score_adjustment", "");
        if (useAdjustment)
        {
            var normalizedAdjustment = (adjustment ?? "").Trim().Replace(',', '.');
            var hasNonZeroAdjustment = decimal.TryParse(normalizedAdjustment, NumberStyles.Any, CultureInfo.InvariantCulture, out var adjustmentNum)
                ? adjustmentNum != 0
                : !string.IsNullOrWhiteSpace(normalizedAdjustment);
            if (hasNonZeroAdjustment)
            {
                return adjustment;
            }
        }

        if (!string.IsNullOrWhiteSpace(finalScoreRpsSaved) && finalScoreRpsSaved != "0")
        {
            return finalScoreRpsSaved;
        }

        return Math.Round(Convert.ToDecimal(row["final_score"] == DBNull.Value ? 0 : row["final_score"]), 0).ToString();
    }
}

