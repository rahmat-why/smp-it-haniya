@using System.Globalization
@using System.Data

@{
    int noPri = 1;
    int noLoc = 1;
    int noIsl = 1;

    var data = (Dictionary<string, object>)Model;
    var report = (System.Data.DataTable)data["report"];

}

@functions {
    public string TerbilangSemester(string semester)
    {
        switch (semester)
        {
            case "1": return "satu";
            case "2": return "dua";
            default: return "";
        }
    }
}

<style>

    body {
        font-family: "Times New Roman";
        font-size: 14px;
        background: #e5e7eb;
    }

    table {
        border-collapse: collapse;
        width: 100%;
        page-break-inside: auto;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto;
    }

    td, th {
        border: 1px solid black;
        padding: 6px;
    }

    .no-border td {
        border: none;
    }

    .center {
        text-align: center;
    }

    .bold {
        font-weight: bold;
    }

    .signature td {
        border: none;
        height: 80px;
    }

    /* KERTAS A4 */
    .paper {
        width: 210mm;
        min-height: 297mm;
        background: white;
        margin: 20px auto;
        padding: 20mm;
        box-shadow: 0 0 10px rgba(0,0,0,0.15);
    }

    .page-break {
        page-break-before: always;
    }

    #exkulTable tr {
        page-break-inside: avoid;
    }

    /* PRINT MODE */
    @@media print {
        #btnSubmit,
        #btnAdd,
        #exkulTable td:last-child,
        #exkulTable th:last-child,
        #exkulTable button {
            display: none !important;
        }

        body {
            background: white;
        }

        .paper {
            box-shadow: none;
            margin: 0;
        }

        button {
            display: none;
        }
    }

    @@page {
        size: A4;
        margin: 0;
    }

    .download-container {
        width: 250mm;
        margin: 30px auto;
        display: flex;
        justify-content: flex-end;
    }

    .nt {
        background: #fffbe6;
        padding: 0;
    }

        .nt input {
            display: block;
            width: 100%;
            border: none;
            background: transparent;
            text-align: center;
            font-family: "Times New Roman";
            font-size: 14px;
        }

            .nt input:focus {
                outline: 2px solid #3b82f6;
            }

    textarea.desc,
    textarea.kokurikuler,
    textarea.wali-notes,
    textarea.parent-notes,
    textarea.wali-notes-2,
    textarea.exkul-desc {
        width: 100%;
        border: none;
        resize: none;
        overflow: hidden;
        font-family: "Times New Roman";
        font-size: 14px;
        line-height: 1.4;
        background: #fffbe6;
        padding: 4px;
    }

    textarea.parent-notes,
    textarea.wali-notes,
    textarea.wali-notes-2,
    textarea.kokurikuler {
        text-align: center;
    }

    .desc-preview {
        display: none;
        width: 100%;
        white-space: pre-wrap;
        word-wrap: break-word;
        font-family: "Times New Roman";
        font-size: 14px;
        text-align: center;
    }

    .walas,
    .walas2,
    .parent {
        min-height: 100px;
    }

    /* remove spinner */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }

    input {
        width: 100%;
        border: none;
        line-height: 1.4;
        background: #fffbe6;
        padding: 4px;
    }

    #btnAdd {
        margin-bottom: 8px;
        border: 1px solid #2563eb;
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-remove-row {
        border: 1px solid #dc2626;
        background: #fef2f2;
        color: #b91c1c;
        border-radius: 9999px;
        width: 26px;
        height: 26px;
        line-height: 20px;
        cursor: pointer;
        font-weight: 700;
    }

</style>

<!-- ========================= -->
<!-- HALAMAN 1 -->
<!-- ========================= -->

<div class="paper">
    <table class="no-border">
        <tr>
            <td width="15%">Nama</td>
            <td width="35%">: @data["full_name"]</td>

            <td width="15%">Kelas</td>
            <td width="35%">: @data["class_name"]</td>
        </tr>

        <tr>
            <td>NISN / NIS</td>
            <td>: @data["nis"]</td>

            <td>Fase</td>
            <td>: D</td>
        </tr>

        <tr>
            <td>Nama Sekolah</td>
            <td>: @data["school_name"]</td>

            <td>Semester</td>
            <td>: @data["semester"] ( @TerbilangSemester(data["semester"].ToString()) )</td>
        </tr>

        <tr>
            <td>Alamat</td>
            <td>: @data["school_address"]</td>

            <td>Tahun Pelajaran</td>
            <td>: @data["academic_year_name"]</td>
        </tr>
    </table>

    <br>

    <h3 class="center">LAPORAN HASIL BELAJAR</h3>

    <table>

        <tr class="bold center">
            <th width="5%">NO</th>
            <th width="31%">MATA PELAJARAN</th>
            <th width="7%">NILAI AKHIR</th>
            <th width="7%">NILAI TAMBAH</th>
            <th>CAPAIAN KOMPETENSI</th>
        </tr>

        @foreach (DataRow row in report.Rows)
        {
            if (row["subject_type"].ToString() == "SUBJ_PRIMARY")
            {
                <tr class="row-grade">
                    <td class="center">@noPri</td>
                    <td class="subject-name">
                        @row["subject_name"]
                        <input type="hidden" class="subject-id" value="@row["subject_id"]" />
                        <input type="hidden" class="subject-type-id" value="@row["subject_code"]" />
                        <input type="hidden" class="subject-type-name" value="@row["subject_type"]" />
                    </td>
                    <td class="final-score-rps center">
                        @Math.Round(Convert.ToDecimal(row["final_score"] == DBNull.Value ? 0 : row["final_score"]), 0)
                    </td>
                    <td class="center nt">
                        <input type="number"
                               class="final-score-adjustment"
                               value="0"
                               onfocus="clearZero(this)"
                               onblur="restoreZero(this)">
                    </td>
                    <td>
                        <textarea class="desc">@data["full_name"] membutuhkan bimbingan dalam pembelajaran @row["subject_name"].</textarea>
                        <div class="desc-preview"></div>
                    </td>
                </tr>

                noPri++;
            }

        }

    </table>

    <br>

    <h3>MUATAN LOKAL</h3>

    <table>
        <tr class="bold center">
            <th width="5%">NO</th>
            <th width="31%">MATA PELAJARAN</th>
            <th width="7%">NILAI AKHIR</th>
            <th width="7%">NILAI TAMBAH</th>
            <th>CAPAIAN KOMPETENSI</th>
        </tr>

        @foreach (DataRow row in report.Rows)
        {
            if (row["subject_type"].ToString() == "SUBJ_LOCAL")
            {
                <tr class="row-grade">
                    <td class="center">@noLoc</td>
                    <td class="subject-name">
                        @row["subject_name"]
                        <input type="hidden" class="subject-id" value="@row["subject_id"]" />
                        <input type="hidden" class="subject-type-id" value="@row["subject_code"]" />
                        <input type="hidden" class="subject-type-name" value="@row["subject_type"]" />
                    </td>
                    <td class="final-score-rps center">
                        @Math.Round(Convert.ToDecimal(row["final_score"] == DBNull.Value ? 0 : row["final_score"]), 0)
                    </td>
                    <td class="center nt">
                        <input type="number"
                               class="final-score-adjustment"
                               value="0"
                               onfocus="clearZero(this)"
                               onblur="restoreZero(this)">
                    </td>
                    <td>
                        <textarea class="desc">@data["full_name"] membutuhkan bimbingan dalam pembelajaran @row["subject_name"].</textarea>
                        <div class="desc-preview"></div>
                    </td>
                </tr>

                noLoc++;
            }
        }

    </table>

    <br>

    <table>
        <tr class="bold center">
            <th width="100%">KOKURIKULER</th>
        </tr>
        <tr>
            <td>
                <textarea class="kokurikuler">Ananda @data["full_name"] sudah sangat menghargai sesama teman berdasarkan yang terlihat dari beberapa proyek pembelajaran interdisipliner.</textarea>
                <div class="desc-preview"></div>
            </td>
        </tr>
    </table>



    <br>

    <div>
        <h3>EKSTRAKURIKULER</h3>

        <button id="btnAdd" type="button" onclick="addEkskulRow()">+ Tambah</button>

        <table id="exkulTable">

            <tr class="bold center">
                <th width="5%">NO</th>
                <th>KEGIATAN</th>
                <th width="15%">PREDIKAT</th>
                <th>KETERANGAN</th>
                <th width="5%">Aksi</th>
            </tr>

            <tr class="row-extra">
                <td class="center">1</td>
                <td>
                    <input class="exkul-name" value="-"
                           onfocus="clearDash(this)"
                           onblur="restoreDash(this)" />
                    <div class="input-preview"></div>
                </td>

                <td class="center">
                    <input class="exkul-predicate" value="-"
                           onfocus="clearDash(this)"
                           onblur="restoreDash(this)" />
                    <div class="input-preview"></div>
                </td>
                <td>
                    <textarea class="exkul-desc"
                              onfocus="clearDash(this)"
                              onblur="restoreDash(this)">-</textarea>
                    <div class="desc-preview"></div>
                </td>

                <td class="center">
                    <button type="button" class="btn-remove-row" onclick="removeRow(this)" title="Hapus baris">&times;</button>
                </td>
            </tr>

        </table>
    </div>

</div>

<div class="page-break"></div>

