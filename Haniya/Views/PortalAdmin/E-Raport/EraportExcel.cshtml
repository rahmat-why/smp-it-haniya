        <table width="100%" class="stacked-table">
            <tr>
                <td colspan="4" class="bold center">TANGGAPAN ORANG TUA / WALI MURID</td>
            </tr>
            <tr>
                <td colspan="4">
                    @if (isPreviewMode)
                    {
                        <textarea class="parent-notes">@savedParentNotes</textarea>
                        <div class="desc-preview parent"></div>
                    }
                    else
                    {
                        <div class="export-text parent">@savedParentNotes</div>
                    }
                </td>
            </tr>
        </table>

        <table class="excel-spacer">
            <tr>
                <td colspan="4">&nbsp;</td>
            </tr>
        </table>

        <table class="signature">
    
            <tr>
                <td width="41%" class="center">
                    Mengetahui,<br>
                    Orang Tua/Wali
                </td>
    
                <td class="signature-spacer"></td>
    
                <td width="41%" class="center">
                    Bekasi, @DateTime.Now.ToString("dd MMMM yyyy", new CultureInfo("id-ID"))<br>
                    Wali Kelas
                </td>
            </tr>
    
            <tr>
                <td class="center"><br><br>(.......................)</td>
                <td class="signature-spacer"></td>
                <td class="center"><br><br><b>@data["teacher_name"]</b></td>
            </tr>
    
        </table>

        <table class="excel-spacer">
            <tr>
                <td colspan="4">&nbsp;</td>
            </tr>
        </table>
    
        <table class="signature">
            <tr>
                <td></td>
                <td width="52%" class="center">
                    Mengetahui,<br>
                    Kepala SMP IT Haniya
                    <br><br><br><br><br>
                    <b>@data["headschool_name"]</b>
