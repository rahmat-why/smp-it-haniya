@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Academic Class";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Academic Class List</h2>
    <a href="/AcademicClass/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
       data-testid="academic-class-add-button">
        + Add Academic Class
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="academic-toolbar"
            class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        </div>
    </div>
    <div class="px-4 pt-4">
        <div class="overflow-x-auto border border-gray-200 rounded-xl bg-white shadow-sm">
            <table id="academic-class-table" class="w-full text-sm text-left text-gray-700 border-collapse">
                <thead class="bg-gray-50 text-gray-600 border-b border-gray-200">
                    <tr>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Academic Year</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Semester</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Class</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Class Level</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Homeroom Teacher</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider">Teacher NPK</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white"></tbody>
            </table>
        </div>
    </div>
    <div class="px-4 pb-4 pt-3">
        <div id="academic-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info"></div>
            <div id="table-pagination"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            initAcademicClassTable();
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.academic-class-actions-wrapper').length) {
                    $('.academic-class-actions-menu').addClass('hidden');
                }
            });
        });

        function formatDateShort(d) {
            if (!d) return "";
            const date = new Date(d);
            if (isNaN(date.getTime())) return "";
            return date.getFullYear();
        }

        function initAcademicClassTable() {
            const table = $('#academic-class-table').DataTable({
                processing: true,
                serverSide: false,
                searching: true,
                lengthChange: true,
                ordering: true,
                order: [[0, 'desc']],
                dom: 't', 
                ajax: {
                    url: '/AcademicClass/GetAll',
                    type: 'GET',
                    dataSrc: function (res) {
                        if (!res.success) {
                            alert(res.message || "Failed to load academic classes");
                            return [];
                        }
                        return res.data;
                    }
                },
                columns: [
                    {
                        data: null,
                        className: 'px-5 py-3 whitespace-nowrap',
                        render: function(data) {
                            return (data.start_date && data.end_date)
                                ? `${formatDateShort(data.start_date)} / ${formatDateShort(data.end_date)}`
                                : '-';
                        }
                    },
                    {
                        data: 'semester',
                        className: 'px-5 py-3 whitespace-nowrap',
                        render: data => data ? `Semester ${data}` : '-'
                    },
                    {
                        data: 'class_name',
                        className: 'px-5 py-3 whitespace-nowrap',
                        render: data => data || '-'
                    },
                    {
                        data: 'class_level',
                        className: 'px-5 py-3 whitespace-nowrap',
                        render: data => data || '-'
                    },
                    {
                        data: 'homeroom_teacher_name',
                        className: 'px-5 py-3 whitespace-nowrap',
                        render: data => data || '-'
                    },
                    {
                        data: 'homeroom_teacher_npk',
                        className: 'px-5 py-3 whitespace-nowrap',
                        render: data => data || '-'
                    },
                    {
                        data: 'academic_class_id',
                        className: 'px-5 py-3 text-right',
                        orderable: false,
                        render: function(data, type, row) {
                            const id = data;
                            return `
                                <div class="relative inline-block text-left academic-class-actions-wrapper">
                                    <button type="button"
                                            onclick="toggleActionsMenu('${id}')"
                                            class="inline-flex items-center justify-center w-8 h-8 rounded-full hover:bg-gray-100 text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                            data-testid="academic-class-actions-toggle-${id}">
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M12 5.25a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 5.25a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 5.25a1.5 1.5 0 110 3 1.5 1.5 0 010-3z" />
                                        </svg>
                                    </button>

                                    <div id="actions-menu-${id}"
                                         class="academic-class-actions-menu hidden origin-top-right absolute right-0 mt-2 w-32 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-10"
                                         data-testid="academic-class-actions-menu-${id}">
                                        <div class="py-1">
                                            <a href="/AcademicClass/Edit?id=${id}"
                                               class="block px-3 py-1.5 text-left text-gray-700 hover:bg-gray-100 text-sm"
                                               data-testid="academic-class-edit-action-${id}">
                                                Edit
                                            </a>
                                            <button type="button"
                                                    onclick="delAcademicClass('${id}')"
                                                    class="w-full text-left block px-3 py-1.5 text-sm text-red-600 hover:bg-red-50"
                                                    data-testid="academic-class-delete-action-${id}">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }
                    }
                ],
                initComplete: function () {
                    renderCustomControls(this.api());
                },
                drawCallback: function () {
                    renderCustomControls(this.api());
                },
            });
        }

        function renderCustomControls(api) {
            $('#academic-toolbar').html(`
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 w-full">
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                        Show 
                        <select id="dt-length" class="border border-gray-300 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-900">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select> rows
                    </div>
                    <div>
                        <input id="dt-search"
                            type="text"
                            placeholder="Search academic class..."
                            class="border border-gray-300 rounded-lg px-3 py-2 w-full md:w-72 focus:outline-none focus:ring-2 focus:ring-blue-900"/>
                    </div>
                </div>
            `);

            $('#dt-length').val(api.page.len());
            $('#dt-length').off().on('change', function () {
                api.page.len($(this).val()).draw();
            });

            $('#dt-search').off().on('keyup', function () {
                api.search(this.value).draw();
            });

            const info = api.page.info();
            $('#table-info').html(`
                <span class="text-sm text-gray-600">
                    Showing ${info.start + 1} to ${info.end} of ${info.recordsTotal} entries
                </span>
            `);

            let paginateHtml = `<div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">`;

            for (let i = 0; i < info.pages; i++) {
                paginateHtml += `
                <button data-page="${i}"
                    class="px-3 py-2 text-sm border-r border-gray-200 rounded-none last:rounded-r-lg last:border-r-0 
                        ${i === info.page ? 'bg-blue-900 text-white font-semibold' : 'bg-white text-gray-700 hover:bg-gray-50'} 
                        flex-shrink-0">
                    ${i + 1}
                </button>
                `;
            }

            paginateHtml += `</div>`;
            $('#table-pagination').html(paginateHtml);

            $('#table-pagination button').off().on('click', function () {
                api.page($(this).data('page')).draw('page');
            });
        }

        function toggleActionsMenu(id) {
            const selector = '#actions-menu-' + id;
            const $menu = $(selector);

            if (!$menu.length) return;

            const isHidden = $menu.hasClass('hidden');

            $('.academic-class-actions-menu').addClass('hidden');

            if (isHidden) $menu.removeClass('hidden');
            else $menu.addClass('hidden');
        }

        function delAcademicClass(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                $.ajax({
                url: "/AcademicClass/Delete",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({
                        action: "delete",
                        id: id,
                        data: null
                    }),
                    success: res => {
                        if (res.success) {
                            $('#student-table').DataTable().ajax.reload(null, false);
                            Swal.fire(
                                'Deleted!',
                                'Class data has been deleted.',
                                'success'
                            );
                        } else {
                            Swal.fire(
                                'Failed!',
                                res.message,
                                'error'
                            );
                        }
                    },
                    error: function () {
                        Swal.fire(
                            'Error!',
                            'An error occurred while deleting the class.',
                            'error'
                        );
                    }
                });
            });
        }
    </script>
}