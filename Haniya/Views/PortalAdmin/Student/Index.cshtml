@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Student";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Student List</h2>
    <a href="/Student/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
       data-testid="student-add-button">
        + Add Student
    </a>
</div>
<div class="bg-white rounded-lg shadow">
    <!-- Toolbar -->
    <div class="px-4 pt-4">
        <div id="student-table-toolbar"
             class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto px-4 pt-4">
        <table id="student-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 250px;">Student</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Birth Date</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Birth Place</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 80px;">Gender</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Address</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Entry Date</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 130px;">Level</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase !text-right" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="px-4 pb-4 pt-3">
        <div id="student-table-footer"
             class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="student-table-info"></div>
            <div id="student-table-pagination"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        initStudentTable();
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.student-actions-wrapper').length) {
                $('.student-actions-menu').addClass('hidden');
            }
        });
    });

    function initStudentTable() {
        $('#student-table').DataTable({
            processing: true,
            serverSide: true,
            searching: true,
            lengthChange: true,
            ordering: true,
            order: [[0, 'desc']],


            ajax: {
                url: '/Student/GetAll',
                type: 'GET'
            },

            dom: 'lftip',

            // LANGUAGE (pisah, jangan nested)
            language: {
                lengthMenu: "Show _MENU_ rows",
                search: "",
                searchPlaceholder: "Search...",
                paginate: {
                    first: "First",
                    last: "Last",
                    next: "Next",
                    previous: "Previous"
                },
                info: "Showing _START_ to _END_ of _TOTAL_ entries"
            },


            // COLUMNS (harus sejajar, bukan di dalam language)
            columns: [

                // Nama + Foto
                {
                    data: null,
                    orderable: true,
                    name: 'full_name',
                    className: 'py-3',
                    render: function (data, type, row) {

                        var src = row.profile_photo || '/image/no-image.png';
                        var name = row.full_name || '-';
                        var nis = row.nis || '-';

                        return `
                            <div class="flex items-center gap-3">
                                <img src="${src}"
                                        class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 flex-shrink-0">

                                <div class="min-w-0 flex-1">
                                    <div class="font-medium text-gray-900 truncate">${name}</div>
                                    <div class="text-xs text-gray-500 truncate">NIS: ${nis}</div>
                                </div>
                            </div>
                        `;
                    }
                },


                // Tanggal Lahir
                {
                    data: 'birth_date',
                    className: 'py-3',
                    render: function (data) {
                        return formatDate(data);
                    }
                },


                // Tempat Lahir
                {
                    data: 'birth_place',
                    className: 'py-3'
                },


                // Gender
                {
                    data: 'gender',
                    className: 'py-3'
                },


                // Alamat
                {
                    data: 'address',
                    className: 'py-3'
                },


                // Tanggal Masuk
                {
                    data: 'entry_date',
                    className: 'py-3',
                    render: function (data) {
                        return formatDate(data);
                    }
                },


                // Level
                {
                    data: 'level',
                    className: 'py-3'
                },


                // Action
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center py-3',

                    render: function (data, type, row) {

                        var id = row.student_id;
                        var editUrl = '/Student/Edit?id=' + id;

                        return `
                            <div class="flex justify-center student-actions-wrapper relative">

                                <button type="button"
                                        onclick="toggleActionsMenu(event, '${id}')"
                                        class="p-1.5 hover:bg-gray-100 rounded-md">

                                    <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10 6a2 2 0 110-4 2 2 0 010 4z
                                                    M10 12a2 2 0 110-4 2 2 0 010 4z
                                                    M10 18a2 2 0 110-4 2 2 0 010 4z"/>
                                    </svg>
                                </button>


                                <div id="actions-menu-${id}" class="student-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">

                                    <a href="${editUrl}"
                                        class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50">

                                        Edit
                                    </a>


                                    <button type="button"
                                            onclick="delStudent('${id}')"
                                            class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100">

                                        Delete
                                    </button>

                                </div>
                            </div>
                        `;
                    }
                }
            ],



            // INIT
            initComplete: function () {

                const wrapper = $('#student-table_wrapper');

                const $length = wrapper.find('.dataTables_length, .dt-length');
                const $filter = wrapper.find('.dataTables_filter, .dt-search');

                $('#student-table-toolbar').empty().append($length).append($filter);


                // Length style
                $length.addClass('flex items-center gap-2 text-sm text-gray-600');

                $length.find('select')
                    .addClass('border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500');


                // Search style
                const $search = $filter.find('input');

                $filter.addClass('flex items-center gap-2 text-sm text-gray-600 w-full md:w-auto justify-end');
                $filter.find('label').addClass('flex items-center gap-2 w-full md:w-auto');

                $search
                    .addClass('border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500 w-full md:w-64')
                    .attr('placeholder', 'Search...');

                styleStudentPagination();
            },


            drawCallback: function () {
                setTimeout(styleStudentPagination, 50);
            }

        });
    }

    function styleStudentPagination() {
        const wrapper = $('#student-table_wrapper');

        let $info = wrapper.find('.dataTables_info').first();
        if ($info.length === 0) $info = wrapper.find('.dt-info').first();

        let $paginate = wrapper.find('.dataTables_paginate').first();
        if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

        if ($info.length) {
            $('#student-table-info').empty().append($info);
            $info.removeClass().addClass('text-sm text-gray-600');
        }

        if ($paginate.length) {
            $('#student-table-pagination').empty().append($paginate);
        }

        $('#student-table-pagination').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
        if (typeof applyAdminPaginationStyle === 'function') {
            applyAdminPaginationStyle($('#student-table-pagination'));
        }
    }

    function toggleActionsMenu(event, id) {
        event.stopPropagation();
        $('.student-actions-menu').addClass('hidden');
        $('#actions-menu-' + id).toggleClass('hidden');
    }

    function delStudent(id) {
        $('.student-actions-menu').addClass('hidden');
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (!result.isConfirmed) return;

            $.ajax({
                url: "/Student/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    action: "delete",
                    id: id,
                    data: null
                }),
                success: res => {
                    if (res.success) {
                        $('#student-table').DataTable().ajax.reload(null, false);
                        Swal.fire(
                            'Deleted!',
                            'Student data has been deleted.',
                            'success'
                        );
                    } else {
                        Swal.fire(
                            'Failed!',
                            res.message,
                            'error'
                        );
                    }
                },
                error: function () {
                    Swal.fire(
                        'Error!',
                        'An error occurred while deleting the student.',
                        'error'
                    );
                }
            });
        });
    }
</script>
}

