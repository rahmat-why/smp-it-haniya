@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Student";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Student List</h2>
    <a id="student-add-link" href="/Student/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
       data-testid="student-add-button">
        + Add Student
    </a>
</div>
<div class="bg-white rounded-lg shadow">
    <!-- Toolbar -->
    <div class="px-4 pt-4">
        <div id="student-table-toolbar"
             class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto px-4 pt-4">
        <table id="student-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th data-sort="student" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 250px;">Student</th>
                    <th data-sort="birthDate" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 130px;">Birth Date</th>
                    <th data-sort="birthPlace" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 130px;">Birth Place</th>
                    <th data-sort="gender" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center cursor-pointer select-none" style="width: 80px;">Gender</th>
                    <th data-sort="address" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Address</th>
                    <th data-sort="entryDate" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 130px;">Entry Date</th>
                    <th data-sort="level" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 130px;">Level</th>
                    <th data-sort="class" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 90px;">Class</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase !text-right" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="px-4 pb-4 pt-3">
        <div id="student-table-footer"
             class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="student-table-info"></div>
            <div id="student-table-pagination"></div>
        </div>
    </div>
</div>

<div id="tw-modal" class="hidden fixed inset-0 z-50" aria-hidden="true">
    <div class="absolute inset-0 bg-black/40" data-modal-close></div>
    <div class="relative min-h-full flex items-center justify-center p-4">
        <div class="w-full max-w-md rounded-xl bg-white shadow-xl" role="dialog" aria-modal="true" aria-labelledby="tw-modal-title">
            <div class="px-5 py-4 border-b border-gray-100">
                <h3 id="tw-modal-title" class="text-base font-semibold text-gray-900"></h3>
            </div>
            <div class="px-5 py-4">
                <p id="tw-modal-message" class="text-sm text-gray-600"></p>
            </div>
            <div class="px-5 py-4 border-t border-gray-100 flex justify-end gap-2">
                <button id="tw-modal-cancel" type="button" class="px-4 py-2 text-sm rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50">Cancel</button>
                <button id="tw-modal-confirm" type="button" class="px-4 py-2 text-sm rounded-md bg-blue-900 text-white hover:bg-blue-800">Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const pageState = {
        page: 1,
        limit: 10,
        filters: { search: '' },
        sort: { field: 'student', order: 'desc' },
        hasNextPage: false
    };
    let lastRequestKey = '';
    let searchDebounce = null;

    function formatDateCell(value) {
        if (!value) return '-';
        return formatDate(value);
    }

    function getStateQuery() {
        return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`;
    }

    function syncStateToUrl() {
        history.replaceState({ ...pageState }, '', `?${getStateQuery()}`);
        $('#student-add-link').attr('href', `/Student/Create?returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`);
    }

    function hydrateStateFromUrl() {
        const q = new URLSearchParams(window.location.search);
        const page = Number(q.get('page') || 1);
        const limit = Number(q.get('limit') || 10);
        pageState.page = Number.isFinite(page) && page > 0 ? page : 1;
        pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10;
        pageState.filters.search = q.get('search') || '';
        pageState.sort.field = q.get('sortField') || 'student';
        pageState.sort.order = q.get('sortOrder') || 'desc';
    }

    function renderToolbar() {
        $('#student-table-toolbar').html(`
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 w-full">
                <div class="flex items-center gap-2 text-sm text-gray-600">
                    Show
                    <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select> rows
                </div>
                <div>
                    <input id="list-search" type="text" placeholder="Search..." class="border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500 w-full md:w-64"/>
                </div>
            </div>
        `);

        $('#list-limit').val(String(pageState.limit));
        $('#list-search').val(pageState.filters.search || '');

        $('#list-limit').off('change').on('change', function () {
            const next = Number($(this).val() || 10);
            if (pageState.limit === next) return;
            pageState.limit = next;
            pageState.page = 1;
            lastRequestKey = '';
            fetchStudents();
        });

        $('#list-search').off('input').on('input', function () {
            const val = $(this).val() || '';
            if ((pageState.filters.search || '') === val) return;
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                pageState.filters.search = val;
                pageState.page = 1;
                lastRequestKey = '';
                fetchStudents();
            }, 300);
        });
    }

    function renderSortIndicators() {
        $('#student-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ▲' : ' ▼') : '';
            const base = $(this).text().replace(/ [▲▼]$/, '');
            $(this).text(base + icon);
        });
    }

    function renderRows(items) {
        const $tbody = $('#student-table tbody');
        if (!items || !items.length) {
            $tbody.html(`<tr><td colspan="9" class="px-4 py-8 text-center text-gray-500">No data found.</td></tr>`);
            return;
        }

        let html = '';
        items.forEach(row => {
            const id = row.student_id || '';
            const src = (typeof row.profile_photo === 'string' && row.profile_photo.trim() !== '')
                ? row.profile_photo
                : '/image/no-image.png';
            const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            html += `
                <tr class="bg-white divide-y divide-gray-100">
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <img src="${src}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 flex-shrink-0">
                            <div class="min-w-0 flex-1">
                                <div class="font-medium text-gray-900 truncate">${row.full_name || '-'}</div>
                                <div class="text-xs text-gray-500 truncate">NIS: ${row.nis || '-'}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-3">${formatDateCell(row.birth_date)}</td>
                    <td class="px-4 py-3">${row.birth_place || '-'}</td>
                    <td class="px-4 py-3 text-center">${row.gender || '-'}</td>
                    <td class="px-4 py-3">${row.address || '-'}</td>
                    <td class="px-4 py-3">${formatDateCell(row.entry_date)}</td>
                    <td class="px-4 py-3">${row.level || '-'}</td>
                    <td class="px-4 py-3">${row.class || '-'}</td>
                    <td class="px-4 py-3 text-right">
                        <div class="inline-flex justify-end student-actions-wrapper relative">
                            <button type="button" onclick="toggleActionsMenu(event, '${id}')" class="p-1.5 hover:bg-gray-100 rounded-md">
                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4z M10 12a2 2 0 110-4 2 2 0 010 4z M10 18a2 2 0 110-4 2 2 0 010 4z"/>
                                </svg>
                            </button>
                            <div id="actions-menu-${id}" class="student-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">
                                <a href="/Student/Edit?id=${encodeURIComponent(id)}&returnUrl=${returnUrl}" class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50">Edit</a>
                                <button type="button" onclick="delStudent('${id}')" class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100">Delete</button>
                            </div>
                        </div>
                    </td>
                </tr>
            `;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#student-table-info').html(`<span class="text-sm text-gray-600">Showing ${start} to ${end}</span>`);

        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        $('#student-table-pagination').html(`
            <div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                <button id="page-prev" class="px-3 py-2 text-sm border-r border-gray-200 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>
                <span class="px-3 py-2 text-sm bg-blue-900 text-white font-semibold">${pageState.page}</span>
                <button id="page-next" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Next</button>
            </div>
        `);

        $('#page-prev').off('click').on('click', function () {
            if (pageState.page <= 1) return;
            pageState.page -= 1;
            lastRequestKey = '';
            fetchStudents();
        });
        $('#page-next').off('click').on('click', function () {
            if (!pageState.hasNextPage) return;
            pageState.page += 1;
            lastRequestKey = '';
            fetchStudents();
        });
    }

    async function fetchStudents() {
        const payload = {
            page: pageState.page,
            limit: pageState.limit,
            filters: { ...pageState.filters },
            sort: { ...pageState.sort }
        };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();

        try {
            const res = await $.ajax({
                url: '/Student/GetAll',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });
            if (!res.success) {
                lastRequestKey = '';
                showMessageModal('Failed', res.message || 'Failed to load student data.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.hasNextPage = !!result.hasNextPage;
            renderRows(items);
            renderPagination(items.length);
        } catch {
            lastRequestKey = '';
            showMessageModal('Error', 'An error occurred while loading student data.');
        }
    }

    function toggleActionsMenu(event, id) {
        event.stopPropagation();
        $('.student-actions-menu').addClass('hidden');
        $('#actions-menu-' + id).toggleClass('hidden');
    }

    async function delStudent(id) {
        $('.student-actions-menu').addClass('hidden');
        const yes = await confirmModal({
            title: 'Delete Confirmation',
            message: 'Are you sure you want to delete this data?',
            confirmText: 'Delete',
            cancelText: 'Cancel'
        });
        if (!yes) return;

        try {
            const res = await $.ajax({
                url: "/Student/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    action: "delete",
                    id: id,
                    data: null
                })
            });
            if (!res || !res.success) {
                await showMessageModal('Failed', (res && res.message) ? res.message : 'Delete failed.');
                return;
            }
            lastRequestKey = '';
            await fetchStudents();
            await showMessageModal('Deleted', 'Student data has been deleted.');
        } catch {
            await showMessageModal('Error', 'An error occurred while deleting the student.');
        }
    }

    function confirmModal({ title, message, confirmText = 'Confirm', cancelText = 'Cancel' }) {
        return new Promise((resolve) => {
            const $modal = $('#tw-modal');
            const $title = $('#tw-modal-title');
            const $msg = $('#tw-modal-message');
            const $confirm = $('#tw-modal-confirm');
            const $cancel = $('#tw-modal-cancel');

            $title.text(title || 'Confirm');
            $msg.text(message || '');
            $confirm.text(confirmText);
            $cancel.text(cancelText);
            $modal.removeClass('hidden').attr('aria-hidden', 'false');
            $confirm.trigger('focus');

            const close = (result) => {
                $modal.addClass('hidden').attr('aria-hidden', 'true');
                $confirm.off('click');
                $cancel.off('click');
                $modal.find('[data-modal-close]').off('click');
                $(document).off('keydown.modalEsc');
                resolve(result);
            };

            $confirm.on('click', () => close(true));
            $cancel.on('click', () => close(false));
            $modal.find('[data-modal-close]').on('click', () => close(false));
            $(document).on('keydown.modalEsc', function (e) {
                if (e.key === 'Escape') close(false);
            });
        });
    }

    function showMessageModal(title, message) {
        return confirmModal({ title, message, confirmText: 'OK', cancelText: 'Close' });
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();
        fetchStudents();
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.student-actions-wrapper').length) {
                $('.student-actions-menu').addClass('hidden');
            }
        });
        $('#student-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) {
                pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            } else {
                pageState.sort.field = field;
                pageState.sort.order = 'asc';
            }
            pageState.page = 1;
            lastRequestKey = '';
            fetchStudents();
        });
    });
</script>
}

