@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Edit Student";
    var id = ViewBag.studentId;
}

<input type="hidden" id="student_id" name="student_id" value="@id">

<h2 class="text-xl font-semibold mb-4">Edit Student</h2>

<div class="bg-white p-6 rounded-lg shadow w-full space-y-6">
    <form id="frm" enctype="multipart/form-data" class="space-y-6 w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
            <div class="border border-gray-200 rounded-lg overflow-hidden w-full">
                <button type="button"
                        onclick="toggleSection('student')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"
                        data-testid="student-info-toggle">
                    <span class="font-semibold text-white">
                        Student Information
                    </span>
                    <svg id="icon-student"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div id="student" class="px-4 pb-4 pt-3 space-y-3 border-t border-gray-100" data-testid="student-info-section">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">
                                First Name <span class="text-red-500">*</span>
                            </label>
                            <input id="first_name"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="first-name-input" />
                            <p id="error-first_name"
                               class="mt-1 text-xs text-red-600 hidden validation-error-message"
                               data-testid="error-first_name"></p>
                        </div>
                        <div>
                            <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">
                                Last Name
                            </label>
                            <input id="last_name"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="last-name-input" />
                        </div>
                    </div>

                    <div>
                        <label for="nis" class="block text-sm font-medium text-gray-700 mb-1">
                            NIS <span class="text-red-500">*</span>
                        </label>
                        <input id="nis"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="nis-input" />
                        <p id="error-nis"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-nis"></p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label for="birth_date" class="block text-sm font-medium text-gray-700 mb-1">
                                Birth Date <span class="text-red-500">*</span>
                            </label>
                            <input type="date"
                                   id="birth_date"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="birth-date-input" />
                            <p id="error-birth_date"
                               class="mt-1 text-xs text-red-600 hidden validation-error-message"
                               data-testid="error-birth_date"></p>
                        </div>
                        <div>
                            <label for="birth_place" class="block text-sm font-medium text-gray-700 mb-1">
                                Birth Place <span class="text-red-500">*</span>
                            </label>
                            <input id="birth_place"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="birth-place-input" />
                            <p id="error-birth_place"
                               class="mt-1 text-xs text-red-600 hidden validation-error-message"
                               data-testid="error-birth_place"></p>
                        </div>
                    </div>

                    <div>
                        <label for="gender" class="block text-sm font-medium text-gray-700 mb-1">
                            Gender <span class="text-red-500">*</span>
                        </label>

                        <select id="gender"
                                class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-testid="gender-select">
                        </select>

                        <p id="error-gender"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-gender"></p>
                    </div>

                    <div>
                        <label for="address" class="block text-sm font-medium text-gray-700 mb-1">
                            Address <span class="text-red-500">*</span>
                        </label>
                        <textarea id="address"
                                  class="w-full border border-gray-300 rounded-md p-2 min-h-[80px] resize-y focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                  data-testid="address-textarea"></textarea>
                        <p id="error-address"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-address"></p>
                    </div>

                    <div>
                        <label for="entry_date" class="block text-sm font-medium text-gray-700 mb-1">
                            Entry Date <span class="text-red-500">*</span>
                        </label>
                        <input type="date"
                               id="entry_date"
                               class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               data-testid="entry-date-input" />
                        <p id="error-entry_date"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-entry_date"></p>
                    </div>

                    <div>
                        <label for="Level" class="block text-sm font-medium text-gray-700 mb-1">
                            Level <span class="text-red-500">*</span>
                        </label>

                        <select id="level"
                                class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                data-testid="level-select">
                        </select>

                        <p id="error-level"
                           class="mt-1 text-xs text-red-600 hidden validation-error-message"
                           data-testid="error-level"></p>
                    </div>

                    <div>
                        <label for="photo" class="block text-sm font-medium text-gray-700 mb-1">
                            Photo
                        </label>
                        <div class="flex items-center gap-3">
                            <label for="photo"
                                   class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
                                Choose File
                            </label>
                            <span id="photo-filename"
                                  class="text-sm text-gray-600 truncate max-w-[200px]"
                                  data-testid="photo-filename">
                                No file chosen
                            </span>
                            <input type="file"
                                   id="photo"
                                   class="hidden"
                                   accept="image/*"
                                   onchange="updatePhotoNameEdit()"
                                   data-testid="photo-input" />
                        </div>

                        <div class="mt-3">
                            <img id="photo-preview"
                                 src=""
                                 alt="Photo preview"
                                 class="w-32 h-32 object-cover rounded-md border border-gray-300"
                                 data-testid="photo-preview" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="border border-gray-200 rounded-lg overflow-hidden w-full">
                <button type="button"
                        onclick="toggleSection('family')"
                        class="w-full flex items-center justify-between px-4 py-3 bg-blue-900 hover:bg-blue-800 transition-colors duration-200 text-left"
                        data-testid="family-info-toggle">
                    <span class="font-semibold text-white">
                        Family Information
                    </span>
                    <svg id="icon-family"
                         class="w-5 h-5 text-white transition-transform duration-300"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div id="family"
                     class="px-4 pb-4 pt-3 space-y-3 border-t border-gray-100"
                     data-testid="family-info-section">
                    <div class="space-y-3">
                        <div>
                            <label for="father_name" class="block text-sm font-medium text-gray-700 mb-1">
                                Father Name
                            </label>
                            <input id="father_name"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="father-name-input" />
                        </div>
                        <div>
                            <label for="father_phone" class="block text-sm font-medium text-gray-700 mb-1">
                                Father Phone
                            </label>
                            <input id="father_phone"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="father-phone-input" />
                        </div>
                        <div>
                            <label for="father_job" class="block text-sm font-medium text-gray-700 mb-1">
                                Father Job
                            </label>
                            <input id="father_job"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="father-job-input" />
                        </div>
                    </div>

                    <div class="space-y-3 pt-2">
                        <div>
                            <label for="mother_name" class="block text-sm font-medium text-gray-700 mb-1">
                                Mother Name
                            </label>
                            <input id="mother_name"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="mother-name-input" />
                        </div>
                        <div>
                            <label for="mother_phone" class="block text-sm font-medium text-gray-700 mb-1">
                                Mother Phone
                            </label>
                            <input id="mother_phone"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="mother-phone-input" />
                        </div>
                        <div>
                            <label for="mother_job" class="block text-sm font-medium text-gray-700 mb-1">
                                Mother Job
                            </label>
                            <input id="mother_job"
                                   class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   data-testid="mother-job-input" />
                        </div>
                    </div>

                    <div class="pt-4 flex items-center justify-end space-x-2">
                        <button type="button"
                                onclick="goBack()"
                                class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300"
                                data-testid="student-back-button">
                            <svg class="w-4 h-4 mr-2 text-gray-600"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M15 19l-7-7 7-7" />
                            </svg>
                            <span>Back</span>
                        </button>

                        <button type="button"
                                onclick="update()"
                                class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
                                data-testid="student-update-button">
                            <span>Update</span>
                            <svg class="w-4 h-4 ml-2 text-white"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M5 13l4 4L19 7" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </form>
</div>

@section Scripts {
    <script>
        function toggleSection(id) {
            const section = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);

            if (!section || !icon) return;

            const isHidden = section.classList.contains('hidden');

            if (isHidden) {
                section.classList.remove('hidden');
                icon.classList.remove('-rotate-90');
            } else {
                section.classList.add('hidden');
                icon.classList.add('-rotate-90');
            }
        }

        function updatePhotoNameEdit() {
            const input = document.getElementById('photo');
            const labelSpan = document.getElementById('photo-filename');
            const preview = document.getElementById('photo-preview');

            if (!input || !labelSpan || !preview) return;

            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                labelSpan.textContent = file.name;

                const url = URL.createObjectURL(file);
                preview.src = url;
                preview.classList.remove('hidden');
            } else {
                labelSpan.textContent = 'No file chosen';
            }
        }

        function showError($input, $error, message) {
            if (!$input.length || !$error.length) return;
            $input.removeClass('border-gray-300').addClass('border-red-500');
            $error.text(message).removeClass('hidden');
        }

        function clearError($input, $error) {
            if (!$input.length || !$error.length) return;
            $input.removeClass('border-red-500').addClass('border-gray-300');
            $error.text('').addClass('hidden');
        }

        function clearAllValidation() {
            const fields = ['first_name', 'nis', 'birth_date', 'birth_place', 'gender', 'address', 'entry_date'];
            fields.forEach(function (id) {
                const $input = $('#' + id);
                const $error = $('#error-' + id);
                clearError($input, $error);
            });
        }

        function validateForm() {
            clearAllValidation();

            let isValid = true;

            const requiredFields = [
                { id: 'first_name', label: 'First Name' },
                { id: 'nis', label: 'NIS' },
                { id: 'birth_date', label: 'Birth Date' },
                { id: 'birth_place', label: 'Birth Place' },
                { id: 'gender', label: 'Gender' },
                { id: 'address', label: 'Address' },
                { id: 'entry_date', label: 'Entry Date' }
            ];

            requiredFields.forEach(function (field) {
                const $input = $('#' + field.id);
                const $error = $('#error-' + field.id);

                const value = ($input.val() || '').toString().trim();
                if (!value) {
                    isValid = false;
                    showError($input, $error, field.label + ' is required.');
                } else {
                    clearError($input, $error);
                }
            });

            if (!isValid) {
                const $firstError = $('.validation-error-message:not(.hidden)').first();
                if ($firstError.length) {
                    $('html, body').animate({
                        scrollTop: $firstError.offset().top - 100
                    }, 400);
                }
            }

            return isValid;
        }

        $(document).ready(function () {
            loadStudent();

            $('#gender').select2({
                placeholder: '-- Gender --',
                allowClear: true,
                ajax: {
                    url: '/Select2/Gender',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            q: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.results,
                            pagination: data.pagination
                        };
                    },
                    cache: true
                }
            }).on('change', function () {
                clearError($('#gender'), $('#error-gender'));
            });

            $('#level').select2({
                placeholder: '-- Level --',
                allowClear: true,
                ajax: {
                    url: '/Select2/LevelStudent',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            q: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.results,
                            pagination: data.pagination
                        };
                    },
                    cache: true
                }
            }).on('change', function () {
                clearError($('#level'), $('#level-gender'));
            });
        });

        function loadStudent() {
            $.get("/Student/GetById?id=" + $("#student_id").val(), res => {
                let d = res.data;

                const fields = ['first_name', 'last_name', 'nis', 'birth_date', 'birth_place', 'address',
                    'entry_date', 'father_name', 'father_phone', 'father_job',
                    'mother_name', 'mother_phone', 'mother_job'];

                fields.forEach(k => {
                    if (d[k] !== undefined && $("#" + k).length) {
                        $("#" + k).val(d[k]);
                    }
                });

                if (d.gender) {
                    var text = d.gender_name
                        || (d.gender === 'M' ? 'Male'
                            : d.gender === 'F' ? 'Female'
                                : d.gender);

                    var option = new Option(text, d.gender, true, true);
                    $('#gender').append(option).trigger('change');
                }

                if (d.level_id) {
                    var text = d.level_name;
                    var option = new Option(text, d.level_id, true, true);
                    $('#level').append(option).trigger('change');
                }

                if (d.profile_photo) {
                    $("#photo-preview").attr("src", d.profile_photo).removeClass('hidden');
                    const parts = d.profile_photo.split('/');
                    $("#photo-filename").text(parts[parts.length - 1]);
                }
            });
        }

        function update() {
            if (!validateForm()) {
                return;
            }

            let fd = new FormData();
            fd.append("student_id", $("#student_id").val());

            $("#frm").find("input,select,textarea").each(function () {
                if (this.type !== "file") {
                    fd.append(this.id, $(this).val());
                }
            });

            const photoInput = document.getElementById("photo");
            if (photoInput && photoInput.files && photoInput.files[0]) {
                fd.append("profile_photo", photoInput.files[0]);
            }

            $.ajax({
                url: "/Student/Update",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: res => {
                    if (res.success) location.href = "/Student";
                    else alert(res.message);
                }
            });
        }

        function goBack() {
            window.location.href = "/Student";
        }
    </script>
}