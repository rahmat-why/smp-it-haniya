@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Ubah Nilai";
}

<input type="hidden" id="grade_id" value="@ViewBag.gradeId">

<h2 class="text-2xl font-bold text-gray-800 mb-6">Ubah Nilai</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="gradeForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
            <div><label for="grade_date" class="block text-sm font-medium text-gray-700 mb-2">Tanggal Penilaian <span class="text-red-600">*</span></label><input type="date" id="grade_date" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" /><p id="error-date" class="mt-1 text-sm text-red-600 hidden"></p></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-2">Kelas <span class="text-red-600">*</span></label><div id="class_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-- Loading --</div><input type="hidden" id="academic_class_id" /></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-2">Mata Pelajaran <span class="text-red-600">*</span></label><div id="subject_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-- Loading --</div><input type="hidden" id="subject_id" /></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-2">Guru <span class="text-red-600">*</span></label><div id="teacher_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-- Loading --</div><input type="hidden" id="teacher_id" /></div>
            <div><label for="grade_type" class="block text-sm font-medium text-gray-700 mb-2">Jenis Penilaian <span class="text-red-600">*</span></label><select id="grade_type" class="w-full"></select></div>
        </div>

        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-gray-800">Rincian Nilai</h3>
            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[500px] shadow-inner"><table class="min-w-full divide-y divide-gray-200 table-fixed"><thead class="bg-gray-100 sticky top-0 z-10"><tr><th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-5/12 uppercase">Siswa</th><th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-2/12 uppercase">Nilai Minimal</th><th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-2/12 uppercase">Nilai Penilaian</th><th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12 uppercase">Catatan</th></tr></thead><tbody id="tbody-details"></tbody></table></div>
            <p id="error-details" class="text-sm text-red-600 hidden"></p>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <button type="button" onclick="goBackGrade()" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm">Kembali</button>
            <button type="button" onclick="updateGrade()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm">Ubah</button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
    const returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Grade';
    let currentMinValue = null;
    let preloadedGradeType = null;

    function updateMinCells() { $('.min-passing-cell').text(currentMinValue ?? '-'); }
    function goBackGrade() { window.location.href = returnUrl; }

    function renderDetailRow(d) {
        const gradeValue = (d.grade_value || '').toString().replace(',', '.');
        $('#tbody-details').append(`<tr class="hover:bg-gray-50 border-b last:border-0"><td class="px-4 py-3"><div class="flex items-center gap-3"><img src="${d.profile_photo || '/image/no-image.png'}" alt="${d.student_name || 'Unknown'}" class="w-10 h-10 rounded-full object-cover border border-gray-200" onerror="this.src='/image/no-image.png'"><div><div class="font-medium text-gray-900">${d.student_name || 'Unknown'}</div><div class="text-xs text-gray-600">NIS: ${d.nis || '-'}</div></div></div><input type="hidden" name="student_ids" value="${d.student_id}" /></td><td class="px-4 py-3 text-center"><div class="min-passing-cell font-medium text-gray-700">${currentMinValue ?? '-'}</div></td><td class="px-4 py-3"><input type="number" name="grade_values" step="0.01" min="0" max="100" value="${gradeValue}" class="w-full px-3 py-1.5 border border-gray-300 rounded" /></td><td class="px-4 py-3"><input type="text" name="notes" value="${d.notes || ''}" class="w-full px-3 py-1.5 border border-gray-300 rounded" /></td></tr>`);
    }

    function collectDetails() {
        const details = [];
        $('#tbody-details tr').each(function () {
            const r = $(this);
            details.push({ student_id: r.find('input[name="student_ids"]').val(), grade_value: r.find('input[name="grade_values"]').val() || null, notes: r.find('input[name="notes"]').val() || '' });
        });
        return details;
    }

    function validateForm() {
        $('#error-details,#error-date').addClass('hidden');
        let valid = true;
        if (!$('#grade_date').val()) { $('#error-date').text('Please select grade date').removeClass('hidden'); valid = false; }
        $('input[name="grade_values"]').each(function () { if ($(this).val() === '') valid = false; });
        if (!valid) $('#error-details').text('Please enter a grade value for all students').removeClass('hidden');
        return valid;
    }

    async function updateGrade() {
        if (!validateForm()) return;
        const yes = await tailwindConfirmModal({ title: 'Update Confirmation', message: 'Are you sure you want to update this data?', confirmText: 'Update', cancelText: 'Cancel' });
        if (!yes) return;

        const fd = new FormData();
        fd.append('grade_id', $('#grade_id').val());
        fd.append('grade_date', $('#grade_date').val());
        fd.append('academic_class_id', $('#academic_class_id').val());
        fd.append('subject_id', $('#subject_id').val());
        fd.append('teacher_id', $('#teacher_id').val());
        fd.append('grade_type', $('#grade_type').val());
        fd.append('details', JSON.stringify(collectDetails()));

        $.ajax({
            url: '/Grade/Update', type: 'POST', data: fd, processData: false, contentType: false,
            success: async res => {
                if (res.success) { await tailwindMessageModal('Success', res.message || 'Grade updated successfully.'); window.location.href = returnUrl; }
                else await tailwindMessageModal('Failed', res.message || 'Update failed');
            },
            error: async () => await tailwindMessageModal('Error', 'Error updating grade')
        });
    }

    function loadGrade() {
        const id = ($('#grade_id').val() || '').trim();
        if (!id) { tailwindMessageModal('Failed', 'Invalid grade ID'); return; }

        $.getJSON(`/Grade/GetById?id=${id}`, async function (res) {
            if (!res.success) { await tailwindMessageModal('Failed', res.message || 'Failed to load grade'); return; }
            const d = res.data;
            $('#grade_date').val(d.grade_date);
            $('#academic_class_id').val(d.academic_class_id); $('#class_display').text(d.class_name || '--');
            $('#subject_id').val(d.subject_id); $('#subject_display').text(d.subject_name || '--');
            $('#teacher_id').val(d.teacher_id); $('#teacher_display').text(d.teacher_name || '--');

            preloadedGradeType = { id: d.grade_type, text: d.grade_type_desc || d.grade_type };
            $('#grade_type').append(new Option(preloadedGradeType.text, preloadedGradeType.id, true, true)).trigger('change');

            currentMinValue = d.minimum_value; updateMinCells();
            $('#tbody-details').empty();
            if (d.details && d.details.length) { d.details.forEach(renderDetailRow); updateMinCells(); }
            else $('#tbody-details').html('<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500 italic">No details</td></tr>');
        }).fail(async function () { await tailwindMessageModal('Error', 'Network error loading grade data'); });
    }

    $(document).ready(function () {
        $('#grade_type').select2({ placeholder: '-- Select Grade Type --', allowClear: false, ajax: { url: '/Select2/GradeTypes', dataType: 'json', delay: 250, data: p => ({ q: p.term || '', page: p.page || 1 }), processResults: d => ({ results: d.results, pagination: d.pagination }), cache: true }, minimumInputLength: 0 });
        loadGrade();
    });
</script>
}
