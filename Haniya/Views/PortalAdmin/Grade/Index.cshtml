@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Grades";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Grade List</h2>
    <a href="/Grade/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
        + Add Grade
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="grade-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="overflow-x-auto px-4 pt-4">
        <table id="grade-table" class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Academic Year</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Semester</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 140px;">Date</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Class</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Subject</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Teacher</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase">Grade Type</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 120px;">Min Value</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase" style="width: 180px;">Summary</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-right" style="width: 70px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3">
        <div id="grade-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gradeTable = null;
        let currentAcademicYearId = '';
        let currentAcademicClassId = '';
        let currentGradeType = '';

        $(document).ready(function () {
            initGradeTable();

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.grade-actions-wrapper').length) {
                    $('.grade-actions-menu').addClass('hidden');
                }
            });
        });

        function initGradeTable() {
            gradeTable = $('#grade-table').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                lengthChange: true,
                ajax: {
                    url: '/Grade/GetAll',
                    type: 'GET',
                    data: function (d) {
                        d.academic_year_id = currentAcademicYearId || null;
                        d.academic_class_id = currentAcademicClassId || null;
                        d.grade_type = currentGradeType || null;
                    }
                },
                dom: 'lftip',
                language: {
                    lengthMenu: "Show _MENU_ rows",
                    search: "",
                    searchPlaceholder: "Search...",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                },
                columns: [
                    {
                        data: null,
                        className: 'py-3',
                        render: function (data, type, row) {
                            return `${formatYearShort(row.start_date)} - ${formatYearShort(row.end_date)}`;
                        }
                    },
                    {
                        data: 'semester',
                        className: 'py-3 text-gray-700',
                        render: function (data) {
                            return data ? `Semester ${data}` : '-';
                        }
                    },
                    {
                        data: 'grade_date',
                        className: 'py-3 text-gray-900',
                        render: data => data ? new Date(data).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
                    },
                    { data: 'class_name', className: 'py-3 text-gray-700' },
                    { data: 'subject_name', className: 'py-3 text-gray-700' },
                    { data: 'teacher_name', className: 'py-3 text-gray-700' },
                    { data: 'grade_type', className: 'py-3 text-gray-700' },
                    {
                        data: 'minimum_value',
                        className: 'py-3 text-gray-700',
                        render: data => data ?? '-'
                    },
                    {
                        data: null,
                        className: 'py-3',
                        render: row => `Pass: ${row.passed || 0} | Remedial: ${row.remedial || 0}`
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-center py-3',
                        render: function (data, type, row) {
                            var id = row.grade_id;
                            var editUrl = '/Grade/Edit?id=' + id;
                            return `
                                        <div class="flex justify-center grade-actions-wrapper relative">
                                            <button type="button" onclick="toggleActionsMenu(event, '${id}')"
                                                    class="p-1.5 hover:bg-gray-100 rounded-md transition-colors duration-150">
                                                <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                                </svg>
                                            </button>
                                            <div id="actions-menu-${id}" class="grade-actions-menu hidden absolute right-0 mt-1 w-48 bg-white rounded-md shadow-lg z-10">
                                                <a href="${editUrl}" class="flex items-center px-4 py-2 text-sm text-blue-700 hover:bg-blue-50">
                                                    Edit
                                                </a>
                                                <button type="button" onclick="delGrade('${id}')"
                                                        class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 border-t border-gray-100">
                                                    Delete
                                                </button>
                                            </div>
                                        </div>`;
                        }
                    }
                ],
                initComplete: function () {
                    const wrapper = $('#grade-table_wrapper');
                    const $length = wrapper.find('.dataTables_length, .dt-length');
                    const $filter = wrapper.find('.dataTables_filter, .dt-search');
                    const initialSearch = (gradeTable.search() || '').replace(/"/g, '&quot;');

                    $filter.hide();

                    const $toggleFilter = $(`
                        <div class="relative">
                            <button id="filterToggleBtn"
                                    onclick="toggleFilter()"
                                    class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                                </svg>
                                Filter
                            </button>

                            <div id="filterDropdown"
                                    class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                                    <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                                    <button type="button"
                                            onclick="toggleFilter()"
                                            class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </button>
                                </div>
                                <div class="px-5 py-4 space-y-4">
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_academic_year">Academic Year</label>
                                        <select id="filter_academic_year" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_class">Class</label>
                                        <select id="filter_class" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="filter_grade_type">Grade Type</label>
                                        <select id="filter_grade_type" class="w-full"></select>
                                    </div>
                                    <div class="w-full">
                                        <label class="block text-xs font-medium mb-1" for="grade_search_filter">Search</label>
                                        <input id="grade_search_filter"
                                                type="text"
                                                value="${initialSearch}"
                                                class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                                placeholder="Filter by grade type / title / description" />
                                    </div>
                                </div>
                                <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                                    <button type="button"
                                            onclick="applyGradeFilter()"
                                            class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">
                                        Filter
                                    </button>
                                </div>
                            </div>
                        </div>
                    `);

                    $('#grade-table-toolbar').empty().append($length).append($toggleFilter);

                    $length.addClass('flex items-center gap-2 text-sm text-gray-600');
                    $length.find('label').addClass('flex items-center gap-2');
                    $length.find('select').addClass('border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500');

                    $('#grade-table-toolbar').addClass('flex flex-col md:flex-row md:items-center md:justify-between gap-4');

                    $('#filter_academic_year').select2({
                        placeholder: "All Academic Years",
                        allowClear: true,
                        width: '100%',
                        ajax: {
                            url: '/Select2/AcademicYears',
                            dataType: 'json',
                            delay: 250,
                            data: params => ({ q: params.term || '', page: params.page || 1 }),
                            processResults: data => ({ results: data.results, pagination: data.pagination }),
                            cache: true
                        },
                        minimumInputLength: 0
                    });

                    $('#filter_class').select2({
                        placeholder: "-- All Class --",
                        allowClear: true,
                        width: '100%',
                        ajax: {
                            url: '/Select2/AcademicClasses',
                            dataType: 'json',
                            delay: 250,
                            data: params => ({ q: params.term || '', page: params.page || 1 }),
                            processResults: data => ({ results: data.results, pagination: data.pagination }),
                            cache: true
                        },
                        minimumInputLength: 0
                    });

                    $('#filter_grade_type').select2({
                        placeholder: "-- All Grade Type --",
                        allowClear: true,
                        width: '100%',
                        ajax: {
                            url: '/Select2/GradeTypes',
                            dataType: 'json',
                            delay: 250,
                            data: params => ({ q: params.term || '', page: params.page || 1 }),
                            processResults: data => ({ results: data.results, pagination: data.pagination }),
                            cache: true
                        },
                        minimumInputLength: 0
                    });

                    $.ajax({
                        url: '/Grade/GetActiveAcademicYear',
                        type: 'GET',
                        success: function (res) {
                            if (!res || !res.success || !res.data || !res.data.id) return;

                            currentAcademicYearId = res.data.id;

                            if ($('#filter_academic_year option[value="' + res.data.id + '"]').length === 0) {
                                const option = new Option(res.data.text || '', res.data.id, true, true);
                                $('#filter_academic_year').append(option);
                            }

                            $('#filter_academic_year').val(res.data.id).trigger('change');
                            gradeTable.ajax.reload(null, true);
                        }
                    });

                    stylePagination();
                },
                drawCallback: function () {
                    setTimeout(stylePagination, 50);
                }
            });
        }

        function applyGradeFilter() {
            currentAcademicYearId = $('#filter_academic_year').val() || '';
            currentAcademicClassId = $('#filter_class').val() || '';
            currentGradeType = $('#filter_grade_type').val() || '';
            const searchKeyword = ($('#grade_search_filter').val() || '').trim();
            gradeTable.search(searchKeyword);
            gradeTable.ajax.reload(null, true);
            toggleFilter();
        }

        function stylePagination() {
            const wrapper = $('#grade-table_wrapper');
            let $info = wrapper.find('.dataTables_info').first();
            if ($info.length === 0) $info = wrapper.find('.dt-info').first();

            let $paginate = wrapper.find('.dataTables_paginate').first();
            if ($paginate.length === 0) $paginate = wrapper.find('.dt-paging').first();

            if ($info.length > 0) {
                $('#table-info-container').empty().append($info);
                $info.removeClass().addClass('text-sm text-gray-600');
            }

            if ($paginate.length > 0) {
                $('#table-pagination-container').empty().append($paginate);
            }

            $('#table-pagination-container').addClass('w-full flex justify-end overflow-x-auto whitespace-nowrap');
            if (typeof applyAdminPaginationStyle === 'function') {
                applyAdminPaginationStyle($('#table-pagination-container'));
            }
        }

        function formatYearShort(d) {
            if (!d) return "";
            const date = new Date(d);
            if (isNaN(date.getTime())) return "";
            return date.getFullYear();
        }

        function toggleActionsMenu(event, id) {
            event.stopPropagation();
            $('.grade-actions-menu').addClass('hidden');
            $('#actions-menu-' + id).toggleClass('hidden');
        }

        function delGrade(id) {
            $('.grade-actions-menu').addClass('hidden');
            if (!confirm("Delete this grade record?")) return;

            $.ajax({
                url: "/Grade/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ id: id }),
                success: res => {
                    if (res.success) {
                        $('#grade-table').DataTable().ajax.reload(null, false);
                    } else {
                        alert(res.message || "Failed to delete grade record");
                    }
                },
                error: () => alert("An error occurred while deleting the grade record.")
            });
        }
    </script>
}
