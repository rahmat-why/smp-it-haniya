@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Grades";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Grade List</h2>
    <a href="/Grade/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
       data-testid="grade-add-button">
        + Add Grade
    </a>
</div>

<div class="overflow-auto bg-white rounded shadow">
    <table class="min-w-full text-sm">
        <thead class="bg-gray-100 text-left text-gray-700">
            <tr>
                <th class="p-2 font-medium">Class</th>
                <th class="p-2 font-medium">Subject</th>
                <th class="p-2 font-medium">Type</th>
                <th class="p-2 font-medium">Teacher</th>
                <th class="p-2 font-medium">Records</th>
                <th class="p-2 font-medium text-right">Action</th>
            </tr>
        </thead>
        <tbody id="tbl" data-testid="grade-table-body"></tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadGrades();

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.grade-actions-wrapper').length) {
                    $('.grade-actions-menu').addClass('hidden');
                }
            });
        });

        function loadGrades() {
            $.get("/Grade/GetAll", res => {
                if (!res.success) {
                    alert(res.message || "Failed to load grades");
                    return;
                }

                let html = "";
                res.data.forEach(x => {
                    const id = x.grade_id;
                    html += `
                                <tr class="border-b last:border-0 hover:bg-gray-50">
                                    <td class="p-2">${x.class_name ?? ""}</td>
                                    <td class="p-2">${x.subject_name ?? ""}</td>
                                    <td class="p-2">${x.grade_type ?? ""}</td>
                                    <td class="p-2">${x.teacher_name ?? ""}</td>
                                    <td class="p-2">${x.total_student ?? 0}</td>
                                    <td class="p-2 text-right">
                                        <div class="relative inline-block text-left grade-actions-wrapper">
                                            <button type="button"
                                                    onclick="toggleGradeActions('${id}')"
                                                    class="inline-flex items-center justify-center w-8 h-8 rounded-full hover:bg-gray-100 text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                                    data-testid="grade-actions-toggle-${id}">
                                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round"
                                                          stroke-linejoin="round"
                                                          stroke-width="2"
                                                          d="M12 5.25a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 5.25a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 5.25a1.5 1.5 0 110 3 1.5 1.5 0 010-3z" />
                                                </svg>
                                            </button>

                                            <div id="grade-menu-${id}"
                                                 class="grade-actions-menu hidden origin-top-right absolute right-0 mt-2 w-32 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-10"
                                                 data-testid="grade-actions-menu-${id}">
                                                <div class="py-1">
                                                    <a href="/Grade/Edit?id=${id}"
                                                       class="block px-3 py-1.5 text-left text-gray-700 hover:bg-gray-100 text-sm"
                                                       data-testid="grade-edit-action-${id}">
                                                        Edit
                                                    </a>
                                                    <button type="button"
                                                            onclick="deleteGrade('${id}')"
                                                            class="w-full text-left block px-3 py-1.5 text-sm text-red-600 hover:bg-red-50"
                                                            data-testid="grade-delete-action-${id}">
                                                        Delete
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>`;
                });

                $("#tbl").html(html);
            });
        }

        function toggleGradeActions(id) {
            const $menu = $('#grade-menu-' + id);
            if (!$menu.length) return;
            const isHidden = $menu.hasClass('hidden');
            $('.grade-actions-menu').addClass('hidden');
            if (isHidden) $menu.removeClass('hidden');
        }

        function deleteGrade(id) {
            if (!confirm("Delete this grade set?")) return;

            $.ajax({
                url: "/Grade/Delete",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ id }),
                success: res => {
                    if (res.success) loadGrades();
                    else alert(res.message || "Failed to delete grade");
                }
            });
        }
    </script>
}