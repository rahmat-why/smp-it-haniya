@using System.Collections.Generic

@{
    Layout = "_LayoutAdmin";
    IEnumerable<dynamic> scOptions = ViewBag.StudentClassOptions as IEnumerable<dynamic> ?? new List<dynamic>();
}

<h2 class="text-xl font-semibold mb-4">Create Payment</h2>

<div class="bg-white p-6 rounded-lg shadow w-full space-y-6">

    <form id="frm" class="space-y-6 w-full">

        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="student_class_id" class="block text-sm font-medium text-gray-700 mb-1">
                        Student Class <span class="text-red-500">*</span>
                    </label>
                    <select id="student_class_id"
                            class="w-full border border-gray-300 rounded-md p-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            data-testid="payment-student-class-select">
                        <option value="">-- Select Student Class --</option>
                        @foreach (var sc in scOptions)
                        {
                            string id = sc.Id as string ?? "";
                            string name = sc.Name as string ?? "";
                            <option value="@id">@name</option>
                        }
                    </select>
                    <p id="error-student-class"
                       class="mt-1 text-xs text-red-600 hidden validation-error-message"
                       data-testid="error-student-class"></p>
                </div>

                <div>
                    <label for="payment_type" class="block text-sm font-medium text-gray-700 mb-1">
                        Payment Type <span class="text-red-500">*</span>
                    </label>
                    <input id="payment_type"
                           class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g. Tuition, Registration"
                           data-testid="payment-type-input" />
                    <p id="error-payment-type"
                       class="mt-1 text-xs text-red-600 hidden validation-error-message"
                       data-testid="error-payment-type"></p>
                </div>

                <div>
                    <label for="total_price" class="block text-sm font-medium text-gray-700 mb-1">
                        Total Price <span class="text-red-500">*</span>
                    </label>
                    <input id="total_price"
                           type="number"
                           step="0.01"
                           class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           data-testid="payment-total-price-input" />
                    <p id="error-total-price"
                       class="mt-1 text-xs text-red-600 hidden validation-error-message"
                       data-testid="error-total-price"></p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="payment_method" class="block text-sm font-medium text-gray-700 mb-1">
                        Payment Method
                    </label>
                    <input id="payment_method"
                           class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g. Cash, Transfer"
                           data-testid="payment-method-input" />
                </div>

                <div>
                    <label for="payment_date" class="block text-sm font-medium text-gray-700 mb-1">
                        Payment Date
                    </label>
                    <input type="date"
                           id="payment_date"
                           class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           data-testid="payment-date-input" />
                </div>

                <div>
                    <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">
                        Notes
                    </label>
                    <input id="notes"
                           class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           data-testid="payment-notes-input" />
                </div>
            </div>
        </div>

        <!-- INSTALMENTS -->
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold text-gray-700">Payment Instalments</h3>
                <button type="button"
                        onclick="addInstalmentRow()"
                        class="inline-flex items-center px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white text-xs font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-600"
                        data-testid="payment-add-row-button">
                    + Add Instalment
                </button>
            </div>

            <div class="overflow-auto border border-gray-200 rounded-md">
                <table class="min-w-full text-xs">
                    <thead class="bg-gray-100 text-left text-gray-700">
                        <tr>
                            <th class="p-2 font-medium">#</th>
                            <th class="p-2 font-medium">Amount</th>
                            <th class="p-2 font-medium">Payment Date</th>
                            <th class="p-2 font-medium">Notes</th>
                            <th class="p-2 font-medium text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-instalments" data-testid="payment-instalments-body"></tbody>

                    <tbody id="row-template-body" class="hidden">
                        <tr class="inst-row">
                            <td class="p-1 instalment-number-cell"></td>
                            <td class="p-1">
                                <input type="number"
                                       step="0.01"
                                       class="inst-amount-input w-full border border-gray-300 rounded-md p-1 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
                            </td>
                            <td class="p-1">
                                <input type="date"
                                       class="inst-date-input w-full border border-gray-300 rounded-md p-1 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
                            </td>
                            <td class="p-1">
                                <input type="text"
                                       class="inst-notes-input w-full border border-gray-300 rounded-md p-1 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500" />
                            </td>
                            <td class="p-1 text-right">
                                <button type="button"
                                        onclick="removeInstalmentRow(this)"
                                        class="inline-flex items-center px-2 py-1 bg-red-600 hover:bg-red-500 text-white text-xs font-medium rounded-md"
                                        data-testid="payment-remove-row-button">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p id="error-instalments"
               class="mt-1 text-xs text-red-600 hidden validation-error-message"
               data-testid="error-instalments"></p>
        </div>

        <input type="hidden" id="instalments" name="instalments" />

        <div class="pt-4 flex items-center justify-end space-x-2">
            <button type="button"
                    onclick="goBackPayment()"
                    class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300"
                    data-testid="payment-back-button">
                <svg class="w-4 h-4 mr-2 text-gray-600"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 19l-7-7 7-7" />
                </svg>
                <span>Back</span>
            </button>

            <button type="button"
                    onclick="savePayment()"
                    class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900"
                    data-testid="payment-save-button">
                <span>Save</span>
                <svg class="w-4 h-4 ml-2 text-white"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7" />
                </svg>
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        function renumberInstalments() {
            $('#tbody-instalments tr.inst-row').each(function (idx) {
                $(this).find('.instalment-number-cell').text(idx + 1);
            });
        }

        function addInstalmentRow() {
            const $tmpl = $('#row-template-body tr.inst-row').first().clone();
            $('#tbody-instalments').append($tmpl);
            renumberInstalments();
        }

        function removeInstalmentRow(btn) {
            $(btn).closest('tr').remove();
            renumberInstalments();
        }

        function collectInstalments() {
            const rows = [];
            $('#tbody-instalments tr.inst-row').each(function () {
                const $row = $(this);
                const total_payment = ($row.find('.inst-amount-input').val() || '').toString().trim();
                const payment_date = ($row.find('.inst-date-input').val() || '').toString().trim();
                const notes = ($row.find('.inst-notes-input').val() || '').toString().trim();

                if (total_payment || payment_date || notes) {
                    rows.push({ total_payment, payment_date, notes });
                }
            });
            return rows;
        }

        function showError($input, $error, message) {
            if ($input && $input.length) {
                $input.addClass('border-red-500').removeClass('border-gray-300');
            }
            if ($error && $error.length) {
                $error.text(message).removeClass('hidden');
            }
        }

        function clearError($input, $error) {
            if ($input && $input.length) {
                $input.removeClass('border-red-500').addClass('border-gray-300');
            }
            if ($error && $error.length) {
                $error.text('').addClass('hidden');
            }
        }

        function clearAllValidation() {
            clearError($('#student_class_id'), $('#error-student-class'));
            clearError($('#payment_type'), $('#error-payment-type'));
            clearError($('#total_price'), $('#error-total-price'));
            clearError($('#tbody-instalments'), $('#error-instalments'));
        }

        function validateForm() {
            clearAllValidation();
            let isValid = true;

            const sc = ($('#student_class_id').val() || '').trim();
            const type = ($('#payment_type').val() || '').trim();
            const totalPrice = ($('#total_price').val() || '').trim();
            const instalments = collectInstalments();

            if (!sc) {
                isValid = false;
                showError($('#student_class_id'), $('#error-student-class'), 'Student class is required.');
            }
            if (!type) {
                isValid = false;
                showError($('#payment_type'), $('#error-payment-type'), 'Payment type is required.');
            }
            if (!totalPrice || isNaN(parseFloat(totalPrice))) {
                isValid = false;
                showError($('#total_price'), $('#error-total-price'), 'Valid total price is required.');
            }

            instalments.forEach(it => {
                if (it.total_payment && isNaN(parseFloat(it.total_payment))) {
                    isValid = false;
                    showError($('#tbody-instalments'), $('#error-instalments'),
                        'Each instalment must have valid amount.');
                }
                if (it.total_payment && !it.payment_date) {
                    isValid = false;
                    showError($('#tbody-instalments'), $('#error-instalments'),
                        'Instalment with amount must have payment date.');
                }
            });

            $('#instalments').val(JSON.stringify(instalments));
            return isValid;
        }

        function goBackPayment() {
            window.location.href = "/Payment";
        }

        function savePayment() {
            if (!validateForm()) return;

            const fd = new FormData();
            fd.append("student_class_id", $('#student_class_id').val());
            fd.append("payment_type", $('#payment_type').val());
            fd.append("total_price", $('#total_price').val());
            fd.append("payment_method", $('#payment_method').val());
            fd.append("payment_date", $('#payment_date').val());
            fd.append("notes", $('#notes').val());
            fd.append("instalments", $('#instalments').val());

            $.ajax({
                url: "/Payment/Create",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: res => {
                    if (res.success) {
                        window.location.href = "/Payment";
                    } else {
                        alert(res.message || "Failed to create payment");
                    }
                }
            });
        }

        $(document).ready(function () {
            addInstalmentRow();
        });
    </script>
}