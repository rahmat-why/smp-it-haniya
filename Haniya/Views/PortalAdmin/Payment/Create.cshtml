@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Publish Pembayaran";
}

<h2 class="text-2xl font-bold text-gray-800 mb-6">Publish Pembayaran</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="publishPaymentForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label for="payment_type" class="block text-sm font-medium text-gray-700 mb-2">
                    Tipe Pembayaran <span class="text-red-600">*</span>
                </label>
                <select id="payment_type"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
                    <option value="">-- Pilih Tipe Pembayaran --</option>
                </select>
                <p id="error-payment-type" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="total_price" class="block text-sm font-medium text-gray-700 mb-2">
                    Total Tagihan
                </label>
                <input type="text" id="total_price" readonly
                       class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700 cursor-not-allowed" />
            </div>

            <div>
                <label for="payment_date" class="block text-sm font-medium text-gray-700 mb-2">
                    Tenggat Waktu
                </label>
                <input type="date" id="payment_date" readonly
                       class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700 cursor-not-allowed" />
            </div>
        </div>

        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-medium text-gray-700">
                    Pilih Kelas <span class="text-red-600">*</span>
                </label>
                <div class="flex gap-2">
                    <button type="button" onclick="toggleAllClass(true)" class="text-sm text-blue-700 hover:underline">Pilih Semua</button>
                    <button type="button" onclick="toggleAllClass(false)" class="text-sm text-gray-600 hover:underline">Hapus</button>
                </div>
            </div>
            <div id="class-checkbox-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 border border-gray-200 rounded-lg p-4 max-h-[300px] overflow-y-auto">
            </div>
            <p id="error-classes" class="mt-1 text-sm text-red-600 hidden"></p>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <a id="payment-back-link" href="/Payment" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300">
                <svg class="w-4 h-4 mr-2 text-gray-600"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M15 19l-7-7 7-7" />
                            </svg>
                Kembali
            </a>
            <button type="button" onclick="publishPayment()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
                Publikasikan
                <svg class="w-4 h-4 ml-2 text-white"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M5 13l4 4L19 7" />
                            </svg>
            </button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
    <script>
        let paymentTypeMap = {};

        async function showError(message) {
            await tailwindMessageModal('Validation Error', message || 'Please check your input.');
        }

        function formatRupiah(amount) {
            if (!amount || isNaN(amount)) return "";
            return "Rp " + Number(amount).toLocaleString("id-ID");
        }

        function getSelectedClassIds() {
            return $('.class-checkbox:checked').map(function () {
                return $(this).val();
            }).get();
        }

        function toggleAllClass(isChecked) {
            $('.class-checkbox').prop('checked', isChecked);
            $('#error-classes').addClass('hidden').text('');
        }

        function renderClassCheckboxes(classes) {
            const $container = $('#class-checkbox-container');
            $container.empty();

            if (!classes || classes.length === 0) {
                $container.html('<p class="text-sm text-gray-500">No active classes found.</p>');
                return;
            }

            classes.forEach(c => {
                const id = (c.id || '').toString();
                const className = (c.class_name || '-').toString();
                const html = `
                    <label class="flex items-center gap-2 px-3 py-2 rounded-md border border-gray-200 hover:bg-gray-50 cursor-pointer">
                        <input type="checkbox" class="class-checkbox rounded border-gray-300 text-blue-700 focus:ring-blue-500" value="${id}" />
                        <span class="text-sm text-gray-800">${className}</span>
                    </label>`;
                $container.append(html);
            });
        }

        function fillPaymentTypeOptions(paymentTypes) {
            const $select = $('#payment_type');
            $select.find('option:not(:first)').remove();
            paymentTypeMap = {};

            (paymentTypes || []).forEach(item => {
                const id = (item.id || '').toString();
                paymentTypeMap[id] = item;
                $select.append(new Option(item.text || '-', id));
            });
        }

        function onPaymentTypeChanged() {
            const selectedId = $('#payment_type').val();
            const data = paymentTypeMap[selectedId];

            if (!data) {
                $('#total_price').val('');
                $('#payment_date').val('');
                return;
            }

            $('#total_price').val(formatRupiah(data.amount));
            $('#payment_date').val(data.due_date || '');
        }

        function validateForm() {
            if (!$('#payment_type').val()) return 'Payment type is required';
            if (getSelectedClassIds().length === 0) return 'Please select at least one class';
            return '';
        }

        async function publishPayment() {
            const validationMessage = validateForm();
            if (validationMessage) {
                await showError(validationMessage);
                return;
            }

            const confirmed = await tailwindConfirmModal({
                title: 'Publish Confirmation',
                message: 'Are you sure you want to publish this payment?',
                confirmText: 'Yes, publish',
                cancelText: 'Cancel'
            });
            if (!confirmed) return;

            const selectedClassIds = getSelectedClassIds();
            const fd = new FormData();
            fd.append("payment_type", $('#payment_type').val());
            fd.append("total_price", ($('#total_price').val() || '').replace(/[^\d.,]/g, ''));
            fd.append("payment_date", $('#payment_date').val() || '');
            fd.append("academic_class_ids", selectedClassIds.join(','));

            $.ajax({
                url: "/Payment/Create",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: async function (res) {
                    if (res.success) {
                        await tailwindMessageModal('Success', res.message || 'Payment published successfully.');
                        window.location.href = "/Payment";
                        return;
                    }
                    await showError(res.message || "Failed to publish payment");
                },
                error: async function () {
                    await showError("An error occurred while publishing payment");
                }
            });
        }

        function loadPublishFormData() {
            $.ajax({
                url: "/Payment/GetPublishFormData",
                type: "GET",
                dataType: "json",
                success: function (res) {
                    if (!res.success) {
                        showError(res.message || "Failed to load form data");
                        return;
                    }

                    const data = res.data || {};
                    fillPaymentTypeOptions(data.paymentTypes || []);
                    renderClassCheckboxes(data.classes || []);
                },
                error: function () {
                    showError("Failed to load publish form data");
                }
            });
        }

        $(document).ready(function () {
            loadPublishFormData();
            $('#payment_type').on('change', onPaymentTypeChanged);
        });
    </script>
}
