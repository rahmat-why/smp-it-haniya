@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Create Payment";
}

<h2 class="text-2xl font-bold text-gray-800 mb-6">Create Payment</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="paymentForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label for="student_class_id" class="block text-sm font-medium text-gray-700 mb-2">
                    Student <span class="text-red-600">*</span>
                </label>
                <select id="student_class_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Student --" required></select>
                <p id="error-student" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="payment_type" class="block text-sm font-medium text-gray-700 mb-2">
                    Payment Type <span class="text-red-600">*</span>
                </label>
                <select id="payment_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Payment Type --" required></select>
                <p id="error-payment-type" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="total_price" class="block text-sm font-medium text-gray-700 mb-2">
                    Total Price <span class="text-red-600">*</span>
                </label>
                <input type="number" id="total_price" step="0.01" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" />
                <p id="error-total-price" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="payment_method" class="block text-sm font-medium text-gray-700 mb-2">
                    Payment Method
                </label>
                <select id="payment_method" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        data-placeholder="-- Select Payment Method --"></select>
            </div>

            <div>
                <label for="payment_date" class="block text-sm font-medium text-gray-700 mb-2">
                    Payment Date <span class="text-red-600">*</span>
                </label>
                <input type="date" id="payment_date" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" />
                <p id="error-payment-date" class="mt-1 text-sm text-red-600 hidden"></p>
            </div>

            <div>
                <label for="notes" class="block text-sm font-medium text-gray-700 mb-2">
                    Notes
                </label>
                <input type="text" id="notes"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" />
            </div>
        </div>

        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-800">Payment Instalments</h3>
                <button type="button" onclick="addInstalmentRow()"
                        class="inline-flex items-center px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-600">
                    + Add Instalment
                </button>
            </div>
            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[400px] shadow-inner">
                <table class="min-w-full divide-y divide-gray-200 table-fixed">
                    <thead class="bg-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-1/12">#</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12">Amount</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12">Payment Date</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Notes</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-1/12">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-instalments"></tbody>
                </table>
            </div>
            <p id="error-instalments" class="text-sm text-red-600 hidden"></p>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <button type="button" onclick="goBackPayment()" class="px-6 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-lg font-medium transition">Back</button>
            <button type="button" onclick="savePayment()" class="px-6 py-2.5 bg-blue-700 hover:bg-blue-800 text-white rounded-lg font-medium transition">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function renumberInstalments() {
            $('#tbody-instalments tr.inst-row').each(function (idx) {
                $(this).find('.instalment-number-cell').text(idx + 1);
            });
        }

        function addInstalmentRow() {
            const row = `
                        <tr class="inst-row hover:bg-gray-50 border-b last:border-0">
                            <td class="px-4 py-3 instalment-number-cell"></td>
                            <td class="px-4 py-3">
                                <input type="number" step="0.01" class="inst-amount-input w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" />
                            </td>
                            <td class="px-4 py-3">
                                <input type="date" class="inst-date-input w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" />
                            </td>
                            <td class="px-4 py-3">
                                <input type="text" class="inst-notes-input w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition" />
                            </td>
                            <td class="px-4 py-3">
                                <button type="button" onclick="removeInstalmentRow(this)"
                                        class="px-2 py-1 bg-red-600 hover:bg-red-500 text-white text-xs font-medium rounded">
                                    Remove
                                </button>
                            </td>
                        </tr>`;
            $('#tbody-instalments').append(row);
            renumberInstalments();
        }

        function removeInstalmentRow(btn) {
            $(btn).closest('tr').remove();
            renumberInstalments();
        }

        function collectInstalments() {
            const rows = [];
            $('#tbody-instalments tr.inst-row').each(function () {
                const $row = $(this);
                const total_payment = ($row.find('.inst-amount-input').val() || '').toString().trim();
                const payment_date = ($row.find('.inst-date-input').val() || '').toString().trim();
                const notes = ($row.find('.inst-notes-input').val() || '').toString().trim();

                if (total_payment || payment_date || notes) {
                    rows.push({ total_payment, payment_date, notes });
                }
            });
            return rows;
        }

        function validateForm() {
            $('.text-red-600').addClass('hidden');
            let valid = true;

            if (!$('#student_class_id').val()) {
                $('#error-student').text('Please select student').removeClass('hidden');
                valid = false;
            }
            if (!$('#payment_type').val()) {
                $('#error-payment-type').text('Please select payment type').removeClass('hidden');
                valid = false;
            }
            if (!$('#total_price').val() || parseFloat($('#total_price').val()) <= 0) {
                $('#error-total-price').text('Please enter valid total price').removeClass('hidden');
                valid = false;
            }
            if (!$('#payment_date').val()) {
                $('#error-payment-date').text('Please select payment date').removeClass('hidden');
                valid = false;
            }

            const instalments = collectInstalments();
            instalments.forEach(it => {
                if (it.total_payment && (isNaN(parseFloat(it.total_payment)) || parseFloat(it.total_payment) <= 0)) {
                    $('#error-instalments').text('Each instalment must have valid amount').removeClass('hidden');
                    valid = false;
                }
                if (it.total_payment && !it.payment_date) {
                    $('#error-instalments').text('Instalment with amount must have payment date').removeClass('hidden');
                    valid = false;
                }
            });

            return valid;
        }

        function goBackPayment() {
            window.location.href = "/Payment";
        }

        function savePayment() {
            if (!validateForm()) return;

            const fd = new FormData();
            fd.append("student_class_id", $('#student_class_id').val());
            fd.append("payment_type", $('#payment_type').val());
            fd.append("total_price", $('#total_price').val());
            fd.append("payment_method", $('#payment_method').val() || '');
            fd.append("payment_date", $('#payment_date').val());
            fd.append("notes", $('#notes').val());
            fd.append("instalments", JSON.stringify(collectInstalments()));

            $.ajax({
                url: "/Payment/Create",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: res => {
                    if (res.success) {
                        location.href = "/Payment";
                    } else {
                        alert(res.message || "Save failed");
                    }
                },
                error: () => alert("Error saving payment")
            });
        }

        $(document).ready(function () {
            $('#payment_date').val(new Date().toISOString().split('T')[0]);

            // Student Select2
            $('#student_class_id').select2({
                placeholder: "-- Select Student --",
                allowClear: true,
                ajax: {
                    url: '/Select2/Students',
                    dataType: 'json',
                    delay: 250,
                    data: params => ({ q: params.term || '', page: params.page || 1 }),
                    processResults: data => ({ results: data.results, pagination: data.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            // Payment Type Select2
            $('#payment_type').select2({
                placeholder: "-- Select Payment Type --",
                allowClear: false,
                ajax: {
                    url: '/Select2/PaymentTypes',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            // Payment Method Select2
            $('#payment_method').select2({
                placeholder: "-- Select Payment Method --",
                allowClear: true,
                ajax: {
                    url: '/Select2/PaymentMethods',
                    dataType: 'json',
                    delay: 250,
                    data: p => ({ q: p.term || '', page: p.page || 1 }),
                    processResults: d => ({ results: d.results, pagination: d.pagination }),
                    cache: true
                },
                minimumInputLength: 0
            });

            addInstalmentRow();

            // Auto-fill total price when payment type changes
            $('#payment_type').on('change', function () {
                const selectedId = $(this).val();

                if (!selectedId) {
                    $('#total_price').val('').trigger('input');
                    return;
                }

                $.ajax({
                    url: '/Payment/GetTotalPriceByPaymentType',
                    type: 'GET',
                    data: { paymentTypeId: selectedId },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            $('#total_price').val(res.amount.toFixed(2)).trigger('input');
                        } else {
                            $('#total_price').val('').trigger('input');
                            if (res.message) alert(res.message);
                        }
                    },
                    error: function () {
                        alert('Gagal mengambil nominal biaya dari server.');
                        $('#total_price').val('');
                    }
                });
            });
        });
    </script>
}