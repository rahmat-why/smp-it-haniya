@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Payments";
}

<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Payment List</h2>
    <a id="payment-add-link" href="/Payment/Create"
       class="inline-flex items-center px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-sm font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
        + Publish Payment
    </a>
</div>

<div class="bg-white rounded-lg shadow">
    <div class="px-4 pt-4">
        <div id="payment-table-toolbar" class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"></div>
    </div>

    <div class="relative overflow-x-auto px-4 pt-4">
        <div id="payment-table-loading" class="hidden absolute inset-0 z-20 bg-white/80 backdrop-blur-[1px] flex items-center justify-center">
            <div class="flex flex-col items-center gap-3 text-gray-600">
                <div class="w-8 h-8 border-4 border-blue-200 border-t-blue-700 rounded-full animate-spin"></div>
                <p class="text-sm font-medium">Loading payment data...</p>
            </div>
        </div>
        <table id="payment-table"
               class="min-w-full text-sm text-left text-gray-700 border-collapse">
            <thead class="bg-gray-100 border-y border-gray-200">
                <tr>
                    <th data-sort="dueDate" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 130px;">Due Date</th>
                    <th data-sort="student" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 250px;">Student</th>
                    <th data-sort="class" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none" style="width: 120px;">Class</th>
                    <th data-sort="type" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase cursor-pointer select-none">Type</th>
                    <th data-sort="bill" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-right !text-right cursor-pointer select-none" style="width: 130px;">Bill</th>
                    <th data-sort="paid" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-right !text-right cursor-pointer select-none" style="width: 130px;">Paid</th>
                    <th data-sort="remaining" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-right !text-right cursor-pointer select-none" style="width: 130px;">Remaining</th>
                    <th data-sort="status" class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center cursor-pointer select-none" style="width: 100px;">Status</th>
                    <th class="px-4 py-3 text-xs font-semibold tracking-wide uppercase text-center" style="width: 180px;">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100"></tbody>
        </table>
    </div>

    <div class="px-4 pb-4 pt-3">
        <div id="payment-summary-container" class="mb-3 text-right font-semibold text-gray-800 text-sm hidden"></div>
        <div id="payment-table-footer" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="table-info-container"></div>
            <div id="table-pagination-container"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
<script>
    const pageState = {
        page: 1,
        limit: 10,
        filters: {
            search: '',
            academicClassId: '',
            status: '',
            paymentType: ''
        },
        sort: { field: 'dueDate', order: 'desc' },
        hasNextPage: false,
        totalRows: 0
    };
    let lastRequestKey = '';
    let searchDebounce = null;

    function formatCurrencyCell(amount) {
        if (!amount || isNaN(amount)) return '-';
        return 'Rp ' + Number(amount).toLocaleString('id-ID');
    }

    function formatDateId(value) {
        if (!value) return '-';
        return new Date(value).toLocaleDateString('id-ID', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
    }

    function isOverdueAndUnpaid(row) {
        if (!row || !row.due_date) return false;
        if ((row.status || '').toUpperCase() === 'PAID') return false;

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const due = new Date(row.due_date + 'T00:00:00');
        return due < today;
    }

    function getStateQuery() {
        return `page=${pageState.page}&limit=${pageState.limit}&search=${encodeURIComponent(pageState.filters.search || '')}&classId=${encodeURIComponent(pageState.filters.academicClassId || '')}&status=${encodeURIComponent(pageState.filters.status || '')}&paymentType=${encodeURIComponent(pageState.filters.paymentType || '')}&sortField=${encodeURIComponent(pageState.sort.field)}&sortOrder=${encodeURIComponent(pageState.sort.order)}`;
    }

    function syncStateToUrl() {
        history.replaceState({ ...pageState }, '', `?${getStateQuery()}`);
        $('#payment-add-link').attr('href', `/Payment/Create?returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`);
    }

    function hydrateStateFromUrl() {
        const q = new URLSearchParams(window.location.search);
        const page = Number(q.get('page') || 1);
        const limit = Number(q.get('limit') || 10);
        pageState.page = Number.isFinite(page) && page > 0 ? page : 1;
        pageState.limit = Number.isFinite(limit) && limit > 0 ? limit : 10;
        pageState.filters.search = q.get('search') || '';
        pageState.filters.academicClassId = q.get('classId') || '';
        pageState.filters.status = q.get('status') || '';
        pageState.filters.paymentType = q.get('paymentType') || '';
        pageState.sort.field = q.get('sortField') || 'dueDate';
        pageState.sort.order = q.get('sortOrder') || 'desc';
    }

    function renderSortIndicators() {
        $('#payment-table thead th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const isActive = field === pageState.sort.field;
            const icon = isActive ? (pageState.sort.order === 'asc' ? ' ↑' : ' ↓') : '';
            const base = $(this).text().replace(/ [↑↓]$/, '');
            $(this).text(base + icon);
        });
    }

    function renderToolbar() {
        const searchValue = (pageState.filters.search || '').replace(/"/g, '&quot;');
        $('#payment-table-toolbar').html(`
            <div class="flex items-center gap-2 text-sm text-gray-600">
                Show
                <select id="list-limit" class="border border-gray-300 rounded-md px-2 py-1 text-sm bg-white text-gray-700 focus:ring-2 focus:ring-blue-500">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select> rows
            </div>

            <div class="relative">
                <button id="paymentFilterToggleBtn"
                        type="button"
                        class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                    </svg>
                    Filter
                </button>

                <div id="paymentFilterDropdown"
                     class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl border border-gray-200 shadow-xl z-50 overflow-visible">
                    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800">Filter</h3>
                        <button type="button" id="paymentFilterCloseBtn"
                                class="text-gray-400 hover:text-gray-600 transition p-1 rounded-lg hover:bg-gray-100">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </div>
                    <div class="px-5 py-4 space-y-4">
                        <div class="w-full">
                            <label class="block text-xs font-medium mb-1" for="filter_class">Class</label>
                            <select id="filter_class" class="w-full"></select>
                        </div>
                        <div class="w-full">
                            <label class="block text-xs font-medium mb-1" for="filter_status">Status</label>
                            <select id="filter_status" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="">-- All Status --</option>
                                <option value="PAID">PAID</option>
                                <option value="PARTIAL">PARTIAL</option>
                                <option value="UNPAID">UNPAID</option>
                            </select>
                        </div>
                        <div class="w-full">
                            <label class="block text-xs font-medium mb-1" for="filter_type">Type</label>
                            <select id="filter_type" class="w-full"></select>
                        </div>
                        <div class="w-full">
                            <label class="block text-xs font-medium mb-1" for="payment_search_filter">Search</label>
                            <input id="payment_search_filter"
                                   type="text"
                                   value="${searchValue}"
                                   class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Search by student name / NIS..." />
                        </div>
                        <div class="w-full">
                            <label class="block text-xs font-medium mb-1" for="filter_monthyear">Month & Year</label>
                            <input id="filter_monthyear" type="month" class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        </div>
                    </div>
                    <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-gray-100">
                        <button type="button"
                                id="apply-payment-filter-btn"
                                class="px-5 py-2 rounded-full text-sm font-medium text-white bg-blue-900 hover:bg-blue-800 transition">
                            Filter
                        </button>
                    </div>
                </div>
            </div>
        `);

        $('#list-limit').val(String(pageState.limit));
        $('#list-limit').off('change').on('change', function () {
            const next = Number($(this).val() || 10);
            if (pageState.limit === next) return;
            pageState.limit = next;
            pageState.page = 1;
            lastRequestKey = '';
            fetchPayments();
        });

        const $dropdown = $('#paymentFilterDropdown');
        $('#paymentFilterToggleBtn').off('click').on('click', function () {
            $dropdown.toggleClass('hidden');
        });
        $('#paymentFilterCloseBtn').off('click').on('click', function () {
            $dropdown.addClass('hidden');
        });

        $('#reset-payment-filter-btn').off('click').on('click', function () {
            $('#filter_class').val(null).trigger('change');
            $('#filter_status').val('').trigger('change');
            $('#filter_type').val(null).trigger('change');
            $('#payment_search_filter').val('');
            $('#filter_monthyear').val('');
            applyPaymentFilter();
        });

        $('#apply-payment-filter-btn').off('click').on('click', function () {
            applyPaymentFilter();
        });

        initFilterSelect2($dropdown);
    }

    function initFilterSelect2($dropdown) {
        $('#filter_class').select2({
            placeholder: "-- All Class --",
            allowClear: true,
            width: '100%',
            dropdownParent: $dropdown,
            ajax: {
                url: '/Select2/AcademicClasses',
                dataType: 'json',
                delay: 250,
                data: params => ({ q: params.term || '', page: params.page || 1 }),
                processResults: data => ({ results: data.results, pagination: data.pagination }),
                cache: true
            },
            minimumInputLength: 0
        });

        $('#filter_status').select2({
            placeholder: "-- All Status --",
            allowClear: true,
            width: '100%',
            dropdownParent: $dropdown,
            minimumResultsForSearch: 0
        });

        $('#filter_type').select2({
            placeholder: "-- All Type --",
            allowClear: true,
            width: '100%',
            dropdownParent: $dropdown,
            ajax: {
                url: '/Select2/PaymentTypes',
                dataType: 'json',
                delay: 250,
                data: params => ({ q: params.term || '', page: params.page || 1 }),
                processResults: data => ({ results: data.results, pagination: data.pagination }),
                cache: true
            },
            minimumInputLength: 0
        });

        if (pageState.filters.academicClassId) {
            const option = new Option(pageState.filters.academicClassId, pageState.filters.academicClassId, true, true);
            $('#filter_class').append(option).trigger('change');
        }
        $('#filter_status').val(pageState.filters.status || '').trigger('change');
        if (pageState.filters.paymentType) {
            const optionType = new Option(pageState.filters.paymentType, pageState.filters.paymentType, true, true);
            $('#filter_type').append(optionType).trigger('change');
        }
        if (pageState.filters.year && pageState.filters.month) {
            const monthVal = pageState.filters.month.padStart(2, '0');
            $('#filter_monthyear').val(`${pageState.filters.year}-${monthVal}`);
        }
    }

    function applyPaymentFilter() {
        pageState.filters.academicClassId = $('#filter_class').val() || '';
        pageState.filters.status = $('#filter_status').val() || '';
        pageState.filters.paymentType = $('#filter_type').val() || '';
        pageState.filters.search = ($('#payment_search_filter').val() || '').trim();
        
        const monthYear = $('#filter_monthyear').val() || '';
        if (monthYear) {
            const parts = monthYear.split('-');
            pageState.filters.year = parts[0];
            pageState.filters.month = parseInt(parts[1], 10).toString();
        } else {
            pageState.filters.year = '';
            pageState.filters.month = '';
        }

        pageState.page = 1;
        lastRequestKey = '';
        fetchPayments();
        $('#paymentFilterDropdown').addClass('hidden');
    }

    function renderRows(items) {
        const $tbody = $('#payment-table tbody');
        if (!items || !items.length) {
            $tbody.html(`
                <tr>
                    <td colspan="9" class="px-4 py-10 text-center">
                        <div class="flex flex-col items-center gap-2 text-gray-500">
                            <div class="text-sm font-semibold text-gray-700">Tidak ada data payment</div>
                            <div class="text-xs">Coba ubah pencarian, class, status, atau type yang digunakan.</div>
                        </div>
                    </td>
                </tr>
            `);
            return;
        }

        let html = '';
        items.forEach(row => {
            const src = row.profile_photo && row.profile_photo.trim() !== ''
                ? row.profile_photo
                : '/image/no-image.png';
            const dueDate = formatDateId(row.due_date);
            const dueHtml = isOverdueAndUnpaid(row)
                ? `<span class="text-red-700 font-semibold">${dueDate} (Overdue)</span>`
                : dueDate;

            let badge = 'bg-gray-100 text-gray-700';
            if (row.status === 'PAID') badge = 'bg-green-100 text-green-800';
            else if (row.status === 'PARTIAL') badge = 'bg-yellow-100 text-yellow-800';
            else if (row.status === 'UNPAID') badge = 'bg-red-100 text-red-800';

            const isPaid = (row.status || '').toUpperCase() === 'PAID';
            const totalPaid = Number(row.total_payment || 0);
            const canExportTotalReceipt = !(totalPaid <= 0 && !isPaid);
            const editUrl = `/Payment/Edit?id=${encodeURIComponent(row.payment_id)}&returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`;
            const detailUrl = `/Payment/Detail?id=${encodeURIComponent(row.payment_id)}`;
            const paymentReceiptUrl = `/Payment/ExportPaymentReceipt?id=${encodeURIComponent(row.payment_id)}&download=true`;

            html += `
                <tr class="bg-white divide-y divide-gray-100 ${isOverdueAndUnpaid(row) ? 'bg-red-50' : ''}">
                    <td class="px-4 py-3 font-medium text-gray-900">${dueHtml}</td>
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <img src="${src}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 flex-shrink-0" alt="Photo" loading="lazy">
                            <div class="min-w-0 flex-1">
                                <div class="font-medium text-gray-900 truncate">${row.student_name || '-'}</div>
                                <div class="text-xs text-gray-500 truncate">NIS: ${row.nis || '-'}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-gray-700">${row.class_name || '-'}</td>
                    <td class="px-4 py-3 text-gray-700">${row.payment_type || '-'}</td>
                    <td class="px-4 py-3 text-right text-gray-700">${formatCurrencyCell(row.total_price)}</td>
                    <td class="px-4 py-3 text-right text-gray-700">${formatCurrencyCell(row.total_payment)}</td>
                    <td class="px-4 py-3 text-right text-gray-700">${formatCurrencyCell(row.remaining_payment)}</td>
                    <td class="px-4 py-3 text-center">
                        <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full ${badge}">${row.status || 'UNKNOWN'}</span>
                    </td>
                    <td class="px-4 py-3 text-center">
                        <div class="flex flex-wrap gap-2 justify-center">
                            <a href="${detailUrl}" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-slate-100 text-slate-700 hover:bg-slate-200" title="Detail">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </a>
                            ${canExportTotalReceipt
                                ? `<a href="${paymentReceiptUrl}" target="_blank" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-emerald-100 text-emerald-700 hover:bg-emerald-200" title="Export Kwitansi Pembayaran">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                        <path d="M14 2v6h6"></path>
                                        <path d="M8 13h8"></path>
                                        <path d="M8 17h8"></path>
                                    </svg>
                                   </a>`
                                : `<button type="button" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-gray-100 text-gray-400 cursor-not-allowed" title="Belum ada pembayaran, kwitansi total belum tersedia" disabled>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                        <path d="M14 2v6h6"></path>
                                        <path d="M8 13h8"></path>
                                        <path d="M8 17h8"></path>
                                    </svg>
                                   </button>`
                            }
                            ${isPaid
                                ? `<button type="button" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-gray-100 text-gray-400 cursor-not-allowed" title="Fully paid" disabled>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                   </button>`
                                : `<a href="${editUrl}" class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-blue-100 text-blue-700 hover:bg-blue-200" title="Pay">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 5v14"></path>
                                        <path d="M5 12h14"></path>
                                    </svg>
                                   </a>`
                            }
                        </div>
                    </td>
                </tr>
            `;
        });
        $tbody.html(html);
    }

    function renderPagination(currentCount) {
        const start = currentCount === 0 ? 0 : ((pageState.page - 1) * pageState.limit) + 1;
        const end = ((pageState.page - 1) * pageState.limit) + currentCount;
        $('#table-info-container').html(`<span class="text-sm text-gray-600">Menampilkan ${start} sampai ${end} dari ${pageState.totalRows} data</span>`);

        const totalPages = Math.max(1, Math.ceil(pageState.totalRows / pageState.limit));
        const prevDisabled = pageState.page <= 1;
        const nextDisabled = !pageState.hasNextPage;
        const pageStart = Math.max(1, Math.min(pageState.page - 1, totalPages - 2));
        const pageEnd = Math.min(totalPages, pageStart + 2);
        const pageButtons = [];
        for (let i = pageStart; i <= pageEnd; i++) {
            const active = i === pageState.page;
            pageButtons.push(`
                <button type="button" data-page="${i}" class="page-number px-3 py-2 text-sm border-l border-gray-200 ${active ? 'bg-blue-900 text-white font-semibold' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${active ? 'disabled' : ''}>${i}</button>
            `);
        }

        $('#table-pagination-container').html(`
            <div class="inline-flex items-center border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                <button id="page-first" class="px-3 py-2 text-sm ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>First</button>
                <button id="page-prev" class="px-3 py-2 text-sm border-l border-gray-200 ${prevDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${prevDisabled ? 'disabled' : ''}>Prev</button>
                ${pageButtons.join('')}
                <button id="page-next" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Next</button>
                <button id="page-last" class="px-3 py-2 text-sm border-l border-gray-200 ${nextDisabled ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-white text-gray-700 hover:bg-gray-50'}" ${nextDisabled ? 'disabled' : ''}>Last</button>
            </div>
        `);

        function goToPage(page) {
            const nextPage = Math.min(Math.max(1, page), totalPages);
            if (nextPage === pageState.page) return;
            pageState.page = nextPage;
            lastRequestKey = '';
            fetchPayments();
        }

        $('#page-first').off('click').on('click', function () {
            if (prevDisabled) return;
            goToPage(1);
        });
        $('#page-prev').off('click').on('click', function () {
            if (prevDisabled) return;
            goToPage(pageState.page - 1);
        });
        $('.page-number').off('click').on('click', function () {
            goToPage(Number($(this).data('page')));
        });
        $('#page-next').off('click').on('click', function () {
            if (nextDisabled) return;
            goToPage(pageState.page + 1);
        });
        $('#page-last').off('click').on('click', function () {
            if (nextDisabled) return;
            goToPage(totalPages);
        });
    }

    function setPaymentLoading(isLoading) {
        $('#payment-table-loading').toggleClass('hidden', !isLoading);
    }

    async function fetchPayments() {
        const payload = {
            page: pageState.page,
            limit: pageState.limit,
            filters: { ...pageState.filters },
            sort: { ...pageState.sort }
        };
        const requestKey = JSON.stringify(payload);
        if (requestKey === lastRequestKey) return;
        lastRequestKey = requestKey;

        syncStateToUrl();
        renderSortIndicators();
        setPaymentLoading(true);

        try {
            const res = await $.ajax({
                url: '/Payment/GetAll',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });

            if (!res.success) {
                lastRequestKey = '';
                tailwindMessageModal('Failed', res.message || 'Failed to load payment data.');
                return;
            }

            const result = res.data || {};
            const items = result.data || [];
            pageState.page = Number(result.currentPage || pageState.page);
            pageState.limit = Number(result.limit || pageState.limit || 10);
            pageState.hasNextPage = !!result.hasNextPage;
            pageState.totalRows = Number(result.totalRows || 0);
            syncStateToUrl();
            renderRows(items);
            renderPagination(items.length);

            const $summary = $('#payment-summary-container');
            if (pageState.filters.month && pageState.filters.year && result.totalPaymentForMonth !== undefined) {
                const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                const mName = monthNames[parseInt(pageState.filters.month, 10) - 1];
                $summary.html(`Total pembayaran (PAID & PARTIAL) pada bulan ${mName} ${pageState.filters.year}: <span class="text-green-700 ml-2">Rp ${Number(result.totalPaymentForMonth).toLocaleString('id-ID')}</span>`);
                $summary.removeClass('hidden');
            } else {
                $summary.addClass('hidden');
                $summary.empty();
            }
        } catch {
            lastRequestKey = '';
            tailwindMessageModal('Error', 'Failed to load payment data.');
        } finally {
            setPaymentLoading(false);
        }
    }

    $(document).ready(function () {
        hydrateStateFromUrl();
        renderToolbar();
        renderSortIndicators();
        fetchPayments();

        $(document).on('click', function (e) {
            const $dropdown = $('#paymentFilterDropdown');
            const isToggle = $(e.target).closest('#paymentFilterToggleBtn').length > 0;
            const isInsideDropdown = $(e.target).closest('#paymentFilterDropdown').length > 0;
            const isSelect2 = $(e.target).closest('.select2-container, .select2-dropdown').length > 0;
            if (!isToggle && !isInsideDropdown && !isSelect2) {
                $dropdown.addClass('hidden');
            }
        });

        $('#payment-table thead').on('click', 'th[data-sort]', function () {
            const field = $(this).data('sort');
            if (!field) return;
            if (pageState.sort.field === field) {
                pageState.sort.order = pageState.sort.order === 'asc' ? 'desc' : 'asc';
            } else {
                pageState.sort.field = field;
                pageState.sort.order = 'asc';
            }
            pageState.page = 1;
            lastRequestKey = '';
            fetchPayments();
        });

        $(document).on('input', '#payment_search_filter', function () {
            const val = ($(this).val() || '').trim();
            if ((pageState.filters.search || '') === val) return;
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                pageState.filters.search = val;
                pageState.page = 1;
                lastRequestKey = '';
                fetchPayments();
            }, 300);
        });
    });
</script>
}
