@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bayar Tagihan";
}

<input type="hidden" id="payment_id" value="@ViewBag.paymentId">

<h2 class="text-2xl font-bold text-gray-800 mb-6">Bayar Tagihan</h2>

<div class="bg-white p-6 rounded-xl shadow-lg w-full">
    <form id="paymentForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <div class="block text-sm font-medium text-gray-700 mb-2">Siswa</div>
                <div id="student_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-</div>
            </div>

            <div>
                <div class="block text-sm font-medium text-gray-700 mb-2">Tipe Pembayaran</div>
                <div id="payment_type_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-</div>
            </div>

            <div>
                <div class="block text-sm font-medium text-gray-700 mb-2">Total Tagihan</div>
                <div id="total_price_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-</div>
            </div>

            <div>
                <div class="block text-sm font-medium text-gray-700 mb-2">Tenggat Waktu</div>
                <div id="due_date_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-</div>
            </div>

            <div>
                <div class="block text-sm font-medium text-gray-700 mb-2">Sisa Tagihan</div>
                <div id="remaining_payment_display" class="w-full px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-700">-</div>
            </div>
        </div>

        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-800">Detail Pembayaran</h3>
            </div>
            <div class="overflow-x-auto border border-gray-200 rounded-lg max-h-[400px] shadow-inner">
                <table class="min-w-full divide-y divide-gray-200 table-fixed">
                    <thead class="bg-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-1/12">#</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12">Dibayar</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12">Tanggal</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-3/12">Metode</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 w-4/12">Catatan</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-instalments"></tbody>
                </table>
            </div>
        </div>

        <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
            <a id="payment-back-link" href="/Payment" class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300">
                <svg class="w-4 h-4 mr-2 text-gray-600"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M15 19l-7-7 7-7" />
                            </svg>
                Kembali
            </a>
            <button type="button" id="btn-update-payment" onclick="updatePayment()" class="inline-flex items-center justify-center bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-md text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900">
                Bayar
                <svg class="w-4 h-4 ml-2 text-white"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M5 13l4 4L19 7" />
                            </svg>
            </button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_TailwindConfirmModal")

@section Scripts {
    <script>
        let isFullyPaid = false;
        let remainingPaymentValue = 0;
        let paymentMethodItems = [];

        async function showError(message) {
            await tailwindMessageModal('Error', message || 'Something went wrong.');
        }

        async function showInfo(message) {
            await tailwindMessageModal('Info', message || 'Information.');
        }

        function formatCurrency(amount) {
            if (!amount || isNaN(amount)) return 'Rp 0';
            return 'Rp ' + Number(amount).toLocaleString('id-ID');
        }

        function getPaymentMethodOptions(selectedValue, selectedText) {
            const selected = (selectedValue || '').toString();
            const options = paymentMethodItems.map(item => {
                const isSelected = item.value === selected ? 'selected' : '';
                return `<option value="${item.value}" ${isSelected}>${item.text}</option>`;
            });

            if (selected && !paymentMethodItems.some(x => x.value === selected)) {
                options.unshift(`<option value="${selected}" selected>${selectedText || selected}</option>`);
            }

            return options.join('');
        }

        function renumberInstalments() {
            $('#tbody-instalments tr.inst-row').each(function (idx) {
                $(this).find('.instalment-number-cell').text(idx + 1);
            });
        }

        function addInstalmentRow(prefill = {}, options = {}) {
            const isExisting = !!options.isExisting;
            const readOnlyAmount = isExisting ? 'readonly' : '';
            const readOnlyNotes = isExisting ? 'readonly' : '';
            const amountClass = isExisting ? 'bg-gray-100 cursor-not-allowed' : '';
            const notesClass = isExisting ? 'bg-gray-100 cursor-not-allowed' : '';
            const disabledMethod = isExisting ? 'disabled' : '';
            const methodClass = isExisting ? 'bg-gray-100 cursor-not-allowed' : '';
            const methodOptions = getPaymentMethodOptions(prefill.payment_method || '', prefill.payment_method_desc || '');

            const row = `
                <tr class="inst-row hover:bg-gray-50 border-b last:border-0 ${isExisting ? 'inst-existing' : 'inst-new'}">
                    <td class="px-4 py-3 instalment-number-cell"></td>
                    <td class="px-4 py-3">
                        <input type="number" step="1" min="0"
                               class="inst-amount-input w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition ${amountClass}"
                               value="${prefill.total_payment || ''}" ${readOnlyAmount} />
                    </td>
                    <td class="px-4 py-3">
                        <input type="date"
                               class="inst-date-input w-full px-3 py-1.5 border border-gray-300 rounded bg-gray-100 cursor-not-allowed"
                               value="${prefill.payment_date || ''}" readonly />
                    </td>
                    <td class="px-4 py-3">
                        <select class="inst-method-select w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition ${methodClass}" ${disabledMethod}>
                            <option value="">-- Select Payment Method --</option>
                            ${methodOptions}
                        </select>
                    </td>
                    <td class="px-4 py-3">
                        <input type="text"
                               class="inst-notes-input w-full px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition ${notesClass}"
                               value="${prefill.notes || ''}" ${readOnlyNotes} />
                    </td>
                </tr>`;
            $('#tbody-instalments').append(row);
            renumberInstalments();
        }

        function collectInstalments() {
            const rows = [];
            $('#tbody-instalments tr.inst-row.inst-new').each(function () {
                const $row = $(this);
                const total_payment = ($row.find('.inst-amount-input').val() || '').toString().trim();
                const payment_date = ($row.find('.inst-date-input').val() || '').toString().trim();
                const notes = ($row.find('.inst-notes-input').val() || '').toString().trim();
                const payment_method = ($row.find('.inst-method-select').val() || '').toString().trim();

                if (total_payment || payment_date || notes || payment_method) {
                    rows.push({ total_payment, payment_date, notes, payment_method });
                }
            });
            return rows;
        }

        function validateForm() {
            if (isFullyPaid) return 'Payment is already fully paid';

            const instalments = collectInstalments();
            let hasNewPayment = false;
            let totalPaid = 0;

            for (const it of instalments) {
                const amount = parseFloat(it.total_payment || '0');
                if (isNaN(amount) || amount < 0) return 'Each instalment must have a valid amount';
                if (amount > 0) hasNewPayment = true;
                if (amount > 0 && !it.payment_method) return 'Payment method is required for each payment row';
                totalPaid += amount;
            }

            if (!hasNewPayment) return 'Please input payment amount';

            if (totalPaid > remainingPaymentValue) return 'Payment amount cannot exceed remaining payment';

            return '';
        }

        function setPayButtonDisabled(disabled) {
            const $btn = $('#btn-update-payment');
            $btn.prop('disabled', disabled);
            if (disabled) {
                $btn.removeClass('bg-blue-900 hover:bg-blue-800').addClass('bg-gray-300 text-gray-500 cursor-not-allowed');
            } else {
                $btn.removeClass('bg-gray-300 text-gray-500 cursor-not-allowed').addClass('bg-blue-900 hover:bg-blue-800');
            }
        }

        async function updatePayment() {
            const validationMessage = validateForm();
            if (validationMessage) {
                await showError(validationMessage);
                return;
            }

            const confirmed = await tailwindConfirmModal({
                title: 'Confirm Payment',
                message: 'Are you sure you want to submit this payment?',
                confirmText: 'Yes, submit',
                cancelText: 'Cancel'
            });
            if (!confirmed) return;

            const fd = new FormData();
            fd.append("payment_id", $('#payment_id').val());
            fd.append("instalments", JSON.stringify(collectInstalments()));

            $.ajax({
                url: "/Payment/Update",
                type: "POST",
                data: fd,
                processData: false,
                contentType: false,
                success: async function (res) {
                    if (res.success) {
                        await tailwindMessageModal('Success', res.message || 'Payment updated.');
                        window.location.href = "/Payment";
                    } else {
                        await showError(res.message || "Update failed");
                    }
                },
                error: async function () {
                    await showError("Error updating payment");
                }
            });
        }

        function loadPayment() {
            const id = $('#payment_id').val().trim();
            if (!id) {
                showError("Invalid payment ID");
                return;
            }

            $.ajax({
                url: `/Payment/GetById?id=${id}`,
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (!res.success) {
                        showError(res.message || "Failed to load payment");
                        return;
                    }
                    const d = res.data || {};
                    isFullyPaid = (d.status || '').toUpperCase() === 'PAID';
                    remainingPaymentValue = parseFloat(d.remaining_payment || 0);

                    const studentText = d.student_name ? `${d.student_name} - ${d.nis || '-'}` : `Student (${d.student_class_id})`;
                    $('#student_display').text(studentText);
                    const ptypeText = d.payment_type_desc || d.payment_type;
                    $('#payment_type_display').text(ptypeText || '-');

                    const price = parseFloat(d.total_price || 0);
                    $('#total_price_display').text(formatCurrency(price));
                    $('#due_date_display').text(d.due_date || '-');
                    $('#remaining_payment_display').text(formatCurrency(d.remaining_payment || 0));

                    $('#tbody-instalments').empty();
                    if (d.instalments && d.instalments.length > 0) {
                        d.instalments.forEach(inst => addInstalmentRow(inst, { isExisting: true }));
                    }

                    if (!isFullyPaid) {
                        const defaultMethod = paymentMethodItems.length > 0 ? paymentMethodItems[0].value : '';
                        addInstalmentRow({
                            total_payment: '',
                            payment_date: new Date().toISOString().split('T')[0],
                            payment_method: defaultMethod,
                            notes: ''
                        }, { isExisting: false });
                        setPayButtonDisabled(false);
                    } else {
                        setPayButtonDisabled(true);
                        showInfo('This payment is already fully paid.');
                    }
                },
                error: function () {
                    showError("Failed to load payment");
                }
            });
        }

        function loadPaymentMethods() {
            return $.ajax({
                url: '/Payment/GetPaymentMethodItems',
                type: 'GET',
                dataType: 'json'
            }).then(function (res) {
                if (!res.success) {
                    throw new Error(res.message || 'Failed to load payment methods');
                }
                paymentMethodItems = res.data || [];
            });
        }

        $(document).ready(function () {
            loadPaymentMethods().then(function () {
                loadPayment();
            }).catch(function (err) {
                showError(err?.message || 'Failed to load payment methods');
            });
        });
    </script>
}
