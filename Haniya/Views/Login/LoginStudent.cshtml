@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Masuk Siswa - SMP IT HANIYA</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/image/logo-haniya.png" asp-append-version="true" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-red-900 via-red-700 to-red-500 flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-lg shadow-2xl overflow-hidden">
            <div class="bg-red-900 text-white p-8 text-center">
                <div class="mb-4">
                    <svg class="w-20 h-20 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold">SMP IT HANIYA</h1>
                <p class="text-red-200 mt-2">Portal Masuk Siswa</p>
            </div>

            <div class="p-8">
                <form id="loginForm">
                    @Html.AntiForgeryToken()

                    <div id="alertMessage" class="hidden mb-4 p-4 rounded-lg"></div>

                    <div class="mb-6">
                        <label class="block text-gray-700 text-sm font-semibold mb-2" for="nis">
                            NIS (Nomor Induk Siswa)
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 2a1 1 0 00-1 1v1a1 1 0 002 0V3a1 1 0 00-1-1zM4 4h3a3 3 0 006 0h3a2 2 0 012 2v9a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2zm2.5 7a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm2.45 4a2.5 2.5 0 10-4.9 0h4.9zM12 9a1 1 0 100 2h3a1 1 0 100-2h-3zm-1 4a1 1 0 011-1h2a1 1 0 110 2h-2a1 1 0 01-1-1z" clip-rule="evenodd" />
                                </svg>
                            </span>
                            <input type="text"
                                   id="nis"
                                   name="nis"
                                   class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
                                   placeholder="Masukkan NIS Anda"
                                   autocomplete="off"
                                   required>
                        </div>
                    </div>

                    <div class="mb-6">
                        <label class="block text-gray-700 text-sm font-semibold mb-2" for="password">
                            Kata Sandi
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                </svg>
                            </span>
                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
                                   placeholder="Masukkan kata sandi"
                                   autocomplete="current-password"
                                   required>
                            <button type="button"
                                    onclick="togglePassword()"
                                    class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600">
                                <svg id="eyeIcon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <svg id="eyeOffIcon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="mb-6 flex items-center justify-between">
                        <div class="flex items-center">
                            <input type="checkbox"
                                   id="remember_me"
                                   name="remember_me"
                                   class="w-4 h-4 text-red-600 border-gray-300 rounded focus:ring-red-500">
                            <label for="remember_me" class="ml-2 text-sm text-gray-700">
                                Ingat saya selama 30 hari
                            </label>
                        </div>
                    </div>

                    <button type="submit"
                            id="loginBtn"
                            class="w-full bg-red-900 text-white py-3 rounded-lg font-semibold hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition duration-200">
                        <span id="btnText">Masuk</span>
                        <span id="btnLoader" class="hidden">
                            <svg class="animate-spin h-5 w-5 inline-block" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Masuk...
                        </span>
                    </button>
                </form>

                <div class="mt-6 text-center text-sm text-gray-600">
                    <p class="mb-2">Masuk sebagai:</p>
                    <div class="flex justify-center space-x-4">
                        <a href="/LoginAdmin/Index" class="text-red-600 hover:text-red-800 font-medium transition">Admin</a>
                        <span class="text-gray-400">|</span>
                        <a href="/LoginTeacher/Index" class="text-red-600 hover:text-red-800 font-medium transition">Guru</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-6 text-white text-sm">
            <p>&copy; @DateTime.UtcNow.Year SMP IT HANIYA. Hak cipta dilindungi.</p>
        </div>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            const eyeOffIcon = document.getElementById('eyeOffIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.add('hidden');
                eyeOffIcon.classList.remove('hidden');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('hidden');
                eyeOffIcon.classList.add('hidden');
            }
        }

        $(document).ready(function () {
            $('#loginForm').on('submit', function (e) {
                e.preventDefault();

                $('#loginBtn').prop('disabled', true);
                $('#btnText').addClass('hidden');
                $('#btnLoader').removeClass('hidden');
                $('#alertMessage').addClass('hidden');

                const formData = new FormData(this);
                formData.append('remember_me', $('#remember_me').is(':checked'));

                $.ajax({
                    url: '/LoginStudent/Login',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            showAlert('success', response.message);
                            setTimeout(function () {
                                window.location.href = response.redirectUrl;
                            }, 500);
                        } else {
                            showAlert('error', response.message);
                            resetButton();
                        }
                    },
                    error: function (xhr) {
                        let errorMsg = 'Terjadi kesalahan. Silakan coba lagi.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        showAlert('error', errorMsg);
                        resetButton();
                    }
                });
            });

            function showAlert(type, message) {
                const alertDiv = $('#alertMessage');
                alertDiv.removeClass('hidden bg-red-100 bg-red-50 text-red-700 border-red-400');

                if (type === 'success') {
                    // Success alert tetap hijau atau bisa pakai shade merah yang sangat soft
                    alertDiv.addClass('bg-green-100 text-green-700 border border-green-400');
                } else {
                    alertDiv.addClass('bg-red-100 text-red-700 border border-red-400');
                }

                alertDiv.html(`
                            <div class="flex items-center">
                                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                </svg>
                                <span>${message}</span>
                            </div>
                        `);
                alertDiv.removeClass('hidden');
            }

            function resetButton() {
                $('#loginBtn').prop('disabled', false);
                $('#btnText').removeClass('hidden');
                $('#btnLoader').addClass('hidden');
            }

            $('#nis, #password').on('keypress', function (e) {
                if (e.which === 13) {
                    $('#loginForm').submit();
                }
            });
        });
    </script>
</body>
</html>
